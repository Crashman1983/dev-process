#!/usr/bin/env python3
"""publish_and_prune: the Spec Kit merge ritual — move a feature's spec
artifacts to their tracking issue, then remove specs/<feature>/ from the tree.

Order and safety (the independent design review's F5 conditions):
  1. read the `issue:` ref from specs/<feature>/plan.md — no ref, no prune;
  2. account for every SC-ID in spec.md: each must appear in the plan's
     `sc-evidenced:`/`sc-followup:`/`sc-waived:` lines — an unaccounted SC
     would vanish silently, so the ritual refuses (the SC lifecycle);
  2b. refuse while the directory holds uncommitted or untracked content, or
     while a tracked file outside it (code, tests, Makefile, hooks — not
     Markdown, not .process-work/) names a file in it (`referenced_files`);
  3. publish spec.md, tasks.md (and research/data-model, if present) as
     comments on the issue, split under GitHub's comment size limit;
  4. VERIFY the publish by reading the comment ids back — only then
  5. delete specs/<feature>/ (git rm) so main stays clean; on any publish
     failure, or when git refuses the removal, the directory stays
     (flow-forward degradation, stated loudly) — never a forced delete.

The plan itself is archived by the normal merge ritual
(`.process-work/plans/archive/` — the review gate keys on it); this tool
copies it there if the caller has not. Best-effort network tool (gh), never
a gate. Stdlib + `gh`.

Usage: python scripts/process/publish_and_prune.py <feature-dir-name>
       python scripts/process/publish_and_prune.py --stage <feature-dir-name>

--stage is the mid-flight half of the ritual: it publishes the CURRENT
spec.md (and design.md, if present) to the tracking issue as a dated
read-only snapshot comment and prunes NOTHING — the human's influence
window is the spec/design stage, so those artifacts must be readable where
the human reads BEFORE planning starts. The issue ref comes from spec.md's
`issue:` line (falling back to plan.md).
"""
from __future__ import annotations

import fnmatch
import json
import re
import shutil
import subprocess
import sys
from pathlib import Path

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parent))
from check_review import spec_dir_issue  # noqa: E402

SPECS = "specs"
ARCHIVE = ".process-work/plans/archive"
COMMENT_LIMIT = 60000  # under GitHub's 65536, leaving header room
SC_ID = re.compile(r"\bSC-\d{3}\b")
SC_ACCOUNT = re.compile(r"^\s*(?:[-*+]\s+)?sc-(evidenced|followup|waived)\s*:\s*(SC-\d{3})\b",
                        re.IGNORECASE | re.MULTILINE)
ISSUE_LINE = re.compile(r"^\s*(?:[-*+]\s+)?issue\s*:\s*(\S+)", re.IGNORECASE | re.MULTILINE)


def _issue_number(plan_text: str) -> str | None:
    m = ISSUE_LINE.search(plan_text)
    if not m:
        return None
    ref = m.group(1)
    num = re.search(r"(\d+)$", ref)
    return num.group(1) if num else None


def _unaccounted_scs(spec_text: str, plan_text: str) -> list[str]:
    declared = sorted(set(SC_ID.findall(spec_text)))
    accounted = {m.group(2).upper() for m in SC_ACCOUNT.finditer(plan_text)}
    return [sc for sc in declared if sc.upper() not in accounted]


def _git_out(root: Path, *args: str) -> subprocess.CompletedProcess:
    return subprocess.run(["git", "-C", str(root), *args], capture_output=True)


def _needles(rel: str, *, is_dir: bool = False) -> list[str]:
    """The strings a reference to `rel` (specs/<feature>/...) contains. A file:
    its root-relative path, the path below specs/, its name with its parent
    directory, for a module its dotted path (whole and from the parent). A
    directory: its root-relative path, and for a subdirectory the path below
    specs/ too (`sys.path.insert(…/probes)` names no file)."""
    parts = rel.split("/")
    if is_dir:
        return [rel] if len(parts) <= 2 else [rel, "/".join(parts[1:])]
    found = [rel, "/".join(parts[1:])]
    if len(parts) > 3:
        found.append("/".join(parts[-2:]))
    if rel.endswith(".py"):
        dotted = [*parts[:-1], parts[-1][:-3]]
        found.append(".".join(dotted))
        if len(parts) > 3:
            found.append(".".join(dotted[-2:]))
    return list(dict.fromkeys(found))


def _tokens(rel_dir: str, files: list[str]) -> dict[str, str]:
    """{token: key} that name the directory without its path: the spec
    directory's name as a whole word (`Path("specs") / "<feature>"`,
    `Path("specs", "<feature>")`), and the bare stem of each module in it —
    only where it is imported (`_imported`): a stem like `main` or `config` is
    a word in every YAML file. The examples here are placeholders on purpose:
    this file is tracked too. Dunder stems (`__init__`) name no module."""
    tokens = {rel_dir.rsplit("/", 1)[-1]: rel_dir + "/"}
    for rel in files:
        stem = rel.rsplit("/", 1)[-1][:-3] if rel.endswith(".py") else ""
        if stem and not (stem.startswith("__") and stem.endswith("__")):
            tokens.setdefault(stem, rel)
    return tokens


def _whole(token: str, text: str) -> bool:
    return re.search(rf"(?<![\w-]){re.escape(token)}(?![\w-])", text) is not None


def _imported(stem: str, rel: str, text: str) -> bool:
    """An import statement naming <stem> (`import <stem>`, `from <stem> import …`,
    `from <its parent dir> import <stem>` — statements, not prose like "from
    main", and not `from other import main`), `import_module("<stem>")`,
    `__import__("<stem>")`, or a `pytest_plugins` line quoting it."""
    s = re.escape(stem)
    parent = re.escape(rel.split("/")[-2]) if rel.count("/") > 2 else None
    return (re.search(rf"^\s*import\s+(?:[\w.]+\s*,\s*)*{s}(?![\w-])", text) is not None
            or re.search(rf"^\s*from\s+{s}(?:\.[\w.]+)?\s+import\b", text) is not None
            or (parent is not None and re.search(
                rf"^\s*from\s+(?:[\w.]+\.)?{parent}\s+import\s+\(?[\w\s,]*\b{s}\b", text) is not None)
            or re.search(rf"\b(?:import_module|__import__)\(\s*['\"]{s}['\"]", text) is not None
            or ("pytest_plugins" in text and re.search(rf"['\"]{s}['\"]", text) is not None))


# a path under the spec root with a wildcard or a variable in a segment: `*`,
# `?`, `**`, `[…]`, `{a,b}`, `<name>`, Makefile `$(F)`, shell `${F}`
_GLOB = re.compile(r"specs/(?:\$\([^)\s]*\)|\$\{[^}\s]*\}|\{[^}\s]*\}|<[^>\s]*>|[^\s'\"`,;(){}<>])+")
_GLOB_HIT = r"specs/[^[:space:]]*([][*?{<]|[$][({])"


def _glob_segments(token: str) -> list[str]:
    token = re.sub(r"\$\([^)]*\)|\$\{[^}]*\}|\{[^}]*\}|<[^>]*>", "*", token)
    return token.rstrip("/").split("/")


def _glob_matches(segs: list[str], parts: list[str]) -> bool:
    """Segment-wise: `*` and `?` stay inside one path segment, `**` spans any."""
    if not segs:
        return not parts
    if segs[0] == "**":
        return any(_glob_matches(segs[1:], parts[i:]) for i in range(len(parts) + 1))
    return bool(parts) and fnmatch.fnmatchcase(parts[0], segs[0]) and _glob_matches(segs[1:], parts[1:])


def _glob_target(token: str, files: list[str]) -> str | None:
    """The file or subdirectory of the spec directory that the glob `token`
    reaches — never the spec directory itself or a Markdown artifact: process
    tools glob `specs/*/plan.md` and the like, and the ritual publishes those.
    A glob of wildcard segments only covers the spec root wholesale (a CI
    `paths-ignore`, .gitattributes, CODEOWNERS) and names nothing in it."""
    if not any(c in token for c in "*?[{<$"):
        return None
    segs = _glob_segments(token)
    if all(re.fullmatch(r"[*?]+", s) for s in segs[1:]):
        return None  # the spec root wholesale (`paths-ignore`, CODEOWNERS): names nothing in it
    for rel in files:
        parts = rel.split("/")
        for depth in range(3, len(parts) + 1):  # a subdirectory, then the file
            if depth == len(parts) and rel.endswith(".md"):
                continue
            if _glob_matches(segs, parts[:depth]):
                return "/".join(parts[:depth]) + ("/" if depth < len(parts) else "")
    return None


def referenced_files(root: Path, fdir: Path) -> dict[str, str]:
    """{tracked file or directory (`…/`) under `fdir`: "referrer:line"} — what
    the prune would delete although a tracked file outside it (not
    .process-work/, not Markdown — a doctest or snippet in a .md file is not
    read) still names it: by path, by dotted module path, by the directory's
    name or a module's bare stem as a whole token, or by a glob over specs/
    that reaches a non-Markdown file or a subdirectory in it. Over-refusing is
    cheap — the referrer is named; a deleted probe a test imports is not
    (observed downstream). RuntimeError when git cannot answer — no answer,
    no prune."""
    rel_dir = fdir.relative_to(root).as_posix()
    ls = _git_out(root, "ls-files", "-z", "--", rel_dir)
    if ls.returncode != 0:
        raise RuntimeError(f"git ls-files failed: {ls.stderr.decode(errors='replace').strip()}")
    files = [rel for rel in ls.stdout.decode(errors="surrogateescape").split("\0") if rel]
    if not files:
        return {}
    needles: dict[str, list[str]] = {rel: _needles(rel) for rel in files}
    for rel in files:
        parent = rel.rsplit("/", 1)[0]
        while len(parent) >= len(rel_dir):
            needles.setdefault(parent + "/", _needles(parent, is_dir=True))
            parent = parent.rsplit("/", 1)[0]
    tokens = _tokens(rel_dir, files)
    pats = dict.fromkeys([*(n for ns in needles.values() for n in ns), *tokens])
    scope = ("--", ".", ":(exclude).process-work", f":(exclude){rel_dir}", ":(exclude)*.md")
    hits: dict[str, str] = {}
    for line, path, lineno in _grep(root, "-F", *[a for n in pats for a in ("-e", n)], *scope):
        # the most specific name on the line: a file's path also names its directories
        matched = [(len(n), key) for key, ns in needles.items() for n in ns if n in line]
        if matched:
            hits.setdefault(max(matched)[1], f"{path}:{lineno}")
            continue
        for token, key in tokens.items():  # the directory's name, then module stems
            if _whole(token, line) if key.endswith("/") else _imported(token, key, line):
                hits.setdefault(key, f"{path}:{lineno}, names {token!r}")
                break
    for line, path, lineno in _grep(root, "-E", "-e", _GLOB_HIT, *scope):
        for token in _GLOB.findall(line):
            target = _glob_target(token, files)
            if target:
                hits.setdefault(target, f"{path}:{lineno}, glob {token}")
                break
    return hits


def _grep(root: Path, *args: str) -> list[tuple[str, str, str]]:
    """(text, path, line number) of each tracked line `git grep` matches."""
    r = _git_out(root, "grep", "-n", "-z", "-I", "--no-color", *args)
    if r.returncode not in (0, 1):  # 1: no match
        raise RuntimeError(f"git grep failed: {r.stderr.decode(errors='replace').strip()}")
    out = []
    for raw in r.stdout.decode(errors="surrogateescape").splitlines():
        fields = raw.split("\0", 2)
        if len(fields) == 3:
            out.append((fields[2], fields[0], fields[1]))
    return out


def _dirty(root: Path, fdir: Path) -> list[str]:
    """Modified, staged or untracked entries under `fdir` — content `git rm`
    would refuse or leave behind; RuntimeError when git cannot answer."""
    st = _git_out(root, "status", "--porcelain", "-z", "--untracked-files=all", "--",
                  fdir.relative_to(root).as_posix())
    if st.returncode != 0:
        raise RuntimeError(f"git status failed: {st.stderr.decode(errors='replace').strip()}")
    return [e[3:] for e in st.stdout.decode(errors="surrogateescape").split("\0") if len(e) > 3]


def _gh(gh: str, *args: str) -> subprocess.CompletedProcess:
    return subprocess.run([gh, *args], capture_output=True, text=True, timeout=120)


# --- outbound guard: what leaves the repo is checked before it leaves ------
# `.publish-denylist` holds one regex per line (comments with #). Every body
# about to be posted is matched against it; a hit refuses the whole publish
# and names pattern and line. Observed downstream: a spec snapshot carried
# client slugs copied from UI-test stubs onto a public issue and had to be
# scrubbed by hand. The list is the project's — the template ships none.
DENYLIST = ".publish-denylist"


def _denylist(root: Path) -> list[re.Pattern[str]]:
    f = root / DENYLIST
    if not f.is_file():
        return []
    pats: list[re.Pattern[str]] = []
    for ln in f.read_text(encoding="utf-8").splitlines():
        ln = ln.strip()
        if ln and not ln.startswith("#"):
            try:
                pats.append(re.compile(ln))
            except re.error as exc:
                print(f"publish_and_prune: {DENYLIST}: bad pattern {ln!r}: {exc}",
                      file=sys.stderr)
    return pats


def _denied(text: str, pats: list[re.Pattern[str]]) -> list[str]:
    hits: list[str] = []
    for i, line in enumerate(text.splitlines(), 1):
        for pat in pats:
            if pat.search(line):
                hits.append(f"line {i} matches {pat.pattern!r}")
    return hits


def _rest_comment(gh: str, issue: str, text: str) -> subprocess.CompletedProcess:
    """`gh issue comment` goes through GraphQL, whose secondary rate limit
    refused posts for hours downstream while the REST budget sat at
    5000/5000. REST is the fallback, same result, different quota."""
    return _gh(gh, "api", f"repos/{{owner}}/{{repo}}/issues/{issue}/comments",
               "-f", f"body={text}")


def _post_comment(gh: str, issue: str, title: str, body: str,
                  deny: list[re.Pattern[str]] | None = None) -> bool:
    """Post (possibly split) and verify by reading the comment back."""
    hits = _denied(body, deny or [])
    if hits:
        print(f"publish_and_prune: REFUSED to publish {title!r} — {DENYLIST} hit: "
              + "; ".join(hits[:5]) + ("; …" if len(hits) > 5 else ""),
              file=sys.stderr)
        return False
    chunks = [body[i:i + COMMENT_LIMIT] for i in range(0, len(body), COMMENT_LIMIT)] or [""]
    for i, chunk in enumerate(chunks, 1):
        suffix = f" (part {i}/{len(chunks)})" if len(chunks) > 1 else ""
        text = f"<!-- publish_and_prune -->\n## {title}{suffix}\n\n{chunk}"
        r = _gh(gh, "issue", "comment", issue, "--body", text)
        if r.returncode != 0:
            print(f"publish_and_prune: `gh issue comment` failed "
                  f"({r.stderr.strip()[:200]}) — retrying via REST", file=sys.stderr)
            r = _rest_comment(gh, issue, text)
        if r.returncode != 0:
            print(f"publish_and_prune: comment failed: {r.stderr.strip()}", file=sys.stderr)
            return False
    # verify: the marker must be present in the issue's comments (REST first —
    # it is the route that was still open when GraphQL was throttled)
    r = _gh(gh, "api", "--paginate", f"repos/{{owner}}/{{repo}}/issues/{issue}/comments")
    bodies: list[str] = []
    if r.returncode == 0:
        try:
            for item in json.loads(r.stdout):
                bodies.append(item.get("body") or "")
        except (json.JSONDecodeError, AttributeError):
            bodies = []
    if not bodies:
        r = _gh(gh, "issue", "view", issue, "--json", "comments")
        if r.returncode != 0:
            return False
        try:
            bodies = [c.get("body") or "" for c in json.loads(r.stdout).get("comments", [])]
        except json.JSONDecodeError:
            return False
    return any("publish_and_prune" in b for b in bodies)


def _stage(root: Path, fdir: Path) -> int:
    """Mid-flight publish: spec (and design) to the issue, prune nothing."""
    import datetime
    spec = fdir / "spec.md"
    if not spec.is_file():
        print("publish_and_prune: --stage needs spec.md — nothing published",
              file=sys.stderr)
        return 1
    spec_text = spec.read_text(encoding="utf-8", errors="replace")
    number = spec_dir_issue(fdir)
    issue = str(number) if number is not None else None
    if not issue:
        print("publish_and_prune: no issue: ref in spec.md (or plan.md) — create "
              "the tracking issue at idea time and record it (issue-before-spec)",
              file=sys.stderr)
        return 1
    gh = shutil.which("gh")
    if not gh:
        print("publish_and_prune: `gh` not on PATH — nothing published", file=sys.stderr)
        return 1
    stamp = datetime.date.today().isoformat()
    deny = _denylist(root)
    ok = _post_comment(gh, issue, f"{fdir.name}/spec.md — stage snapshot {stamp} "
                                  f"(read-only; the file in specs/ is the SSOT)",
                       spec_text, deny)
    design = fdir / "design.md"
    if ok and design.is_file():
        ok = _post_comment(gh, issue, f"{fdir.name}/design.md — stage snapshot {stamp}",
                           design.read_text(encoding="utf-8", errors="replace"), deny)
    if not ok:
        print("publish_and_prune: stage publish NOT verified — re-run", file=sys.stderr)
        return 1
    print(f"publish_and_prune: staged {fdir.name} to issue #{issue} — "
          f"read comments before /plan; they are clarify input")
    return 0


def main() -> int:
    argv = sys.argv[1:]
    stage = "--stage" in argv
    argv = [a for a in argv if a != "--stage"]
    if len(argv) != 1:
        print("usage: publish_and_prune.py [--stage] <feature-dir-name>", file=sys.stderr)
        return 2
    root = Path(".").resolve()
    fdir = root / SPECS / argv[0]
    if not fdir.is_dir():
        print(f"publish_and_prune: no {fdir.relative_to(root)}", file=sys.stderr)
        return 1
    if stage:
        return _stage(root, fdir)
    plan = fdir / "plan.md"
    spec = fdir / "spec.md"
    if not plan.is_file() or not spec.is_file():
        print("publish_and_prune: plan.md and spec.md required — nothing pruned",
              file=sys.stderr)
        return 1
    plan_text = plan.read_text(encoding="utf-8", errors="replace")
    spec_text = spec.read_text(encoding="utf-8", errors="replace")

    issue = _issue_number(plan_text)
    if not issue:
        print("publish_and_prune: plan.md has no issue: ref — no publish target, "
              "directory stays (flow-forward)", file=sys.stderr)
        return 1
    missing = _unaccounted_scs(spec_text, plan_text)
    if missing:
        print("publish_and_prune: unaccounted Success Criteria — each SC-ID needs "
              "an sc-evidenced:/sc-followup:/sc-waived: line in plan.md before the "
              f"prune (silent disappearance is not an option): {', '.join(missing)}",
              file=sys.stderr)
        return 1
    try:
        dirty = _dirty(root, fdir)
        refs = referenced_files(root, fdir)
    except RuntimeError as exc:
        print(f"publish_and_prune: {exc} — nothing pruned", file=sys.stderr)
        return 1
    if dirty:
        print(f"publish_and_prune: {SPECS}/{fdir.name}/ holds uncommitted or untracked "
              f"content ({', '.join(dirty[:5])}{', …' if len(dirty) > 5 else ''}) — commit "
              f"or remove it first; nothing pruned", file=sys.stderr)
        return 1
    if refs:
        print(f"publish_and_prune: tracked files outside {SPECS}/{fdir.name}/ still reference "
              f"what the prune would delete — move it out of the spec directory or drop the "
              f"reference; nothing pruned:", file=sys.stderr)
        for rel, where in sorted(refs.items()):
            print(f"  - {rel} (referenced at {where})", file=sys.stderr)
        return 1

    gh = shutil.which("gh")
    if not gh:
        print("publish_and_prune: `gh` not on PATH — directory stays (flow-forward)",
              file=sys.stderr)
        return 1

    ok = True
    deny = _denylist(root)
    for f in sorted(fdir.glob("*.md")):
        ok = ok and _post_comment(gh, issue, f"{fdir.name}/{f.name}",
                                  f.read_text(encoding="utf-8", errors="replace"), deny)
    for sub in ("contracts", "checklists"):
        for f in sorted((fdir / sub).glob("*")) if (fdir / sub).is_dir() else []:
            if f.is_file():
                ok = ok and _post_comment(gh, issue, f"{fdir.name}/{sub}/{f.name}",
                                          f.read_text(encoding="utf-8", errors="replace"), deny)
    if not ok:
        print("publish_and_prune: publish NOT verified — directory stays "
              "(flow-forward degradation); fix and re-run", file=sys.stderr)
        return 1

    # archive the plan for the review gate, then prune
    adir = root / ARCHIVE
    adir.mkdir(parents=True, exist_ok=True)
    target = adir / f"{fdir.name}.md"
    if not target.exists():
        shutil.copy2(plan, target)
    r = subprocess.run(["git", "rm", "-r", "-q", str(fdir.relative_to(root))],
                       cwd=root, capture_output=True, text=True)
    if r.returncode != 0:  # never a forced delete: what git refuses may be uncommitted work
        print(f"publish_and_prune: published to issue #{issue}, but `git rm` refused "
              f"{SPECS}/{fdir.name}/ ({r.stderr.strip()}) — nothing pruned; resolve and "
              f"re-run", file=sys.stderr)
        return 1
    print(f"publish_and_prune: published to issue #{issue}, archived plan to "
          f"{ARCHIVE}/{fdir.name}.md, pruned {SPECS}/{fdir.name}/ — commit the result")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
