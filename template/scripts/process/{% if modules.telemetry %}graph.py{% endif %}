#!/usr/bin/env python3
"""graph — the process's relations, derived read-only from what already exists.

    graph.py build   [--json] [--commits N]       every edge with its source, commit and certainty
    graph.py context PATH... [--json]             what else a change to PATH probably touches
    graph.py missed  [--branch B] [--json]        relations a branch did not follow

Observation mode (docs/process/optimization.md; telemetry module doc,
"The graph"): the graph recommends, it never decides. It is not a source of
truth for issues, contracts or decisions — every edge is derived from an
owner that already exists and says so:

| edge | from | certainty |
|---|---|---|
| issue → plan | a plan's `issue:` line (check_review) | declared |
| plan → file | a tracked path named in a plan | declared |
| file → test | `docs/process/testing.local.json` (test_select's map, no local command run) | derived |
| file ~ file | changed together in git history (support, confidence) | inferred |
| work → review | a journal REVIEW line: verdict and reviewed head (check_review) | declared |
| project edges | each command in `docs/process/graph.local.json` | as the command says |

Every edge carries `source`, `at` (the commit it was read at) and
`certainty`. **A missing edge proves no independence**: git sees only what
changed together, a plan only what its author named, the test map only
what it maps. `missed` therefore reports what *may* have been overlooked —
a co-change partner the branch did not touch, a file its plan named but the
branch left alone — never a verdict.

Project sources stay the project's: `graph.local.json` is
`{"sources": [{"name": "...", "exec": ["argv", ...]}]}`; each command prints
one JSON object per line, `{"from", "to", "kind", "certainty"}` (certainty
one of declared, derived, inferred), and runs from the repository root. A
source that fails or prints garbage is named in the output, never skipped
silently. Read-only, never a gate, stdlib only.
"""
from __future__ import annotations

import argparse
import json
import re
import subprocess
import sys
from collections import Counter, defaultdict
from pathlib import Path

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parent))  # sibling imports

LOCAL_SOURCES = "docs/process/graph.local.json"
CERTAINTIES = ("declared", "derived", "inferred")
_COMMITS = 300          # history read for co-change
_MAX_FILES = 20         # a commit touching more files says little about pairs (formatting, renames)
_MIN_SUPPORT = 3        # times changed together before a pair is an edge
_MIN_CONFIDENCE = 0.5   # share of the rarer file's commits that carried the partner
_SOURCE_TIMEOUT = 120
_PATH_TOKEN = re.compile(r"[\w][\w./@+-]*")


def _git(root: Path, *args: str) -> bytes | None:
    try:
        r = subprocess.run(["git", "-C", str(root), *args], capture_output=True, timeout=60)
    except (OSError, subprocess.TimeoutExpired):
        return None
    return r.stdout if r.returncode == 0 else None


def head(root: Path) -> str:
    out = _git(root, "rev-parse", "--short=12", "HEAD")
    return out.decode().strip() if out else "unknown"


def tracked(root: Path) -> set[str] | None:
    out = _git(root, "ls-files", "-z")
    if out is None:
        return None
    return {p for p in out.decode("utf-8", "surrogateescape").split("\0") if p}


def _edge(src: str, dst: str, kind: str, source: str, at: str, certainty: str, **extra) -> dict:
    return {"from": src, "to": dst, "kind": kind, "source": source, "at": at, "certainty": certainty, **extra}


# --- sources ---------------------------------------------------------------
def plan_edges(root: Path, at: str, files: set[str]) -> list[dict]:
    import check_review as _review  # noqa: PLC0415 — the plans' owner

    out = []
    for rel, text in _review.record_texts(root, ("plan", "plan-archive", "spec-plan")) or []:
        body = _review.uncommented(text)
        for n in sorted(set(_review.declared_issue_numbers(body))):
            out.append(_edge(f"issue:#{n}", f"plan:{rel}", "plans", rel, at, "declared"))
        # a path is named when it stands as a whole token — `a.py` inside `data.py` is not
        for path in sorted({t.rstrip(".,;:") for t in _PATH_TOKEN.findall(body)} & files):
            out.append(_edge(f"plan:{rel}", f"file:{path}", "names", rel, at, "declared"))
    return out


def cochange_edges(root: Path, at: str, commits: int = _COMMITS) -> list[dict]:
    """Pairs of files changed together; -z, so a non-ASCII name stays one name."""
    out_b = _git(root, "log", "-z", "--no-merges", "-n", str(commits), "--name-only", "--format=\x01%h")
    if out_b is None:
        return []
    groups: list[set[str]] = []
    after_header = False
    for field in out_b.decode("utf-8", "surrogateescape").split("\0"):
        if field.startswith("\x01"):
            groups.append(set())
            after_header = True
            continue
        if after_header and field.startswith("\n"):
            field = field[1:]  # git puts a newline between the header's NUL and the first name
        after_header = False
        if field and groups:
            groups[-1].add(field)
    seen: Counter[str] = Counter()
    pairs: Counter[tuple[str, str]] = Counter()
    for g in groups:
        g = {f for f in g if not f.startswith(".process-work/")}
        if not g or len(g) > _MAX_FILES:
            continue
        seen.update(g)
        ordered = sorted(g)
        for i, a in enumerate(ordered):
            for b in ordered[i + 1:]:
                pairs[(a, b)] += 1
    edges = []
    for (a, b), n in pairs.items():
        conf = n / min(seen[a], seen[b])
        if n >= _MIN_SUPPORT and conf >= _MIN_CONFIDENCE:
            edges.append(_edge(f"file:{a}", f"file:{b}", "changes-with", f"git log -n {commits}", at,
                               "inferred", support=n, confidence=round(conf, 2)))
    return edges


def test_edges(root: Path, at: str, paths: set[str]) -> tuple[list[dict], str | None]:
    """file → test from the project's test map; no local `select` command runs."""
    import testing_config  # noqa: PLC0415 — the test configuration's owner
    import test_select  # noqa: PLC0415 — the one selection rule

    try:
        cfg = testing_config.load(root)
    except testing_config.ConfigError as exc:
        return [], f"{testing_config.CONFIG}: {exc}"
    if cfg is None:
        return [], None
    cfg = {**cfg, "stacks": [{**s, "select": None} for s in cfg["stacks"]]}
    edges = []
    for path in sorted(paths):
        try:
            steps = test_select.plan(root, cfg, {path}, "branch")
        except Exception as exc:  # noqa: BLE001 — a recommendation, never a crash
            return edges, f"test map: {exc}"
        for step in steps:
            for target in step["targets"]:
                if target != path:
                    edges.append(_edge(f"file:{path}", f"test:{target}", "tested-by",
                                       testing_config.CONFIG, at, "derived", stack=step["name"]))
    return edges, None


def review_edges(root: Path, at: str) -> list[dict]:
    import check_review as _review  # noqa: PLC0415

    out = []
    for rel, text in _review.record_texts(root, ("journal",)) or []:
        records, _errors = _review.parse_review_lines(text)
        for _ln, rec in records:
            out.append(_edge(f"work:{rec['work']}", f"review:{rec.get('head') or 'unbound'}", "reviewed",
                             rel, at, "declared", verdict=rec.get("verdict"), tier=rec.get("tier"),
                             round=rec.get("round")))
    return out


def project_edges(root: Path, at: str) -> tuple[list[dict], list[str]]:
    """Edges from the project's own commands; problems named, never swallowed."""
    f = root / LOCAL_SOURCES
    if not f.is_file():
        return [], []
    try:
        data = json.loads(f.read_text(encoding="utf-8"))
        sources = data["sources"]
        assert isinstance(sources, list)
    except (OSError, ValueError, KeyError, TypeError, AssertionError) as exc:
        return [], [f"{LOCAL_SOURCES}: unreadable ({type(exc).__name__}) — expected "
                    '{"sources": [{"name", "exec": [argv]}]}']
    edges, problems = [], []
    for src in sources:
        name = src.get("name") if isinstance(src, dict) else None
        argv = src.get("exec") if isinstance(src, dict) else None
        if not isinstance(name, str) or not isinstance(argv, list) or not argv \
                or not all(isinstance(a, str) and a for a in argv):
            problems.append(f"{LOCAL_SOURCES}: a source needs 'name' and a non-empty 'exec' list")
            continue
        try:
            r = subprocess.run(argv, cwd=root, capture_output=True, text=True, timeout=_SOURCE_TIMEOUT)
        except (OSError, subprocess.TimeoutExpired) as exc:
            problems.append(f"source {name}: did not run ({exc})")
            continue
        if r.returncode != 0:
            problems.append(f"source {name}: exited {r.returncode} — its edges are missing, not absent")
            continue
        for i, line in enumerate(r.stdout.splitlines(), 1):
            if not line.strip():
                continue
            try:
                e = json.loads(line)
                ok = (isinstance(e, dict) and all(isinstance(e.get(k), str) and e[k] for k in ("from", "to"))
                      and e.get("certainty", "inferred") in CERTAINTIES)
            except ValueError:
                ok = False
            if not ok:
                problems.append(f"source {name}: line {i} is not an edge — the rest of its output is used")
                continue
            edges.append(_edge(e["from"], e["to"], str(e.get("kind") or "relates"), name, at,
                               e.get("certainty", "inferred")))
    return edges, problems


def process_version(root: Path) -> str | None:
    try:
        text = (root / ".copier-answers.yml").read_text(encoding="utf-8")
    except OSError:
        return None
    m = re.search(r"^_commit:\s*['\"]?([^'\"\s]+)", text, re.MULTILINE)
    return m.group(1) if m else None


def build(root: Path, *, commits: int = _COMMITS, tests_for: set[str] | None = None) -> dict:
    at = head(root)
    files = tracked(root)
    problems: list[str] = []
    if files is None:
        problems.append("git cannot list the tracked files — plan and test edges are missing")
        files = set()
    edges = plan_edges(root, at, files) + cochange_edges(root, at, commits) + review_edges(root, at)
    t_edges, t_problem = test_edges(root, at, tests_for if tests_for is not None else set())
    edges += t_edges
    if t_problem:
        problems.append(t_problem)
    p_edges, p_problems = project_edges(root, at)
    edges += p_edges
    problems += p_problems
    return {"at": at, "process_version": process_version(root), "edges": edges, "problems": problems,
            "note": "a missing edge proves no independence"}


# --- questions -------------------------------------------------------------
def neighbours(graph: dict, node: str) -> list[dict]:
    """Edges touching `node`, the far end first, strongest certainty first."""
    rank = {c: i for i, c in enumerate(CERTAINTIES)}
    out = []
    for e in graph["edges"]:
        if node in (e["from"], e["to"]):
            other = e["to"] if e["from"] == node else e["from"]
            out.append({**e, "other": other})
    return sorted(out, key=lambda e: (rank.get(e["certainty"], 9), -float(e.get("confidence") or 0), e["other"]))


def context(root: Path, paths: list[str], *, commits: int = _COMMITS) -> dict:
    graph = build(root, commits=commits, tests_for=set(paths))
    return {"at": graph["at"], "problems": graph["problems"], "note": graph["note"],
            "paths": {p: neighbours(graph, f"file:{p}") for p in paths}}


def _changed(root: Path, branch: str) -> tuple[set[str] | None, str | None]:
    import check_review as _review  # noqa: PLC0415 — one owner of the fork point

    base = _review.merge_base(root, branch)
    if not base:
        return None, None
    out = _git(root, "diff", "-z", "--name-only", "--no-renames", f"{base}..{branch}")
    if out is None:
        return None, base
    return {p for p in out.decode("utf-8", "surrogateescape").split("\0") if p}, base


def missed(root: Path, branch: str = "HEAD", *, commits: int = _COMMITS) -> dict:
    import check_review as _review  # noqa: PLC0415

    changed, base = _changed(root, branch)
    if changed is None:
        return {"branch": branch, "problems": ["git cannot tell what the branch changed — nothing judged"],
                "candidates": [], "note": "a missing edge proves no independence"}
    graph = build(root, commits=commits)
    hints: dict[str, list[str]] = defaultdict(list)
    for e in graph["edges"]:
        if e["kind"] != "changes-with":
            continue
        a, b = e["from"][5:], e["to"][5:]
        for mine, other in ((a, b), (b, a)):
            if mine in changed and other not in changed:
                hints[other].append(f"changed with {mine} in {e['support']} commits "
                                    f"(confidence {e['confidence']}, inferred)")
    issue = _review.branch_issue(_review_branch_name(root, branch))
    for e in graph["edges"]:
        if e["kind"] == "names" and issue and any(
                x["from"] == f"issue:#{issue}" and x["to"] == e["from"] for x in graph["edges"]):
            path = e["to"][5:]
            if path not in changed:
                hints[path].append(f"named in {e['from'][5:]}, the plan of #{issue} (declared)")
    return {"branch": branch, "base": base, "changed": sorted(changed), "problems": graph["problems"],
            "candidates": [{"path": p, "why": w} for p, w in sorted(hints.items())],
            "note": graph["note"]}


def _review_branch_name(root: Path, branch: str) -> str:
    if branch != "HEAD":
        return branch
    out = _git(root, "rev-parse", "--abbrev-ref", "HEAD")
    return out.decode().strip() if out else ""


# --- CLI -------------------------------------------------------------------
def _root() -> Path:
    out = _git(Path.cwd(), "rev-parse", "--show-toplevel")
    return Path(out.decode().strip()) if out else Path.cwd()


def main(argv: list[str] | None = None) -> int:
    p = argparse.ArgumentParser(description="read-only process graph (observation mode)")
    p.add_argument("--root", type=Path)
    p.add_argument("--commits", type=int, default=_COMMITS, help="history read for co-change")
    sub = p.add_subparsers(dest="cmd", required=True)
    b = sub.add_parser("build")
    b.add_argument("--json", action="store_true")
    c = sub.add_parser("context")
    c.add_argument("paths", nargs="+")
    c.add_argument("--json", action="store_true")
    m = sub.add_parser("missed")
    m.add_argument("--branch", default="HEAD")
    m.add_argument("--json", action="store_true")
    args = p.parse_args(argv)
    root = args.root or _root()

    if args.cmd == "build":
        g = build(root, commits=args.commits)
        if args.json:
            print(json.dumps(g, indent=2))
            return 0
        kinds = Counter((e["kind"], e["certainty"]) for e in g["edges"])
        print(f"[graph] at {g['at']} · process {g['process_version'] or 'unknown'} · {len(g['edges'])} edges")
        for (kind, certainty), n in sorted(kinds.items()):
            print(f"  {kind:<13} {certainty:<9} {n}")
    elif args.cmd == "context":
        g = context(root, args.paths, commits=args.commits)
        if args.json:
            print(json.dumps(g, indent=2))
            return 0
        for path, edges in g["paths"].items():
            print(f"[graph] {path} — {len(edges)} related")
            for e in edges[:25]:
                extra = f", support {e['support']}, confidence {e['confidence']}" if "support" in e else ""
                print(f"  {e['other']}  ({e['kind']}, {e['certainty']}, from {e['source']}{extra})")
    else:
        g = missed(root, args.branch, commits=args.commits)
        if args.json:
            print(json.dumps(g, indent=2))
            return 0
        print(f"[graph] {g['branch']}: {len(g['candidates'])} relation(s) possibly not followed")
        for cand in g["candidates"]:
            print(f"  {cand['path']}: " + "; ".join(cand["why"]))
    for problem in g["problems"]:
        print(f"  problem: {problem}")
    print(f"  note: {g['note']} — recommendations, not verdicts")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
