#!/usr/bin/env python3
"""design-contracts gate: a surface's design contract is a first-class,
pinned, cited norm — not a document somebody once wrote.

One registry file per surface under docs/process/design-contracts/<surface>.json
points at the committed contract, its status, its pin, the ID families the
contract defines, the decision record that made it normative, the independent
review that said GO, and (optionally) the sealed reference boards the reviewer
judges an AFTER screenshot against.

Hard (exit 1): registry structure; a contract that is not a committed file;
a content-hash pin that no longer matches (the contract moved without a
deliberate re-pin); an ID defined twice in the contract; an `accepted`
contract without decision record or without an independent review that
records a GO; a review that names a different seal than the reference
carries; a reference folder whose seal no longer verifies; an active plan
citing an ID the contract does not define; a malformed `states.json` in the
reference round, and — for a round the push touches — a missing one, a state
of the catalogue a view lacks, `stories` the registry setting rules out
(`touched_rounds`; the same findings are notes for an untouched round).

Best-effort (note, never red): an unknown registry key; an opaque pin; a draft contract; a legacy
norm (one note: registered so plans can declare it, #257); reference
boards rendered from an older contract (external drift — re-seal or start a
new round); a change in flight under the surface's paths while no active
plan cites a contract ID (DoR R5); a plan citing IDs without naming the
contract it means. A plan is bound to a contract by naming its path or a
`design-contract: <surface>` line — ID families are shared across surfaces,
so only a bound plan is judged against a contract. A project may make the
line a duty (docs/process/design-contract-declaration.local.json): from its day on,
every active Tier 2+ plan states `design-contract: <surface> | n/a — <reason>`
and a declared contract carries a non-empty `## Design Contract Trace`; naming
the path alone no longer suffices there. Judging the design itself is never
machine work — that is what the sealed boards and the reviewer are for.
Python stdlib only."""
from __future__ import annotations

import json
import posixpath
import re
import sys
from collections.abc import Callable
from dataclasses import dataclass, field
from pathlib import Path

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parent))  # sibling imports
import seal as _seal  # noqa: E402

REGISTRY_DIR = "docs/process/design-contracts"
PLANS_ACTIVE = ".process-work/plans"
SPECS_DIR = "specs"
# legacy: a norm older than the registry (no ADR made it one, no independent GO
# exists), registered so plans can declare it — one note, no further claims (#257)
STATUSES = {"draft", "accepted", "legacy"}
_HASH_PIN = re.compile(r"^sha256:([0-9a-f]{64})$")
# the seal a review verified is named, not scavenged: a review also carries the
# review-artifact digest (64 hex) — grabbing any hex read that as "a different seal"
_SEAL_LINE = re.compile(r"(?:manifest\.sha256|seal(?:\s+reviewed)?)\s*[:=]\s*`?([0-9a-f]{64})`?", re.IGNORECASE)
# the verdict is the whole token: "Decision: GO/NO-GO meeting" is no decision, and
# neither is the template's unfilled choice "GO | GO with conditions | NO GO"
_GO = re.compile(r"^\s*[*_#\s]*(?:decision|entscheidung)[*_]*\s*:\s*[*_]*\s*(GO|NO[- ]GO|KEIN GO)\b(?![-/])"
                 r"(?!\s*\|)", re.IGNORECASE | re.MULTILINE)
_HEADING = re.compile(r"^#{1,6}\s+(.*)$", re.MULTILINE)
_FENCE = re.compile(r"^(`{3,}|~{3,}).*?^\1[ \t]*$", re.MULTILINE | re.DOTALL)


def _unfenced(text: str) -> str:
    """Fenced blocks are quotations, never declarations — read as the review gate
    reads them (indented and list-item fences, a longer closing fence): one owner."""
    from check_review import _unfenced as owner  # noqa: PLC0415
    return owner(text)


def _without_decisions(text: str) -> str:
    """The text without its dated `DECISION` lines — the review gate's grammar, one owner."""
    from check_review import DECISION_LINE  # noqa: PLC0415
    return "\n".join(line for line in text.splitlines() if not DECISION_LINE.match(line))


def _registry_files(root: Path) -> list[Path]:
    d = root / REGISTRY_DIR
    if not d.is_dir():
        return []
    return sorted(p for p in d.glob("*.json") if not p.name.endswith(".example.json"))


def _inside(root: Path, rel: str) -> Path | None:
    resolved = (root / rel).resolve()
    if root.resolve() not in resolved.parents:
        return None
    return resolved


def _read(p: Path) -> str:
    try:
        return p.read_text(encoding="utf-8")
    except UnicodeDecodeError:
        return p.read_bytes().decode("utf-8", "replace")


def id_pattern(prefixes: list[str]) -> re.Pattern[str]:
    """`["C", "E", "AX"]` → an ID like C03, E1, AX3, C05a. Word-bounded so
    `E1` never matches inside `LINE1` and `C` alone matches nothing."""
    alts = "|".join(re.escape(p) for p in sorted(prefixes, key=len, reverse=True))
    return re.compile(rf"(?<![\w-])(?:{alts})\d+[a-z]?(?![\w-])")


# the one reader of a `design-contract:` line: binding (`bound_to`) and the
# declaration duty (`declaration_problems`) ask here
_DECLARED = re.compile(r"^\s*(?:[-*+]\s+)?[*_]*design-contract[*_]*[ \t]*:[ \t]*[*_]*[ \t]*(.*)$",
                       re.IGNORECASE | re.MULTILINE)


def declarations(text: str) -> list[str]:
    """The values of a plan's `design-contract:` lines, emphasis stripped, in order."""
    return [m.group(1).strip().strip("*_").strip() for m in _DECLARED.finditer(text)]


def declared_surface(value: str) -> str:
    """The surface a declaration names: its first word, quotes and backticks off, lower case."""
    return value.split()[0].strip("`'\"").lower() if value else ""


def bound_to(text: str, surface: str, contract_rel: str) -> bool:
    """A plan builds on a contract when it names it: the contract's path, or a
    `design-contract: <surface>` line. Two surfaces share ID families (E1 is
    an elevation on web and on mobile) — without the binding an iOS plan
    would be judged against the web contract and vice versa."""
    if contract_rel in text:
        return True
    return any(declared_surface(v) == surface.lower() for v in declarations(text))


def canonical(ident: str, ids: re.Pattern[str]) -> str:
    """C8 and C08 are the same element: prefix + int(number) + suffix."""
    m = re.fullmatch(r"(.*?)(\d+)([a-z]?)", ident)
    return f"{m.group(1)}{int(m.group(2))}{m.group(3)}" if m else ident


def _glob_re(pattern: str) -> re.Pattern[str]:
    out = ""
    i = 0
    while i < len(pattern):
        if pattern.startswith("**/", i):
            out += "(?:.*/)?"
            i += 3
        elif pattern.startswith("**", i):
            out += ".*"
            i += 2
        elif pattern[i] == "*":
            out += "[^/]*"
            i += 1
        elif pattern[i] == "?":
            out += "[^/]"
            i += 1
        else:
            out += re.escape(pattern[i])
            i += 1
    return re.compile(rf"^{out}$")


def active_plan_texts(root: Path) -> dict[str, str]:
    """Active plans and spec plans — the documents that must cite the IDs a
    UI change implements. Archived plans are history, never scanned."""
    out: dict[str, str] = {}
    d = root / PLANS_ACTIVE
    if d.is_dir():
        for p in sorted(d.glob("*.md")):
            out[str(p.relative_to(root))] = _read(p)
    s = root / SPECS_DIR
    if s.is_dir():
        for p in sorted(s.glob("*/plan.md")):
            out[str(p.relative_to(root))] = _read(p)
    return out


def _paths_in_flight(root: Path) -> set[str]:
    try:
        import check_review as _review_gate  # sibling; core script
    except ImportError:
        return set()
    try:
        return _review_gate.paths_in_flight(root)
    except Exception:  # a gate must never crash on git oddities
        return set()


def _notes_text(path: Path, data: dict) -> str:
    """The JSON `notes` plus the amendment lines of `<surface>.notes.md`.

    The sidecar takes new amendments as whole lines, so two branches appending
    to it merge without a conflict (`merge=union`); a missing sidecar is empty.
    """
    base = data.get("notes", "")
    base = base if isinstance(base, str) else ""
    sidecar = path.with_name(f"{path.stem}.notes.md")
    if not sidecar.is_file():
        return base
    return f"{base}\n{_read(sidecar)}"


def load(root: Path, path: Path) -> tuple[dict | None, list[str]]:
    rel = path.relative_to(root)
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except json.JSONDecodeError as exc:
        return None, [f"{rel}: invalid JSON: {exc}"]
    except UnicodeDecodeError as exc:
        return None, [f"{rel}: not valid UTF-8: {exc}"]
    if not isinstance(data, dict):
        return None, [f"{rel}: must be a JSON object, got {type(data).__name__}"]
    hard: list[str] = []
    for key in ("surface", "contract", "status", "pin"):
        if not isinstance(data.get(key), str) or not data[key].strip():
            hard.append(f"{rel}: '{key}' must be a non-empty string")
    prefixes = data.get("id_prefixes")
    if not (isinstance(prefixes, list) and prefixes
            and all(isinstance(x, str) and re.fullmatch(r"[A-Za-z][\w-]*", x) for x in prefixes)):
        hard.append(f"{rel}: 'id_prefixes' must be a non-empty list of identifier prefixes (e.g. [\"C\", \"E\", \"AX\"])")
    for key in ("adr", "review", "reference", "notes"):
        if key in data and not isinstance(data[key], str):
            hard.append(f"{rel}: '{key}' must be a string when present")
    paths = data.get("paths", [])
    if not (isinstance(paths, list) and all(isinstance(x, str) and x.strip() for x in paths)):
        hard.append(f"{rel}: 'paths' must be a list of glob strings when present")
    if hard:
        return None, hard
    if data["surface"].strip() != path.stem:
        hard.append(f"{rel}: 'surface' {data['surface'].strip()!r} must equal the filename stem {path.stem!r}")
    if data["status"].strip() not in STATUSES:
        hard.append(f"{rel}: 'status' must be one of {sorted(STATUSES)}")
    return (None, hard) if hard else (data, [])


def _check_one(root: Path, path: Path, plans: dict[str, str], in_flight: set[str]
               ) -> tuple[list[str], list[str]]:
    hard: list[str] = []
    soft: list[str] = []
    rel = path.relative_to(root)
    data, errs = load(root, path)
    if data is None:
        return errs, []
    # before this function adds its own `_review_hashes`: only what the file carries
    unknown = sorted(set(data) - set(_known_entry_keys()))
    if unknown:
        soft.append(f"{rel}: unknown key(s) {', '.join(repr(k) for k in unknown)} — no gate reads "
                    "them (a typo of a known field?)")
    _catalogue, problem = state_catalogue(root, data.get("state_catalogue"), _worktree_text(root))
    if problem:
        hard.append(f"{rel}: {problem}")
    surface = data["surface"].strip()
    status = data["status"].strip()
    cpath = _inside(root, data["contract"].strip())
    if cpath is None:
        return [f"{rel}: contract path escapes the repo root"], []
    if not cpath.is_file():
        return [f"{rel}: contract not committed / does not exist: {data['contract'].strip()}"], []
    text = _unfenced(_read(cpath))

    # --- the pin: the drift ratchet ---------------------------------------
    m = _HASH_PIN.match(data["pin"].strip())
    if m:
        actual = _seal._sha256(cpath)
        if actual != m.group(1):
            hard.append(f"{rel}: contract {data['contract'].strip()} changed without a re-pin "
                        f"(pin sha256:{m.group(1)[:12]}…, file sha256:{actual[:12]}…) — an "
                        "amendment is deliberate: record its provenance in the contract, then re-pin")
    else:
        if status != "legacy":  # the legacy note says it already
            soft.append(f"{rel}: opaque pin {data['pin'].strip()!r} — drift is not machine-checked")

    # --- IDs: defined once, cited from something real ------------------------
    ids = id_pattern(data["id_prefixes"])
    # a `DECISION` line quotes IDs, it defines none (the pin above still covers it)
    defined = {canonical(i, ids) for i in ids.findall(_without_decisions(text))}
    if not defined:
        if status != "legacy":
            soft.append(f"{rel}: contract defines no ID of the families {data['id_prefixes']} yet")
    seen: dict[str, list[str]] = {}
    for h in _HEADING.findall(text):
        lead = ids.match(h.strip().lstrip("*_`").strip())  # the ID *leads* the heading: a definition
        if lead:
            i = lead.group(0)
            seen.setdefault(canonical(i, ids), []).append(i)
    for forms in seen.values():
        if len(forms) > 1:
            hard.append(f"{rel}: ID {forms[0]} is defined by {len(forms)} headings in the "
                        "contract — one owner per ID")
    cited: dict[str, set[str]] = {}
    contract_rel = data["contract"].strip()
    for prel, ptext in plans.items():
        found = set(ids.findall(ptext))
        if not found:
            continue
        if not bound_to(ptext, surface, contract_rel):
            continue  # judged against the contract it names; unbound plans: see check()
        cited[prel] = found
        for i in sorted(found, key=lambda x: canonical(x, ids)):
            if canonical(i, ids) not in defined:
                hard.append(f"{prel}: cites {surface} design-contract ID {i}, which "
                            f"{contract_rel} does not define — a plan may only "
                            "build on IDs the contract carries (amend the contract first)")

    # --- status: accepted needs a decision record and an independent GO --------
    if status == "draft":
        soft.append(f"{rel}: {surface} contract is a draft — not yet the norm for implementation")
    elif status == "legacy":
        soft.append(f"{rel}: {surface} is a legacy norm — registered so plans can declare it, "
                    "not machine-checked beyond the IDs plans cite")
    else:
        for key, what in (("adr", "decision record"), ("review", "independent review")):
            val = data.get(key, "").strip() if isinstance(data.get(key), str) else ""
            if not val:
                hard.append(f"{rel}: status 'accepted' requires '{key}' (the {what} that made it the norm)")
                continue
            p = _inside(root, val)
            if p is None or not p.is_file():
                hard.append(f"{rel}: {key} {val!r} is not a committed file")
                continue
            if key == "review":
                rtext = _unfenced(_read(p))
                decisions = list(_GO.finditer(rtext))
                go = decisions[-1] if decisions else None  # the last decision line stands
                if go is None:
                    hard.append(f"{rel}: review {val} records no decision line (`Decision: GO` / "
                                "`Decision: NO GO`) — an accepted contract needs a recorded GO")
                elif go.group(1).upper() != "GO":
                    hard.append(f"{rel}: review {val} records {go.group(1)!r} — the contract "
                                "cannot be 'accepted' on a review that did not clear it")
                data["_review_hashes"] = {m.group(1) for m in _SEAL_LINE.finditer(rtext)}

    # --- the reference: sealed boards -----------------------------------------
    ref = data.get("reference", "").strip() if isinstance(data.get("reference"), str) else ""
    if ref:
        rdir = _inside(root, ref)
        if rdir is None or not rdir.is_dir():
            hard.append(f"{rel}: reference {ref!r} is not a directory in the repo")
        else:
            sealed_hard, drift = _seal.verify(root, rdir)
            hard += [f"{rel}: reference: {h}" for h in sealed_hard]
            soft += [f"{rel}: reference rendered from an older dependency — {d} "
                     "(re-seal or start a new round)" for d in drift]
            spath = rdir / _seal.SEAL
            if not sealed_hard and spath.is_file() and "_review_hashes" in data:
                current = (spath.read_text(encoding="utf-8").split() or [""])[0]
                hashes = data["_review_hashes"]
                if hashes and current not in hashes:
                    hard.append(f"{rel}: review {data['review'].strip()} names seal(s) "
                                f"{', '.join(sorted(h[:12] + '…' for h in hashes))} but the reference "
                                f"carries {current[:12]}… — the GO applies to different boards")
                elif not hashes:
                    soft.append(f"{rel}: review does not name the seal it verified — "
                                "quote manifest.sha256 in the review")
    elif status == "accepted":
        soft.append(f"{rel}: no sealed reference — the reviewer judges AFTER pictures "
                    "against the contract text alone")

    # Notes may cite older seals only when their sentence says historical.
    notes = _notes_text(path, data)
    if notes:
        current = ""
        seal_path = _inside(root, ref + "/manifest.sha256") if ref else None
        if seal_path and seal_path.is_file():
            current = (seal_path.read_text(encoding="utf-8").split() or [""])[0]
        for sentence in re.split(r"\n|;|(?<=[.!?])\s+", notes):
            if re.search(r"\b(?:historical|historisch)\b", sentence, re.IGNORECASE):
                continue
            # Support the abbreviated hashes used by design-review notes.
            hashes = re.findall(r"(?<![0-9a-f])([0-9a-f]{8,64})(?![0-9a-f])", sentence)
            for cited in hashes:
                if not current or not current.startswith(cited):
                    hard.append(f"{rel}: notes cite seal {cited}, which is not current — mark the citation historical or cite manifest.sha256")

    # --- in flight: a UI change under the surface must cite what it implements ---
    globs = [_glob_re(g.strip()) for g in data.get("paths", [])]
    if globs and in_flight:
        touched = sorted(p for p in in_flight if any(g.match(p) for g in globs))
        if touched and not cited:
            soft.append(f"{rel}: this push touches {len(touched)} file(s) under the {surface} "
                        f"surface (e.g. {touched[0]}) while no active plan cites a "
                        f"{'/'.join(data['id_prefixes'])}* contract ID — DoR R5: name the IDs "
                        "the change implements or amends")
    return hard, soft


def _known_entry_keys() -> tuple[str, ...]:
    """Every key a registry entry may carry — `check_ui` (core) holds the one list."""
    from check_ui import REGISTRY_KEYS  # noqa: PLC0415
    return REGISTRY_KEYS


def _worktree_text(root: Path) -> Callable[[str], str | None]:
    def read(rel: str) -> str | None:
        p = root / rel
        return _read(p) if p.is_file() else None
    return read


def state_catalogue(root: Path, value: object, read: Callable[[str], str | None]
                    ) -> tuple[list[str] | None, str | None]:
    """(states, problem) of an entry's `state_catalogue`: a list of state IDs, or a
    repo path to a JSON list — one place for every surface. None, None: not set.
    `read(rel)` gives a file's text or None; the fork point's reader reads there."""
    if value is None:
        return None, None
    if isinstance(value, str) and value.strip():
        target = _inside(root, value.strip())
        if target is None:
            return None, f"'state_catalogue' path {value.strip()!r} escapes the repo root"
        text = read(target.relative_to(root.resolve()).as_posix())
        if text is None:
            return None, f"'state_catalogue' {value.strip()} does not exist"
        try:
            items = json.loads(text)
        except ValueError as exc:
            return None, f"'state_catalogue' {value.strip()} is not valid JSON ({exc})"
        if not isinstance(items, list):
            return None, f"'state_catalogue' {value.strip()} must hold a JSON list of state IDs"
    elif isinstance(value, list):
        items = value
    else:
        return None, "'state_catalogue' must be a list of state IDs or a repo path to a JSON list of them"
    if not all(isinstance(x, str) and x.strip() for x in items):
        return None, "'state_catalogue' must hold non-empty state IDs (strings)"
    return [x.strip() for x in items], None


# --- the round's state list and element map (#404 B1/B2) ----------------------------
# `states.json` in the reference round says which views and states the boards show, at
# which viewports, themes and variants, and which owner each element of a view has. This
# gate owns loading and checking it. What the file says about itself is checked always —
# a sealed round cannot change without a push touching it. What depends on the world
# around it (the state catalogue, the feature registry) is hard only for a round the push
# touches (`entry_triggers`), a note otherwise: else every clean-up elsewhere would red a
# sealed round until it is re-sealed and re-reviewed. Never by the fork point's state.
STATES = "states.json"
COMMENT = "_comment"  # allowed at every level of states.json
_STATES_KEYS = frozenset({"schema_version", "surfaces", "stories", "viewports", "themes", "variants",
                          "elements", "views", COMMENT})
_VIEWPORT_KEYS = frozenset({"id", "width", "height", COMMENT})
_ELEMENT_KEYS = frozenset({"id", "owner", "role", COMMENT})
_VIEW_KEYS = frozenset({"id", "elements", "states", "not_applicable", COMMENT})
_STATE_KEYS = frozenset({"id", "viewports", "themes", "variants", "boards", COMMENT})
_UNTOUCHED = " (no push touches the round here: a note)"


def _rel(root: Path, p: Path) -> str:
    return p.resolve().relative_to(root.resolve()).as_posix()


def _unknown_keys(obj: dict, known: frozenset[str], where: str) -> list[str]:
    extra = sorted(k for k in obj if k not in known)
    if not extra:
        return []
    return [f"{where}: unknown key(s) {', '.join(repr(k) for k in extra)} — known: "
            f"{', '.join(sorted(known - {COMMENT}))} (and `{COMMENT}`)"]


def _names(value: object, key: str, where: str, out: list[str]) -> list[str]:
    """A non-empty list of distinct non-empty strings; problems go to `out`."""
    if not (isinstance(value, list) and value and all(isinstance(x, str) and x.strip() for x in value)):
        out.append(f"{where}: '{key}' must be a non-empty list of names")
        return []
    names = [x.strip() for x in value]
    for dup in sorted({n for n in names if names.count(n) > 1}):
        out.append(f"{where}: '{key}' names {dup!r} twice")
    return names


def _subset(state: dict, key: str, known: list[str], what: str, where: str, out: list[str]) -> None:
    if key not in state:
        return
    for name in _names(state[key], key, where, out):
        if name not in known:
            out.append(f"{where}: unknown {what} {name!r} — the round lists {', '.join(known) or 'none'}")


def stories_problem(value: object) -> str | None:
    """Why a round's `stories` is malformed — None when absent, a non-empty list of story
    IDs, or `n/a: <reason>` (a round that covers no story says so, with the reason)."""
    if value is None:
        return None
    if isinstance(value, str):
        na = _NA.match(value.strip())
        if na is not None:
            return None if re.search(r"\w", na.group(1)) else (
                "'stories': `n/a` without a reason — name why the round covers no story")
    elif isinstance(value, list) and value and all(isinstance(x, str) and x.strip() for x in value):
        return None
    return "'stories' must be a non-empty list of story IDs or `\"n/a: <reason>\"`"


def round_stories(states: dict) -> list[str] | None:
    """The story IDs a valid `states.json` names; None for `n/a: …` or no `stories` key."""
    value = states.get("stories")
    return [x.strip() for x in value] if isinstance(value, list) else None


def load_states(root: Path, rdir: Path) -> tuple[dict | None, list[str]]:
    """(data, problems) of the round's `states.json`, checked on its own: shape, the axes
    of each state within the round's lists, the boards it names, the element map (every
    element once, with an owner; a view names only elements the map has). data is None
    when the file cannot be read as a JSON object."""
    where = f"{_rel(root, rdir)}/{STATES}"
    try:
        data = json.loads((rdir / STATES).read_text(encoding="utf-8"))
    except (OSError, UnicodeDecodeError, ValueError) as exc:
        return None, [f"{where}: not readable as JSON ({exc})"]
    if not isinstance(data, dict):
        return None, [f"{where}: must be a JSON object"]
    out = _unknown_keys(data, _STATES_KEYS, where)
    version = data.get("schema_version")
    if type(version) is not int or version != 1:
        out.append(f"{where}: 'schema_version' must be 1")
    if "surfaces" in data and not (isinstance(data["surfaces"], list) and data["surfaces"]):
        out.append(f"{where}: 'surfaces' must be a non-empty list when given")
    elif "surfaces" in data:
        _names(data["surfaces"], "surfaces", where, out)
    problem = stories_problem(data.get("stories"))
    if problem:
        out.append(f"{where}: {problem}")
    axes: dict[str, list[str]] = {}
    for key in ("themes", "variants"):
        axes[key] = _names(data[key], key, where, out) if key in data else []
    axes["viewports"] = _viewports(data.get("viewports"), where, out)
    elements = _elements(data.get("elements"), where, out)
    views = data.get("views")
    if not (isinstance(views, list) and views):
        out.append(f"{where}: 'views' must be a non-empty list")
        return data, out
    seen: set[str] = set()
    for i, view in enumerate(views):
        if not isinstance(view, dict):
            out.append(f"{where}: views[{i}] must be an object")
            continue
        vid = view.get("id")
        vwhere = f"{where}: view {vid!r}" if isinstance(vid, str) else f"{where}: views[{i}]"
        out += _unknown_keys(view, _VIEW_KEYS, vwhere)
        if not (isinstance(vid, str) and vid.strip()):
            out.append(f"{vwhere}: 'id' must be a non-empty string")
        elif vid in seen:
            out.append(f"{where}: view {vid!r} twice")
        else:
            seen.add(vid)
        for eid in _names(view["elements"], "elements", vwhere, out) if "elements" in view else []:
            if eid not in elements:
                out.append(f"{vwhere} names element {eid!r}, which `elements` does not define")
        state_ids = _states_of(root, rdir, view.get("states", []), axes, vwhere, out)
        na = view.get("not_applicable", {})
        if not isinstance(na, dict):
            out.append(f"{vwhere}: 'not_applicable' must be an object (state ID → reason)")
            continue
        for sid, reason in na.items():
            if sid == COMMENT:
                continue
            if not (isinstance(reason, str) and re.search(r"\w", reason)):
                out.append(f"{vwhere}: not_applicable {sid!r} has no reason")
            if sid in state_ids:
                out.append(f"{vwhere}: {sid!r} is in `states` and in `not_applicable` — one or the other")
    return data, out


def _viewports(value: object, where: str, out: list[str]) -> list[str]:
    if value is None:
        return []
    if not (isinstance(value, list) and value):
        out.append(f"{where}: 'viewports' must be a non-empty list when given")
        return []
    ids: list[str] = []
    for i, vp in enumerate(value):
        if not isinstance(vp, dict):
            out.append(f"{where}: viewports[{i}] must be an object")
            continue
        out += _unknown_keys(vp, _VIEWPORT_KEYS, f"{where}: viewports[{i}]")
        vid = vp.get("id")
        if not (isinstance(vid, str) and vid.strip()):
            out.append(f"{where}: viewports[{i}]: 'id' must be a non-empty string")
            continue
        if vid in ids:
            out.append(f"{where}: viewport {vid!r} twice")
        ids.append(vid)
        for dim in ("width", "height"):
            size = vp.get(dim)
            if type(size) is not int or size <= 0:
                out.append(f"{where}: viewport {vid!r}: '{dim}' must be a positive whole number (px)")
    return ids


def _elements(value: object, where: str, out: list[str]) -> set[str]:
    if value is None:
        return set()
    if not isinstance(value, list):
        out.append(f"{where}: 'elements' must be a list")
        return set()
    ids: set[str] = set()
    for i, el in enumerate(value):
        if not isinstance(el, dict):
            out.append(f"{where}: elements[{i}] must be an object")
            continue
        eid = el.get("id")
        ewhere = f"{where}: element {eid!r}" if isinstance(eid, str) else f"{where}: elements[{i}]"
        out += _unknown_keys(el, _ELEMENT_KEYS, ewhere)
        if not (isinstance(eid, str) and eid.strip()):
            out.append(f"{ewhere}: 'id' must be a non-empty string")
        elif eid in ids:
            out.append(f"{where}: element {eid!r} twice — one owner per element")
        else:
            ids.add(eid)
        if not (isinstance(el.get("owner"), str) and el["owner"].strip()):
            out.append(f"{ewhere}: 'owner' must be a non-empty string (the one owner of the element)")
        if "role" in el and not isinstance(el["role"], str):
            out.append(f"{ewhere}: 'role' must be a string (e.g. main, secondary)")
    return ids


def _states_of(root: Path, rdir: Path, value: object, axes: dict[str, list[str]], vwhere: str,
               out: list[str]) -> set[str]:
    if not isinstance(value, list):
        out.append(f"{vwhere}: 'states' must be a list")
        return set()
    ids: set[str] = set()
    folder = rdir.resolve()
    for i, state in enumerate(value):
        if not isinstance(state, dict):
            out.append(f"{vwhere}: states[{i}] must be an object")
            continue
        sid = state.get("id")
        swhere = f"{vwhere} state {sid!r}" if isinstance(sid, str) else f"{vwhere} states[{i}]"
        out += _unknown_keys(state, _STATE_KEYS, swhere)
        if not (isinstance(sid, str) and sid.strip()):
            out.append(f"{swhere}: 'id' must be a non-empty string")
        elif sid in ids:
            out.append(f"{vwhere}: state {sid!r} twice")
        else:
            ids.add(sid)
        _subset(state, "viewports", axes["viewports"], "viewport", swhere, out)
        _subset(state, "themes", axes["themes"], "theme", swhere, out)
        _subset(state, "variants", axes["variants"], "variant", swhere, out)
        for board in _names(state["boards"], "boards", swhere, out) if "boards" in state else []:
            target = (rdir / board).resolve()
            if folder not in target.parents or not target.is_file():
                out.append(f"{swhere}: board {board!r} does not exist in the round")
    return ids


def catalogue_gaps(states: dict, catalogue: list[str]) -> list[str]:
    """Each view of a valid `states.json` against the state catalogue: every catalogue
    state is rendered (`states`) or named in `not_applicable`; others are allowed."""
    out: list[str] = []
    for view in states.get("views", []):
        if not isinstance(view, dict) or not isinstance(view.get("id"), str):
            continue
        have = {s.get("id") for s in view.get("states", []) if isinstance(s, dict)}
        na = view.get("not_applicable", {})
        have |= set(na) if isinstance(na, dict) else set()
        for state in catalogue:
            if state not in have:
                out.append(f"view {view['id']!r} has no state {state!r} of the state catalogue — "
                           "render it, or name it in `not_applicable` with a reason")
    return out


# --- an acceptance item's anchor in a round (#404 B3) ---------------------------------
# A feature-registry item's `design` names where its behaviour is drawn: `<round>/<view>#
# <state>`, the round by its folder name. The round is the `reference` of an entry, or —
# an older round, a note — `docs/design/concepts/<round>` with a states.json. This gate
# owns the anchor; the registry gate reports its findings under the item.
CONCEPTS = "docs/design/concepts"
_ANCHOR = re.compile(r"^(?P<round>[^\s/:#]+)/(?P<view>[^\s/#]+)#(?P<state>[^\s#]+)$")
_ANCHOR_FORM = "`<round>/<view>#<state>`"


def parse_anchor(text: object) -> tuple[str, str, str] | None:
    """(round, view, state) of an anchor `<round>/<view>#<state>`; None for anything else."""
    m = _ANCHOR.match(text.strip()) if isinstance(text, str) else None
    return (m.group("round"), m.group("view"), m.group("state")) if m else None


def anchor_texts(value: object) -> list[str] | None:
    """The anchors an item's `design` holds — a string or a list of strings; None: neither."""
    if isinstance(value, str) and value.strip():
        return [value.strip()]
    if isinstance(value, list) and value and all(isinstance(x, str) and x.strip() for x in value):
        return [x.strip() for x in value]
    return None


def round_views(states: object) -> dict[str, dict[str, dict]]:
    """{view: {state: its object}} of a states.json, read leniently: what does not parse
    names nothing. A state in `not_applicable` is not rendered, so no anchor names it."""
    out: dict[str, dict[str, dict]] = {}
    views = states.get("views") if isinstance(states, dict) else None
    for view in views if isinstance(views, list) else []:
        if not (isinstance(view, dict) and isinstance(view.get("id"), str)):
            continue
        rendered = view.get("states") if isinstance(view.get("states"), list) else []
        out.setdefault(view["id"], {}).update(
            {s["id"]: s for s in rendered if isinstance(s, dict) and isinstance(s.get("id"), str)})
    return out


def _states_at(path: Path) -> dict | None:
    try:
        data = json.loads((path / STATES).read_text(encoding="utf-8"))
    except (OSError, UnicodeDecodeError, ValueError):
        return None
    return data if isinstance(data, dict) else None


class AnchorIndex:
    """The rounds an anchor can name, read once per run: the folder name of every entry's
    `reference` (any status), then `docs/design/concepts/<name>` with a states.json."""

    def __init__(self, root: Path) -> None:
        self.root = root
        self.referenced: dict[str, set[str]] = {}
        for path in _registry_files(root):
            data, _errs = load(root, path)
            if data is None or not _norm(data.get("reference")):
                continue
            rdir = _inside(root, data["reference"].strip())
            if rdir is not None and rdir.is_dir():
                key = _rel(root, rdir)
                self.referenced.setdefault(Path(key).name, set()).add(key)
        self._views: dict[str, dict[str, dict[str, dict]] | None] = {}

    def views(self, key: str) -> dict[str, dict[str, dict]] | None:
        """The views of the round folder `key`; None when it has no readable states.json."""
        if key not in self._views:
            states = _states_at(self.root / key)
            self._views[key] = None if states is None else round_views(states)
        return self._views[key]

    def problems(self, value: object) -> list:
        """What is wrong with an item's `design` (`registry_config.Problem`s): an anchor that
        resolves to no round, view or state fails; one into an older round is a note."""
        from registry_config import Problem  # noqa: PLC0415  (core, a leaf)
        anchors = anchor_texts(value)
        if anchors is None:
            return [Problem(True, f"'design' must be an anchor {_ANCHOR_FORM} or a non-empty list "
                                  f"of them, got {value!r}")]
        out: list = []
        for text in anchors:
            parsed = parse_anchor(text)
            if parsed is None:
                out.append(Problem(True, f"design {text!r} is no anchor {_ANCHOR_FORM}"))
                continue
            name, view, state = parsed
            keys = sorted(self.referenced.get(name, ()))
            if len(keys) > 1:
                out.append(Problem(True, f"anchor {text!r}: round name {name!r} names {len(keys)} "
                                         f"reference folders ({', '.join(keys)}) — an anchor cannot "
                                         "tell them apart; rename one round"))
                continue
            if keys:
                key = keys[0]
            elif (self.root / CONCEPTS / name / STATES).is_file():
                key = f"{CONCEPTS}/{name}"
                out.append(Problem(False, f"anchor {text!r}: round {name!r} is no entry's reference "
                                          "(an older round?) — anchor the item in the round that "
                                          "draws it now"))
            else:
                out.append(Problem(True, f"anchor {text!r} names round {name!r}, which no "
                                         f"design-contract entry references and {CONCEPTS}/{name} "
                                         f"does not hold with a {STATES}"))
                continue
            views = self.views(key)
            if views is None:
                out.append(Problem(True, f"anchor {text!r}: round {name!r} has no readable {STATES} "
                                         "— the anchor names no view of it"))
            elif view not in views:
                out.append(Problem(True, f"anchor {text!r} names view {view!r}, which {name} does "
                                         "not list"))
            elif state not in views[view]:
                out.append(Problem(True, f"anchor {text!r} names state {state!r}, which view "
                                         f"{view!r} of {name} does not render"))
        return out


# --- when the round is judged hard: the push touches it ------------------------------

def fork_point(root: Path) -> tuple[str | None, str | None]:
    """(fork point SHA, why there is none). Without one, whether a push touches a round
    is unknown — the caller notes that, never treats every round as touched nor
    passes silently (unlike `declaration_rule`, which falls back to the working tree)."""
    import check_review as _review  # noqa: PLC0415  (the owner of the fork point)
    try:
        base = _review.merge_base(root)
    except _review.GitReadError as exc:
        return None, f"the fork point is ambiguous ({exc})"
    if base:
        return base, None
    forkless = _review.forkless_refs(root)
    if forkless:
        remedy = ("this clone is shallow: `git fetch --unshallow`" if _review.is_shallow(root)
                  else f"fetch the history of {forkless[0]} the branch forked from")
        return None, f"no fork point with {', '.join(forkless)} in this history — {remedy}"
    return None, "no fork point: no push range against an integration ref (on it, or none exists)"


def _norm(value: object) -> str:
    """A repo path as written in an entry, normalized: `x` and `x/` are one folder."""
    return posixpath.normpath(value.strip()) if isinstance(value, str) and value.strip() else ""


def _status(data: dict) -> str:
    return data["status"].strip() if isinstance(data.get("status"), str) else ""


def _blob_changed(root: Path, base: str, rel: str) -> bool:
    """Whether `rel` in the working tree differs from the fork point's blob: compared by
    blob ID, not decoded text. Missing or unreadable at the fork point counts as changed."""
    from check_review import _git_bytes  # noqa: PLC0415
    old = _git_bytes(root, "rev-parse", "--verify", "-q", f"{base}:{rel}")
    if old is None:
        return True
    if not (root / rel).is_file():
        return True
    now = _git_bytes(root, "hash-object", "--", rel)
    return now is None or now.strip() != old.strip()


def _entry_at(root: Path, base: str, rel: str) -> dict | None | bool:
    """The registry entry at the fork point: a dict, None when the file is new, False
    when it is there but no JSON object."""
    import check_review as _review  # noqa: PLC0415
    text = _review._show(root, base, rel)
    if text is None:
        return None
    try:
        data = json.loads(text)
    except ValueError:
        return False
    return data if isinstance(data, dict) else False


def entry_triggers(root: Path, base: str, rel: str, data: dict) -> list[str]:
    """Why this push touches the round a registry entry references, against the fork
    point `base` — [] when it does not. A new entry file is touched (fail-closed)."""
    old = _entry_at(root, base, rel)
    if old is None:
        return ["new registry entry file"]
    if old is False:
        return ["registry entry unreadable at the fork point"]
    out: list[str] = []
    ref, review = _norm(data.get("reference")), _norm(data.get("review"))
    if _norm(old.get("reference")) != ref:
        out.append("reference changed")
    if _status(data) == "accepted" and _status(old) != "accepted":
        out.append("status became accepted")
    if _norm(old.get("review")) != review:
        out.append("review path changed")
    if ref and _blob_changed(root, base, f"{ref}/{_seal.SEAL}"):
        out.append("seal changed")
    if review and _blob_changed(root, base, review):
        out.append("review file changed")
    return out


@dataclass
class Round:
    """A reference round and the registry entries that reference it."""
    key: str                      # the round folder, repo-relative and resolved
    path: Path
    entries: list[tuple[str, dict]] = field(default_factory=list)   # (registry rel, entry)
    triggers: dict[str, list[str]] = field(default_factory=dict)    # registry rel → why touched
    states: dict | None = None    # the parsed states.json, once `round_findings` read it

    @property
    def touched(self) -> bool:
        """Does this push touch the round? False also when no fork point tells."""
        return any(self.triggers.values())

    def why(self) -> str:
        return "; ".join(f"{Path(rel).name}: {', '.join(t)}" for rel, t in self.triggers.items() if t)


def touched_rounds(root: Path, entries: list[tuple[str, dict]], base: str | None) -> list[Round]:
    """Every round a non-legacy registry entry references, with the triggers by which this
    push touches it (`entry_triggers`; none without a fork point). Two entries on one
    folder (`x` and `x/` alike) are one round. The one owner of "hard or note"."""
    found: dict[str, Round] = {}
    for rel, data in entries:
        if _status(data) == "legacy" or not _norm(data.get("reference")):
            continue
        rdir = _inside(root, data["reference"].strip())
        if rdir is None or not rdir.is_dir():
            continue  # `_check_one` reports it
        rnd = found.setdefault(_rel(root, rdir), Round(_rel(root, rdir), rdir))
        rnd.entries.append((rel, data))
        rnd.triggers[rel] = entry_triggers(root, base, rel, data) if base else []
    return [found[k] for k in sorted(found)]


def _by_touch(rnd: Round, findings: list[str]) -> tuple[list[str], list[str]]:
    return (findings, []) if rnd.touched else ([], [f + _UNTOUCHED for f in findings])


def round_catalogue(root: Path, rnd: Round, base: str | None) -> list[str] | None:
    """The state catalogue of a round: the union over its entries, each as it stands now
    and at the fork point — a push cannot drop a state for its own GO. None: none set."""
    import check_review as _review  # noqa: PLC0415
    states: list[str] = []
    found = False
    for rel, data in rnd.entries:
        values = [(data.get("state_catalogue"), _worktree_text(root))]
        old = _entry_at(root, base, rel) if base else None
        if isinstance(old, dict):
            values.append((old.get("state_catalogue"),
                           lambda r, b=base: _review._show(root, b, r)))  # type: ignore[misc]
        for value, read in values:
            got, _problem = state_catalogue(root, value, read)
            if got is not None:
                found = True
                states += [s for s in got if s not in states]
    return states if found else None


def story_findings(root: Path, rnd: Round) -> tuple[list[str], list[str]]:
    """(hard, notes) for the `stories` of a round whose states.json loaded. Without the
    feature registry a list is a finding (no coverage is judgeable; `n/a: <reason>`
    says so); with it a touched round names its stories or `n/a: <reason>`.

    The hook for coverage (#404 B4): the registry lookup of the IDs and the duty of at
    least one visible AC go here, gated by `rnd.touched` like everything else."""
    import registry_config  # noqa: PLC0415  (core: the registry module's presence)
    assert rnd.states is not None
    where = f"{rnd.key}/{STATES}"
    stories = rnd.states.get("stories")
    findings: list[str] = []
    if not registry_config.module_active(root):
        if isinstance(stories, list):
            findings.append(f"{where}: 'stories' lists story IDs, but this project has no feature "
                            "registry, so no coverage can be judged — write `\"stories\": \"n/a: <reason>\"`")
    elif stories is None:
        findings.append(f"{where}: 'stories' is required with the feature registry — the story IDs "
                        "the round covers, or `\"n/a: <reason>\"`")
    return _by_touch(rnd, findings)


def round_findings(root: Path, rnd: Round, base: str | None) -> tuple[list[str], list[str]]:
    """(hard, notes) of one reference round: its states.json — required where the push
    touches the round — and what it says against the catalogue and the registry."""
    if not (rnd.path / STATES).is_file():
        names = ", ".join(Path(rel).name for rel, _ in rnd.entries)
        if rnd.touched:
            return [f"{rnd.key}: the reference round has no {STATES}, required once a push touches "
                    f"the round ({rnd.why()}) — list its views, states, viewports, themes and "
                    f"elements ({REGISTRY_DIR}/templates/states.example.json), then re-seal and "
                    "re-review"], []
        return [], [f"{rnd.key}: the reference round of {names} has no {STATES} — not touched by "
                    "this push, so a note; required once a push changes its reference, status, "
                    "review or seal"]
    states, hard = load_states(root, rnd.path)
    soft: list[str] = []
    if states is None or hard:
        return hard, soft
    rnd.states = states
    catalogue = round_catalogue(root, rnd, base)
    h, s = _by_touch(rnd, [f"{rnd.key}/{STATES}: {gap}" for gap in catalogue_gaps(states, catalogue or [])])
    hard += h
    soft += s
    h, s = story_findings(root, rnd)
    return hard + h, soft + s


def shared_review_findings(rounds: list[Round]) -> tuple[list[str], list[str]]:
    """Entries on different rounds that share one review file couple the rounds: a new
    section for one touches both. Red where the push touches one of them, else a note."""
    by_review: dict[str, list[tuple[str, Round]]] = {}
    for rnd in rounds:
        for rel, data in rnd.entries:
            if _norm(data.get("review")):
                by_review.setdefault(_norm(data["review"]), []).append((rel, rnd))
    hard: list[str] = []
    soft: list[str] = []
    for review, users in sorted(by_review.items()):
        keys = sorted({rnd.key for _rel_, rnd in users})
        if len(keys) < 2:
            continue
        line = (f"{', '.join(sorted(Path(rel).name for rel, _ in users))} share the review {review} "
                f"but reference different rounds ({', '.join(keys)}) — a section for one touches "
                "the other; give each round its own review file")
        if any(rnd.triggers.get(rel) for rel, rnd in users):
            hard.append(line)
        else:
            soft.append(line + _UNTOUCHED)
    return hard, soft


# --- declaring the contract (#248): opt-in per project -------------------------
# A project that wants every Tier 2+ plan to state its contract writes
# DECLARATION: {"from": "YYYY-MM-DD", "spec_above": N}. Read at the fork point,
# like the review evidence rules: a branch cannot lift the duty for itself.
DECLARATION = "docs/process/design-contract-declaration.local.json"
TRACE_HEADING = "## Design Contract Trace"
# `n/a`, then a reason: a dash or colon alone is none
_NA = re.compile(r"^n/?a\b[\s—–:-]*(.*)$", re.IGNORECASE)
_SPEC_NUMBER = re.compile(r"^(\d+)-")
_ISO_DAY = re.compile(r"^\d{4}-\d{2}-\d{2}$")


def declaration_rule(root: Path) -> tuple[dict | None, str | None, str | None]:
    """(rule, problem, fork point): the project's declaration duty as its fork point
    has it — no rule when the project has none (nothing changes for it). Without a
    readable fork point (none yet, or an ambiguous one the review gate reports) the
    working tree is all there is."""
    import check_review as _review  # noqa: PLC0415  (the owner of the fork point)
    try:
        base = _review.merge_base(root)
    except _review.GitReadError:
        base = None
    if base:
        text = _review._show(root, base, DECLARATION)
    else:
        path = root / DECLARATION
        text = _read(path) if path.is_file() else None
    if text is None:
        return None, None, base
    try:
        data = json.loads(text)
    except ValueError as exc:
        return None, f"{DECLARATION}: not valid JSON ({exc})", base
    if not isinstance(data, dict) or not _ISO_DAY.match(str(data.get("from", ""))):
        return None, f'{DECLARATION}: needs "from": "YYYY-MM-DD" (the day the duty starts)', base
    above = data.get("spec_above")
    if above is not None and (isinstance(above, bool) or not isinstance(above, int) or above < 0):
        return None, f'{DECLARATION}: "spec_above" must be a whole number (the highest spec before the duty)', base
    return data, None, base


SHALLOW = "shallow"  # `_first_added`: the add lies at a shallow clone's boundary


def _shallow_commits(root: Path) -> set[str]:
    """The boundary commits of a shallow clone (`.git/shallow`); empty in a full one."""
    import subprocess  # noqa: PLC0415
    r = subprocess.run(["git", "-C", str(root), "rev-parse", "--git-path", "shallow"],
                       capture_output=True, text=True)
    if r.returncode != 0:
        return set()
    path = Path(r.stdout.strip())
    path = path if path.is_absolute() else root / path
    return set(_read(path).split()) if path.is_file() else set()


def _first_added(root: Path, rel: str) -> str | None:
    """The day of the commit that first added `rel`; None: not committed yet; SHALLOW:
    that commit is a shallow clone's boundary, where every file it holds looks added
    — its day is the clone's, not the plan's (#252). Asked only for a plan the fork
    point already has — a plan this branch adds is bound whatever its dates say."""
    import subprocess  # noqa: PLC0415
    r = subprocess.run(["git", "-C", str(root), "log", "--diff-filter=A", "--format=%H %as", "--", rel],
                       capture_output=True, text=True)
    rows = [ln.split() for ln in r.stdout.splitlines() if ln.strip()] if r.returncode == 0 else []
    if not rows:
        return None
    sha, day = rows[-1][0], rows[-1][1]
    return SHALLOW if sha in _shallow_commits(root) else day


def _on_integration(root: Path, rel: str) -> bool | None:
    """Whether the first integration ref this clone has holds `rel`; None without one.
    A shallow clone that cut off the fork point can still tell a plan main never had."""
    import subprocess  # noqa: PLC0415
    import check_review as _review  # noqa: PLC0415  (the owner of the integration refs)
    for ref in _review.integration_refs(root):
        r = subprocess.run(["git", "-C", str(root), "rev-parse", "--verify", "-q", f"{ref}^{{commit}}"],
                           capture_output=True, text=True)
        if r.returncode == 0:
            return _review._show(root, ref, rel) is not None
    return None


def _trace_body(text: str) -> str | None:
    """What stands under the trace heading up to the next `## ` heading; None without one."""
    lines = text.splitlines()
    for i, line in enumerate(lines):
        if line.strip() == TRACE_HEADING:
            body = []
            for nxt in lines[i + 1:]:
                if nxt.startswith("## "):
                    break
                body.append(nxt)
            return "\n".join(body).strip()
    return None


def declaration_problems(text: str, contracts: set[str]) -> list[str]:
    """Why a plan does not state its contract as the duty asks — [] when it does."""
    plain = _unfenced(text)
    named = ", ".join(sorted(contracts)) or "(no contract registered yet)"
    found = declarations(plain)
    if not found:
        return [f"no `design-contract:` line — declare one of {named} or `n/a — <reason>`"]
    na = _NA.match(found[0])
    if na is not None:
        return [] if re.search(r"\w", na.group(1)) else ["`design-contract: n/a` without a reason — "
                                                          "name why no visual surface is touched"]
    surface = declared_surface(found[0])
    if surface not in {c.lower() for c in contracts}:
        return [f"unknown design contract `{surface}` — expected one of {named} or `n/a — <reason>`"]
    if not _trace_body(plain):
        return [f"declares `{surface}` but its `{TRACE_HEADING}` is missing or empty — name the "
                f"contract sections, screen IDs and briefs the work follows, and every deviation"]
    return []


def declaration_check(root: Path, plans: dict[str, str], contracts: set[str]
                      ) -> tuple[list[str], list[str]]:
    """The declaration duty over the active Tier 2+ plans: every plan this branch
    adds is bound; a plan the fork point already has is bound from the project's
    day on (spec plans: above its number) — older ones get one summary note."""
    import check_review as _review  # noqa: PLC0415  (one owner of the tier grammar)
    rule, problem, base = declaration_rule(root)
    if problem:
        return [problem], []
    if rule is None:
        return [], []
    hard, older, unknown = [], [], []
    moved = _review.plans_moved_in(root, base) if base else {}
    for rel, text in plans.items():
        if Path(rel).name.startswith("design-"):
            continue
        tier = _review.plan_tier(_unfenced(text))
        if tier is None or tier < 2:
            continue
        problems = declaration_problems(text, contracts)
        if not problems:
            continue
        # where the plan stood at the fork point: a rename keeps its age, a new file has none
        origin = moved.get(rel, rel) if base else rel
        if base and (origin is None or _review._show(root, base, origin) is None):
            bound = True  # new on this branch: no date of its own can grandfather it
        elif origin.startswith(SPECS_DIR + "/"):
            m = _SPEC_NUMBER.match(Path(origin).parent.name)
            bound = rule.get("spec_above") is None or m is None or int(m.group(1)) > rule["spec_above"]
        else:
            added = _first_added(root, origin)
            if added == SHALLOW and _on_integration(root, origin) is not False:
                unknown.append(rel)
                continue
            # beyond the boundary, yet not on main: this branch's own (refute v2.75 r3)
            bound = added in (None, SHALLOW) or added >= rule["from"]
        if bound:
            hard += [f"{rel}: {p}" for p in problems]
        else:
            older.append(rel)
    soft = [f"{len(older)} Tier 2+ plan(s) predate the declaration duty and state no valid "
            f"`design-contract:` line (not enforced): {', '.join(older)}"] if older else []
    if unknown:
        soft.append(f"{len(unknown)} Tier 2+ plan(s) without a valid `design-contract:` line were "
                    f"first committed beyond this shallow clone's history, so their age is unknown "
                    f"and the duty is not judged here: {', '.join(unknown)} — `git fetch --unshallow` "
                    "judges them (a full clone, like the gate host's, always does)")
    return hard, soft


def _rounds_check(root: Path, entries: list[tuple[str, dict]]) -> tuple[list[str], list[str]]:
    """The reference rounds of the registry: each round, then the shared review files."""
    base, problem = fork_point(root)
    rounds = touched_rounds(root, entries, base)
    hard: list[str] = []
    soft: list[str] = []
    if rounds and base is None:
        soft.append(f"{problem} — whether this push touches the round(s) "
                    f"{', '.join(r.key for r in rounds)} is unknown, so their {STATES} duty and "
                    "touched-round checks are notes here")
    for rnd in rounds:
        h, s = round_findings(root, rnd, base)
        hard += h
        soft += s
    h, s = shared_review_findings(rounds)
    return hard + h, soft + s


def check(root: Path) -> tuple[list[str], list[str]]:
    files = _registry_files(root)
    plans = active_plan_texts(root)
    contracts = set()
    for path in files:
        data, _errs = load(root, path)
        if data is not None:
            contracts.add(data["surface"].strip())
    decl_hard, decl_soft = declaration_check(root, plans, contracts)
    if not files:
        return decl_hard, ["no design contracts yet (dir empty or absent)", *decl_soft]
    in_flight = _paths_in_flight(root)
    hard: list[str] = list(decl_hard)
    soft: list[str] = list(decl_soft)
    entries = []
    for path in files:
        h, s = _check_one(root, path, plans, in_flight)
        hard += h
        soft += s
        data, _errs = load(root, path)
        if data is not None:
            entries.append((path.relative_to(root).as_posix(), data))
    h, s = _rounds_check(root, entries)
    hard += h
    soft += s
    entries = [data for _rel, data in entries]
    # a plan that cites IDs of some family but names no contract at all is
    # judged against nothing — say so once, not once per surface
    for prel, ptext in plans.items():
        if any(bound_to(ptext, e["surface"].strip(), e["contract"].strip()) for e in entries):
            continue
        found = sorted({i for e in entries for i in id_pattern(e["id_prefixes"]).findall(ptext)})
        if found:
            surfaces = "|".join(e["surface"].strip() for e in entries)
            soft.append(f"{prel}: cites {', '.join(found[:6])} but names no design contract — "
                        f"bind it (`design-contract: {surfaces}` or the contract path) so the "
                        "IDs are checked against the norm they mean")
    return hard, soft


def bundle_lines(root: Path, plans: dict[str, str] | None = None) -> list[str]:
    """For the review bundle: which surface contracts govern this change and
    which IDs the plans cite — so the reviewer opens the right norm and the
    right boards instead of judging from taste."""
    out: list[str] = []
    plans = active_plan_texts(root) if plans is None else plans
    for path in _registry_files(root):
        data, _errs = load(root, path)
        if data is None:
            out.append(f"- {path.relative_to(root)}: unreadable registry entry (gate reports it)")
            continue
        ids = id_pattern(data["id_prefixes"])
        surface, contract_rel = data["surface"].strip(), data["contract"].strip()
        cited = sorted({i for t in plans.values() if bound_to(t, surface, contract_rel)
                        for i in ids.findall(t)})
        ref = data.get("reference", "")
        line = (f"- **{data['surface'].strip()}**: `{data['contract'].strip()}` "
                f"({data['status'].strip()}"
                + (f", reference `{ref}`" if ref else ", no sealed reference") + ")")
        line += f" — plan cites {', '.join(cited)}" if cited else " — no ID cited by an active plan"
        out.append(line)
    return out


def main() -> int:
    root = Path(sys.argv[1] if len(sys.argv) > 1 else ".").resolve()
    hard, soft = check(root)
    for note in soft:
        print(f"design-contracts: note: {note}")
    if hard:
        print("design-contracts: FAILED:")
        for h in hard:
            print(f"  - {h}")
        return 1
    print("design-contracts: OK")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
