#!/usr/bin/env python3
"""feature-inventory gate: validate the feature registry — the "what can the
product do, and where is that proven?" SSOT.

Lean pass: the registry's work-log axis (status, blocked_by, parent, ready
ordering) moved to GitHub Issues/Projects — issues own "what is in flight".
This inventory owns the other question: each entry names a capability, its
acceptance criteria, and the tests that prove them. An entry without a
resolvable test is a claim, not an inventory item — hard failure. Fed at
merge: the feature's spec user stories are promoted here with their test
references (the durable yield of the pruned spec artifacts).

How the registry is laid out and which rules bind is configuration
(`docs/process/feature-registry.json`, a project's `.local.json` over it), read
through `registry_config` — the template's defaults are a flat folder of
`STORY-NNNN.json` entries; a project may choose capability directories, its own
id pattern, surfaces, a story status and a test mapping instead
(`docs/process/modules/feature-registry.md`, Configuration).

Item ids are stable (v2.93, #404 I4): with `stable_ids` on, each story is compared
with itself at the branch's fork point (`registry_config.load_registry_at`) — a
removed id stands in `retired`, a new id is higher than the base's, a renumbering is
refused — and every `<story id>#AC<n>` ref inside the registry must name an item.
Without a readable base the comparison is a note, never an error or a silent pass.

An item's `design` anchor `<round>/<view>#<state>` (v2.93, #404 B3) is checked only
with the design-contracts module, whose gate owns the anchor and is imported for it.

Structure and reference existence are hard-guaranteed (CI exit 1). Whether a
test *semantically* proves its criterion is not mechanically decidable and is
review judgment. Language-agnostic; stdlib only (plus the shared adr glob)."""
from __future__ import annotations

import argparse
import ast
import json
import re
import sys
from dataclasses import dataclass, field
from pathlib import Path

# the decision-records gate owns ADR file identity, the review gate the issue-ref
# grammar, and registry_config configuration and loader (all core, always
# rendered) — import, don't copy (one owner per behavior)
sys.path.insert(0, str(Path(__file__).resolve().parent))  # sibling import
import registry_config  # noqa: E402
from check_decisions import ADR_DIR, adr_exists as _adr_exists  # noqa: E402
from check_review import GitReadError, forkless_refs, is_shallow, merge_base, parse_issue_ref  # noqa: E402

PREFIX = re.compile(r"^[A-Z]+$")
PLANNED_REF = re.compile(r"^planned:#\d+:\S.*$")
# an acceptance item (#404): addressable as `<story id>#<item id>`, proven or a target
ITEM_ID = registry_config.ITEM_ID
RETIRED_ENTRY_FIELDS = {"id", "split_into"}  # an entry of a story's `retired` list (v2.93 I4.1)
ITEM_FIELDS = {"id", "text", "surfaces", "state", "tests", "owned_by", "design", "issue"}
STATES = ("proven", "target")

# Advisory only: an entry with many mapped tests but very few acceptance
# criteria likely under-describes its tested behaviour. Warns, never blocks.
UNDER_GRANULAR_MAX_ACC = 2
UNDER_GRANULAR_MIN_TESTS = 5


@dataclass
class Run:
    """One gate run: the configuration, what it found, and what spans entries."""
    root: Path
    cfg: dict
    hard: list[str] = field(default_factory=list)
    soft: list[str] = field(default_factory=list)
    seen_ids: dict = field(default_factory=dict)
    stats: list[dict] = field(default_factory=list)
    names: dict = field(default_factory=dict)   # .py file -> its def/class names (None: unparsable)
    texts: dict = field(default_factory=dict)   # other file -> its text (None: unreadable)
    untested: dict = field(default_factory=dict)  # capability or inventory -> items without a test
    owned: dict = field(default_factory=dict)  # capability or inventory -> [items, items owned_by]
    anchors: object = None  # the design gate's AnchorIndex, read on the first `design` (B3)

    def rel(self, path: Path) -> str:
        return path.relative_to(self.root).as_posix()


def _known_fields(cfg: dict) -> set[str]:
    known = {"id", "acceptance", "adr", "links", "retired", cfg["issues"]["field"], cfg["story_tests"],
             *cfg["story_text_fields"], *cfg["extra_fields"]}
    if cfg["story_surfaces"] != "none":
        known.add("surfaces")
    if cfg["story_status"]:
        known.add("status")
    return known


def _retired_fields(cfg: dict) -> set[str]:
    # with a project story status, `status` is the project's field, not a leftover
    return set(cfg["retired_fields"]) - ({"status"} if cfg["story_status"] else set())


def _python_names(run: Run, path: Path) -> set[str] | None:
    """Every def/class name of a Python file, read by AST without importing it; None
    when it cannot be parsed. A flat set: `a::B::c` checks each segment by itself."""
    if path not in run.names:
        try:
            tree = ast.parse(path.read_text(encoding="utf-8"))
        except (OSError, UnicodeDecodeError, SyntaxError, ValueError):
            run.names[path] = None
        else:
            run.names[path] = {node.name for node in ast.walk(tree)
                               if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef))}
    return run.names[path]


def _file_text(run: Run, path: Path) -> str | None:
    if path not in run.texts:
        try:
            run.texts[path] = path.read_text(encoding="utf-8")
        except (OSError, UnicodeDecodeError):
            run.texts[path] = None
    return run.texts[path]


def _node_problems(run: Run, base: str, node: str) -> list[str]:
    """Why the `::node` selector of an existing file names nothing there — per segment."""
    path = run.root / base
    segments = node.split("::")
    if base.endswith(".py"):
        names = _python_names(run, path)
        if names is None:
            return [f"cannot parse {base} to verify the node"]
        return [f"node {s!r} not defined in {base}" for s in segments if s not in names]
    text = _file_text(run, path)
    if text is None:
        return [f"cannot read {base} to verify the node"]
    return [f"node {s!r} not found in {base}" for s in segments if s not in text]


def _test_ref(run: Run, rel: str, where: str, ref: object) -> bool:
    """One test ref: an existing file under `test_ref_roots`, its `::node` segments
    checked as `node_check` says, or — with `planned_refs` — a placeholder
    `planned:#<issue>:<text>`. True when it names an existing test: a placeholder
    is never proof."""
    cfg = run.cfg
    if not isinstance(ref, str) or not ref.strip():
        run.hard.append(f"{rel}: {where}: a test ref must be a non-empty string, got {ref!r}")
        return False
    if ref.startswith("planned:"):
        if not cfg["planned_refs"]:
            run.hard.append(f"{rel}: {where}: {ref!r}: placeholders need `planned_refs` in the "
                            f"registry configuration")
        elif not PLANNED_REF.match(ref):
            run.hard.append(f"{rel}: {where}: {ref!r}: malformed placeholder; "
                            f"expected planned:#<issue>:<description>")
        return False
    roots = cfg["test_ref_roots"]
    if roots and not ref.startswith(tuple(roots)):
        run.hard.append(f"{rel}: {where}: {ref!r} must start with one of {roots}")
        return False
    base, _, node = ref.partition("::")
    if not (run.root / base).is_file():
        run.hard.append(f"{rel}: {where}: test path does not exist: {ref}")
        return False
    if node:
        sink = run.hard if cfg["node_check"] == "hard" else run.soft
        sink += [f"{rel}: {where}: {ref!r}: {why}" for why in _node_problems(run, base, node)]
    return True


def _check_id(run: Run, story: registry_config.Story, data: dict, rel: str, stats: dict) -> None:
    cfg = run.cfg
    sid = data.get("id")
    prefix = None
    if story.capability and story.capability.head:
        prefix = story.capability.head.get("prefix")
        prefix = prefix if isinstance(prefix, str) and PREFIX.match(prefix) else None
    pattern = registry_config.strict_id_pattern(cfg, prefix)
    if not isinstance(sid, str) or not sid:
        run.hard.append(f"{rel}: missing or non-string 'id'")
    elif not pattern.match(sid):
        run.hard.append(f"{rel}: 'id' must match {pattern.pattern}, got {sid!r}")
    elif sid in run.seen_ids:
        run.hard.append(f"{rel}: duplicate id {sid!r} (also in {run.seen_ids[sid]})")
    else:
        run.seen_ids[sid] = rel
        stats["sid"] = sid
    if story.capability and isinstance(sid, str) and story.path.stem != sid:
        run.hard.append(f"{rel}: filename must match story id {sid!r}")


def _report(run: Run, label: str, found: list[registry_config.Problem]) -> None:
    """The surface resolution's findings (`registry_config`, which reports none itself)."""
    for problem in found:
        (run.hard if problem.hard else run.soft).append(f"{label}: {problem.text}")


def _check_status(run: Run, data: dict, rel: str) -> None:
    status_cfg = run.cfg["story_status"]
    if not status_cfg:
        return
    if "status" not in data:
        run.hard.append(f"{rel}: missing 'status'")
    elif data["status"] not in status_cfg["values"]:
        run.hard.append(f"{rel}: invalid status {data['status']!r} (want one of {status_cfg['values']})")


def _check_issues(run: Run, data: dict, rel: str) -> None:
    issues_cfg = run.cfg["issues"]
    name = issues_cfg["field"]
    refs: list = []
    if data.get(name) is None:  # absent or null: no ref (the template's `issue` is optional)
        if issues_cfg["required"]:
            run.hard.append(f"{rel}: missing '{name}'")
    elif name == "issue":
        if isinstance(data[name], str):
            refs = [data[name]]
        else:  # a provenance pointer for humans: a wrong type is a note, as before v2.92 nothing
            run.soft.append(f"{rel}: 'issue' should be a string, got {type(data[name]).__name__}")
    elif isinstance(data[name], list):
        refs = data[name]
    else:
        run.hard.append(f"{rel}: 'issues' must be a list (it may be empty)")
    # the template's own `issue` field is a provenance pointer for humans — an issue or
    # the PR that delivered the capability (module doc) — so a ref parse_issue_ref does
    # not know is a note there; a project that configures `issues` asks for the format
    for ref in refs:
        if not isinstance(ref, str) or parse_issue_ref(ref.strip()) is None:
            (run.soft if name == "issue" else run.hard).append(
                f"{rel}: malformed issue ref {ref!r} in '{name}' "
                f"(want '#N', 'owner/repo#N', or a github issue URL)")
    required_for = issues_cfg["required_for"]
    if required_for is not None and data.get("status") == required_for and not refs:
        run.hard.append(f"{rel}: status {required_for!r} needs at least one ref in '{name}'")


def _check_story_tests(run: Run, data: dict, rel: str, stats: dict) -> None:
    if run.cfg["story_tests"] == "tests":
        # an inventory entry asserts a proven capability — it requires at least
        # one existing test; a dead test path is a false claim of proof
        tests = data.get("tests")
        if not isinstance(tests, list) or not tests:
            run.hard.append(f"{rel}: 'tests' must be a non-empty list — an inventory "
                            f"entry without a proving test is a claim, not an inventory")
            return
        stats["n_tests"] += sum(_test_ref(run, rel, "tests", t) for t in tests)
        if all(isinstance(t, str) and t.startswith("planned:") for t in tests):
            run.hard.append(f"{rel}: 'tests' names no existing test — a planned: placeholder "
                            f"is never proof")
        return
    mapping = data.get("test_mapping")
    if not isinstance(mapping, dict) or not mapping:
        run.hard.append(f"{rel}: 'test_mapping' must be a non-empty object")
        return
    allowed = set(run.cfg["surfaces"]) | set(run.cfg["shared_proof_layers"])
    unknown = sorted(set(mapping) - allowed)
    if unknown:
        run.hard.append(f"{rel}: unknown test_mapping key(s) {unknown} — allowed: {sorted(allowed)}")
    status_cfg = run.cfg["story_status"] or {}
    empty_ok = bool(status_cfg.get("deferred_allows_empty_tests")) \
        and status_cfg.get("deferred") is not None and data.get("status") == status_cfg.get("deferred")
    for key, refs in mapping.items():
        if empty_ok and refs == []:
            continue
        if not isinstance(refs, list) or not refs:
            run.hard.append(f"{rel}: 'test_mapping.{key}' must be a non-empty list")
            continue
        stats["n_tests"] += sum(_test_ref(run, rel, f"test_mapping.{key}", t) for t in refs)


def _check_state(run: Run, item: dict, label: str, surfaces: list[str]) -> None:
    """`state`: proven/target, or a map over the item's surfaces; a target needs an issue."""
    state = item.get("state", "proven")
    if isinstance(state, dict):
        outside = sorted(set(state) - set(surfaces))
        if outside:
            hint = " (one implicit surface takes a single state value)" if not surfaces else ""
            run.hard.append(f"{label}: state key(s) {outside} outside the item's surfaces {surfaces}{hint}")
        values = list(state.values())
    else:
        values = [state]
    if any(v not in STATES for v in values):
        run.hard.append(f"{label}: state must be 'proven' or 'target', or a map from surface to one "
                        f"of them, got {state!r}")
    issue = item.get("issue")
    valid_issue = isinstance(issue, str) and parse_issue_ref(issue.strip()) is not None
    if "issue" in item and not valid_issue:
        run.hard.append(f"{label}: malformed issue ref {issue!r} "
                        f"(want '#N', 'owner/repo#N', or a github issue URL)")
    elif "target" in values and not valid_issue:
        run.hard.append(f"{label}: state 'target' needs an 'issue' — the issue that makes it proven")


def _check_item_tests(run: Run, item: dict, label: str, surfaces: list[str], owned_by: object) -> bool:
    """`tests`: a map over the item's surfaces and its owned_by layer, or a plain list for
    an item with exactly one (maybe implicit) surface. True when one names an existing test."""
    tests = item["tests"]
    if isinstance(tests, list):
        if len(surfaces) > 1:
            run.hard.append(f"{label}: a plain 'tests' list fits an item with exactly one surface; "
                            f"this one has {surfaces} — use a map per surface")
        return any([_test_ref(run, label, "tests", ref) for ref in tests])
    if not isinstance(tests, dict):
        run.hard.append(f"{label}: 'tests' must be a list or a map from surface to a list of test refs")
        return False
    layers = run.cfg["shared_proof_layers"]
    proof = False
    for key, refs in tests.items():
        if key in layers and key != owned_by:
            run.hard.append(f"{label}: tests key {key!r} is a shared proof layer — only an item with "
                            f"owned_by {key!r} may use it")
        elif key not in surfaces and key != owned_by:
            run.hard.append(f"{label}: tests key {key!r} is neither one of the item's surfaces "
                            f"{surfaces} nor its owned_by layer")
        if not isinstance(refs, list) or not refs:
            run.hard.append(f"{label}: tests.{key} must be a non-empty list")
            continue
        proof = any([_test_ref(run, label, f"tests.{key}", ref) for ref in refs]) or proof
    return proof


DESIGN_GATE = "scripts/process/check_design_contracts.py"


def _anchor_index(run: Run) -> object | None:
    """The design-contracts gate's reading of the rounds an item's `design` anchor may name
    (v2.93 B3) — None without that module: there `design` stays unchecked. Imported here
    only, so a project without the module never loads it."""
    if not (run.root / DESIGN_GATE).is_file():
        return None
    if run.anchors is None:
        import check_design_contracts  # noqa: PLC0415  (sibling; the owner of the anchor)
        run.anchors = check_design_contracts.AnchorIndex(run.root)
    return run.anchors


def _check_item(run: Run, item: dict, label: str, story_surfaces: list[str], group: str) -> None:
    unknown = sorted(set(item) - ITEM_FIELDS)
    if unknown:
        run.soft.append(f"{label}: unknown item field(s) {unknown} — not validated")
    surfaces, found = registry_config.item_surfaces(run.cfg, item, story_surfaces)
    _report(run, label, found)
    owned_by = item.get("owned_by")
    if "owned_by" in item and owned_by not in run.cfg["shared_proof_layers"]:
        run.hard.append(f"{label}: owned_by {owned_by!r} is not one of shared_proof_layers "
                        f"{run.cfg['shared_proof_layers']}")
    counts = run.owned.setdefault(group, [0, 0])
    counts[0] += 1
    counts[1] += "owned_by" in item
    _check_state(run, item, label, surfaces)
    if "design" in item:
        index = _anchor_index(run)
        if index is not None:
            _report(run, label, index.problems(item["design"]))
    if "tests" in item and _check_item_tests(run, item, label, surfaces, owned_by):
        return
    if run.cfg["strict_item_tests"]:
        run.hard.append(f"{label}: no existing test (strict_item_tests)")
    else:
        run.untested[group] = run.untested.get(group, 0) + 1


def _check_acceptance(run: Run, data: dict, rel: str, stats: dict, group: str,
                      story_surfaces: list[str]) -> None:
    acceptance = data.get("acceptance")
    if not isinstance(acceptance, list) or not acceptance:
        run.hard.append(f"{rel}: 'acceptance' must be a non-empty list")
        return
    stats["n_acc"] = len(acceptance)
    sid = data.get("id") if isinstance(data.get("id"), str) else "?"
    seen: set[str] = set()
    for i, ac in enumerate(acceptance):
        where = f"{rel}: acceptance[{i}]"
        if not isinstance(ac, dict) or "id" not in ac:
            run.hard.append(f"{where} has no 'id' — an item is an object with 'id' and 'text'; "
                            f"`python scripts/process/check_feature_registry.py --assign-ids --write` "
                            f"numbers them by position")
            continue
        iid = ac["id"]
        label = where
        if not isinstance(iid, str) or not ITEM_ID.match(iid):
            run.hard.append(f"{where} 'id' must match {ITEM_ID.pattern}, got {iid!r}")
        elif iid in seen:
            run.hard.append(f"{rel}: {sid}#{iid} is used twice — an item id is unique within its story")
        else:
            seen.add(iid)
            label = f"{rel}: {sid}#{iid}"
        text = ac.get("text")
        if not isinstance(text, str) or not text.strip():
            run.hard.append(f"{where} 'text' must be a non-empty string")
        _check_item(run, ac, label, story_surfaces, group)


def _check_retired(run: Run, data: dict, rel: str) -> None:
    """A story's `retired` list (v2.93 I4.1): `[{"id": "AC9"}, {"id": "AC12", "split_into":
    ["AC31", "AC32"]}]` — each id an item id, once, and no longer an acceptance item;
    `split_into` names items that stand in this story, none of them retired."""
    if "retired" not in data:
        return
    retired = data["retired"]
    sid = data.get("id") if isinstance(data.get("id"), str) else "?"
    if not isinstance(retired, list):
        run.hard.append(f"{rel}: 'retired' must be a list of objects with an 'id' (and maybe "
                        f"'split_into')")
        return
    current, _ = registry_config.item_ids(data)
    ids: set[str] = set()
    splits: list[tuple[str, object]] = []
    for i, entry in enumerate(retired):
        where = f"{rel}: retired[{i}]"
        if not isinstance(entry, dict) or "id" not in entry:
            run.hard.append(f"{where} must be an object with an 'id'")
            continue
        unknown = sorted(set(entry) - RETIRED_ENTRY_FIELDS)
        if unknown:
            run.soft.append(f"{where}: unknown field(s) {unknown} — not validated")
        iid = entry["id"]
        if not isinstance(iid, str) or not ITEM_ID.match(iid):
            run.hard.append(f"{where} 'id' must match {ITEM_ID.pattern}, got {iid!r}")
            continue
        if iid in ids:
            run.hard.append(f"{rel}: {sid}#{iid} is retired twice — a retired id stands once")
            continue
        ids.add(iid)
        if iid in current:
            run.hard.append(f"{rel}: {sid}#{iid} is retired and still an acceptance item — "
                            f"a retired id names no item")
        if "split_into" in entry:
            splits.append((iid, entry["split_into"]))
    for iid, targets in splits:
        if not (isinstance(targets, list) and targets and all(isinstance(t, str) for t in targets)):
            run.hard.append(f"{rel}: {sid}#{iid}: 'split_into' must be a non-empty list of item ids "
                            f"of this story")
            continue
        for target in targets:
            if target in ids:
                run.hard.append(f"{rel}: {sid}#{iid}: split_into names {target!r}, itself retired — "
                                f"a split names the items that stand")
            elif target not in current:
                run.hard.append(f"{rel}: {sid}#{iid}: split_into names {target!r}, no item of "
                                f"this story")


def _check_entry(run: Run, story: registry_config.Story, group: str) -> None:
    stats = {"n_acc": 0, "n_tests": 0, "sid": None}
    run.stats.append(stats)
    rel = run.rel(story.path)
    if story.error:
        run.hard.append(f"{rel}: {story.error}")
        return
    data = story.data
    if not isinstance(data, dict):
        run.hard.append(f"{rel}: entry must be a JSON object, got {type(data).__name__}")
        return
    cfg = run.cfg

    # work-log fields retired in the lean pass — their truth lives in GitHub
    # Issues/Sub-Issues/Projects now; a leftover field is stale double bookkeeping
    retired_fields = _retired_fields(cfg)
    retired = sorted(retired_fields & set(data))
    if retired:
        run.hard.append(f"{rel}: retired work-log field(s) {retired} — status, "
                        f"dependencies, and decomposition live in GitHub "
                        f"Issues/Projects now; the inventory carries only "
                        f"capability -> acceptance -> tests")
    unknown = sorted(set(data) - _known_fields(cfg) - retired_fields)
    if unknown:
        run.soft.append(f"{rel}: unknown field(s) {unknown} — not validated")

    _check_id(run, story, data, rel, stats)
    for name in cfg["story_text_fields"]:
        value = data.get(name)
        if not value:
            run.hard.append(f"{rel}: missing '{name}'")
        elif not isinstance(value, str) or not value.strip():
            run.hard.append(f"{rel}: '{name}' must be a non-empty string")
    surfaces, found = registry_config.story_surfaces(cfg, data)
    _report(run, rel, found)
    _check_status(run, data, rel)
    _check_acceptance(run, data, rel, stats, group, surfaces)
    _check_retired(run, data, rel)
    _check_story_tests(run, data, rel, stats)
    _check_issues(run, data, rel)

    adr = data.get("adr")
    if adr and not _adr_exists(run.root, adr):
        run.hard.append(f"{rel}: adr link {adr!r} has no file under {ADR_DIR}/")


def _check_capabilities(run: Run, reg: registry_config.Registry) -> None:
    """The capabilities layout: heads, directory names, nothing loose in the root."""
    cfg = run.cfg
    root_rel = run.rel(reg.path)
    for path in reg.stray:
        run.hard.append(f"{run.rel(path)}: JSON directly in {root_rel} — a capability is a "
                        f"directory <capability>/{registry_config.HEAD} plus one <id>.json per story")
    needs_prefix = "{prefix}" in cfg["id_pattern"]
    for cap in reg.capabilities:
        crel = run.rel(cap.path)
        head_rel = f"{crel}/{registry_config.HEAD}"
        if cap.error:
            run.hard.append(f"{crel}: {cap.error}")
        else:
            head = cap.head
            if head.get("schema_version") != 1:
                run.hard.append(f"{head_rel}: schema_version must be 1, got {head.get('schema_version')!r}")
            if head.get("capability") != cap.path.name:
                run.hard.append(f"{crel}: directory name must match capability {head.get('capability')!r}")
            prefix = head.get("prefix")
            if needs_prefix and not (isinstance(prefix, str) and PREFIX.match(prefix)):
                run.hard.append(f"{head_rel}: 'prefix' must be upper-case letters A-Z, got {prefix!r} "
                                "— id_pattern uses {prefix}")  # no f-string: the file is Jinja
        if not cap.stories:
            (run.hard if cfg["require_registry"] else run.soft).append(
                f"{crel}: a capability without stories")
    if not reg.capabilities:
        (run.hard if cfg["require_registry"] else run.soft).append(
            f"{root_rel} holds no capability directory")


def _under_granular_note(stats: list[dict]) -> list[str]:
    flagged = sorted(
        ((s["sid"], s["n_tests"]) for s in stats
         if s["sid"] and s["n_acc"] <= UNDER_GRANULAR_MAX_ACC
         and s["n_tests"] >= UNDER_GRANULAR_MIN_TESTS),
        key=lambda x: -x[1])
    if not flagged:
        return []
    shown = ", ".join(f"{sid}({nt}t)" for sid, nt in flagged[:12])
    more = f" (+{len(flagged) - 12} more)" if len(flagged) > 12 else ""
    return [f"{len(flagged)} entr(ies) carry <= {UNDER_GRANULAR_MAX_ACC} acceptance "
            f"criteria but >= {UNDER_GRANULAR_MIN_TESTS} mapped tests — acceptance may "
            f"under-describe tested behaviour; consider adding explicit criteria: "
            f"{shown}{more}"]


# --- stable item ids: the branch against its fork point (v2.93 I4.2–I4.4, I4.6) ----

NOT_COMPARED = "item ids are not compared with a base"


def _base(root: Path) -> tuple[registry_config.Registry | None, list[str]]:
    """The registry at the branch's fork point (`check_review.merge_base`), or None with a
    note saying why there is none — never an error, never a silent pass. The pre-push, the
    train and `finish` fork from the tip of the integration branch; PR CI forks through
    its merge commit; on the integration branch itself there is no fork point."""
    try:
        fork = merge_base(root)
    except GitReadError as exc:
        return None, [f"no fork point to compare with: it is ambiguous ({exc}) — {NOT_COMPARED}"]
    if fork is not None:
        return registry_config.load_registry_at(root, fork)
    forkless = forkless_refs(root)
    if not forkless:
        return None, [f"no fork point to compare with (on the integration branch, or no "
                      f"integration ref) — {NOT_COMPARED}"]
    remedy = ("this clone is shallow: `git fetch --unshallow`" if is_shallow(root)
              else f"fetch the history of {forkless[0]} the branch forked from")
    return None, [f"no fork point with {', '.join(forkless)} in this history — {NOT_COMPARED}; "
                  f"{remedy}"]


def _stable_ids(run: Run, base: registry_config.Registry | None) -> bool:
    """`stable_ids` (I4.6): off only where the base AND the branch say false — a branch
    cannot lift the duty for itself. No base value counts as true; one that is no boolean
    counts as true too, with a note."""
    value = base.cfg.get("stable_ids", True) if base is not None else True
    if not isinstance(value, bool):
        run.soft.append(f"`stable_ids` at the base is {value!r}, no boolean — it counts as true")
        value = True
    return value or run.cfg["stable_ids"]


def _num(iid: str) -> int:
    return int(iid[2:])


def _texts(data: dict) -> dict[str, str]:
    """{item id: its text, whitespace normalised} of a story's acceptance items with an id."""
    items = data.get("acceptance") if isinstance(data.get("acceptance"), list) else []
    return {it["id"]: " ".join(it["text"].split()) for it in items
            if isinstance(it, dict) and isinstance(it.get("id"), str) and ITEM_ID.match(it["id"])
            and isinstance(it.get("text"), str)}


def _splits(data: dict) -> dict[str, list[str]]:
    """{retired id: the ids its `split_into` names} of a story — well-formed entries only."""
    retired = data.get("retired") if isinstance(data.get("retired"), list) else []
    return {e["id"]: [t for t in e.get("split_into") or [] if isinstance(t, str)]
            for e in retired if isinstance(e, dict) and isinstance(e.get("id"), str)
            and isinstance(e.get("split_into", []), list)}


def _compare_story(run: Run, story: registry_config.Story, old: registry_config.Story) -> None:
    """I4.3: one story at the base and today. Ids compare by number (AC10 > AC9)."""
    data, before = story.data, old.data
    if not isinstance(data.get("acceptance"), list):
        return  # the acceptance check says why
    rel, sid = run.rel(story.path), data["id"]
    ids, retired = registry_config.item_ids(data)
    old_ids, old_retired = registry_config.item_ids(before)
    for iid in sorted(old_ids - ids - retired, key=_num):
        run.hard.append(f"{rel}: {sid}#{iid} is gone without an entry in 'retired' — item ids "
                        f"are stable: list a removed id there, so it is never given again")
    for iid in sorted(old_retired - retired, key=_num):
        run.hard.append(f"{rel}: {sid}#{iid} is retired at the base, its 'retired' entry is gone — "
                        f"a retired entry stays")
    top = max(map(_num, old_ids | old_retired), default=0)
    for iid in sorted((ids | retired) - old_ids - old_retired, key=_num):
        if _num(iid) <= top:
            run.hard.append(f"{rel}: {sid}#{iid} is new but not higher than AC{top}, the highest id "
                            f"{sid} held at the base — a new item gets AC{top + 1} or higher "
                            f"(`--assign-ids` gives it)")
    # renumbered: an item's text now under another id that did not carry it at the base
    old_text, text, splits = _texts(before), _texts(data), _splits(data)
    holders: dict[str, list[str]] = {}
    for iid, t in text.items():
        holders.setdefault(t, []).append(iid)
    for iid, t in sorted(old_text.items(), key=lambda kv: _num(kv[0])):
        if text.get(iid) == t:
            continue
        moved = [other for other in holders.get(t, []) if other != iid
                 and old_text.get(other) != t and other not in splits.get(iid, [])]
        if moved:
            run.hard.append(f"{rel}: {sid}#{iid}'s text now stands under {sid}#{moved[0]} — "
                            f"renumbered? An item keeps its id; if the wording went to another "
                            f"item on purpose, retire {iid} with `split_into` naming {moved[0]}")


def _ref_pattern(cfg: dict) -> re.Pattern:
    """A registry ref `<story id>#AC<n>` (I4.4): the loose story id, then the item id; a
    URL anchor `#AC4` without a story id in front matches nothing."""
    return re.compile("(?P<story>" + registry_config.story_ref_pattern(cfg).pattern
                      + r")#(?P<item>AC[1-9]\d*)(?![\w-])")


def _strings(value: object) -> list[str]:
    if isinstance(value, str):
        return [value]
    if isinstance(value, dict):
        return [s for v in value.values() for s in _strings(v)]
    if isinstance(value, list):
        return [s for v in value for s in _strings(v)]
    return []


def _check_refs(run: Run, reg: registry_config.Registry) -> None:
    """I4.4: every `<story id>#AC<n>` in a text value of a story or head file — test refs
    included — names an item of today's registry. A retired id with `split_into` is a
    note naming its successors; without one, an unknown story or an unknown id fails. For
    a deleted story this is the one guard."""
    stories: dict[str, tuple[set[str], set[str], dict[str, list[str]]]] = {}
    for story in reg.stories:
        if isinstance(story.data, dict) and isinstance(story.data.get("id"), str):
            ids, retired = registry_config.item_ids(story.data)
            stories.setdefault(story.data["id"], (ids, retired, _splits(story.data)))
    pattern = _ref_pattern(run.cfg)
    files = [(story.path, story.data) for story in reg.stories]
    files += [(cap.path / registry_config.HEAD, cap.head) for cap in reg.capabilities]
    for path, data in files:
        rel = run.rel(path)
        refs = sorted({(m.group("story"), m.group("item")) for text in _strings(data)
                       for m in pattern.finditer(text)})
        for sid, iid in refs:
            ref = f"{sid}#{iid}"
            if sid not in stories:
                run.hard.append(f"{rel}: {ref} names no story of the registry")
                continue
            ids, retired, splits = stories[sid]
            if iid in ids:
                continue
            if iid in retired and splits.get(iid):
                run.soft.append(f"{rel}: {ref} is retired, split into {', '.join(splits[iid])} — "
                                f"point the ref at the item it means")
            elif iid in retired:
                run.hard.append(f"{rel}: {ref} is retired — point the ref at the item that holds "
                                f"the behaviour now, or drop it")
            else:
                run.hard.append(f"{rel}: {ref} names no item of {sid}")


def _stable(run: Run, reg: registry_config.Registry) -> None:
    base, notes = _base(run.root)
    run.soft += notes
    if not _stable_ids(run, base):
        return
    if base is not None:
        for story, old in registry_config.paired_stories(reg, base):
            _compare_story(run, story, old)
    _check_refs(run, reg)


def check(root: Path) -> tuple[list[str], list[str]]:
    try:
        cfg = registry_config.config(root)
    except registry_config.ConfigError as exc:
        return [str(exc)], []
    problems = registry_config.problems(cfg)
    if problems:
        return problems, []
    reg = registry_config.load_registry(root, cfg)
    run = Run(root, cfg)
    if not reg.present:
        if cfg["require_registry"]:
            return [f"{cfg['root']} does not exist"], []
        return [], ["no inventory entries yet (feature inventory empty)"]
    if cfg["layout"] == "capabilities":
        _check_capabilities(run, reg)
    elif not reg.stories:
        if cfg["require_registry"]:
            return [f"{cfg['root']} holds no story"], []
        return [], ["no inventory entries yet (feature inventory empty)"]
    for story in reg.stories:
        _check_entry(run, story, run.rel(story.capability.path if story.capability else reg.path))
    _stable(run, reg)
    run.soft += [f"{group}: {n} acceptance item(s) without an existing test — "
                 f"`strict_item_tests` would fail them" for group, n in sorted(run.untested.items())]
    if cfg["shared_proof_layers"] and run.owned:
        # whether a behaviour really is the shared layer's stays review judgment; the
        # share makes a drift of client items into "owned_by" visible (#404 AC-22)
        shares = ", ".join(f"{group.rsplit('/', 1)[-1]} {owned}/{n}"
                           for group, (n, owned) in sorted(run.owned.items()))
        run.soft.append(f"items owned_by a shared proof layer, per capability: {shares}")
    run.soft += _under_granular_note(run.stats)
    return run.hard, run.soft


# --- migration: --assign-ids [--write] ------------------------------------------

def _numbered(items: list, reserved: set[str] | frozenset[str] = frozenset()) -> tuple[list, int, list[str]]:
    """(the items with an id each, how many were assigned, non-conforming ids kept).
    `reserved` are the ids the story holds besides its items: today's `retired` and, where
    a base registry was read, the base's items and retired ids (v2.93 I4.5). A story with
    an item id or a reserved id gives each new item the maximum plus one, so a just
    removed id is never given again; only a story with neither numbers by position
    (`AC<position>`), the first migration."""
    taken = {it["id"] for it in items
             if isinstance(it, dict) and isinstance(it.get("id"), str) and ITEM_ID.match(it["id"])}
    odd = [repr(it["id"]) for it in items
           if isinstance(it, dict) and "id" in it and not (isinstance(it["id"], str) and ITEM_ID.match(it["id"]))]
    held = taken | set(reserved)
    top = max(map(_num, held), default=0)
    out: list = []
    assigned = 0
    for position, item in enumerate(items, 1):
        if (isinstance(item, dict) and "id" in item) or not isinstance(item, (str, dict)):
            out.append(item)
            continue
        if held:
            top += 1
            iid = f"AC{top}"
        else:
            iid = f"AC{position}"
        assigned += 1
        out.append({"id": iid, "text": item} if isinstance(item, str) else {"id": iid, **item})
    return out, assigned, odd


def _assign_base(root: Path, reg: registry_config.Registry) -> dict[int, registry_config.Story]:
    """{id(story): the story at the base} for `--assign-ids` — matched as the gate matches
    (I4.2); empty without a base registry, with a note when git cannot tell the base."""
    try:
        fork = merge_base(root)
    except GitReadError as exc:
        print(f"assign-ids: note: the fork point cannot be told ({exc}) — the base is not read; "
              f"ids follow this tree only")
        return {}
    if fork is None:
        return {}
    base, notes = registry_config.load_registry_at(root, fork)
    for note in notes:
        print(f"assign-ids: note: {note}")
    if base is None:
        return {}
    return {id(story): old for story, old in registry_config.paired_stories(reg, base)}


def _indent(text: str) -> int | str | None:
    """The file's own indentation: its first indented line's, None for a one-line file."""
    m = re.search(r"\n([ \t]+)\S", text)
    if not m:
        return None
    return "\t" if m.group(1).startswith("\t") else len(m.group(1))


def assign_ids(root: Path, write: bool) -> int:
    """Give every acceptance item an id, in either layout; a preview without `write`.
    Idempotent: a second run changes nothing. Exit 1 when an id needs a human."""
    try:
        cfg = registry_config.config(root)
    except registry_config.ConfigError as exc:
        print(f"assign-ids: FAILED: {exc}")
        return 1
    problems = registry_config.problems(cfg)
    if problems:
        print("assign-ids: FAILED:\n" + "\n".join(f"  - {p}" for p in problems))
        return 1
    changed = 0
    odd_found = False
    reg = registry_config.load_registry(root, cfg)
    at_base = _assign_base(root, reg)
    for story in reg.stories:
        rel = story.path.relative_to(root).as_posix()
        data = story.data
        if story.error or not isinstance(data, dict) or not isinstance(data.get("acceptance"), list):
            print(f"assign-ids: {rel}: skipped — no readable acceptance list (the gate says why)")
            continue
        _ids, reserved = registry_config.item_ids(data)
        if id(story) in at_base:
            old_ids, old_retired = registry_config.item_ids(at_base[id(story)].data)
            reserved |= old_ids | old_retired
        items, assigned, odd = _numbered(data["acceptance"], reserved)
        sid = data.get("id", rel)
        for iid in odd:
            odd_found = True
            print(f"assign-ids: {rel}: {sid}: item id {iid} does not match {ITEM_ID.pattern} "
                  f"— rename it by hand (references may name it)")
        if not assigned:
            continue
        changed += 1
        if not write:
            print(f"assign-ids: {rel}: would assign {assigned} item id(s)")
            continue
        text = story.path.read_text(encoding="utf-8")
        data["acceptance"] = items
        story.path.write_text(json.dumps(data, indent=_indent(text), ensure_ascii=False) + "\n",
                              encoding="utf-8")
        print(f"assign-ids: {rel}: assigned {assigned} item id(s)")
    if not changed:
        print("assign-ids: nothing to assign")
    elif not write:
        print(f"assign-ids: {changed} file(s) would change — rerun with --write")
    return 1 if odd_found else 0


def main() -> int:
    ap = argparse.ArgumentParser(description="Validate the feature registry, or migrate its "
                                             "acceptance items to ids (--assign-ids).")
    ap.add_argument("root", nargs="?", default=".")
    ap.add_argument("--assign-ids", action="store_true",
                    help="give every acceptance item an id AC<n> (a preview without --write)")
    ap.add_argument("--write", action="store_true", help="with --assign-ids: write the files")
    args = ap.parse_args()
    root = Path(args.root).resolve()
    if args.write and not args.assign_ids:
        ap.error("--write only goes with --assign-ids")
    if args.assign_ids:
        return assign_ids(root, args.write)
    hard, soft = check(root)
    for note in soft:
        print(f"inventory-gate: note: {note}")
    if hard:
        print("inventory-gate: FAILED:")
        for h in hard:
            print(f"  - {h}")
        return 1
    print("inventory-gate: OK")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
