#!/usr/bin/env python3
"""feature-inventory gate: validate the capability entries under
docs/process/feature-registry/ — the "what can the product do today, and
where is that proven?" SSOT.

Lean pass: the registry's work-log axis (status, blocked_by, parent, ready
ordering) moved to GitHub Issues/Projects — issues own "what is in flight".
This inventory owns the other question: each entry names a shipped
capability, its acceptance criteria, and the tests that prove them. An entry
without a resolvable test is a claim, not an inventory item — hard failure.
Fed at merge: the feature's spec user stories are promoted here with their
test references (the durable yield of the pruned spec artifacts).

Structure and reference existence are hard-guaranteed (CI exit 1). Whether a
test *semantically* proves its criterion is not mechanically decidable and is
review judgment. Language-agnostic; stdlib only (plus the shared adr glob)."""
from __future__ import annotations

import re
import sys
from pathlib import Path

# the decision-records gate (core, always rendered) owns ADR file identity, and
# registry_config (core) owns configuration and loader — import, don't copy (one
# owner per behavior)
sys.path.insert(0, str(Path(__file__).resolve().parent))  # sibling import
import registry_config  # noqa: E402
from check_decisions import ADR_DIR, adr_exists as _adr_exists  # noqa: E402

ID_RE = re.compile(r"^STORY-\d{4}$")
KNOWN_FIELDS = {"id", "title", "story", "acceptance", "tests", "adr", "issue", "links"}

# Advisory only: an entry with many mapped tests but very few acceptance
# criteria likely under-describes its tested behaviour. Warns, never blocks.
UNDER_GRANULAR_MAX_ACC = 2
UNDER_GRANULAR_MIN_TESTS = 5


def _check_entry(root: Path, cfg: dict, story: registry_config.Story,
                 seen_ids: dict) -> tuple[list[str], list[str], dict]:
    hard: list[str] = []
    soft: list[str] = []
    stats = {"n_acc": 0, "n_tests": 0, "sid": None}
    rel = story.path.relative_to(root)
    if story.error:
        return [f"{rel}: {story.error}"], [], stats
    data = story.data
    if not isinstance(data, dict):
        return [f"{rel}: entry must be a JSON object, got {type(data).__name__}"], [], stats

    # work-log fields retired in the lean pass — their truth lives in GitHub
    # Issues/Sub-Issues/Projects now; a leftover field is stale double bookkeeping
    retired_fields = set(cfg["retired_fields"])
    retired = sorted(retired_fields & set(data))
    if retired:
        hard.append(f"{rel}: retired work-log field(s) {retired} — status, "
                    f"dependencies, and decomposition live in GitHub "
                    f"Issues/Projects now; the inventory carries only "
                    f"capability -> acceptance -> tests")
    unknown = sorted(set(data) - KNOWN_FIELDS - retired_fields)
    if unknown:
        soft.append(f"{rel}: unknown field(s) {unknown} — not validated")

    sid = data.get("id")
    if not isinstance(sid, str) or not sid:
        hard.append(f"{rel}: missing or non-string 'id'")
    elif not ID_RE.match(sid):
        hard.append(f"{rel}: 'id' must match STORY-NNNN, got {sid!r}")
    elif sid in seen_ids:
        hard.append(f"{rel}: duplicate id {sid!r} (also in {seen_ids[sid]})")
    else:
        seen_ids[sid] = str(rel)
        stats["sid"] = sid

    if not data.get("title"):
        hard.append(f"{rel}: missing 'title'")
    if not data.get("story"):
        hard.append(f"{rel}: missing 'story'")

    acceptance = data.get("acceptance")
    if not isinstance(acceptance, list) or not acceptance:
        hard.append(f"{rel}: 'acceptance' must be a non-empty list")
    else:
        stats["n_acc"] = len(acceptance)
        for i, ac in enumerate(acceptance):
            text = ac.get("text") if isinstance(ac, dict) else None
            if not isinstance(text, str) or not text.strip():
                hard.append(f"{rel}: acceptance[{i}] 'text' must be a non-empty string")

    # an inventory entry asserts a shipped, proven capability — it requires at
    # least one existing test; a dead test path is a false claim of proof
    tests = data.get("tests")
    if not isinstance(tests, list) or not tests:
        hard.append(f"{rel}: 'tests' must be a non-empty list — an inventory "
                    f"entry without a proving test is a claim, not an inventory")
    else:
        for t in tests:
            file_part = str(t).split("::", 1)[0]  # strip a pytest ::node selector
            if not (root / file_part).is_file():
                hard.append(f"{rel}: test path does not exist: {t}")
            else:
                stats["n_tests"] += 1

    adr = data.get("adr")
    if adr and not _adr_exists(root, adr):
        hard.append(f"{rel}: adr link {adr!r} has no file under {ADR_DIR}/")

    return hard, soft, stats


def _under_granular_note(stats: list[dict]) -> list[str]:
    flagged = sorted(
        ((s["sid"], s["n_tests"]) for s in stats
         if s["sid"] and s["n_acc"] <= UNDER_GRANULAR_MAX_ACC
         and s["n_tests"] >= UNDER_GRANULAR_MIN_TESTS),
        key=lambda x: -x[1])
    if not flagged:
        return []
    shown = ", ".join(f"{sid}({nt}t)" for sid, nt in flagged[:12])
    more = f" (+{len(flagged) - 12} more)" if len(flagged) > 12 else ""
    return [f"{len(flagged)} entr(ies) carry <= {UNDER_GRANULAR_MAX_ACC} acceptance "
            f"criteria but >= {UNDER_GRANULAR_MIN_TESTS} mapped tests — acceptance may "
            f"under-describe tested behaviour; consider adding explicit criteria: "
            f"{shown}{more}"]


def check(root: Path) -> tuple[list[str], list[str]]:
    try:
        cfg = registry_config.config(root)
    except registry_config.ConfigError as exc:
        return [str(exc)], []
    problems = registry_config.problems(cfg)
    if problems:
        return problems, []
    reg = registry_config.load_registry(root, cfg)
    if not reg.stories:
        return [], ["no inventory entries yet (feature inventory empty)"]
    hard: list[str] = []
    soft: list[str] = []
    seen_ids: dict = {}
    all_stats: list[dict] = []
    for story in reg.stories:
        h, s, stats = _check_entry(root, cfg, story, seen_ids)
        hard += h
        soft += s
        all_stats.append(stats)
    soft += _under_granular_note(all_stats)
    return hard, soft


def main() -> int:
    root = Path(sys.argv[1] if len(sys.argv) > 1 else ".").resolve()
    hard, soft = check(root)
    for note in soft:
        print(f"inventory-gate: note: {note}")
    if hard:
        print("inventory-gate: FAILED:")
        for h in hard:
            print(f"  - {h}")
        return 1
    print("inventory-gate: OK")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
