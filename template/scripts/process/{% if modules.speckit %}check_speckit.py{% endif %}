#!/usr/bin/env python3
"""speckit gate: the deterministic floor under the Spec Kit integration.

Spec Kit's own quality steps (analyze, checklist, converge) are LLM judgment,
optional, on demand, at every tier; this gate enforces the two lines a machine can honestly draw (the independent
design review's F3/F7 conditions — prompts alone must not carry rule 5):

  - HARD: the constitution pointer marker is missing from
    .specify/memory/constitution.md — someone ran /speckit-constitution (or
    edited the file) and replaced the pointer with generated principles: a
    second truth beside the gated one. Restore the pointer.
  - HARD: a user-story phase in an active specs/*/tasks.md has no task that
    references a test — "tests are optional" upstream must never survive into
    rendered tasks (mandatory rule 5). Heuristic and honest about it: a phase
    heading that names a user story must contain at least one task line
    mentioning a test. The task grain is /plan's "one task = one behaviour,
    test AND implementation" (red → green inside the task); a combined
    behaviour task with a test reference passes, and so does an older
    split-style list (separate test task, then implement task) — the floor
    is the test reference, not the shape. Semantic adequacy stays review
    judgment.
  - HARD: an active Tier 2+ plan in .process-work/plans that neither
    references a specs/ directory nor carries a `spec-waived: <reason>` line —
    with the speckit module on, the spec interrogation (stories, EARS twins,
    clarify loop) comes BEFORE planning; skipping it is a documented decision,
    never a silent one. Fenced text is quotation; designs (design-*) and
    archived plans are out of scope (history is not retroactively re-specced).
  - SOFT: .specify/ missing entirely — expected before `specify init` ran
    (the BOOTSTRAP step); named, never silently green.
  - SOFT: unchecked tasks in an active specs/*/tasks.md — the deterministic
    completeness signal at review time (in place of a required LLM converge
    pass, which stays optional; the reviewer judges the note, the gate never
    blocks mid-build).
  - SOFT: the /speckit-* skills an active integration installed
    (.specify/integrations/<name>.manifest.json) are not committed, are
    missing from the checkout, or a skill Setup deliberately removes is back;
    a committed skill no manifest lists is an orphan. A clone gets only what
    is committed — an ignored skills directory left every fresh clone without
    the flow and sent it to the CLI (#363). Never a block: the skills
    directory is harness-specific, and a failed read is a note, never "all
    committed".

Unresolved [NEEDS CLARIFICATION] markers in specs/ are the clarification
gate's job (one owner). Pure stdlib.
"""
from __future__ import annotations

import json
import re
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from check_review import plan_tier, _unfenced, waiver_debt_notes  # noqa: E402  (one owner: the
# review gate owns the plan-field grammar and fence discipline; import, don't copy)

CONSTITUTION = ".specify/memory/constitution.md"
POINTER_MARK = "DEV-PROCESS-CONSTITUTION-POINTER"
SPECS_DIR = "specs"
PLANS_ACTIVE = ".process-work/plans"
SPEC_REF = re.compile(r"\bspecs/[\w][\w.-]*", re.IGNORECASE)
SPEC_WAIVED = re.compile(r"^[>\s\-*]*spec-waived[*_]*\s*:\s*\S", re.IGNORECASE | re.MULTILINE)

STORY_PHASE = re.compile(r"^##+\s+Phase\s+\d+.*User Story", re.IGNORECASE)
ANY_PHASE = re.compile(r"^##+\s+(?:Phase\b|Final phase\b)", re.IGNORECASE)
TASK_LINE = re.compile(r"^\s*- \[[ xX]\] ")
TESTY = re.compile(r"\btest", re.IGNORECASE)

INTEGRATIONS = ".specify/integrations"
INTEGRATION_STATE = ".specify/integration.json"
EXTENSION_REGISTRY = ".specify/extensions/.registry"  # installed Spec Kit extensions
CORE_MANIFEST = "speckit.manifest.json"
# Setup removes these three (speckit.md, "Setup"): constitution would replace
# the gated pointer, implement bypasses the execute flow, taskstoissues
# duplicates the issue path
DROPPED_SKILLS = ("constitution", "implement", "taskstoissues")
SKILL_PART = re.compile(r"(?:^|/)(speckit[.-]([a-z]+)[^/]*)")
SHOWN = 3
IGNORE_SOURCE = re.compile(r"^(.*?):(\d+):(.*)$")  # check-ignore -v: source:line:pattern


def _story_phases_without_tests(text: str) -> list[str]:
    missing: list[str] = []
    lines = text.splitlines()
    current: str | None = None
    has_test = False
    def flush():
        if current is not None and not has_test:
            missing.append(current)
    for line in lines:
        if ANY_PHASE.match(line):
            flush()
            current = line.strip() if STORY_PHASE.match(line) else None
            has_test = False
            continue
        if current is not None and TASK_LINE.match(line) and TESTY.search(line):
            has_test = True
    flush()
    return missing


def _listed(paths: list[str]) -> str:
    shown = ", ".join(paths[:SHOWN])
    more = len(paths) - SHOWN
    return f"{shown}, and {more} more" if more > 0 else shown


def _skill_part(path: str) -> tuple[str, str] | None:
    """(skills directory, skill name) of a Spec Kit skill or command path."""
    m = SKILL_PART.search(path)
    if not m:
        return None
    return path[:m.start(1)].rstrip("/"), m.group(2).lower()


def _read_json(path: Path) -> object:
    """JSON from a regular file; a FIFO or directory is unreadable, never a hang."""
    if not path.is_file():
        raise OSError(f"{path.name} is not a regular file")
    return json.loads(path.read_text(encoding="utf-8"))


def _installed(state: object) -> list[str]:
    """Spec Kit's own reading of integration.json (normalize_integration_state,
    0.16): the installed list plus the default, which is `default_integration`
    or else the legacy single `integration`."""
    if not isinstance(state, dict):
        return []
    names = state.get("installed_integrations")
    names = list(names) if isinstance(names, list) else []
    names.append(state.get("default_integration") or state.get("integration"))
    return sorted({n for n in names
                   if isinstance(n, str) and re.fullmatch(r"[\w.-]+", n)})


def _manifests(root: Path, notes: list[str]) -> list[Path]:
    integ = root / INTEGRATIONS
    found = sorted(p for p in integ.glob("*.manifest.json")
                   if p.name != CORE_MANIFEST) if integ.is_dir() else []
    state = root / INTEGRATION_STATE
    if not state.exists():
        if found:
            notes.append(f"no {INTEGRATION_STATE} — every integration manifest "
                         f"is read for the /speckit-* skill check")
        return found
    try:
        installed = _installed(_read_json(state))
    except (OSError, ValueError):
        installed = []
    if not installed:
        notes.append(f"{INTEGRATION_STATE}: names no installed integration — "
                     f"every integration manifest is read for the /speckit-* "
                     f"skill check")
        return found
    active = []
    for name in installed:
        p = integ / f"{name}.manifest.json"
        if p.is_file():
            active.append(p)
        else:
            notes.append(f"{INTEGRATIONS}/{p.name}: missing for the installed "
                         f"integration {name!r} — its /speckit-* skills are unverified")
    return active


def _extension_ids(root: Path) -> list[str] | None:
    """Ids of installed Spec Kit extensions — their skills (speckit-<id>-…)
    are listed in no integration manifest; None when the registry is unreadable."""
    reg = root / EXTENSION_REGISTRY
    if not reg.exists():
        return []
    try:
        exts = _read_json(reg)["extensions"]
        if not isinstance(exts, dict):
            raise TypeError
    except (OSError, ValueError, KeyError, TypeError):
        return None
    return sorted(str(k).lower() for k in exts if str(k))


def _git(root: Path, *args: str) -> subprocess.CompletedProcess | None:
    try:
        # errors="replace": a file name that is not UTF-8 must not crash the gate
        return subprocess.run(["git", *args], cwd=root, capture_output=True,
                              text=True, encoding="utf-8", errors="replace")
    except OSError:
        return None


def _tracked(root: Path, dirs: list[str]) -> dict[str, str] | None:
    """path -> `git ls-files -t` tag for indexed files under dirs; None when
    git cannot answer (no repository, no git)."""
    r = _git(root, "--literal-pathspecs", "ls-files", "-t", "-z", "--", *dirs)
    if r is None or r.returncode != 0:
        return None
    out: dict[str, str] = {}
    for entry in r.stdout.split("\0"):
        if len(entry) > 2 and entry[1] == " ":
            out[entry[2:]] = entry[0]
    return out


def _committed(root: Path, dirs: list[str]) -> set[str] | None:
    """Files under dirs in HEAD — what a clone gets (a staged skill is not
    committed yet); empty before the first commit, None when unreadable."""
    r = _git(root, "--literal-pathspecs", "ls-tree", "-r", "-z", "--name-only",
             "HEAD", "--", *dirs)
    if r is not None and r.returncode == 0:
        return {e for e in r.stdout.split("\0") if e}
    head = _git(root, "rev-parse", "--verify", "-q", "HEAD")
    return set() if head is not None and head.returncode == 1 else None


def _ignore_rule(root: Path, path: str) -> str:
    # check-ignore takes plain paths (it refuses pathspec magic) and, with
    # --no-index, names the rule for a path that is not on disk
    r = _git(root, "check-ignore", "-v", "--no-index", "--", path)
    m = (IGNORE_SOURCE.match(r.stdout.split("\t", 1)[0])
         if r is not None and r.returncode == 0 else None)
    return f" (ignored by {m[1]}:{m[2]} `{m[3]}`)" if m else ""


def _orphan(path: str, dirs: set[str], exts: list[str]) -> bool:
    part = _skill_part(path)
    if part is None or (part[0] or ".") not in dirs:
        return False
    rest = SKILL_PART.search(path).group(1)[len("speckit."):].lower()
    return not any(rest == e or rest.startswith((e + "-", e + "."))
                   for e in exts)


def _link_target(root: Path, d: str) -> str | None:
    """The in-repo target of a symlinked skills directory, else None."""
    p = root / d
    if not p.is_symlink():
        return None
    try:
        return p.resolve().relative_to(root.resolve()).as_posix()
    except (OSError, ValueError):
        return None


def _skill_notes(root: Path) -> list[str]:
    """The /speckit-* skills a clone needs, from the integration manifests
    (#363): committed, present, none of the dropped three, no orphan."""
    notes: list[str] = []
    kept: list[str] = []
    dropped: list[str] = []
    dirs: set[str] = set()
    manifests = _manifests(root, notes)
    for m in manifests:
        try:
            files = _read_json(m)["files"]
            if not isinstance(files, dict):
                raise TypeError
        except (OSError, ValueError, KeyError, TypeError):
            notes.append(f"{INTEGRATIONS}/{m.name}: unreadable — "
                         f"its /speckit-* skills are unverified")
            continue
        if not any(_skill_part(str(f)) for f in files):
            notes.append(f"{INTEGRATIONS}/{m.name}: lists no /speckit-* skill "
                         f"file — its skills are unverified")
        for path in files:
            part = _skill_part(str(path))
            if part is None:
                continue
            dirs.add(part[0] or ".")
            (dropped if part[1] in DROPPED_SKILLS else kept).append(str(path))
    if not manifests:
        notes.append(f"no Spec Kit integration manifest under {INTEGRATIONS}/ — "
                     f"whether the /speckit-* skills are installed and committed "
                     f"is unverified (Spec Kit setup)")
        return notes
    # a skills directory may be a committed symlink into the repo (one copy for
    # several harnesses): git tracks the files under the link's target
    real = {d: _link_target(root, d) for d in dirs}
    def through(path: str) -> str:
        d = _skill_part(path)[0] or "."
        return path if real[d] is None else real[d] + path[len(d):]
    kept = sorted({through(p) for p in kept})
    dropped = sorted({through(p) for p in dropped})
    dirs = {real[d] or d for d in dirs}
    listed = set(kept) | set(dropped)
    tracked = _tracked(root, sorted(dirs)) if dirs else {}
    committed = _committed(root, sorted(dirs)) if dirs else set()
    if tracked is None or committed is None:
        notes.append(f"git cannot list the tracked files here — whether the "
                     f"/speckit-* skills are committed is unverified; a fresh "
                     f"clone gets only committed ones (Spec Kit setup)")
        gone = [p for p in kept if not (root / p).is_file()]
        if gone:
            notes.append(f"{len(gone)} /speckit-* skill file(s) missing from "
                         f"this checkout: {_listed(gone)} (Spec Kit setup)")
    else:
        never = [p for p in kept if p not in committed]
        lost = [p for p in kept if p in committed and tracked.get(p) != "S"
                and not (root / p).is_file()]
        if never:
            unstaged = [p for p in never if p not in tracked]
            if not unstaged:
                how = "they are staged — commit them"
            elif all((root / p).is_file() for p in unstaged):
                how = "add and commit them"
            else:
                how = ("commit them from a checkout that has them, or run the "
                       "Spec Kit setup")
            rule = _ignore_rule(root, unstaged[0]) if unstaged else ""
            if rule:
                how = f"fix the ignore rule first (Spec Kit setup), then {how}"
            notes.append(f"{len(never)} /speckit-* skill file(s) never "
                         f"committed{rule}: "
                         f"{_listed(never)} — a fresh clone or worktree has no "
                         f"/speckit-* skill without them; {how} (Spec Kit "
                         f"setup: committing the skills)")
        if lost:
            notes.append(f"{len(lost)} committed /speckit-* skill file(s) "
                         f"missing from this checkout: {_listed(lost)} — restore "
                         f"with `git checkout -- <path>`")
        exts = _extension_ids(root)
        orphans = [] if exts is None else sorted(
            p for p in tracked if p not in listed and _orphan(p, dirs, exts))
        if exts is None:
            notes.append(f"{EXTENSION_REGISTRY}: unreadable — committed "
                         f"/speckit-* skills no manifest lists are not checked")
        if orphans:
            notes.append(f"{len(orphans)} committed /speckit-* skill file(s) "
                         f"no manifest lists: {_listed(orphans)} — renamed or "
                         f"removed upstream; `git rm` them (Spec Kit upgrades)")
    back = [p for p in dropped
            if (root / p).is_file() or (tracked and p in tracked)]
    if back:
        notes.append(f"{len(back)} deliberately removed /speckit-* skill "
                     f"file(s) present: {_listed(back)} — Setup removes "
                     f"constitution, implement and taskstoissues; delete them "
                     f"(`git rm` if committed)")
    return notes


def check(root: Path) -> tuple[list[str], list[str]]:
    hard: list[str] = []
    soft: list[str] = []

    spec_dir = root / ".specify"
    if not spec_dir.is_dir():
        return [], [f"no .specify/ yet — run the pinned `specify init` step "
                    f"(BOOTSTRAP, Spec Kit setup); the speckit gate has nothing "
                    f"to verify until then"]

    cf = root / CONSTITUTION
    if not cf.is_file():
        hard.append(f"{CONSTITUTION}: missing — the rendered pointer file was "
                    f"removed; restore it (it routes every /speckit-* phase to "
                    f"the gated methodology)")
    elif POINTER_MARK not in cf.read_text(encoding="utf-8", errors="replace"):
        hard.append(f"{CONSTITUTION}: pointer marker missing — running "
                    f"/speckit-constitution (or hand-editing) replaced the "
                    f"pointer with a second truth beside the gated one; "
                    f"restore the pointer file (git checkout -- {CONSTITUTION})")

    try:
        skill = _skill_notes(root)
    except Exception as exc:  # noqa: BLE001 — the skill check is soft by contract
        # (#363 AC-3): odd manifest data must never turn into a block or a crash
        skill = [f"/speckit-* skill check failed ({type(exc).__name__}: "
                 f"{exc}) — whether the skills are committed is unverified"]
    # manifest paths may carry lone surrogates (json.dump of a non-UTF-8 name):
    # escape them here, so printing a note can never raise
    soft += [n.encode("utf-8", "backslashreplace").decode("utf-8") for n in skill]

    sdir = root / SPECS_DIR
    if sdir.is_dir():
        for tasks in sorted(sdir.glob("*/tasks.md")):
            rel = tasks.relative_to(root)
            text = tasks.read_text(encoding="utf-8", errors="replace")
            for phase in _story_phases_without_tests(text):
                hard.append(f"{rel}: {phase!r} has no task that references a "
                            f"test — tests prove acceptance (mandatory rule 5); "
                            f"one task per behaviour names its test file and "
                            f"runs red → green inside the task (write the "
                            f"test, watch it fail, implement, watch it pass)")
            open_tasks = len(re.findall(r"^\s*- \[ \] ", text, re.MULTILINE))
            if open_tasks:
                soft.append(f"{rel}: {open_tasks} unchecked task(s) — the "
                            f"deterministic completeness signal for the review "
                            f"(done means every box ticked or the gap named)")

        # --- the Owner brief is the influence window's readability layer:
        # a spec the owner cannot understand has no working window. Soft —
        # the template mandates it, the note catches the forgotten ones ---
        for spec in sorted(sdir.glob("*/spec.md")):
            stext = spec.read_text(encoding="utf-8", errors="replace")
            if not re.search(r"^#{1,6}\s+Owner brief\b", stext,
                             re.IGNORECASE | re.MULTILINE):
                soft.append(f"{spec.relative_to(root)}: no 'Owner brief' "
                            f"section — five plain-language sentences, first "
                            f"(spec-template); the owner steers from this "
                            f"block or not at all")

    # --- spec-before-plan: an active Tier 2+ plan either points at its spec
    # or names why it has none (spec-waived:) — never silently spec-free ---
    pdir = root / PLANS_ACTIVE
    if pdir.is_dir():
        for p in sorted(pdir.glob("*.md")):
            if p.name.startswith("design-"):
                continue
            text = _unfenced(p.read_text(encoding="utf-8", errors="replace"))
            tier = plan_tier(text)
            if tier is None or tier < 2:
                continue
            if SPEC_REF.search(text) or SPEC_WAIVED.search(text):
                soft += waiver_debt_notes(f"{PLANS_ACTIVE}/{p.name}", text,
                                          SPEC_WAIVED, "spec-waived")
                continue
            hard.append(
                f"{PLANS_ACTIVE}/{p.name}: tier {tier} plan references no "
                f"specs/ directory and carries no 'spec-waived: <reason>' line — "
                f"the spec interrogation (/speckit-specify + clarify) comes "
                f"before planning; run it, or record why it does not apply")
    return hard, soft


def main() -> int:
    root = Path(sys.argv[1] if len(sys.argv) > 1 else ".").resolve()
    if not root.is_dir():
        print(f"speckit: FAILED:\n  - root {root} is not a directory")
        return 1
    hard, soft = check(root)
    for note in soft:
        print(f"speckit: note: {note}")
    if hard:
        print("speckit: FAILED:")
        for h in hard:
            print(f"  - {h}")
        return 1
    print("speckit: OK")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
