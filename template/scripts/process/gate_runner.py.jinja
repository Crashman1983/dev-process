#!/usr/bin/env python3
# /// script
# requires-python = ">=3.11"
# dependencies = ["pyyaml>=6,<7"]
# ///
"""Manifest-aware gate runner. Reads .copier-answers.yml and runs only the
gates whose module is active. Language-agnostic; each gate is a subprocess.

The manifest is load-bearing: a missing or malformed .copier-answers.yml is a
hard failure, never an empty gate list — otherwise enforcement can disappear
silently while reporting green."""
from __future__ import annotations

import os
import re
import subprocess
import sys
from pathlib import Path

GATE_TIMEOUT_S = 600  # a wedged gate (e.g. pathological regex) must fail, not hang CI

try:
    import yaml
except ImportError:
    print("gate-runner: PyYAML is required — pip install 'PyYAML>=6'", file=sys.stderr)
    raise SystemExit(1)

# gate_invoke owns "how is a declaring script launched" and "can the
# registered hooks run at all" — one owner instead of a copy per caller.
# The sibling import must not drop a __pycache__ into the tree it judges.
sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parent))  # sibling import
from gate_invoke import child_argv, hook_wiring_findings  # noqa: E402

# gate-name -> (module answer key, command relative to repo root).
# A module key of None marks a *core* gate: it ships in core and always runs,
# regardless of the manifest. Core gates guard artifacts that are themselves
# core (e.g. docs/process/adr/), so their enforcement must not hinge on an
# optional module being enabled.
GATES = {
    "kernel": (None, [sys.executable, "scripts/process/check_kernel.py", "."]),
    "decision-records": (None, [sys.executable, "scripts/process/check_decisions.py", "."]),
    "review": (None, [sys.executable, "scripts/process/check_review.py", "."]),
    "clarification": (None, [sys.executable, "scripts/process/check_clarification.py", "."]),
    "product-frame": (None, [sys.executable, "scripts/process/check_product_frame.py", "."]),
    "speckit": ("speckit", [sys.executable, "scripts/process/check_speckit.py", "."]),
    "doc-drift-gate": ("doc_drift_gate", [sys.executable, "scripts/process/check_doc_drift.py", "."]),
    "arch-onboarding": ("arch_onboarding", [sys.executable, "scripts/process/check_architecture.py", "."]),
    "feature-registry": ("feature_registry", [sys.executable, "scripts/process/check_feature_registry.py", "."]),
    "github-issues": ("github_issues", [sys.executable, "scripts/process/check_issues.py", "."]),
    "contracts-drift": ("contracts", [sys.executable, "scripts/process/check_contracts.py", "."]),
    "contract-first": ("contracts", [sys.executable, "scripts/process/check_capability_contracts.py", "."]),
    "security-floor": ("security_floor", [sys.executable, "scripts/process/check_security_floor.py", "."]),
    "sbom": ("sbom", [sys.executable, "scripts/process/check_sbom.py", "."]),
    "telemetry": ("telemetry", [sys.executable, "scripts/process/check_telemetry.py", "."]),
    "arch-docs": ("arch_docs", [sys.executable, "scripts/process/check_arch_docs.py", "."]),
    "github-master": ("github_master", [sys.executable, "scripts/process/check_github_master.py", "."]),
}
KNOWN_MODULES = {key for key, _command in GATES.values() if key is not None} | {"git_hooks"}
KNOWN_HARNESSES = {"claude", "copilot", "agents_md"}


def _validate_boolean_mapping(
    answers: dict, field: str, known_keys: set[str], label: str, *, required: bool = False
) -> dict:
    if required and field not in answers:
        print(f"gate-runner: manifest has no '{field}' mapping", file=sys.stderr)
        raise SystemExit(1)
    values = answers.get(field, {})
    if not isinstance(values, dict):
        print(f"gate-runner: '{field}' must be a mapping", file=sys.stderr)
        raise SystemExit(1)
    unknown = sorted(set(values) - known_keys)
    if unknown:
        print(f"gate-runner: unknown {label} key(s): {', '.join(unknown)}", file=sys.stderr)
        raise SystemExit(1)
    invalid = sorted(key for key, value in values.items() if not isinstance(value, bool))
    if invalid:
        print(
            f"gate-runner: {label} values must be booleans: {', '.join(invalid)}",
            file=sys.stderr,
        )
        raise SystemExit(1)
    return values


def load_modules(root: Path) -> dict:
    """The manifest's modules mapping; raises SystemExit with a diagnostic
    on anything that would otherwise silently disable enforcement."""
    f = root / ".copier-answers.yml"
    try:
        answers = yaml.safe_load(f.read_text(encoding="utf-8"))
    except (yaml.YAMLError, UnicodeDecodeError) as exc:
        print(f"gate-runner: unparseable {f}: {exc}", file=sys.stderr)
        raise SystemExit(1)
    if not isinstance(answers, dict):
        print(
            f"gate-runner: {f} must contain a top-level mapping — manifest corrupt",
            file=sys.stderr,
        )
        raise SystemExit(1)
    mods = _validate_boolean_mapping(
        answers, "modules", KNOWN_MODULES, "module", required=True
    )
    _validate_boolean_mapping(answers, "harnesses", KNOWN_HARNESSES, "harness")
    return mods


# --- note ledger: a note is printed when it is NEW, not on every run -------
# Every gate run's stdout lands in an agent's context. The notes are stable
# across runs by design (pre-adoption states, placeholder sections, known
# freshness caveats), so re-printing them costs tokens on every push and
# buries the one note that changed. The ledger remembers the notes of the
# last run in .git/ (never in the tree) and prints only what is new; the
# count of suppressed known notes is always shown, `--all-notes` shows them.
# A fresh checkout (CI) has no ledger and prints everything — CI is the
# authority and must not inherit a local silence.
_NOTE_LINE = re.compile(r"^\S+: note: ")
LEDGER_NAME = "process-notes-ledger"
# A gate that stays red becomes wallpaper: observed downstream, a hard
# integrity failure was reported on every run for months and nobody read it
# any more — the evidence behind it turned out fabricated. The runner remembers
# the first day each gate went red (in .git/, never the tree) and prints the
# age with every failure; the owner digest shows the same numbers.
RED_LEDGER_NAME = "process-red-ledger"


def _red_ledger_path(root: Path) -> Path | None:
    p = _ledger_path(root)
    return p.with_name(RED_LEDGER_NAME) if p else None


def _read_red(path: Path | None) -> dict[str, str]:
    if path is None or not path.is_file():
        return {}
    out: dict[str, str] = {}
    try:
        for ln in path.read_text(encoding="utf-8").splitlines():
            if " " in ln:
                gate, day = ln.split(" ", 1)
                out[gate] = day.strip()
    except OSError:
        pass
    return out


def _write_red(path: Path | None, red: dict[str, str]) -> None:
    if path is None:
        return
    try:
        path.write_text("".join(f"{g} {d}\n" for g, d in sorted(red.items())),
                        encoding="utf-8")
    except OSError:
        pass


def _red_age(red: dict[str, str], gate: str, today: str) -> str:
    since = red.get(gate)
    if not since or since == today:
        return ""
    try:
        import datetime as _dt
        days = (_dt.date.fromisoformat(today) - _dt.date.fromisoformat(since)).days
    except ValueError:
        return ""
    return f" (red since {since}, {days} day(s))"


def _ledger_path(root: Path) -> Path | None:
    try:
        proc = subprocess.run(["git", "-C", str(root), "rev-parse", "--git-dir"],
                              capture_output=True, text=True, timeout=30)
    except (OSError, subprocess.TimeoutExpired):
        return None
    if proc.returncode != 0:
        return None
    gitdir = Path(proc.stdout.strip())
    if not gitdir.is_absolute():
        gitdir = root / gitdir
    return gitdir / LEDGER_NAME


def _read_ledger(path: Path | None) -> set[str]:
    if path is None or not path.is_file():
        return set()
    try:
        return {ln for ln in path.read_text(encoding="utf-8").splitlines() if ln}
    except OSError:
        return set()


def _write_ledger(path: Path | None, notes: set[str]) -> None:
    if path is None:
        return
    try:
        path.write_text("\n".join(sorted(notes)) + ("\n" if notes else ""),
                        encoding="utf-8")
    except OSError:
        pass  # a ledger that cannot be written just means notes print again


def _emit(output: str, known: set[str], seen: set[str], show_all: bool) -> int:
    """Print a gate's output, holding back notes already in the ledger.
    Returns the number of suppressed notes."""
    suppressed = 0
    for line in output.splitlines():
        if _NOTE_LINE.match(line):
            seen.add(line)
            if line in known and not show_all:
                suppressed += 1
                continue
        print(line)
    return suppressed


def main() -> int:
    root = Path(__file__).resolve().parents[2]
    if not (root / ".copier-answers.yml").is_file():
        print(
            f"gate-runner: no .copier-answers.yml found at rendered repo root {root}; "
            "enforcement cannot be verified",
            file=sys.stderr,
        )
        return 1
    mods = load_modules(root)
    # core gates (key is None) always run; module gates run when their key is on
    active = [name for name, (key, _cmd) in GATES.items() if key is None or mods.get(key)]
    if "--list" in sys.argv:
        for g in active:
            print(g)
        return 0
    warn = "--warn" in sys.argv
    show_all = "--all-notes" in sys.argv
    failed = []
    ledger = _ledger_path(root)
    known = _read_ledger(ledger)
    seen: set[str] = set()
    suppressed = 0
    # a registered hook that cannot run is a missing check reported as passed
    # — the loudest thing here, before any gate result
    hook_hard, hook_soft = hook_wiring_findings(root)
    suppressed += _emit("".join(f"gate-runner: note: {n}\n" for n in hook_soft),
                        known, seen, show_all)
    if hook_hard:
        for finding in hook_hard:
            print(f"gate-runner: hook-wiring: {finding}", file=sys.stderr)
        failed.append("hook-wiring")
    # don't litter the repo with __pycache__ from the gates' sibling imports
    env = {**os.environ, "PYTHONDONTWRITEBYTECODE": "1"}
    for name in active:
        _key, cmd = GATES[name]
        script = root / cmd[1]
        if not script.is_file():
            # a module enabled in the manifest whose gate script is missing is
            # almost always a hand-edited .copier-answers.yml (copier then never
            # renders the module) — name the cause, not just the missing file
            print(f"gate-runner: {name} is enabled in the manifest but "
                  f"{cmd[1]} is missing — if .copier-answers.yml was edited by "
                  f"hand, revert it and enable the module via `copier update "
                  f"--data` instead (see BOOTSTRAP 'Later')", file=sys.stderr)
            failed.append(name)
            continue
        print(f"== running {name} ==")
        try:
            # a child that declares its own dependencies (PEP 723) runs through
            # the launcher that resolves them, not this runner's interpreter.
            # Output is captured so known notes can be held back (ledger).
            proc = subprocess.run(child_argv(root, cmd), cwd=root, env=env,
                                  timeout=GATE_TIMEOUT_S, capture_output=True,
                                  text=True, encoding="utf-8", errors="replace")
            rc = proc.returncode
            suppressed += _emit(proc.stdout, known, seen, show_all)
            if proc.stderr:
                print(proc.stderr, end="" if proc.stderr.endswith("\n") else "\n",
                      file=sys.stderr)
        except subprocess.TimeoutExpired:
            print(f"gate-runner: {name} exceeded {GATE_TIMEOUT_S}s and was killed "
                  f"— a hanging gate is a failure, not a wait", file=sys.stderr)
            rc = 1
        if rc != 0:
            failed.append(name)
    _write_ledger(ledger, seen)
    if suppressed:
        print(f"gate-runner: {suppressed} known note(s) unchanged since the last "
              f"run — not repeated (--all-notes shows them)")
    import datetime as _dt
    today = _dt.date.today().isoformat()
    red_path = _red_ledger_path(root)
    red = _read_red(red_path)
    for name in list(red):
        if name not in failed:
            del red[name]  # green again: the clock stops
    for name in failed:
        red.setdefault(name, today)
    _write_red(red_path, red)
    if failed:
        if warn:
            print(f"gate warnings (not blocking): {', '.join(failed)}")
            return 0
        aged = [f"{n}{_red_age(red, n, today)}" for n in failed]
        print(f"FAILED gates: {', '.join(aged)}")
        if any(_red_age(red, n, today) for n in failed):
            print("gate-runner: a gate red for days is wallpaper — nobody reads it, "
                  "and the finding behind it stops being true or false. Fix it, or "
                  "waive it with a named owner, today.")
        return 1
    print(f"all {len(active)} active gate(s) passed")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
