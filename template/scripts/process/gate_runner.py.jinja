#!/usr/bin/env python3
# /// script
# requires-python = ">=3.11"
# dependencies = ["pyyaml>=6,<7"]
# ///
"""Manifest-aware gate runner. Reads .copier-answers.yml and runs only the
gates whose module is active. Language-agnostic; each gate is a subprocess.

The manifest is load-bearing: a missing or malformed .copier-answers.yml is a
hard failure, never an empty gate list — otherwise enforcement can disappear
silently while reporting green."""
from __future__ import annotations

import os
import re
import subprocess
import sys
import time
from pathlib import Path

GATE_TIMEOUT_S = 600  # a wedged gate (e.g. pathological regex) must fail, not hang CI

try:
    import yaml
except ImportError:
    print("gate-runner: PyYAML is required — pip install 'PyYAML>=6'", file=sys.stderr)
    raise SystemExit(1)

# gate_invoke owns "how is a declaring script launched" and "can the
# registered hooks run at all" — one owner instead of a copy per caller.
# The sibling import must not drop a __pycache__ into the tree it judges.
sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parent))  # sibling import
try:  # the one owner of a gate's mode (block, shadow, sampled, off); without it every gate blocks
    import gate_modes  # noqa: E402
except Exception as _exc:  # noqa: BLE001
    gate_modes = None
    _GATE_MODES_ERROR = f"gate_modes unavailable ({_exc}) — every gate blocks"
from gate_invoke import child_argv, hook_wiring_findings  # noqa: E402
from process_git import path_matches, pushed_commit_problem  # noqa: E402

# gate-name -> (module answer key, command relative to repo root).
# A module key of None marks a *core* gate: it ships in core and always runs,
# regardless of the manifest. Core gates guard artifacts that are themselves
# core (e.g. docs/process/adr/), so their enforcement must not hinge on an
# optional module being enabled.
GATES = {
    "kernel": (None, [sys.executable, "scripts/process/check_kernel.py", "."]),
    "decision-records": (None, [sys.executable, "scripts/process/check_decisions.py", "."]),
    "review": (None, [sys.executable, "scripts/process/check_review.py", "."]),
    "clarification": (None, [sys.executable, "scripts/process/check_clarification.py", "."]),
    "product-frame": (None, [sys.executable, "scripts/process/check_product_frame.py", "."]),
    "speckit": ("speckit", [sys.executable, "scripts/process/check_speckit.py", "."]),
    "doc-drift-gate": ("doc_drift_gate", [sys.executable, "scripts/process/check_doc_drift.py", "."]),
    "arch-onboarding": ("arch_onboarding", [sys.executable, "scripts/process/check_architecture.py", "."]),
    "feature-registry": ("feature_registry", [sys.executable, "scripts/process/check_feature_registry.py", "."]),
    "github-issues": ("github_issues", [sys.executable, "scripts/process/check_issues.py", "."]),
    "sbom": ("sbom", [sys.executable, "scripts/process/check_sbom.py", "."]),
    "design-contracts": ("design_contracts", [sys.executable, "scripts/process/check_design_contracts.py", "."]),
}
# modules without a gate of their own: git_hooks installs hooks, telemetry
# ships the read-only KPI cockpit (its GRADE gate is retired)
KNOWN_MODULES = ({key for key, _command in GATES.values() if key is not None}
                 | {"git_hooks", "telemetry"})
# modules the template no longer ships (v2.27.0 KISS pass): an older manifest
# may still name them — accepted, never run
RETIRED_MODULES = {"contracts", "security_floor", "arch_docs", "github_master"}
KNOWN_HARNESSES = {"claude", "copilot", "agents_md"}
# a project's own gates, without owning this runner: {name: {"module": key or null,
# "command": ["path/in/repo.py", args...]} or "exec": [argv as given, e.g. "make",
# "lint"], optional "paths": [globs]}} — added to GATES, or replacing one by name.
# With `paths` the gate runs only when a path in flight matches (`process_git`'s
# glob); when git cannot tell which paths are in flight, it runs.
LOCAL_GATES = "docs/process/gates.local.json"


def _local_refused(why: str) -> SystemExit:
    print(f"gate-runner: {LOCAL_GATES}: {why} — fix the file; a broken list must not "
          f"read as 'no local gates'", file=sys.stderr)
    return SystemExit(1)


def with_local_gates(root: Path) -> tuple[dict, dict]:
    """(GATES with the project's gates merged in, the local entries as
    {name: {"exec": bool, "paths": [globs] or None}}). Load-bearing like the
    manifest: anything malformed is a hard failure."""
    import json

    f = root / LOCAL_GATES
    if not f.is_file():
        return dict(GATES), {}
    try:
        data = json.loads(f.read_text(encoding="utf-8"))
    except (ValueError, UnicodeDecodeError) as exc:
        raise _local_refused(f"unparseable ({exc})")
    if not isinstance(data, dict):
        raise _local_refused("must be a mapping {name: {module, command or exec}}")
    gates, local = {}, {}
    for name, entry in data.items():
        if (not isinstance(entry, dict) or "module" not in entry
                or ("command" in entry) == ("exec" in entry)):
            raise _local_refused(f"{name}: needs 'module' (a module key or null) and one of "
                                 f"'command' or 'exec'")
        unknown = sorted(set(entry) - {"module", "command", "exec", "paths"})
        if unknown:
            raise _local_refused(f"{name}: unknown key(s) {', '.join(unknown)}")
        key, field = entry["module"], "exec" if "exec" in entry else "command"
        cmd = entry[field]
        if key is not None and key not in KNOWN_MODULES:
            raise _local_refused(f"{name}: unknown module {key!r}")
        if not isinstance(cmd, list) or not cmd or not all(isinstance(a, str) and a for a in cmd):
            raise _local_refused(f"{name}: '{field}' must be a non-empty list of strings")
        if field == "command":
            script = Path(cmd[0])
            if script.is_absolute() or ".." in script.parts:
                raise _local_refused(f"{name}: {cmd[0]} must be a path inside the repository")
        paths = entry.get("paths")
        if paths is not None and not (isinstance(paths, list) and paths
                                      and all(isinstance(g, str) and g for g in paths)):
            raise _local_refused(f"{name}: 'paths' must be a non-empty list of globs")
        if name in GATES and GATES[name][0] is None:
            # a core gate guards what every project has (the review record, the
            # kernel); a branch's own file replaced `review` with a script that
            # exits 0 and pushed past a standing block (refutation)
            raise _local_refused(f"{name} is a core gate — it cannot be replaced or moved "
                                 f"into a module; add the project's check under its own name")
        gates[name] = (key, list(cmd) if field == "exec" else [sys.executable, *cmd])
        local[name] = {"exec": field == "exec", "paths": paths}
    return {**GATES, **gates}, local


def _untouched(root: Path, globs: list[str], memo: dict) -> bool:
    """True when git names the paths in flight and none matches `globs`; a
    path set git cannot tell runs the gate (fail closed)."""
    if "paths" not in memo:
        from check_review import paths_in_flight  # noqa: PLC0415

        try:
            # both sides of a rename: a file moved out of `backend/` changed `backend/`
            memo["paths"] = paths_in_flight(root, no_renames=True)
        except Exception:  # noqa: BLE001 — an unreadable diff runs the gate
            memo["paths"] = None
    changed = memo["paths"]
    return changed is not None and not any(path_matches(g, p) for g in globs for p in changed)


def _validate_boolean_mapping(
    answers: dict, field: str, known_keys: set[str], label: str, *, required: bool = False
) -> dict:
    if required and field not in answers:
        print(f"gate-runner: manifest has no '{field}' mapping", file=sys.stderr)
        raise SystemExit(1)
    values = answers.get(field, {})
    if not isinstance(values, dict):
        print(f"gate-runner: '{field}' must be a mapping", file=sys.stderr)
        raise SystemExit(1)
    unknown = sorted(set(values) - known_keys)
    if unknown:
        print(f"gate-runner: unknown {label} key(s): {', '.join(unknown)}", file=sys.stderr)
        raise SystemExit(1)
    invalid = sorted(key for key, value in values.items() if not isinstance(value, bool))
    if invalid:
        print(
            f"gate-runner: {label} values must be booleans: {', '.join(invalid)}",
            file=sys.stderr,
        )
        raise SystemExit(1)
    return values


def load_modules(root: Path) -> dict:
    """The manifest's modules mapping; raises SystemExit with a diagnostic
    on anything that would otherwise silently disable enforcement."""
    f = root / ".copier-answers.yml"
    try:
        answers = yaml.safe_load(f.read_text(encoding="utf-8"))
    except (yaml.YAMLError, UnicodeDecodeError) as exc:
        print(f"gate-runner: unparseable {f}: {exc}", file=sys.stderr)
        raise SystemExit(1)
    if not isinstance(answers, dict):
        print(
            f"gate-runner: {f} must contain a top-level mapping — manifest corrupt",
            file=sys.stderr,
        )
        raise SystemExit(1)
    mods = _validate_boolean_mapping(
        answers, "modules", KNOWN_MODULES | RETIRED_MODULES, "module", required=True
    )
    mods = {k: v for k, v in mods.items() if k not in RETIRED_MODULES}
    _validate_boolean_mapping(answers, "harnesses", KNOWN_HARNESSES, "harness")
    return mods


# --- note ledger: a note is printed when it is NEW, not on every run -------
# Every gate run's stdout lands in an agent's context. The notes are stable
# across runs by design (pre-adoption states, placeholder sections, known
# freshness caveats), so re-printing them costs tokens on every push and
# buries the one note that changed. The ledger remembers the notes of the
# last run in .git/ (never in the tree) and prints only what is new; the
# count of suppressed known notes is always shown, `--all-notes` shows them.
# A fresh checkout (CI) has no ledger and prints everything — CI is the
# authority and must not inherit a local silence.
_NOTE_LINE = re.compile(r"^\S+: note: ")
LEDGER_NAME = "process-notes-ledger"
# A gate that stays red becomes wallpaper: observed downstream, a hard
# integrity failure was reported on every run for months and nobody read it
# any more — the evidence behind it turned out fabricated. The runner remembers
# the first day each gate went red (in .git/, never the tree) and prints the
# age with every failure; the owner digest shows the same numbers.
RED_LEDGER_NAME = "process-red-ledger"


def _red_ledger_path(root: Path) -> Path | None:
    p = _ledger_path(root)
    return p.with_name(RED_LEDGER_NAME) if p else None


def _read_red_entries(path: Path | None) -> dict[str, tuple[str, str]]:
    """gate -> (first red day, reason). A line is `<gate> <day>` or
    `<gate> <day> <reason>`; the older form reads with an empty reason."""
    if path is None or not path.is_file():
        return {}
    out: dict[str, tuple[str, str]] = {}
    try:
        for ln in path.read_text(encoding="utf-8").splitlines():
            if " " in ln:
                gate, rest = ln.split(" ", 1)
                day, _sep, reason = rest.strip().partition(" ")
                out[gate] = (day, reason.strip())
    except OSError:
        pass
    return out


def _read_red(path: Path | None) -> dict[str, str]:
    return {gate: day for gate, (day, _reason) in _read_red_entries(path).items()}


def _write_red(path: Path | None, red: dict[str, str],
               reasons: dict[str, str] | None = None) -> None:
    if path is None:
        return
    reasons = reasons or {}

    def line(gate: str, day: str) -> str:
        reason = " ".join(reasons.get(gate, "").split())  # one line, single spaces
        return f"{gate} {day}{' ' + reason if reason else ''}\n"

    try:
        path.write_text("".join(line(g, d) for g, d in sorted(red.items())),
                        encoding="utf-8")
    except OSError:
        pass


def _red_age(red: dict[str, str], gate: str, today: str) -> str:
    since = red.get(gate)
    if not since or since == today:
        return ""
    try:
        import datetime as _dt
        days = (_dt.date.fromisoformat(today) - _dt.date.fromisoformat(since)).days
    except ValueError:
        return ""
    return f" (red since {since}, {days} day(s))"


PHASE_MARK = "gate-phase:"  # `<name> start|done <monotonic seconds>` on a gate's stderr


def _phase_marks(stderr: str | bytes | None) -> list[tuple[str, str, float]]:
    """The phase lines a gate wrote. `TimeoutExpired.stderr` is bytes even
    when the run was in text mode, so both are read."""
    if stderr is None:
        return []
    text = stderr.decode("utf-8", errors="replace") if isinstance(stderr, bytes) else stderr
    marks: list[tuple[str, str, float]] = []
    for ln in text.splitlines():
        fields = ln.split()
        if len(fields) == 4 and fields[0] == PHASE_MARK and fields[2] in ("start", "done"):
            try:
                marks.append((fields[1], fields[2], float(fields[3])))
            except ValueError:
                continue
    return marks


def timeout_reason(stderr: str | bytes | None, now: float) -> str:
    """Why a killed gate was slow: the phase running at the kill and the
    longest one that finished. A killed gate reached no verdict either way.
    `now` is the runner's `time.monotonic()`, the clock the child shares.
    Empty when the gate reported no phases."""
    started: dict[str, float] = {}
    finished: dict[str, float] = {}
    running: str | None = None
    for name, kind, at in _phase_marks(stderr):
        if kind == "start":
            started[name], running = at, name
        elif name in started:
            finished[name] = max(finished.get(name, 0.0), at - started[name])
            running = None if running == name else running
    if running is None and not finished:
        return ""
    parts = []
    if running is not None:
        parts.append(f"killed during phase `{running}` ({max(now - started[running], 0):.0f} s in)")
    if finished:
        slow, took = max(finished.items(), key=lambda kv: kv[1])
        parts.append(f"longest finished phase `{slow}` {took:.0f} s")
    return "; ".join(parts) + " — the gate reached no verdict"


def _ledger_path(root: Path) -> Path | None:
    try:
        proc = subprocess.run(["git", "-C", str(root), "rev-parse", "--git-dir"],
                              capture_output=True, text=True, timeout=30)
    except (OSError, subprocess.TimeoutExpired):
        return None
    if proc.returncode != 0:
        return None
    gitdir = Path(proc.stdout.strip())
    if not gitdir.is_absolute():
        gitdir = root / gitdir
    return gitdir / LEDGER_NAME


def _read_ledger(path: Path | None) -> set[str]:
    if path is None or not path.is_file():
        return set()
    try:
        return {ln for ln in path.read_text(encoding="utf-8").splitlines() if ln}
    except OSError:
        return set()


def _write_ledger(path: Path | None, notes: set[str]) -> None:
    if path is None:
        return
    try:
        path.write_text("\n".join(sorted(notes)) + ("\n" if notes else ""),
                        encoding="utf-8")
    except OSError:
        pass  # a ledger that cannot be written just means notes print again


# Every gate run leaves one line in the common git dir (shared by all
# worktrees, never the tree): what it cost and what it found. `process_kpis.py
# nodes` reads it to weigh each gate's cost against its catches
# (docs/process/optimization.md, "The process as a check graph"). An
# observation, not a duty: a log that cannot be written changes no verdict.
EVENTS_NAME = "process-gate-events.jsonl"
_EVENTS_MAX_BYTES = 5_000_000  # then the log rolls over to .1 (one generation kept)


def _git_out(root: Path, *args: str) -> str | None:
    try:
        proc = subprocess.run(["git", "-C", str(root), *args], capture_output=True, text=True,
                              encoding="utf-8", errors="replace", timeout=30)
    except (OSError, subprocess.TimeoutExpired):
        return None
    return proc.stdout.strip() if proc.returncode == 0 else None


def _events_path(root: Path) -> Path | None:
    common = _git_out(root, "rev-parse", "--git-common-dir")
    if not common:
        return None
    path = Path(common)
    return (path if path.is_absolute() else root / path) / EVENTS_NAME


def _run_context(root: Path, pushed: str) -> dict:
    """What this run checked: the commit, whether the tree held more than it
    (the gates read the working tree), the branch, and where it ran."""
    head = _git_out(root, "rev-parse", "HEAD")
    # untracked files count: a gate scans them, and no commit names them
    status = _git_out(root, "status", "--porcelain", "--untracked-files=normal") if head else None
    dirty = None if status is None else bool(status)
    branch = _git_out(root, "rev-parse", "--abbrev-ref", "HEAD")
    return {"head": head, "dirty": dirty, "pushed": pushed or None,
            "branch": None if branch in (None, "HEAD") else branch,
            "ci": bool(os.environ.get("CI"))}


def _record_event(path: Path | None, context: dict, gate: str, *, mode: str,
                  outcome: str, rc: int | None, duration_s: float,
                  reason: str | None = None) -> None:
    if path is None:
        return
    import datetime as _dt  # noqa: PLC0415
    import json  # noqa: PLC0415

    row = {"ts": _dt.datetime.now(_dt.timezone.utc).isoformat(timespec="milliseconds"),
           "gate": gate, "mode": mode, "outcome": outcome, "rc": rc,
           "duration_s": round(duration_s, 3), "reason": reason, **context}
    try:
        if path.is_file() and path.stat().st_size > _EVENTS_MAX_BYTES:
            os.replace(path, path.with_name(path.name + ".1"))
        with path.open("a", encoding="utf-8") as fh:
            fh.write(json.dumps(row) + "\n")
    except Exception:  # noqa: BLE001 — an unwritable log loses an observation, never a verdict
        pass


def _emit(output: str, known: set[str], seen: set[str], show_all: bool) -> int:
    """Print a gate's output, holding back notes already in the ledger.
    Returns the number of suppressed notes."""
    suppressed = 0
    for line in output.splitlines():
        if _NOTE_LINE.match(line):
            seen.add(line)
            if line in known and not show_all:
                suppressed += 1
                continue
        print(line)
    return suppressed


def main() -> int:
    root = Path(__file__).resolve().parents[2]
    if not (root / ".copier-answers.yml").is_file():
        print(
            f"gate-runner: no .copier-answers.yml found at rendered repo root {root}; "
            "enforcement cannot be verified",
            file=sys.stderr,
        )
        return 1
    if "--unless-frame-ran" in sys.argv:
        # pre-commit's own pre-push entry: the frame (`pre_push.py`, reached
        # through the installed guard) already ran these gates for this ref
        import merge_route  # noqa: PLC0415

        if merge_route.frame_ran_gates(root, dict(os.environ)):
            print("gate-runner: the pre-push frame ran the gates for this push — not again",
                  file=sys.stderr)
            return 0
    mods = load_modules(root)
    gates, local = with_local_gates(root)
    # core gates (key is None) always run; module gates run when their key is on
    active = [name for name, (key, _cmd) in gates.items() if key is None or mods.get(key)]
    if "--list" in sys.argv:
        for g in active:
            print(g)
        return 0
    warn = "--warn" in sys.argv
    show_all = "--all-notes" in sys.argv
    failed = []
    reasons: dict[str, str] = {}  # why a gate failed, where this run knows
    ledger = _ledger_path(root)
    known = _read_ledger(ledger)
    seen: set[str] = set()
    suppressed = 0
    # a registered hook that cannot run is a missing check reported as passed
    # — the loudest thing here, before any gate result
    hook_hard, hook_soft = hook_wiring_findings(root)
    suppressed += _emit("".join(f"gate-runner: note: {n}\n" for n in hook_soft),
                        known, seen, show_all)
    if hook_hard:
        for finding in hook_hard:
            print(f"gate-runner: hook-wiring: {finding}", file=sys.stderr)
        failed.append("hook-wiring")
    # the gates check the WORKING TREE. In a pre-push run the pushed commit must
    # be that tree, or the verdict describes something nobody pushes (observed
    # downstream: a shared checkout stood on another agent's branch while main
    # was pushed, and the hook passed a tree it never saw). pre-commit names the
    # pushed commit in PRE_COMMIT_TO_REF; a manual run has no such variable.
    pushed = os.environ.get("PRE_COMMIT_TO_REF", "").strip()
    problem = pushed_commit_problem(root, pushed) if pushed else None
    if problem:
        print(f"gate-runner: {problem}", file=sys.stderr)
        failed.append("pushed-tree")
    # Child output is decoded as UTF-8 below, including on Windows. Keep
    # that protocol independent of the runner's own console encoding.
    # Don't litter the repo with __pycache__ from the gates' sibling imports.
    env = {**os.environ, "PYTHONDONTWRITEBYTECODE": "1", "PYTHONIOENCODING": "utf-8"}
    for name in sorted(set(local) & set(GATES)):
        # stderr: pre-commit shows a passing hook's stdout to nobody
        print(f"gate-runner: {LOCAL_GATES} replaces the template's {name} gate", file=sys.stderr)
    in_flight: dict = {}
    try:  # the log observes; nothing in it may stop a gate from running
        events = _events_path(root)
        context = _run_context(root, pushed) if events is not None else {}
    except Exception:  # noqa: BLE001
        events, context = None, {}
    # a gate's mode comes from the change record alone; core gates always block,
    # and anything unreadable leaves every gate blocking (gate_modes.py)
    try:
        if gate_modes is None:
            raise RuntimeError(_GATE_MODES_ERROR)
        modes, mode_problems = gate_modes.effective(
            root, {n for n, (key, _cmd) in GATES.items() if key is None})
    except Exception as exc:  # noqa: BLE001
        modes, mode_problems = {}, [f"gate modes unreadable ({exc}) — every gate blocks"]
    suppressed += _emit("".join(f"gate-runner: note: {p}\n" for p in mode_problems), known, seen, show_all)
    for name in active:
        _key, cmd = gates[name]
        spec = local.get(name, {})
        node = modes.get(name, {})
        node_mode = node.get("mode", "block")
        mode = node_mode if node_mode != "block" else ("warn" if warn else "block")
        if node_mode == "off":
            print(f"== {name}: off ({node.get('record')}) — not run ==")
            _record_event(events, context, name, mode=mode, outcome="off", rc=None, duration_s=0.0)
            continue
        if node_mode == "sampled" and not gate_modes.sampled_in(name, context.get("head"), node["rate"]):
            print(f"== {name}: sampled at {node['rate']:.0%} — not this commit ==")
            _record_event(events, context, name, mode=mode, outcome="unsampled", rc=None, duration_s=0.0)
            continue
        if spec.get("paths") and _untouched(root, spec["paths"], in_flight):
            print(f"== {name}: no path in flight matches {', '.join(spec['paths'])} — not run ==")
            _record_event(events, context, name, mode=mode, outcome="skipped", rc=None, duration_s=0.0)
            continue
        # an `exec` argv runs as given: the project owns what it names
        script = None if spec.get("exec") else root / cmd[1]
        if script is not None and name in local and not script.is_file():
            print(f"gate-runner: {name} is named in {LOCAL_GATES} but {cmd[1]} is missing",
                  file=sys.stderr)
            failed.append(name)
            _record_event(events, context, name, mode=mode, outcome="missing", rc=None, duration_s=0.0)
            continue
        if script is not None and not script.is_file():
            # a module enabled in the manifest whose gate script is missing is
            # almost always a hand-edited .copier-answers.yml (copier then never
            # renders the module) — name the cause, not just the missing file
            print(f"gate-runner: {name} is enabled in the manifest but "
                  f"{cmd[1]} is missing — if .copier-answers.yml was edited by "
                  f"hand, revert it and enable the module via `copier update "
                  f"--data` instead (see BOOTSTRAP 'Later')", file=sys.stderr)
            failed.append(name)
            _record_event(events, context, name, mode=mode, outcome="missing", rc=None, duration_s=0.0)
            continue
        print(f"== running {name} ==")
        started = time.monotonic()
        try:
            # a child that declares its own dependencies (PEP 723) runs through
            # the launcher that resolves them, not this runner's interpreter.
            # Output is captured so known notes can be held back (ledger).
            argv = cmd if spec.get("exec") else child_argv(root, cmd)
            proc = subprocess.run(argv, cwd=root, env=env,
                                  timeout=GATE_TIMEOUT_S, capture_output=True,
                                  text=True, encoding="utf-8", errors="replace")
            rc = proc.returncode
            suppressed += _emit(proc.stdout, known, seen, show_all)
            # phase marks are for a timeout (`timeout_reason`), not for the reader
            err = "".join(ln for ln in proc.stderr.splitlines(keepends=True)
                          if not ln.startswith(PHASE_MARK))
            if err:
                print(err, end="" if err.endswith("\n") else "\n", file=sys.stderr)
        except subprocess.TimeoutExpired as exc:
            killed_at = time.monotonic()
            print(f"gate-runner: {name} exceeded {GATE_TIMEOUT_S}s and was killed "
                  f"— a hanging gate is a failure, not a wait", file=sys.stderr)
            why = timeout_reason(exc.stderr, killed_at)
            if why:
                print(f"gate-runner: {name}: {why}", file=sys.stderr)
                reasons[name] = f"exceeded {GATE_TIMEOUT_S}s: {why}"
            rc = 1
            _record_event(events, context, name, mode=mode, outcome="timeout", rc=None,
                          duration_s=killed_at - started, reason=reasons.get(name))
        else:
            _record_event(events, context, name, mode=mode, outcome="pass" if rc == 0 else "fail",
                          rc=rc, duration_s=time.monotonic() - started)
        if rc != 0 and node_mode in ("shadow", "sampled"):
            print(f"gate-runner: {name} failed in {node_mode} mode ({node.get('record')}) — recorded, "
                  f"not blocking; `gate_modes.py sentinel` returns it to block", file=sys.stderr)
        elif rc != 0:
            failed.append(name)
    _write_ledger(ledger, seen)
    if suppressed:
        print(f"gate-runner: {suppressed} known note(s) unchanged since the last "
              f"run — not repeated (--all-notes shows them)")
    import datetime as _dt
    today = _dt.date.today().isoformat()
    red_path = _red_ledger_path(root)
    red = _read_red(red_path)
    for name in list(red):
        if name not in failed:
            del red[name]  # green again: the clock stops
    for name in failed:
        red.setdefault(name, today)
    _write_red(red_path, red, reasons)
    if failed:
        if warn:
            print(f"gate warnings (not blocking): {', '.join(failed)}")
            return 0
        aged = [f"{n}{_red_age(red, n, today)}{' — ' + reasons[n] if n in reasons else ''}"
                for n in failed]
        print(f"FAILED gates: {', '.join(aged)}")
        if any(_red_age(red, n, today) for n in failed):
            print("gate-runner: a gate red for days is wallpaper — nobody reads it, "
                  "and the finding behind it stops being true or false. Fix it, or "
                  "waive it with a named owner, today.")
        return 1
    print(f"all {len(active)} active gate(s) passed")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
