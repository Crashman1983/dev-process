def main() -> int:
    p = argparse.ArgumentParser(description="process KPI cockpit (read-only)")
    sub = p.add_subparsers(dest="cmd")
    k = sub.add_parser("cost")
    k.add_argument("--transcripts")
    k.add_argument("--issue", type=int,
                   help="one issue's dispatched sessions (policy `transcripts`)")
    c = sub.add_parser("cfr")
    c.add_argument("--branch")
    cl = sub.add_parser("clusters")
    cl.add_argument("--branch")
    cl.add_argument("--window", type=int, default=_CLUSTER_WINDOW_DAYS,
                    help="days of history to cluster (default 14)")
    cl.add_argument("--min", type=int, default=_CLUSTER_MIN, dest="min_cluster",
                    help="minimum fixes to call it a cluster (default 3)")
    sub.add_parser("models")
    sub.add_parser("execution")
    sub.add_parser("rounds")
    bl = sub.add_parser("baseline")
    bl.add_argument("--window", type=_window, action="append", metavar="SINCE:UNTIL",
                    help="a date window (UNTIL exclusive; repeat once to compare)")
    bl.add_argument("--json", action="store_true")
    wk = sub.add_parser("works")
    wk.add_argument("--window", type=_window, metavar="SINCE:UNTIL", help="a date window (UNTIL exclusive)")
    wk.add_argument("--json", action="store_true")
    ld = sub.add_parser("load")
    ld.add_argument("--weeks", type=int, default=_LOAD_WEEKS)
    ld.add_argument("--json", action="store_true")
    sz = sub.add_parser("size")
    sz.add_argument("--window", type=_window, metavar="SINCE:UNTIL", help="a date window (UNTIL exclusive)")
    sz.add_argument("--json", action="store_true")
    fi = sub.add_parser("findings")
    fi.add_argument("--min-works", type=int, default=2)
    fi.add_argument("--json", action="store_true")
    sh = sub.add_parser("share")
    sh.add_argument("--weeks", type=int, default=4)
    tp = sub.add_parser("train-phases")
    tp.add_argument("--runs", type=int, default=20)
    fl = sub.add_parser("flow")
    fl.add_argument("--issue", type=int)
    fl.add_argument("--json", action="store_true")
    fl.add_argument("--follow-up-days", type=int, default=_FOLLOW_UP_DAYS,
                    help="how long after the merge an escape counts (default 30)")
    ls = sub.add_parser("losses")
    ls.add_argument("--days", type=int, default=_LOSS_DAYS)
    ls.add_argument("--json", action="store_true")
    oc = sub.add_parser("outcomes")
    oc.add_argument("--days", type=int, default=_OUTCOME_DAYS)
    oc.add_argument("--json", action="store_true")
    nd = sub.add_parser("nodes")
    nd.add_argument("--days", type=int, default=_NODE_DAYS)
    nd.add_argument("--json", action="store_true")
    sub.add_parser("report")
    args = p.parse_args()

    if args.cmd == "models":
        return models()
    if args.cmd == "execution":
        return execution()
    if args.cmd == "baseline":
        if args.window and len(args.window) > 2:
            p.error("baseline compares at most two windows")
        return baseline(windows=args.window, as_json=args.json)
    if args.cmd == "works":
        return works(window=args.window, as_json=args.json)
    if args.cmd == "load":
        return load(weeks=args.weeks, as_json=args.json)
    if args.cmd == "size":
        return size(window=args.window, as_json=args.json)
    if args.cmd == "findings":
        return findings(min_works=args.min_works, as_json=args.json)
    if args.cmd == "rounds":
        return rounds()
    if args.cmd == "share":
        return share(args.weeks)
    if args.cmd == "train-phases":
        return train_phases(args.runs)
    if args.cmd == "flow":
        return flow(issue=args.issue, as_json=args.json, follow_up_days=args.follow_up_days)
    if args.cmd == "losses":
        return losses(days=args.days, as_json=args.json)
    if args.cmd == "outcomes":
        return outcomes(days=args.days, as_json=args.json)
    if args.cmd == "nodes":
        return nodes(days=args.days, as_json=args.json)

    if args.cmd == "cost" and args.issue is not None:
        import dispatch  # one reader of dispatch records, policy and transcripts
        print(f"[cost] issue #{args.issue} ~approx — {dispatch.tokens_line(ROOT, args.issue)}")
        return 0
    if args.cmd == "cost":
        return cost(args.transcripts)
    if args.cmd == "cfr":
        return cfr(args.branch)
    if args.cmd == "clusters":
        return clusters(args.branch, args.window, args.min_cluster)
    return report()


if __name__ == "__main__":
    raise SystemExit(main())
