#!/usr/bin/env python3
# /// script
# requires-python = ">=3.11"
# dependencies = ["pyyaml>=6,<7"]
# ///
"""Process KPI cockpit — a read-only aggregator over EXISTING traces.

Reads the artifacts the workflow already produces (GRADE lines in journals,
git history, `gh` issue data, optional harness transcripts) and cuts them into
decision families. It is not a measurement pipeline: no new instrumentation,
no hook/gate/daemon, only reading. It never blocks and never mutates.

Guiding principle: measured numbers carry confidence and an action; the
convergence threshold family prints pass/not-met against its documented
threshold instead. A number that yields no action does not belong
in the cockpit. Confidence is `high`
(direct measure, enough n), `medium` (sample-biased), or `low` (proxy or thin
n) — proxy measures never reach `high`, because confounding cannot be filtered out.
At `low`, the only action is to collect more data; never act on a thin or
biased number. n before percent.

Numbers are within-project only: they compare a project against its own
baseline over time (trends, ratios, catch/escape events). Cross-project
comparison is meaningless — criterion granularity and domain dominate the
difference. See "honest ceiling" in the module doc.

  process_kpis.py convergence   [JOURNAL ...]   # do kickbacks converge?
  process_kpis.py cost          [JOURNAL ...] [--transcripts DIR] [--issue N]
  process_kpis.py cfr           [--branch B]
  process_kpis.py clusters      [--branch B] [--window D] [--min N]
                                                # fix clusters (rule 6 across sessions)
  process_kpis.py models                        # rounds-to-pass and blocks by phase model × tier
  process_kpis.py rounds                        # per work item: rounds to pass, blockers by origin
  process_kpis.py report                        # all families

Lean pass: the cockpit carries exactly the three KPIs the process goals name
— convergence (error rate at the gate), cost, and CFR (error rate after
merge). The removed families (effectiveness, calibration suite, tempo,
friction) live in git history if a project ever needs them back.

GRADE parsing is imported from check_telemetry (one owner for the grammar).
Stdlib itself; the header declares PyYAML for `rounds`, whose FINDING reader
(check_issues) imports it — `uv run` resolves it, and without it `rounds`
names the missing dependency. Not a gate. Reads only; never writes.
"""
from __future__ import annotations

import argparse
import glob
import re
import statistics
import subprocess
import sys
from collections import defaultdict
from datetime import datetime, timezone
from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(Path(__file__).resolve().parent))  # sibling import
import check_telemetry  # noqa: E402  (one owner for the GRADE grammar)

# --- thresholds, with their honesty labels -------------------------------
# Grader-trust threshold (ported from a calibrated production process):
# >= 90% kickback convergence in <= 2 rounds.
_CONVERGENCE_PCT = 90.0
_CONVERGENCE_ROUNDS = 2
# Below this many flagged episodes, a catch-rate percentage is anecdote.
_FLAGGED_FLOOR = 20
_N_THRESHOLD = 20
# Cycle-time p90 threshold (days): an UNCALIBRATED heuristic — the output says
# so, lest an "unremarkable p90" borrow authority from a guessed number.
_ISSUE_LIMIT = 100
# DORA change-failure window: a later fix: within this many days counts.
_CFR_WINDOW_DAYS = 7
_GIT_LIMIT = 300
# Only real source-code extensions count for CFR file overlap — process
# artifacts (journals, registries) change with almost every commit and would
# fabricate failures.
_CODE_EXT = {
    ".py", ".ts", ".tsx", ".js", ".jsx", ".mjs", ".vue", ".svelte",
    ".go", ".rs", ".java", ".kt", ".kts", ".rb", ".php", ".cs", ".scala",
    ".c", ".cc", ".cpp", ".h", ".hpp", ".m", ".mm", ".swift", ".css",
}
_CONV_COMMIT = re.compile(r"^(feat|fix)(\(.+?\))?!?:", re.IGNORECASE)

CONVERGED = {"satisfied", "out_of_scope"}
DANGER_GT = {"not_satisfied", "partial"}     # ground truth: a real gap
GRADER_PASS = {"satisfied", "out_of_scope"}  # grader said "fine"


# --- confidence framing ----------------------------------------------------
def _level(n: int | None, proxy: bool, sample_biased: bool, threshold: int) -> str:
    if proxy or (n is not None and n < threshold):
        return "low"
    if sample_biased:
        return "medium"
    return "high"


def confidence(n: int | None = None, *, proxy: bool = False,
               sample_biased: bool = False, threshold: int = _N_THRESHOLD) -> str:
    level = _level(n, proxy, sample_biased, threshold)
    reasons: list[str] = []
    if proxy:
        reasons.append("proxy, confounded")
    if n is not None and n < threshold:
        reasons.append(f"n={n}<{threshold}")
    if sample_biased:
        reasons.append("sample not representative")
    if not reasons:
        reasons.append(f"direct, n={n}" if n is not None else "direct")
    return f"confidence: {level} ({'; '.join(reasons)})"


def action(level: str, ready: str, *, thin: str) -> str:
    """At low confidence the only action is the measuring one; the named
    action applies only once the number can carry it."""
    if level == "low":
        return f"action: {thin}"
    return f"action: {ready or thin}"



def _journal_text(paths: list[str]) -> str:
    # errors="replace": the cockpit reads whatever is there; the gate is the
    # place where a non-UTF-8 journal fails loudly.
    if paths:
        return "\n".join(Path(p).read_text(encoding="utf-8", errors="replace")
                         for p in paths if Path(p).is_file())
    files = glob.glob(str(ROOT / ".process-work" / "journal" / "**" / "*.md"),
                      recursive=True)
    return "\n".join(Path(p).read_text(encoding="utf-8", errors="replace")
                     for p in files if Path(p).is_file())


def _round_int(r: dict) -> int | None:
    """round= as int, or None — isascii guards unicode digits that pass
    isdigit() but crash int(). One owner; every reader uses this."""
    v = r["round"]
    return int(v) if v.isascii() and v.isdigit() else None


def _by_round(rs: list[dict]) -> list[dict]:
    return sorted(rs, key=lambda r: (_round_int(r) is None, _round_int(r) or 0))


def _episodes(rows: list[dict]) -> dict[tuple, list[dict]]:
    """One episode = all rounds sharing (work, checkpoint, criterion)."""
    episodes: dict[tuple, list[dict]] = defaultdict(list)
    for r in rows:
        episodes[(r["work"], r["checkpoint"], r["criterion"])].append(r)
    return episodes


# --- convergence: do kickbacks resolve, or thrash? ---------------------------
def classify_episodes(rows: list[dict]) -> dict[str, dict[str, int]]:
    """Per source: converged (<=2 rounds), thrash (>2), unresolved, first_try.

    Only episodes that actually kicked back (>=1 not_satisfied/partial round)
    are convergence data; first-try-satisfied episodes are tallied separately —
    counting them would inflate convergence with freebies."""
    per_source: dict[str, dict[str, int]] = defaultdict(
        lambda: {"converged": 0, "thrash": 0, "unresolved": 0, "first_try": 0})
    for rs in _episodes(rows).values():
        last = _by_round(rs)[-1]
        src = last["source"]
        if not any(r["verdict"] in DANGER_GT for r in rs):
            per_source[src]["first_try"] += 1
            continue
        rounds = [n for n in (_round_int(r) for r in rs) if n is not None]
        max_round = max(rounds, default=99)
        if last["verdict"] in CONVERGED and max_round <= _CONVERGENCE_ROUNDS:
            bucket = "converged"
        elif last["verdict"] in CONVERGED:
            bucket = "thrash"
        else:
            bucket = "unresolved"
        per_source[src][bucket] += 1
    return per_source


def convergence(paths: list[str]) -> int:
    print("[convergence] — kickback loops per source")
    rows = check_telemetry.parse_grade_lines(_journal_text(paths))
    if not rows:
        print("  no GRADE lines found (no kickback logs yet — expected pre-adoption)")
        return 0
    per_source = classify_episodes(rows)
    for src in sorted(per_source):
        s = per_source[src]
        kicked = s["converged"] + s["thrash"] + s["unresolved"]
        if kicked:
            pct = 100.0 * s["converged"] / kicked
            verdict = "PASS" if pct >= _CONVERGENCE_PCT else "NOT MET"
            print(f"  source={src}: {s['converged']}/{kicked} kickback episodes "
                  f"converged <={_CONVERGENCE_ROUNDS} rounds ({pct:.1f}%) · "
                  f"thrash={s['thrash']} unresolved={s['unresolved']} "
                  f"first_try={s['first_try']} · "
                  f"threshold (>={_CONVERGENCE_PCT:.0f}%): {verdict}")
        else:
            print(f"  source={src}: grader ran ({s['first_try']} first-try "
                  f"satisfied), 0 kickback episodes -> no convergence data yet")
    print("  note: a 100% from a handful of episodes is not trust — "
          "collect more graded episodes before loading the number")
    return 0


# --- cost: rework + optional harness tokens ----------------------------------
def rework_episodes(rows: list[dict]) -> int:
    """Episodes with a kickback (round>1) that ended in action=fixed."""
    n = 0
    for rs in _episodes(rows).values():
        rounds = [n_ for n_ in (_round_int(r) for r in rs) if n_ is not None]
        if rounds and max(rounds) > 1 and any(r["action"] == "fixed" for r in rs):
            n += 1
    return n


def session_output_tokens(transcript_dir: Path) -> dict[str, int]:
    """Output tokens per transcript file (~approx: per session, not per work
    item; the JSONL 'output_tokens' shape is harness-specific)."""
    from dispatch import OUTPUT_TOKENS  # one reader of the transcript shape
    out: dict[str, int] = {}
    if not transcript_dir.is_dir():
        return out
    for f in sorted(transcript_dir.glob("*.jsonl")):
        total = sum(int(m) for m in OUTPUT_TOKENS.findall(f.read_text(errors="ignore")))
        if total:
            out[f.stem] = total
    return out


def cost(paths: list[str], transcripts: str | None) -> int:
    print("[cost] ~approx")
    if transcripts:
        tokens = session_output_tokens(Path(transcripts))
        if tokens:
            vals = list(tokens.values())
            # The decision number is the median per session (budget lever per
            # unit of work); the cumulative sum carries no decision — context only.
            print(f"  output tokens/session: median {int(statistics.median(vals)):,} "
                  f"({sum(vals):,} total over {len(vals)} sessions, cumulative — context)")
            print(f"  {confidence(len(vals))}")
        else:
            print(f"  no transcript tokens found under {transcripts}")
    else:
        print("  tokens: not read (pass --transcripts DIR with harness "
              "transcript JSONL; harness-specific)")
    rows = check_telemetry.parse_grade_lines(_journal_text(paths))
    rework = rework_episodes(rows)
    n_ep = len(_episodes(rows))
    lvl = _level(n_ep, False, False, _N_THRESHOLD)
    print(f"  rework episodes (kickback round>1 -> fixed): {rework}  [{confidence(n_ep)}]")
    ready = (
        f"look at the {rework} rework episode(s) — which criterion kicks back "
        "repeatedly (missing test seam / unclear acceptance)?"
        if rework > 0
        else "none — no rework waste in the graded episodes"
    )
    print(f"  -> {action(lvl, ready, thin='collect more graded episodes first, then address the rework source')}")
    return 0


# --- cfr: DORA change failure rate (proxy) ------------------------------------
def _commit_kind(subject: str) -> str | None:
    m = _CONV_COMMIT.match(subject)
    return m.group(1).lower() if m else None


def _code_files(files: set[str]) -> set[str]:
    return {f for f in files if any(f.endswith(e) for e in _CODE_EXT)}


def change_failure_rate(commits: list[dict], window_days: int = _CFR_WINDOW_DAYS) -> dict:
    """Share of feat: changes followed by a corrective fix: within the window
    that shares at least one CODE file — the closest honest CFR without deploy
    events. Doc-only feats are not deployable changes and do not count."""
    feats = [(c, _code_files(c["files"])) for c in commits
             if _commit_kind(c["subject"]) == "feat"]
    feats = [(c, cf) for c, cf in feats if cf]
    fixes = [(c, _code_files(c["files"])) for c in commits
             if _commit_kind(c["subject"]) == "fix"]
    failed = 0
    for fe, fe_code in feats:
        for fx, fx_code in fixes:
            if (fx["ts"] > fe["ts"]
                    and (fx["ts"] - fe["ts"]).days <= window_days
                    and (fe_code & fx_code)):
                failed += 1
                break
    rate = (100.0 * failed / len(feats)) if feats else 0.0
    return {"feats": len(feats), "fixes": len(fixes), "failed": failed, "rate": rate}


# --- fix clusters: rule 6 across sessions --------------------------------
# Rule 6's two-attempt counter lives in the session; sessions end. A behaviour
# that collects fix after fix across days looks like a first attempt from
# inside every one of them. The durable counter is the commit history — this
# family reads it and names clusters of fix: commits sharing a salient
# subject token. Advisory only: a cluster is the signal to stop path-patching
# and write the invariant record (Type: invariant, adr/template.md) with its
# table test.
_CLUSTER_WINDOW_DAYS = 14
_CLUSTER_MIN = 3
# subject words that carry no behaviour identity (articles, glue verbs the
# conventional style produces constantly). Tokens shorter than 4 chars are
# dropped anyway.
_CLUSTER_STOP = {
    "the", "a", "an", "and", "for", "with", "into", "from", "that", "this",
    "its", "own", "one", "two", "not", "out", "when", "every", "only",
    "let", "make", "keep", "give", "pass", "carry", "mark", "keep", "hear",
    "reach", "behind", "through", "over", "under", "after", "before",
    "test", "tests", "fix", "fixes", "again", "back", "path", "state",
}


def _fix_tokens(subject: str) -> set[str]:
    """Salient identity tokens of a fix: subject — the conventional scope
    plus every >=4-char word outside the stoplist."""
    tokens: set[str] = set()
    m = re.match(r"^fix\((?P<scope>[^)]+)\)!?:\s*(?P<tail>.*)$", subject,
                 re.IGNORECASE)
    tail = subject
    if m:
        tail = m.group("tail")
    else:
        m2 = re.match(r"^fix!?:\s*(?P<tail>.*)$", subject, re.IGNORECASE)
        if m2:
            tail = m2.group("tail")
    for w in re.findall(r"[a-zA-Z][a-zA-Z-]{3,}", tail):
        w = w.lower().strip("-")
        if len(w) >= 4 and w not in _CLUSTER_STOP:
            tokens.add(w)
    return tokens


def fix_clusters(commits: list[dict],
                 window_days: int = _CLUSTER_WINDOW_DAYS,
                 min_cluster: int = _CLUSTER_MIN) -> list[dict]:
    """Clusters of fix: commits in the window, largest first, in two kinds:
    kind="token" (shared subject word — precise, but blind to synonyms and
    to non-English vocabularies) and kind="file" (shared CODE file —
    language-independent, but a hot file collects unrelated fixes). A
    cluster whose commit set is a subset of an already reported one is
    folded away (it re-names the same cluster); token clusters report
    first, so the file dimension only adds what wording missed."""
    fixes = [c for c in commits if _commit_kind(c["subject"]) == "fix"]
    if not fixes:
        return []
    newest = max(c["ts"] for c in fixes)
    fixes = [c for c in fixes if (newest - c["ts"]).days <= window_days]
    by_token: dict[str, list[dict]] = defaultdict(list)
    for c in fixes:
        for t in _fix_tokens(c["subject"]):
            by_token[t].append(c)
    by_file: dict[str, list[dict]] = defaultdict(list)
    for c in fixes:
        for f in _code_files(c["files"]):
            by_file[f].append(c)
    clusters: list[dict] = []
    seen: list[set[int]] = []
    for kind, groups in (("token", by_token), ("file", by_file)):
        for key, cs in sorted(groups.items(), key=lambda kv: (-len(kv[1]), kv[0])):
            if len(cs) < min_cluster:
                continue
            ids = {id(c) for c in cs}
            if any(ids <= s for s in seen):
                continue
            seen.append(ids)
            days = (max(c["ts"] for c in cs) - min(c["ts"] for c in cs)).days
            label = key if kind == "token" else key.rsplit("/", 1)[-1]
            clusters.append({"kind": kind, "token": label, "count": len(cs),
                             "days": days,
                             "subjects": [c["subject"] for c in cs]})
    return clusters


def clusters(branch: str | None,
             window_days: int = _CLUSTER_WINDOW_DAYS,
             min_cluster: int = _CLUSTER_MIN) -> int:
    print(f"[clusters] fix clusters, last {window_days} d ~advisory")
    try:
        b = branch or _default_branch()
        commits = _git_commits(b)
    except (subprocess.CalledProcessError, OSError) as exc:
        print(f"  not a git repository, git missing, or branch not resolvable "
              f"({type(exc).__name__}) — clusters skipped")
        return 0
    if not any(_commit_kind(c["subject"]) == "fix" for c in commits):
        print(f"  no 'fix:' commits on {b} — this detector reads Conventional "
              f"Commits; without 'fix:' subjects it is blind, not green")
        return 0
    found = fix_clusters(commits, window_days, min_cluster)
    if not found:
        print(f"  no cluster of >={min_cluster} fix: commits sharing a "
              f"subject token or code file on {b} — nothing to escalate")
        return 0
    # the advisory names the worst offenders, not every echo — overlapping
    # clusters largely describe the same behaviour from another angle
    shown, rest = found[:5], found[5:]
    if rest:
        print(f"  top 5 of {len(found)} clusters (the rest mostly "
              f"re-name these)")
    for cl in shown:
        kind = "" if cl["kind"] == "token" else \
            "file " if cl["kind"] == "file" else f"{cl['kind']} "
        note = "" if cl["kind"] == "token" else \
            "  (hot files collect unrelated fixes — read before believing)"
        print(f"  {kind}'{cl['token']}': {cl['count']} fix commits in "
              f"{cl['days']} d{note}")
        for s in cl["subjects"][:6]:
            print(f"    - {s}")
        if len(cl["subjects"]) > 6:
            print(f"    ... and {len(cl['subjects']) - 6} more")
    print("  -> a cluster is rule 6's counter surviving the session: stop "
          "path-patching, write the invariant record (Type: invariant, "
          "docs/process/adr/template.md) and pin the WHOLE rule with a "
          "table/property test — the next path-fix grows that table instead")
    return 0


def _default_branch() -> str:
    for b in ("main", "master"):
        if subprocess.run(["git", "rev-parse", "--verify", "--quiet", b],
                          capture_output=True, cwd=str(ROOT)).returncode == 0:
            return b
    return "HEAD"


def _git_commits(branch: str, limit: int = _GIT_LIMIT) -> list[dict]:
    # -z: without it git quotes a non-ASCII name, and the same file under a
    # quoted and a plain name reads as two. Fields are NUL-separated; a
    # commit's header carries its first name after a newline.
    proc = subprocess.run(
        ["git", "log", branch, "-z", "--no-merges", "-n", str(limit), "--name-only",
         "--pretty=format:\x01%ct\x01%s"],
        capture_output=True, check=True, cwd=str(ROOT),
    )
    commits: list[dict] = []
    cur: dict | None = None
    for field in proc.stdout.decode(errors="surrogateescape").split("\0"):
        if field.startswith("\x01"):
            header, _nl, field = field.partition("\n")
            _, ct, subject = header.split("\x01", 2)
            cur = {"subject": subject,
                   "ts": datetime.fromtimestamp(int(ct), tz=timezone.utc),
                   "files": set()}
            commits.append(cur)
        if field and cur is not None:
            cur["files"].add(field)
    return commits


def cfr(branch: str | None) -> int:
    print("[cfr] change failure rate (DORA) ~approx")
    try:
        b = branch or _default_branch()
        commits = _git_commits(b)
    except (subprocess.CalledProcessError, OSError) as exc:
        print(f"  not a git repository, git missing, or branch not resolvable "
              f"({type(exc).__name__}) — cfr skipped")
        return 0
    r = change_failure_rate(commits)
    if not r["feats"]:
        print(f"  no feat: commits with code files in the last {_GIT_LIMIT} "
              f"commits on {b}")
        return 0
    print(f"  change failure rate on {b}: {r['rate']:.1f}% "
          f"({r['failed']}/{r['feats']} feat changes with a corrective fix "
          f"<={_CFR_WINDOW_DAYS} d, code overlap)")
    print("  DORA bands: elite 0-15% · high 16-30% · medium 31-45% · low >45%")
    print(f"  {confidence(r['feats'], proxy=True)} — hot-file bursts overcount; "
          "only the trend is loadable, never the point value")
    print(f"  -> {action('low', '', thin='build a CFR trend over >=3 windows; if it rises while effectiveness shows catch>0, tighten the test/review gate. Single value: no action')}")
    return 0


# --- models: which model did which phase, and what came of it -----------------
def _reports_by_worker(root: Path) -> dict[str, list[dict]]:
    try:
        import report as _report  # sibling; the worker protocol
    except ImportError:
        return {}
    by: dict[str, list[dict]] = {}
    for rec in _report.read_reports(root, remote=True):
        by.setdefault(rec.get("worker") or "?", []).append(rec)
    return by


def _model(rec: dict) -> str:
    """The reported model, "" when the report says it was not measured."""
    m = rec.get("model") or ""
    return "" if m == "not measured" else m  # report.UNMEASURED


def _review_rounds(root: Path) -> dict[str, dict]:
    """work id → {max_round, passed, tier, pass_round, blocked} from every REVIEW
    line in the journal: `pass_round` is the first passing round (None before
    it), `blocked` the distinct rounds with a block verdict."""
    import check_review as _review
    out: dict[str, dict] = {}
    jdir = root / _review.JOURNAL_DIR
    if not jdir.is_dir():
        return out
    for f in jdir.glob("**/*.md"):
        recs, _e = _review.parse_review_lines(f.read_text(encoding="utf-8", errors="replace"))
        for _ln, r in recs:
            e = out.setdefault(r["work"], {"max_round": 0, "passed": False, "tier": r.get("tier"),
                                           "pass_round": None, "blocked": set()})
            try:
                rnd = int(r.get("round") or 0)
            except ValueError:
                rnd = None
            if rnd is not None:
                e["max_round"] = max(e["max_round"], rnd)
            tier = str(r.get("tier") or "")
            if tier.isdigit() and not (str(e["tier"] or "").isdigit() and int(e["tier"]) >= int(tier)):
                e["tier"] = tier  # the highest tier any round declared
            if r.get("verdict") == "pass":
                e["passed"] = True
                if rnd is not None and (e["pass_round"] is None or rnd < e["pass_round"]):
                    e["pass_round"] = rnd
            elif r.get("verdict") == "block" and rnd is not None:
                e["blocked"].add(rnd)
    return out


def models(root: Path | None = None) -> int:
    """Per (tier, phase, model): issues seen, blocked reports, review rounds
    to the clearing pass. Reads the worker reports (what model ran which
    phase — the only trace that carries it) and the journal's REVIEW lines.
    Proxy at best: the model is what the worker reported, the rounds are
    the reviewer's count; confidence never above medium."""
    root = root or Path.cwd()
    print("[models] ~proxy — the worker's reported model × the journal's review rounds")
    by = _reports_by_worker(root)
    if not by:
        print("  no worker reports with a model yet (report.py … --model, or PROCESS_MODEL in the session env)")
        return 0
    rounds = _review_rounds(root)
    # one issue is one unit: the LAST model reported per phase did the work
    # that the review counted (a re-dispatch with another model supersedes),
    # blocks are counted per report, rounds once per issue and phase
    cells: dict[tuple, dict] = {}
    seen_rounds: set[tuple] = set()
    for worker, recs in by.items():
        issue = next((str(r.get("issue")) for r in recs if r.get("issue")), None)
        unit = issue or worker
        last_model: dict[str, str] = {}
        for r in sorted(recs, key=lambda x: x.get("epoch", 0)):
            if _model(r) and r.get("phase"):
                last_model[r["phase"]] = r["model"]
        tier = rounds[issue].get("tier") if issue and issue in rounds else None
        for r in recs:
            m, ph = _model(r), r.get("phase") or ""
            if not m or not ph or last_model.get(ph) != m:
                continue
            cell = cells.setdefault((str(tier), ph, m), {"issues": set(), "blocked": 0, "rounds": [], "passed": 0})
            cell["issues"].add(unit)
            if r.get("state") == "blocked":
                cell["blocked"] += 1
            key = (unit, ph, m)
            if issue and issue in rounds and ph == "execute" and key not in seen_rounds:
                seen_rounds.add(key)
                cell["rounds"].append(rounds[issue]["max_round"])
                cell["passed"] += int(rounds[issue]["passed"])
    if not cells:
        print("  reports carry no model/phase yet — start sessions via dispatch.py or set PROCESS_MODEL/PROCESS_PHASE")
        return 0
    print(f"  {'tier':>4} {'phase':<8} {'model':<22} {'n':>3} {'blocked':>7} {'rounds→pass':>12}")
    for (tier, ph, m), c in sorted(cells.items()):
        n = len(c["issues"])
        avg = f"{sum(c['rounds']) / len(c['rounds']):.1f} ({c['passed']}/{len(c['rounds'])} pass)" if c["rounds"] else "—"
        print(f"  {tier:>4} {ph:<8} {m:<22} {n:>3} {c['blocked']:>7} {avg:>12}")
    n = len({u for c in cells.values() for u in c["issues"]})
    lvl = _level(n, True, False, _N_THRESHOLD)
    print(f"  {confidence(n, proxy=True)} · {action(lvl, 'compare execute models within one tier: more rounds to pass is the price of the cheaper model', thin='keep dispatching with the policy; judge after ~20 issues per cell')}")
    return 0


# --- rounds: how many review rounds a work item took, and where its blockers came from
_NO_FINDING_READER = "FINDING lines are read by check_issues — the github-issues module"


def _blockers_by_work(root: Path) -> dict[str, dict[str, int]] | str:
    """work id → {origin or "-": blocker count} over the review reports, or why
    they were not read: the FINDING reader (check_issues, github-issues module)
    is not installed, or it is and cannot import (a missing dependency is named,
    never read as "module not there").
    A report names its work in its `work:` header (check_review reads
    that header); a report without one counts under "(no work: header)"."""
    if not (Path(__file__).resolve().parent / "check_issues.py").is_file():
        return _NO_FINDING_READER
    try:
        import check_issues as _issues  # sibling; the one FINDING reader
        import check_review as _review  # sibling; the one report-header reader
    except ModuleNotFoundError as exc:
        if exc.name in ("check_issues", "check_review"):
            return _NO_FINDING_READER
        return (f"check_issues needs {exc.name} — run with it installed "
                f"(e.g. uv run --with pyyaml …)")
    except ImportError as exc:
        return f"check_issues does not import ({exc})"
    out: dict[str, dict[str, int]] = {}
    rdir = root / _issues.REVIEWS_DIR
    if not rdir.is_dir():
        return out
    for p in sorted(rdir.glob("*.md")):
        try:
            text = p.read_text(encoding="utf-8", errors="replace")
        except OSError:
            continue
        works = [w.lstrip("#") for w in _review.report_header(text).get("work", [])] \
            or ["(no work: header)"]
        for fields, err, _line in _issues.report_findings(text):
            if err or fields["sev"] != "blocker":
                continue
            for work in works:
                cell = out.setdefault(work, {})
                origin = fields.get("origin") or "-"
                cell[origin] = cell.get(origin, 0) + 1
    return out


def _origin_text(counts: dict[str, int]) -> str:
    total = sum(counts.values())
    named = [f"{o} {counts[o]}" for o in ("draft", "fix", "late") if counts.get(o)]
    if counts.get("-") and named:
        named.append(f"unmarked {counts['-']}")
    return f"{total} ({', '.join(named)})" if named else str(total)


def rounds(root: Path | None = None) -> int:
    """Per work item: tier, rounds to the first pass, blocked rounds (journal
    REVIEW lines) and blockers per FINDING, by `origin=` where the reports
    carry it. Many `fix` blockers ask for regression tests and a re-check of the
    fixed class; many `late` ones for a more complete first round."""
    root = root or Path.cwd()
    print("[rounds] ~proxy — review rounds per work item × blockers by origin")
    rnds = _review_rounds(root)
    if not rnds:
        print("  no REVIEW lines in the journal yet")
        return 0
    blockers = _blockers_by_work(root)
    print(f"  {'work':<24} {'tier':>4} {'rounds→pass':>11} {'blocked':>7}  blockers")
    totals: dict[str, int] = {}
    for work, e in sorted(rnds.items()):
        to_pass = str(e["pass_round"]) if e["pass_round"] is not None else "open"
        if isinstance(blockers, str):
            found = "not read"
        else:
            counts = blockers.get(work.lstrip("#"), {})
            for o, n in counts.items():
                totals[o] = totals.get(o, 0) + n
            found = _origin_text(counts) if counts else "0"
        print(f"  {work:<24} {str(e['tier'] or '?'):>4} {to_pass:>11} {len(e['blocked']):>7}  {found}")
    if isinstance(blockers, str):
        print(f"  blockers: not read ({blockers})")
    elif totals:
        print(f"  all blockers: {_origin_text(totals)}")
    n = len(rnds)
    lvl = _level(n, True, False, _N_THRESHOLD)
    print(f"  {confidence(n, proxy=True)} · {action(lvl, 'compare rounds to pass within one tier over time; where fix-origin blockers dominate, re-check the fixed class (verification-independence.md, What each round judges)', thin='record origin= on blocker findings; judge after ~20 work items')}")
    return 0


def report() -> int:
    print("=== process KPI cockpit (read-only) ===\n")
    convergence([])
    print()
    cost([], None)
    print()
    cfr(None)
    print()
    clusters(None)
    return 0


def main() -> int:
    p = argparse.ArgumentParser(description="process KPI cockpit (read-only)")
    sub = p.add_subparsers(dest="cmd")
    v = sub.add_parser("convergence")
    v.add_argument("journals", nargs="*")
    k = sub.add_parser("cost")
    k.add_argument("journals", nargs="*")
    k.add_argument("--transcripts")
    k.add_argument("--issue", type=int,
                   help="one issue's dispatched sessions (policy `transcripts`)")
    c = sub.add_parser("cfr")
    c.add_argument("--branch")
    cl = sub.add_parser("clusters")
    cl.add_argument("--branch")
    cl.add_argument("--window", type=int, default=_CLUSTER_WINDOW_DAYS,
                    help="days of history to cluster (default 14)")
    cl.add_argument("--min", type=int, default=_CLUSTER_MIN, dest="min_cluster",
                    help="minimum fixes to call it a cluster (default 3)")
    sub.add_parser("models")
    sub.add_parser("rounds")
    sub.add_parser("report")
    args = p.parse_args()

    if args.cmd == "models":
        return models()
    if args.cmd == "rounds":
        return rounds()

    if args.cmd == "convergence":
        return convergence(args.journals)
    if args.cmd == "cost" and args.issue is not None:
        import dispatch  # one reader of dispatch records, policy and transcripts
        print(f"[cost] issue #{args.issue} ~approx — {dispatch.tokens_line(ROOT, args.issue)}")
        return 0
    if args.cmd == "cost":
        return cost(args.journals, args.transcripts)
    if args.cmd == "cfr":
        return cfr(args.branch)
    if args.cmd == "clusters":
        return clusters(args.branch, args.window, args.min_cluster)
    return report()


if __name__ == "__main__":
    raise SystemExit(main())
