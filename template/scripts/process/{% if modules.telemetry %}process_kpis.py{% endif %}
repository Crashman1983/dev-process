#!/usr/bin/env python3
# /// script
# requires-python = ">=3.11"
# dependencies = ["pyyaml>=6,<7"]
# ///
"""Process KPI cockpit — a read-only aggregator over EXISTING traces.

Reads the artifacts the workflow already produces (review records, git
history, `gh` issue data, optional harness transcripts) and cuts them into
decision families. It is not a measurement pipeline: no new instrumentation,
no hook/gate/daemon, only reading. It never blocks and never mutates.

Guiding principle: measured numbers carry confidence and an action. A number that yields no action does not belong
in the cockpit. Confidence is `high`
(direct measure, enough n), `medium` (sample-biased), or `low` (proxy or thin
n) — proxy measures never reach `high`, because confounding cannot be filtered out.
At `low`, the only action is to collect more data; never act on a thin or
biased number. n before percent.

Numbers are within-project only: they compare a project against its own
baseline over time (trends, ratios, catch/escape events). Cross-project
comparison is meaningless — criterion granularity and domain dominate the
difference. See "honest ceiling" in the module doc.

  process_kpis.py cost          [--transcripts DIR] [--issue N]
  process_kpis.py cfr           [--branch B]
  process_kpis.py clusters      [--branch B] [--window D] [--min N]
                                                # fix clusters (rule 6 across sessions)
  process_kpis.py models                        # rounds-to-pass and blocks by phase model × tier
  process_kpis.py rounds                        # per work item: rounds to pass, blockers by origin
  process_kpis.py share         [--weeks N]     # process vs product, week by week
  process_kpis.py train-phases  [--runs N]      # where the merge train's time goes, phase by phase
  process_kpis.py flow          [--issue N] [--json] [--follow-up-days D]
                                                # one issue, first phase to deploy: work, wait,
                                                # tokens, owner decisions, escapes, process version
  process_kpis.py report                        # all families

Lean pass: the error rate at the gate is read from the review records
(`rounds`, `models`), the error rate after merge from git (`cfr`,
`clusters`). The removed families (GRADE convergence, effectiveness,
calibration suite, tempo, friction) live in git history if a project ever
needs them back.

Stdlib itself; the header declares PyYAML for `rounds`, whose FINDING reader
(check_issues) imports it — `uv run` resolves it, and without it `rounds`
names the missing dependency. Not a gate. Reads only; never writes.
"""
from __future__ import annotations

import argparse
import re
import statistics
import subprocess
import sys
from collections import defaultdict
from datetime import datetime, timedelta, timezone
from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(Path(__file__).resolve().parent))  # sibling import

# --- thresholds, with their honesty labels -------------------------------
_N_THRESHOLD = 20
# Cycle-time p90 threshold (days): an UNCALIBRATED heuristic — the output says
# so, lest an "unremarkable p90" borrow authority from a guessed number.
_ISSUE_LIMIT = 100
# DORA change-failure window: a later fix: within this many days counts.
_CFR_WINDOW_DAYS = 7
_GIT_LIMIT = 300
# Only real source-code extensions count for CFR file overlap — process
# artifacts (journals, registries) change with almost every commit and would
# fabricate failures.
_CODE_EXT = {
    ".py", ".ts", ".tsx", ".js", ".jsx", ".mjs", ".vue", ".svelte",
    ".go", ".rs", ".java", ".kt", ".kts", ".rb", ".php", ".cs", ".scala",
    ".c", ".cc", ".cpp", ".h", ".hpp", ".m", ".mm", ".swift", ".css",
}
_CONV_COMMIT = re.compile(r"^(feat|fix)(\(.+?\))?!?:", re.IGNORECASE)


# --- confidence framing ----------------------------------------------------
def _level(n: int | None, proxy: bool, sample_biased: bool, threshold: int) -> str:
    if proxy or (n is not None and n < threshold):
        return "low"
    if sample_biased:
        return "medium"
    return "high"


def confidence(n: int | None = None, *, proxy: bool = False,
               sample_biased: bool = False, threshold: int = _N_THRESHOLD) -> str:
    level = _level(n, proxy, sample_biased, threshold)
    reasons: list[str] = []
    if proxy:
        reasons.append("proxy, confounded")
    if n is not None and n < threshold:
        reasons.append(f"n={n}<{threshold}")
    if sample_biased:
        reasons.append("sample not representative")
    if not reasons:
        reasons.append(f"direct, n={n}" if n is not None else "direct")
    return f"confidence: {level} ({'; '.join(reasons)})"


def action(level: str, ready: str, *, thin: str) -> str:
    """At low confidence the only action is the measuring one; the named
    action applies only once the number can carry it."""
    if level == "low":
        return f"action: {thin}"
    return f"action: {ready or thin}"



# --- cost: optional harness tokens ----------------------------------------
def session_output_tokens(transcript_dir: Path) -> dict[str, int]:
    """Output tokens per transcript file (~approx: per session, not per work
    item; the JSONL 'output_tokens' shape is harness-specific)."""
    from dispatch import OUTPUT_TOKENS  # one reader of the transcript shape
    out: dict[str, int] = {}
    if not transcript_dir.is_dir():
        return out
    for f in sorted(transcript_dir.glob("*.jsonl")):
        total = sum(int(m) for m in OUTPUT_TOKENS.findall(f.read_text(errors="ignore")))
        if total:
            out[f.stem] = total
    return out


def cost(transcripts: str | None) -> int:
    print("[cost] ~approx")
    if transcripts:
        tokens = session_output_tokens(Path(transcripts))
        if tokens:
            vals = list(tokens.values())
            # The decision number is the median per session (budget lever per
            # unit of work); the cumulative sum carries no decision — context only.
            print(f"  output tokens/session: median {int(statistics.median(vals)):,} "
                  f"({sum(vals):,} total over {len(vals)} sessions, cumulative — context)")
            print(f"  {confidence(len(vals))}")
        else:
            print(f"  no transcript tokens found under {transcripts}")
    else:
        print("  tokens: not read (pass --transcripts DIR with harness "
              "transcript JSONL; harness-specific)")
    return 0


# --- cfr: DORA change failure rate (proxy) ------------------------------------
def _commit_kind(subject: str) -> str | None:
    m = _CONV_COMMIT.match(subject)
    return m.group(1).lower() if m else None


def _code_files(files: set[str]) -> set[str]:
    return {f for f in files if any(f.endswith(e) for e in _CODE_EXT)}


def change_failure_rate(commits: list[dict], window_days: int = _CFR_WINDOW_DAYS) -> dict:
    """Share of feat: changes followed by a corrective fix: within the window
    that shares at least one CODE file — the closest honest CFR without deploy
    events. Doc-only feats are not deployable changes and do not count."""
    feats = [(c, _code_files(c["files"])) for c in commits
             if _commit_kind(c["subject"]) == "feat"]
    feats = [(c, cf) for c, cf in feats if cf]
    fixes = [(c, _code_files(c["files"])) for c in commits
             if _commit_kind(c["subject"]) == "fix"]
    failed = 0
    for fe, fe_code in feats:
        for fx, fx_code in fixes:
            if (fx["ts"] > fe["ts"]
                    and (fx["ts"] - fe["ts"]).days <= window_days
                    and (fe_code & fx_code)):
                failed += 1
                break
    rate = (100.0 * failed / len(feats)) if feats else 0.0
    return {"feats": len(feats), "fixes": len(fixes), "failed": failed, "rate": rate}


# --- fix clusters: rule 6 across sessions --------------------------------
# Rule 6's two-attempt counter lives in the session; sessions end. A behaviour
# that collects fix after fix across days looks like a first attempt from
# inside every one of them. The durable counter is the commit history — this
# family reads it and names clusters of fix: commits sharing a salient
# subject token. Advisory only: a cluster is the signal to stop path-patching
# and write the invariant record (Type: invariant, adr/template.md) with its
# table test.
_CLUSTER_WINDOW_DAYS = 14
_CLUSTER_MIN = 3
# subject words that carry no behaviour identity (articles, glue verbs the
# conventional style produces constantly). Tokens shorter than 4 chars are
# dropped anyway.
_CLUSTER_STOP = {
    "the", "a", "an", "and", "for", "with", "into", "from", "that", "this",
    "its", "own", "one", "two", "not", "out", "when", "every", "only",
    "let", "make", "keep", "give", "pass", "carry", "mark", "keep", "hear",
    "reach", "behind", "through", "over", "under", "after", "before",
    "test", "tests", "fix", "fixes", "again", "back", "path", "state",
}


def _fix_tokens(subject: str) -> set[str]:
    """Salient identity tokens of a fix: subject — the conventional scope
    plus every >=4-char word outside the stoplist."""
    tokens: set[str] = set()
    m = re.match(r"^fix\((?P<scope>[^)]+)\)!?:\s*(?P<tail>.*)$", subject,
                 re.IGNORECASE)
    tail = subject
    if m:
        tail = m.group("tail")
    else:
        m2 = re.match(r"^fix!?:\s*(?P<tail>.*)$", subject, re.IGNORECASE)
        if m2:
            tail = m2.group("tail")
    for w in re.findall(r"[a-zA-Z][a-zA-Z-]{3,}", tail):
        w = w.lower().strip("-")
        if len(w) >= 4 and w not in _CLUSTER_STOP:
            tokens.add(w)
    return tokens


def fix_clusters(commits: list[dict],
                 window_days: int = _CLUSTER_WINDOW_DAYS,
                 min_cluster: int = _CLUSTER_MIN) -> list[dict]:
    """Clusters of fix: commits in the window, largest first, in two kinds:
    kind="token" (shared subject word — precise, but blind to synonyms and
    to non-English vocabularies) and kind="file" (shared CODE file —
    language-independent, but a hot file collects unrelated fixes). A
    cluster whose commit set is a subset of an already reported one is
    folded away (it re-names the same cluster); token clusters report
    first, so the file dimension only adds what wording missed."""
    fixes = [c for c in commits if _commit_kind(c["subject"]) == "fix"]
    if not fixes:
        return []
    newest = max(c["ts"] for c in fixes)
    fixes = [c for c in fixes if (newest - c["ts"]).days <= window_days]
    by_token: dict[str, list[dict]] = defaultdict(list)
    for c in fixes:
        for t in _fix_tokens(c["subject"]):
            by_token[t].append(c)
    by_file: dict[str, list[dict]] = defaultdict(list)
    for c in fixes:
        for f in _code_files(c["files"]):
            by_file[f].append(c)
    clusters: list[dict] = []
    seen: list[set[int]] = []
    for kind, groups in (("token", by_token), ("file", by_file)):
        for key, cs in sorted(groups.items(), key=lambda kv: (-len(kv[1]), kv[0])):
            if len(cs) < min_cluster:
                continue
            ids = {id(c) for c in cs}
            if any(ids <= s for s in seen):
                continue
            seen.append(ids)
            days = (max(c["ts"] for c in cs) - min(c["ts"] for c in cs)).days
            label = key if kind == "token" else key.rsplit("/", 1)[-1]
            clusters.append({"kind": kind, "token": label, "count": len(cs),
                             "days": days,
                             "subjects": [c["subject"] for c in cs]})
    return clusters


def clusters(branch: str | None,
             window_days: int = _CLUSTER_WINDOW_DAYS,
             min_cluster: int = _CLUSTER_MIN) -> int:
    print(f"[clusters] fix clusters, last {window_days} d ~advisory")
    try:
        b = branch or _default_branch()
        commits = _git_commits(b)
    except (subprocess.CalledProcessError, OSError) as exc:
        print(f"  not a git repository, git missing, or branch not resolvable "
              f"({type(exc).__name__}) — clusters skipped")
        return 0
    if not any(_commit_kind(c["subject"]) == "fix" for c in commits):
        print(f"  no 'fix:' commits on {b} — this detector reads Conventional "
              f"Commits; without 'fix:' subjects it is blind, not green")
        return 0
    found = fix_clusters(commits, window_days, min_cluster)
    if not found:
        print(f"  no cluster of >={min_cluster} fix: commits sharing a "
              f"subject token or code file on {b} — nothing to escalate")
        return 0
    # the advisory names the worst offenders, not every echo — overlapping
    # clusters largely describe the same behaviour from another angle
    shown, rest = found[:5], found[5:]
    if rest:
        print(f"  top 5 of {len(found)} clusters (the rest mostly "
              f"re-name these)")
    for cl in shown:
        kind = "" if cl["kind"] == "token" else \
            "file " if cl["kind"] == "file" else f"{cl['kind']} "
        note = "" if cl["kind"] == "token" else \
            "  (hot files collect unrelated fixes — read before believing)"
        print(f"  {kind}'{cl['token']}': {cl['count']} fix commits in "
              f"{cl['days']} d{note}")
        for s in cl["subjects"][:6]:
            print(f"    - {s}")
        if len(cl["subjects"]) > 6:
            print(f"    ... and {len(cl['subjects']) - 6} more")
    print("  -> a cluster is rule 6's counter surviving the session: stop "
          "path-patching, write the invariant record (Type: invariant, "
          "docs/process/adr/template.md) and pin the WHOLE rule with a "
          "table/property test — the next path-fix grows that table instead")
    return 0


def _default_branch() -> str:
    for b in ("main", "master"):
        if subprocess.run(["git", "rev-parse", "--verify", "--quiet", b],
                          capture_output=True, cwd=str(ROOT)).returncode == 0:
            return b
    return "HEAD"


def _git_commits(branch: str, limit: int = _GIT_LIMIT) -> list[dict]:
    # -z: without it git quotes a non-ASCII name, and the same file under a
    # quoted and a plain name reads as two. Fields are NUL-separated; a
    # commit's header carries its first name after a newline.
    proc = subprocess.run(
        ["git", "log", branch, "-z", "--no-merges", "-n", str(limit), "--name-only",
         "--pretty=format:\x01%ct\x01%s"],
        capture_output=True, check=True, cwd=str(ROOT),
    )
    commits: list[dict] = []
    cur: dict | None = None
    for field in proc.stdout.decode(errors="surrogateescape").split("\0"):
        if field.startswith("\x01"):
            header, _nl, field = field.partition("\n")
            _, ct, subject = header.split("\x01", 2)
            cur = {"subject": subject,
                   "ts": datetime.fromtimestamp(int(ct), tz=timezone.utc),
                   "files": set()}
            commits.append(cur)
        if field and cur is not None:
            cur["files"].add(field)
    return commits


def cfr(branch: str | None) -> int:
    print("[cfr] change failure rate (DORA) ~approx")
    try:
        b = branch or _default_branch()
        commits = _git_commits(b)
    except (subprocess.CalledProcessError, OSError) as exc:
        print(f"  not a git repository, git missing, or branch not resolvable "
              f"({type(exc).__name__}) — cfr skipped")
        return 0
    r = change_failure_rate(commits)
    if not r["feats"]:
        print(f"  no feat: commits with code files in the last {_GIT_LIMIT} "
              f"commits on {b}")
        return 0
    print(f"  change failure rate on {b}: {r['rate']:.1f}% "
          f"({r['failed']}/{r['feats']} feat changes with a corrective fix "
          f"<={_CFR_WINDOW_DAYS} d, code overlap)")
    print("  DORA bands: elite 0-15% · high 16-30% · medium 31-45% · low >45%")
    print(f"  {confidence(r['feats'], proxy=True)} — hot-file bursts overcount; "
          "only the trend is loadable, never the point value")
    print(f"  -> {action('low', '', thin='build a CFR trend over >=3 windows; if it rises while effectiveness shows catch>0, tighten the test/review gate. Single value: no action')}")
    return 0


# --- models: which model did which phase, and what came of it -----------------
def _reports_by_worker(root: Path) -> dict[str, list[dict]]:
    try:
        import report as _report  # sibling; the worker protocol
    except ImportError:
        return {}
    by: dict[str, list[dict]] = {}
    for rec in _report.read_reports(root, remote=True):
        by.setdefault(rec.get("worker") or "?", []).append(rec)
    return by


def _model(rec: dict) -> str:
    """The reported model with its effort when one was set (`model (effort)`,
    a cell of its own), "" when the report says the model was not measured."""
    m = rec.get("model") or ""
    if m == "not measured":  # report.UNMEASURED
        return ""
    return f"{m} ({rec['effort']})" if rec.get("effort") else m


def _review_rounds(root: Path) -> dict[str, dict]:
    """work id → {max_round, passed, tier, pass_round, blocked} from every REVIEW
    line in the journal: `pass_round` is the first passing round (None before
    it), `blocked` the distinct rounds with a block verdict."""
    import check_review as _review
    out: dict[str, dict] = {}
    jdir = root / _review.JOURNAL_DIR
    if not jdir.is_dir():
        return out
    for f in jdir.glob("**/*.md"):
        recs, _e = _review.parse_review_lines(f.read_text(encoding="utf-8", errors="replace"))
        for _ln, r in recs:
            e = out.setdefault(r["work"], {"max_round": 0, "passed": False, "tier": r.get("tier"),
                                           "pass_round": None, "blocked": set()})
            try:
                rnd = int(r.get("round") or 0)
            except ValueError:
                rnd = None
            if rnd is not None:
                e["max_round"] = max(e["max_round"], rnd)
            tier = str(r.get("tier") or "")
            if tier.isdigit() and not (str(e["tier"] or "").isdigit() and int(e["tier"]) >= int(tier)):
                e["tier"] = tier  # the highest tier any round declared
            if r.get("verdict") == "pass":
                e["passed"] = True
                if rnd is not None and (e["pass_round"] is None or rnd < e["pass_round"]):
                    e["pass_round"] = rnd
            elif r.get("verdict") == "block" and rnd is not None:
                e["blocked"].add(rnd)
    return out


def models(root: Path | None = None) -> int:
    """Per (tier, phase, model): issues seen, blocked reports, review rounds
    to the clearing pass. Reads the worker reports (what model ran which
    phase — the only trace that carries it) and the journal's REVIEW lines.
    Proxy at best: the model is what the worker reported, the rounds are
    the reviewer's count; confidence never above medium."""
    root = root or Path.cwd()
    print("[models] ~proxy — the worker's reported model × the journal's review rounds")
    by = _reports_by_worker(root)
    if not by:
        print("  no worker reports with a model yet (report.py … --model, or PROCESS_MODEL in the session env)")
        return 0
    rounds = _review_rounds(root)
    # one issue is one unit: the LAST model reported per phase did the work
    # that the review counted (a re-dispatch with another model supersedes),
    # blocks are counted per report, rounds once per issue and phase
    cells: dict[tuple, dict] = {}
    seen_rounds: set[tuple] = set()
    for worker, recs in by.items():
        issue = next((str(r.get("issue")) for r in recs if r.get("issue")), None)
        unit = issue or worker
        last_model: dict[str, str] = {}
        for r in sorted(recs, key=lambda x: x.get("epoch", 0)):
            if _model(r) and r.get("phase"):
                last_model[r["phase"]] = _model(r)
        tier = rounds[issue].get("tier") if issue and issue in rounds else None
        for r in recs:
            m, ph = _model(r), r.get("phase") or ""
            if not m or not ph or last_model.get(ph) != m:
                continue
            cell = cells.setdefault((str(tier), ph, m), {"issues": set(), "blocked": 0, "rounds": [], "passed": 0})
            cell["issues"].add(unit)
            if r.get("state") == "blocked":
                cell["blocked"] += 1
            key = (unit, ph, m)
            if issue and issue in rounds and ph == "execute" and key not in seen_rounds:
                seen_rounds.add(key)
                cell["rounds"].append(rounds[issue]["max_round"])
                cell["passed"] += int(rounds[issue]["passed"])
    if not cells:
        print("  reports carry no model/phase yet — start sessions via dispatch.py or set PROCESS_MODEL/PROCESS_PHASE")
        return 0
    print(f"  {'tier':>4} {'phase':<8} {'model':<22} {'n':>3} {'blocked':>7} {'rounds→pass':>12}")
    for (tier, ph, m), c in sorted(cells.items()):
        n = len(c["issues"])
        avg = f"{sum(c['rounds']) / len(c['rounds']):.1f} ({c['passed']}/{len(c['rounds'])} pass)" if c["rounds"] else "—"
        print(f"  {tier:>4} {ph:<8} {m:<22} {n:>3} {c['blocked']:>7} {avg:>12}")
    n = len({u for c in cells.values() for u in c["issues"]})
    lvl = _level(n, True, False, _N_THRESHOLD)
    print(f"  {confidence(n, proxy=True)} · {action(lvl, 'compare execute models within one tier: more rounds to pass is the price of the cheaper model', thin='keep dispatching with the policy; judge after ~20 issues per cell')}")
    return 0


# --- rounds: how many review rounds a work item took, and where its blockers came from
_NO_FINDING_READER = "FINDING lines are read by check_issues — the github-issues module"


def _blockers_by_work(root: Path) -> dict[str, dict[str, int]] | str:
    """work id → {origin or "-": blocker count} over the review reports, or why
    they were not read: the FINDING reader (check_issues, github-issues module)
    is not installed, or it is and cannot import (a missing dependency is named,
    never read as "module not there").
    A report names its work in its `work:` header (check_review reads
    that header); a report without one counts under "(no work: header)"."""
    if not (Path(__file__).resolve().parent / "check_issues.py").is_file():
        return _NO_FINDING_READER
    try:
        import check_issues as _issues  # sibling; the one FINDING reader
        import check_review as _review  # sibling; the one report-header reader
    except ModuleNotFoundError as exc:
        if exc.name in ("check_issues", "check_review"):
            return _NO_FINDING_READER
        return (f"check_issues needs {exc.name} — run with it installed "
                f"(e.g. uv run --with pyyaml …)")
    except ImportError as exc:
        return f"check_issues does not import ({exc})"
    out: dict[str, dict[str, int]] = {}
    rdir = root / _issues.REVIEWS_DIR
    if not rdir.is_dir():
        return out
    for p in sorted(rdir.glob("*.md")):
        try:
            text = p.read_text(encoding="utf-8", errors="replace")
        except OSError:
            continue
        works = [w.lstrip("#") for w in _review.report_header(text).get("work", [])] \
            or ["(no work: header)"]
        for fields, err, _line in _issues.report_findings(text):
            if err or fields["sev"] != "blocker":
                continue
            for work in works:
                cell = out.setdefault(work, {})
                origin = fields.get("origin") or "-"
                cell[origin] = cell.get(origin, 0) + 1
    return out


def _origin_text(counts: dict[str, int]) -> str:
    total = sum(counts.values())
    named = [f"{o} {counts[o]}" for o in ("draft", "fix", "late") if counts.get(o)]
    if counts.get("-") and named:
        named.append(f"unmarked {counts['-']}")
    return f"{total} ({', '.join(named)})" if named else str(total)


def rounds(root: Path | None = None) -> int:
    """Per work item: tier, rounds to the first pass, blocked rounds (journal
    REVIEW lines) and blockers per FINDING, by `origin=` where the reports
    carry it. Many `fix` blockers ask for regression tests and a re-check of the
    fixed class; many `late` ones for a more complete first round."""
    root = root or Path.cwd()
    print("[rounds] ~proxy — review rounds per work item × blockers by origin")
    rnds = _review_rounds(root)
    if not rnds:
        print("  no REVIEW lines in the journal yet")
        return 0
    blockers = _blockers_by_work(root)
    print(f"  {'work':<24} {'tier':>4} {'rounds→pass':>11} {'blocked':>7}  blockers")
    totals: dict[str, int] = {}
    for work, e in sorted(rnds.items()):
        to_pass = str(e["pass_round"]) if e["pass_round"] is not None else "open"
        if isinstance(blockers, str):
            found = "not read"
        else:
            counts = blockers.get(work.lstrip("#"), {})
            for o, n in counts.items():
                totals[o] = totals.get(o, 0) + n
            found = _origin_text(counts) if counts else "0"
        print(f"  {work:<24} {str(e['tier'] or '?'):>4} {to_pass:>11} {len(e['blocked']):>7}  {found}")
    if isinstance(blockers, str):
        print(f"  blockers: not read ({blockers})")
    elif totals:
        print(f"  all blockers: {_origin_text(totals)}")
    n = len(rnds)
    lvl = _level(n, True, False, _N_THRESHOLD)
    print(f"  {confidence(n, proxy=True)} · {action(lvl, 'compare rounds to pass within one tier over time; where fix-origin blockers dominate, re-check the fixed class (verification-independence.md, What each round judges)', thin='record origin= on blocker findings; judge after ~20 work items')}")
    return 0


# --- share: how much of what lands is process ----------------------------------
def share(weeks: int = 4) -> int:
    """Week by week on the integration branch: process-only, mixed and product
    commits, and the landed changes that carried product code. tower.py owns
    the classification (one owner); this prints its trend."""
    import tower  # noqa: E402  (sibling; owns PROCESS_PATHS and balance)
    print("[share] process vs product on the integration branch")
    ref = tower.integration_ref(ROOT)
    rows = [tower.balance(ROOT, ref, 7, 7 * w) for w in range(weeks)]
    if not ref or any(r is None for r in rows):
        print("  no integration branch or git unreadable — share skipped")
        return 0
    for w, r in enumerate(rows):
        n = r["commits"]
        pct = (lambda k: f"{100 * r[k] // n:>3}%") if n else (lambda k: "  -")
        print(f"  week -{w}: {n:>4} commits — process only {pct('process')}, mixed {pct('mixed')}, "
              f"product {pct('product')}; {r['landed_product']}/{r['landed']} landed changes with product code")
    n = sum(r["commits"] for r in rows)
    heavy = n and sum(r["process"] for r in rows) / n > tower.PROCESS_HEAVY_SHARE
    print(f"  {confidence(n, proxy=True)} — paths classify, not effort: a one-line plan edit counts like a feature")
    print(f"  -> {action('low', '', thin='process-only above 40% over weeks: look where the rounds go (rounds) and batch bookkeeping one commit per round (testing.md); falling product changes with rising process share is the signal' if heavy else 'watch the trend; act when process-only stays above 40% for two weeks')}")
    return 0


# --- train-phases: where the merge train's time goes ---------------------------
_TRAIN_PHASES = ("preflight", "gates", "suite", "retry", "bisect", "push", "deploy")


def train_phases(runs: int = 20) -> int:
    """Median and maximum seconds per phase over the last `runs` trains
    (`process-train/phases.jsonl`, written by train.py): a slow merge is
    a wait, a suite, a bisection or a deploy — each has its own lever."""
    import json  # noqa: PLC0415

    print(f"[train-phases] the last {runs} train runs")
    r = subprocess.run(["git", "-C", str(ROOT), "rev-parse", "--git-common-dir"],
                       capture_output=True, text=True)
    common = Path(r.stdout.strip()) if r.returncode == 0 else None
    if common is not None and not common.is_absolute():
        common = ROOT / common
    rows = []
    try:
        for line in (common / "process-train" / "phases.jsonl").read_text(encoding="utf-8").splitlines():
            try:
                row = json.loads(line)
            except ValueError:
                continue
            if isinstance(row, dict):
                rows.append(row)
    except (OSError, TypeError):
        pass
    rows = rows[-runs:]
    if not rows:
        print("  no train run recorded yet — train-phases skipped")
        return 0
    for phase in _TRAIN_PHASES:
        values = [float(row.get(phase) or 0) for row in rows]
        ran = [v for v in values if v]
        if ran:
            print(f"  {phase:<9} median {statistics.median(values):>6.0f} s, max {max(values):>6.0f} s "
                  f"(in {len(ran)}/{len(rows)} runs)")
    results = [row.get("result") for row in rows]
    print(f"  {results.count('red')}/{len(rows)} runs ended red, "
          f"{results.count('environment')} stopped by the preflight (the host, not a passenger)")
    n = len(rows)
    print(f"  {confidence(n)} · {action(_level(n, False, False, _N_THRESHOLD), 'shorten the phase with the largest median first: suite → test selection and certificates, bisect → smaller batches, retry → flaky tests (failure-catalog.md)', thin='let more trains run before acting on a phase')}")
    return 0


# --- flow: one issue from its first dispatched phase to deploy ---------------
# What ties the traces together (docs/process/optimization.md, "Goals"): the
# dispatch logs (a phase's start, named <branch>-<phase>-<stamp>.log), the
# worker reports (a phase's end), the train's phases.jsonl (who landed,
# whether the deploy ran green, when), git (Regression-of trailers, the
# process version at merge) and the plans (owner decisions). Every field
# says whether it is measured, estimated or missing; nothing is filled in.
_FOLLOW_UP_DAYS = 30  # escapes count this long after the merge (mandate: follow_up_days)
_PHASE_LOG = re.compile(r"^(?P<branch>.+)-(?P<phase>brainstorm|plan|execute|review)-(?P<ts>\d{8}-\d{6})\.log$")
_PHASE_ENDS = {"brainstorm": {"planned", "blocked", "idle"}, "plan": {"planned", "blocked"},
               "execute": {"pushed", "blocked"}, "review": {"review-pass", "blocked"}}
_REGRESSION_OF = re.compile(r"^\s*Regression-of:\s*(.+)$", re.IGNORECASE | re.MULTILINE)
_ANSWERS_COMMIT = re.compile(r"^_commit:\s*['\"]?([^'\"\s]+)", re.MULTILINE)


def _common_dir(root: Path) -> Path | None:
    r = subprocess.run(["git", "-C", str(root), "rev-parse", "--git-common-dir"],
                       capture_output=True, text=True)
    if r.returncode != 0 or not r.stdout.strip():
        return None
    common = Path(r.stdout.strip())
    return common if common.is_absolute() else root / common


def _aware(value) -> datetime | None:
    """An ISO timestamp as an aware datetime; a naive one is this host's local time."""
    if not value:
        return None
    try:
        dt = datetime.fromisoformat(str(value).replace("Z", "+00:00"))
    except ValueError:
        try:
            dt = datetime.strptime(str(value), "%Y-%m-%dT%H:%M:%S%z")
        except ValueError:
            return None
    return dt if dt.tzinfo else dt.astimezone()


def _phase_starts(common: Path | None) -> list[dict]:
    """[{branch, phase, ts}] from the dispatch logs' names (one per started phase)."""
    out: list[dict] = []
    d = common / "process-dispatch" if common else None
    if d is None or not d.is_dir():
        return out
    for f in d.glob("*.log"):
        m = _PHASE_LOG.match(f.name)
        if m:
            ts = datetime.strptime(m.group("ts"), "%Y%m%d-%H%M%S").astimezone()
            out.append({"branch": m.group("branch").replace("__", "/"), "phase": m.group("phase"), "ts": ts})
    return out


def _train_rows(common: Path | None) -> list[dict]:
    import json  # noqa: PLC0415

    rows: list[dict] = []
    try:
        for line in (common / "process-train" / "phases.jsonl").read_text(encoding="utf-8").splitlines():
            try:
                row = json.loads(line)
            except ValueError:
                continue
            if isinstance(row, dict):
                rows.append(row)
    except (OSError, TypeError):
        pass
    return rows


def _regressions(root: Path, branch: str) -> dict[int, list[datetime]]:
    """issue → commit times of the fixes that name it in a `Regression-of:` trailer."""
    import check_review as _review  # noqa: PLC0415 — the issue-ref parser's owner

    r = subprocess.run(["git", "-C", str(root), "log", branch, "-z", "--format=%ct%x01%B"],
                       capture_output=True)
    out: dict[int, list[datetime]] = defaultdict(list)
    if r.returncode != 0:
        return out
    for entry in r.stdout.decode("utf-8", "surrogateescape").split("\0"):
        ct, sep, body = entry.strip("\n").partition("\x01")
        if not sep or not ct.isdigit():
            continue
        when = datetime.fromtimestamp(int(ct), tz=timezone.utc)
        for m in _REGRESSION_OF.finditer(body):
            for tok in re.split(r"[,\s]+", m.group(1).strip()):
                if tok.lstrip("#").isdigit():
                    out[int(tok.lstrip("#"))].append(when)
                else:
                    parsed = _review.parse_issue_ref(tok) if tok else None
                    if parsed is not None:
                        out[parsed[1]].append(when)
    return out


def _owner_decisions(root: Path) -> dict[int, int]:
    """issue → `DECISION <date> owner:` lines in the plans that declare it (proxy for owner effort)."""
    import check_review as _review  # noqa: PLC0415
    from process_context import DECISION  # noqa: PLC0415 — the ledger line's owner

    out: dict[int, int] = defaultdict(int)
    for _rel, text in _review.record_texts(root, ("plan", "plan-archive", "spec-plan")) or []:
        owners = sum(1 for m in DECISION.finditer(text) if m.group(2).strip().lower() == "owner")
        for n in set(_review.declared_issue_numbers(text)):
            out[n] += owners
    return out


def _process_version(root: Path, branch: str, when: datetime | None) -> str | None:
    """`_commit` of .copier-answers.yml on the integration branch at `when`."""
    if when is None:
        return None
    r = subprocess.run(["git", "-C", str(root), "log", "-1", f"--before={when.isoformat()}",
                        "--format=%H", branch], capture_output=True, text=True)
    sha = r.stdout.strip()
    if r.returncode != 0 or not sha:
        return None
    r = subprocess.run(["git", "-C", str(root), "show", f"{sha}:.copier-answers.yml"],
                       capture_output=True, text=True)
    m = _ANSWERS_COMMIT.search(r.stdout) if r.returncode == 0 else None
    return m.group(1) if m else None


def _percentile(values: list[float], q: float) -> float:
    """Nearest-rank percentile: honest for small n (P90 of 3 values is the largest)."""
    ordered = sorted(values)
    k = max(0, min(len(ordered) - 1, -(-int(q * 100) * len(ordered) // 100) - 1))
    return ordered[k]


def flow_items(root: Path, *, issue: int | None = None, branch: str | None = None,
               follow_up_days: int = _FOLLOW_UP_DAYS, now: datetime | None = None) -> list[dict]:
    """One timeline per issue; every value is {"value", "quality"} where quality
    is measured, estimated or missing."""
    import check_review as _review  # noqa: PLC0415

    now = now or datetime.now(timezone.utc)
    common = _common_dir(root)
    integration = branch or _default_branch()
    starts = _phase_starts(common)
    reports = [r for recs in _reports_by_worker(root).values() for r in recs]
    rows = _train_rows(common)
    # which branches carried which issue: the reports say it, else the branch name
    branches_of: dict[int, set[str]] = defaultdict(set)
    for rep in reports:
        b = rep.get("worker") or rep.get("branch")
        if b and str(rep.get("issue") or "").isdigit():
            branches_of[int(rep["issue"])].add(b)
    for st in starts:
        n = _review.branch_issue(st["branch"])
        if n and str(n).isdigit():
            branches_of[int(n)].add(st["branch"])
    wanted = [issue] if issue is not None else sorted(branches_of)
    regressions = _regressions(root, integration)
    decisions = _owner_decisions(root)
    try:
        import dispatch as _dispatch  # noqa: PLC0415 — one reader of transcripts
    except ImportError:  # pragma: no cover — dispatch is core
        _dispatch = None
    items = []
    for n in wanted:
        bs = branches_of.get(n, set())
        own_starts = sorted((s for s in starts if s["branch"] in bs), key=lambda s: s["ts"])
        own_reports = sorted(((r, t) for r in reports
                              if (r.get("worker") in bs or r.get("branch") in bs
                                  or str(r.get("issue")) == str(n))
                              and (t := _aware(r.get("ts"))) is not None), key=lambda rt: rt[1])
        start = {"value": own_starts[0]["ts"], "quality": "measured"} if own_starts else (
            {"value": own_reports[0][1], "quality": "estimated"} if own_reports else
            {"value": None, "quality": "missing"})
        done = [t for r, t in own_reports if r.get("state") == "done"]
        merged = {"value": done[-1], "quality": "measured"} if done else {"value": None, "quality": "missing"}
        deployed = {"value": None, "quality": "missing"}
        for row in rows:
            if bs & set(row.get("branches") or []):
                ended = _aware(row.get("ended"))
                if row.get("deployed") is True and ended:
                    deployed = {"value": ended, "quality": "measured"}
                elif row.get("deployed") is None and deployed["value"] is None:
                    deployed = {"value": None, "quality": "not configured"}
        end = deployed if deployed["value"] else merged
        work = 0.0
        unended = 0
        for s in own_starts:
            fin = next((t for r, t in own_reports if t >= s["ts"]
                        and (r.get("worker") == s["branch"] or r.get("branch") == s["branch"])
                        and r.get("state") in _PHASE_ENDS[s["phase"]]), None)
            if fin is None:
                unended += 1
            else:
                work += (fin - s["ts"]).total_seconds()
        lead = wait = None
        if start["value"] and end["value"]:
            lead = (end["value"] - start["value"]).total_seconds()
            wait = max(0.0, lead - work)
        quality = ("missing" if lead is None else
                   "measured" if start["quality"] == end["quality"] == "measured" and not unended
                   else "estimated")
        escapes = None
        if merged["value"]:
            horizon = merged["value"] + timedelta(days=follow_up_days)
            escapes = sum(1 for t in regressions.get(n, []) if merged["value"] <= t <= horizon)
            window_open = now < horizon
        else:
            window_open = None
        tokens = _dispatch.issue_token_usage(root, n) if _dispatch else None
        items.append({
            "issue": n, "branches": sorted(bs),
            "start": start, "merged": merged, "deployed": deployed,
            "lead_s": {"value": lead, "quality": quality},
            "work_s": {"value": work if own_starts else None,
                       "quality": "missing" if not own_starts else ("estimated" if unended else "measured")},
            "wait_s": {"value": wait, "quality": quality},
            "tokens": {"value": tokens[0] if tokens else None, "sessions": tokens[1] if tokens else 0,
                       "quality": "measured" if tokens else "missing"},
            "owner_decisions": {"value": decisions.get(n, 0), "quality": "proxy"},
            "escapes": {"value": escapes, "quality": "measured" if escapes is not None else "missing",
                        "window_open": window_open, "days": follow_up_days},
            "process_version": {"value": _process_version(root, integration, merged["value"]),
                                "quality": "measured" if merged["value"] else "missing"},
        })
    return items


def _hours(seconds: float | None) -> str:
    return "—" if seconds is None else f"{seconds / 3600:.1f} h"


def _token_text(tok: dict) -> str:
    if tok["value"] is None:
        return "tokens not measured"
    v = tok["value"]
    names = (("output_tokens", "out"), ("input_tokens", "in"),
             ("cache_read_input_tokens", "cache read"), ("cache_creation_input_tokens", "cache write"))
    parts = [f"{label} {v[k]:,}" for k, label in names if k in v]
    return f"tokens {' / '.join(parts) or 'none recorded'} ({tok['sessions']} session(s))"


def flow(root: Path | None = None, *, issue: int | None = None, as_json: bool = False,
         follow_up_days: int = _FOLLOW_UP_DAYS) -> int:
    import json  # noqa: PLC0415

    root = root or Path.cwd()
    items = flow_items(root, issue=issue, follow_up_days=follow_up_days)
    if as_json:
        def _plain(o):
            return o.isoformat() if isinstance(o, datetime) else str(o)
        print(json.dumps(items, indent=2, default=_plain))
        return 0
    print("[flow] per issue — first dispatched phase to deploy (else merge); "
          "measured / estimated / missing per field")
    if not items:
        print("  no dispatched issue found (dispatch logs, worker reports) — flow skipped")
        return 0
    for it in items:
        esc = it["escapes"]
        esc_text = ("escapes not measurable (no merge)" if esc["value"] is None else
                    f"escapes {esc['value']} in {esc['days']} d" + (" (window still open)" if esc["window_open"] else ""))
        print(f"  #{it['issue']}: lead {_hours(it['lead_s']['value'])} [{it['lead_s']['quality']}] "
              f"(work {_hours(it['work_s']['value'])}, wait {_hours(it['wait_s']['value'])}) · "
              f"start {it['start']['quality']} · merge {it['merged']['quality']} · "
              f"deploy {it['deployed']['quality']} · {_token_text(it['tokens'])} · "
              f"owner decisions {it['owner_decisions']['value']} (proxy) · {esc_text} · "
              f"process {it['process_version']['value'] or 'unknown'}")
    leads = [it["lead_s"]["value"] for it in items if it["lead_s"]["value"] is not None]
    measured = [it for it in items if it["lead_s"]["quality"] == "measured"]
    if leads:
        works = [it["work_s"]["value"] for it in items if it["lead_s"]["value"] is not None
                 and it["work_s"]["value"] is not None]
        waits = [it["wait_s"]["value"] for it in items if it["wait_s"]["value"] is not None]
        print(f"  lead median {_hours(statistics.median(leads))}, P90 {_hours(_percentile(leads, 0.9))} "
              f"over n={len(leads)} ({len(measured)} fully measured)"
              + (f"; work median {_hours(statistics.median(works))}" if works else "")
              + (f", wait median {_hours(statistics.median(waits))}" if waits else ""))
    n = len(measured)
    level = _level(n, False, len(measured) < len(items), _N_THRESHOLD)
    print(f"  {confidence(n, sample_biased=len(measured) < len(items))} · "
          f"{action(level, 'the larger of work and wait is the lever: wait → steward hand-offs, questions, the train; work → rounds (`rounds`) and context', thin='let more issues run through dispatch, reports and the train before acting on a duration')}")
    print("  recovery time: not measured (no incident records)")
    return 0


def report() -> int:
    print("=== process KPI cockpit (read-only) ===\n")
    cost(None)
    print()
    cfr(None)
    print()
    clusters(None)
    print()
    share()
    print()
    flow()
    return 0


def main() -> int:
    p = argparse.ArgumentParser(description="process KPI cockpit (read-only)")
    sub = p.add_subparsers(dest="cmd")
    k = sub.add_parser("cost")
    k.add_argument("--transcripts")
    k.add_argument("--issue", type=int,
                   help="one issue's dispatched sessions (policy `transcripts`)")
    c = sub.add_parser("cfr")
    c.add_argument("--branch")
    cl = sub.add_parser("clusters")
    cl.add_argument("--branch")
    cl.add_argument("--window", type=int, default=_CLUSTER_WINDOW_DAYS,
                    help="days of history to cluster (default 14)")
    cl.add_argument("--min", type=int, default=_CLUSTER_MIN, dest="min_cluster",
                    help="minimum fixes to call it a cluster (default 3)")
    sub.add_parser("models")
    sub.add_parser("rounds")
    sh = sub.add_parser("share")
    sh.add_argument("--weeks", type=int, default=4)
    tp = sub.add_parser("train-phases")
    tp.add_argument("--runs", type=int, default=20)
    fl = sub.add_parser("flow")
    fl.add_argument("--issue", type=int)
    fl.add_argument("--json", action="store_true")
    fl.add_argument("--follow-up-days", type=int, default=_FOLLOW_UP_DAYS,
                    help="how long after the merge an escape counts (default 30)")
    sub.add_parser("report")
    args = p.parse_args()

    if args.cmd == "models":
        return models()
    if args.cmd == "rounds":
        return rounds()
    if args.cmd == "share":
        return share(args.weeks)
    if args.cmd == "train-phases":
        return train_phases(args.runs)
    if args.cmd == "flow":
        return flow(issue=args.issue, as_json=args.json, follow_up_days=args.follow_up_days)

    if args.cmd == "cost" and args.issue is not None:
        import dispatch  # one reader of dispatch records, policy and transcripts
        print(f"[cost] issue #{args.issue} ~approx — {dispatch.tokens_line(ROOT, args.issue)}")
        return 0
    if args.cmd == "cost":
        return cost(args.transcripts)
    if args.cmd == "cfr":
        return cfr(args.branch)
    if args.cmd == "clusters":
        return clusters(args.branch, args.window, args.min_cluster)
    return report()


if __name__ == "__main__":
    raise SystemExit(main())
