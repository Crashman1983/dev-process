# --- load: how much process each merge carries ------------------------------------
_LOAD_WEEKS = 4


def _outside(events: list[dict], key: str) -> int | None:
    """Stray lines of the events; None when git could not read any of them."""
    got = [e.get(key, 0) for e in events if e.get("strays")]
    return None if any(n is None for n in got) else sum(got)


def load_table(root: Path, *, weeks: int = _LOAD_WEEKS, now: datetime | None = None) -> dict:
    """Week by week over the merge events (one event counts once, whatever issues it
    carries): process and product lines and their ratio, the median process files per merge,
    merges without a product file, and the lines committed outside any merge range (strays,
    counted with the event that follows them). An event whose range is unknown counts apart."""
    now = now or datetime.now(timezone.utc)
    got = merge_events(root)
    if got["events"] is None:
        return {"available": False, "why": got["why"], "weeks": [], "shallow": False}
    rows = []
    for w in range(weeks):
        hi = now - timedelta(days=7 * w)
        lo = hi - timedelta(days=7)
        evs = [e for e in got["events"] if lo <= e["when"] < hi]
        known = [e for e in evs if e["product_lines"] is not None]
        prod = sum(e["product_lines"] for e in known)
        proc = sum(e["process_lines"] for e in known)
        rows.append({"week": -w, "merges": len(evs), "unknown": len(evs) - len(known),
                     "product_lines": prod if known else None, "process_lines": proc if known else None,
                     "ratio": round(proc / prod, 2) if known and prod else None,
                     "process_files_median": (statistics.median(len(e["process_files"]) for e in known)
                                              if known else None),
                     "without_product": sum(1 for e in known if not e["files"]) if known else None,
                     "outside_process_lines": _outside(evs, "stray_process_lines"),
                     "outside_product_lines": _outside(evs, "stray_product_lines")})
    return {"available": True, "why": None, "weeks": rows, "shallow": got["shallow"]}


def load(root: Path | None = None, weeks: int = _LOAD_WEEKS, *, as_json: bool = False) -> int:
    import json  # noqa: PLC0415
    root = root or Path.cwd()
    t = load_table(root, weeks=weeks)
    if as_json:
        print(json.dumps(t, default=str, sort_keys=True))
        return 0
    print("[load] process against product lines per merge, week by week ~proxy — "
          "paths classify (tower.is_process_path), not effort")
    if not t["available"]:
        print(f"  git not read ({t['why']}) — load skipped")
        return 0
    if t["shallow"]:
        print("  shallow clone — history before its boundary is missing, the first range unknown")
    for r in t["weeks"]:
        if not r["merges"]:
            print(f"  week {r['week']}:    0 merges")
            continue
        ratio = "—" if r["ratio"] is None else f"{r['ratio']:g}"
        print(f"  week {r['week']}: {r['merges']:>4} merges — product {_num(r['product_lines'])} lines, process "
              f"{_num(r['process_lines'])} lines ({ratio} per product line); process files per merge median "
              f"{_num(r['process_files_median'])}; {_num(r['without_product'])} merges without a product file"
              + (f"; {r['unknown']} with an unknown range" if r["unknown"] else "")
              + (f"; outside merge ranges: process {_num(r['outside_process_lines'])}, product "
                 f"{_num(r['outside_product_lines'])} lines"
                 if r["outside_process_lines"] != 0 or r["outside_product_lines"] != 0 else ""))
    trend = " → ".join("—" if r["ratio"] is None else f"{r['ratio']:g}" for r in reversed(t["weeks"]))
    print(f"  trend, process lines per product line (oldest week first): {trend}")
    n = sum(r["merges"] for r in t["weeks"])
    print(f"  {confidence(n, proxy=True)} — paths classify, not effort; `share` counts the same split in commits")
    print(f"  -> {action('low', '', thin='a rising ratio over weeks while product lines fall is the signal: look where the process lines go (plans, attests, journals) before adding a rule (optimization.md)')}")
    return 0


# --- size: rounds by the size and spread of a work --------------------------------
SIZE_STEPS = ("<200", "200-500", "500-1500", ">1500")  # product lines of a work
_TOP_FILES = 15


def _size_step(lines: int) -> str:
    # each boundary in one step only: 200 and 500 open the next step, 1500 closes its own
    return "<200" if lines < 200 else "200-500" if lines < 500 else "500-1500" if lines <= 1500 else ">1500"


def _round_cell(members: list[dict]) -> dict:
    rounded = [w["rounds"] for w in members if w["rounds"] is not None]
    return {"works": len(members), "rounds_median": statistics.median(rounded) if rounded else None,
            "share_3plus": round(sum(r >= 3 for r in rounded) / len(rounded), 2) if rounded else None}


def _stacks(root: Path) -> list[dict] | str:
    """The stacks of `testing.local.json`; NOT_READ without one, with a broken one, or with
    no stack in it."""
    import testing_config  # noqa: PLC0415 — the configuration's one reader
    try:
        cfg = testing_config.load(root)
    except testing_config.ConfigError:
        return NOT_READ
    return cfg["stacks"] if cfg and cfg["stacks"] else NOT_READ


def _window_end(root: Path, ref: str, hi: datetime) -> str | None:
    if hi >= _ALL_TIME[1]:
        return ref
    return (_git_out(root, "rev-list", "-1", "--first-parent", f"--before={hi.isoformat()}", ref) or "").strip() or None


def size_table(root: Path, lo: datetime = _ALL_TIME[0], hi: datetime = _ALL_TIME[1], *,
               items: list[dict] | None = None) -> dict:
    """Over the works merged in the window: review rounds by product lines (count, median,
    share with >= 3 rounds, rounds per 100 product lines and process lines per product line,
    each a sum over a sum); rounds for work in one stack against several (`test_select`'s
    stack of a path); the product files most works touched with the median of the other
    product files touched alongside; the share of the window's product lines on files gone at
    its end, renames followed forward over the window's merge events."""
    items = flow_items(root) if items is None else items
    merged = _merged_in(items, lo, hi)
    plans, rounds = _plans(root), _review_rounds(root)
    got = merge_events(root)
    events = [e for e in got["events"] or [] if lo <= e["when"] < hi and e["product_lines"] is not None]
    # forward renames over the window: a file renamed later lives on under its new name
    current: dict[str, str] = {}
    lines_on: dict[str, int] = {}
    for e in events:
        moved = dict(e["renames"])
        for key, name in current.items():
            current[key] = moved.get(name, name)
        for old, new in moved.items():  # a file first merged before the window
            current.setdefault(old, new)
        for path, n in e["files"].items():
            current.setdefault(path, path)
            lines_on[path] = lines_on.get(path, 0) + n
    works_ = []
    for it in merged:
        r = _rounds_of_issue(root, rounds, it["issue"], plans)
        works_.append({"issue": it["issue"], "rounds": r["max_round"] if r else None,
                       "lines": (it.get("product_lines") or {}).get("value"),
                       "process": (it.get("process_lines") or {}).get("value"),
                       "files": {current.get(f, f) for f in it.get("files") or {}}})
    buckets: dict[str, dict] = {}
    for label in SIZE_STEPS:
        members = [w for w in works_ if w["lines"] is not None and _size_step(w["lines"]) == label]
        both = [w for w in members if w["rounds"] is not None]
        lines = sum(w["lines"] for w in both)
        # n/a: the step has no product lines; None: none of its works has a review round
        per_100 = (None if not both and any(w["lines"] for w in members) else
                   round(100 * sum(w["rounds"] for w in both) / lines, 2) if lines else "n/a")
        with_process = [w for w in members if w["process"] is not None]
        product = sum(w["lines"] for w in with_process)
        buckets[label] = {**_round_cell(members),
                          "rounds_per_100_lines": per_100,
                          "process_per_product_line": round(sum(w["process"] for w in with_process) / product, 2)
                          if product else "n/a"}
    stacks = _stacks(root)
    spread: dict | str = stacks if isinstance(stacks, str) else {}
    if not isinstance(stacks, str):
        import test_select  # noqa: PLC0415 — the one stack-of-a-path rule
        groups: dict[str, list[dict]] = {"one stack": [], "several stacks": [], "no stack": []}
        for w in works_:
            if not w["files"]:
                continue
            names = {s["name"] for f in w["files"] if (s := test_select._stack_of(stacks, f))}
            groups["no stack" if not names else "one stack" if len(names) == 1 else "several stacks"].append(w)
        spread = {name: _round_cell(members) for name, members in groups.items()}
    # code files only: shared documents, contracts and build files collect unrelated works and
    # crowded out the code that couples (dry run on a consumer clone); `_CODE_EXT` is the owner
    touched: dict[str, list[int]] = {}
    for w in works_:
        code = [f for f in w["files"] if Path(f).suffix.lower() in _CODE_EXT]
        for f in code:
            touched.setdefault(f, []).append(len(code) - 1)
    top = [{"file": f, "works": len(co), "co_files_median": statistics.median(co)}
           for f, co in sorted(touched.items(), key=lambda kv: (-len(kv[1]), kv[0]))[:_TOP_FILES]]
    vanished: dict | None = None
    end = _window_end(root, got["ref"], hi) if got["ref"] and events else None
    listed = _git_out(root, "ls-tree", "-r", "-z", "--name-only", end) if end else None
    if listed is not None:
        tree = set(listed.split("\0"))
        gone = sum(n for key, n in lines_on.items() if current[key] not in tree)
        total = sum(lines_on.values())
        vanished = {"lines": gone, "of": total, "share": round(gone / total, 2) if total else None}
    return {"buckets": buckets, "unknown_lines": sum(1 for w in works_ if w["lines"] is None),
            "stacks": spread, "top_files": top, "vanished": vanished,
            "population": _population(root, merged, lo, hi, plans, rounds)}


def _cell_text(c: dict) -> str:
    share = "—" if c["share_3plus"] is None else f"{round(100 * c['share_3plus'])} %"
    return f"n={c['works']}, rounds median {_num(c['rounds_median'])}, >=3 rounds {share}"


