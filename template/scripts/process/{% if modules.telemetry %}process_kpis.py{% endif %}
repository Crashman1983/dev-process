#!/usr/bin/env python3
# /// script
# requires-python = ">=3.11"
# dependencies = ["pyyaml>=6,<7"]
# ///
"""Process KPI cockpit — a read-only aggregator over EXISTING traces.

Reads the artifacts the workflow already produces (review records, git
history, `gh` issue data, optional harness transcripts) and cuts them into
decision families. It is not a measurement pipeline: no new instrumentation,
no hook/gate/daemon, only reading. It never blocks and never mutates.

Guiding principle: measured numbers carry confidence and an action. A number that yields no action does not belong
in the cockpit. Confidence is `high`
(direct measure, enough n), `medium` (sample-biased), or `low` (proxy or thin
n) — proxy measures never reach `high`, because confounding cannot be filtered out.
At `low`, the only action is to collect more data; never act on a thin or
biased number. n before percent.

Numbers are within-project only: they compare a project against its own
baseline over time (trends, ratios, catch/escape events). Cross-project
comparison is meaningless — criterion granularity and domain dominate the
difference. See "honest ceiling" in the module doc.

  process_kpis.py cost          [--transcripts DIR] [--issue N]
  process_kpis.py cfr           [--branch B]
  process_kpis.py clusters      [--branch B] [--window D] [--min N]
                                                # fix clusters (rule 6 across sessions)
  process_kpis.py models                        # token share per model; rounds-to-pass and
                                                # blocks by phase model × tier
  process_kpis.py rounds                        # per work item: rounds to pass, blockers by origin; by kind;
                                                # per round number: blockers, still blocked, cost
  process_kpis.py baseline      [--window S:U]… [--json]
                                                # per window: medians per merged work, escapes per tier
  process_kpis.py works         [--window S:U] [--json]
                                                # per merged work: rounds, lead, sessions, product lines
  process_kpis.py load          [--weeks N] [--json]
                                                # process vs product lines per merge, week by week
  process_kpis.py size          [--window S:U] [--json]
                                                # rounds by size and stacks; churn on vanished files
  process_kpis.py share         [--weeks N]     # process vs product, week by week
  process_kpis.py train-phases  [--runs N]      # where the merge train's time goes, phase by phase
  process_kpis.py flow          [--issue N] [--json] [--follow-up-days D]
                                                # one issue, first phase to deploy: work, wait,
                                                # tokens, owner decisions, escapes, process version
  process_kpis.py losses        [--days D] [--json]
                                                # four separate loss measures over flow:
                                                # occupancy, delay, owner effort, tokens
  process_kpis.py outcomes      [--days D] [--json]
                                                # value: epics to usable, disruptive bugs to
                                                # fixed; bug origin coverage (cause × channel)
  process_kpis.py nodes         [--days D] [--json]
                                                # per gate: cost, blocks, distinct inputs,
                                                # sole blocks, flips, triaged blocks
  process_kpis.py report                        # cost, cfr, clusters, share, flow, losses, nodes,
                                                # baseline, works, load, size

Lean pass: the error rate at the gate is read from the review records
(`rounds`, `models`), the error rate after merge from git (`cfr`,
`clusters`). The removed families (GRADE convergence, effectiveness,
calibration suite, tempo, friction) live in git history if a project ever
needs them back.

Stdlib itself; the header declares PyYAML for `rounds`, whose FINDING reader
(check_issues) imports it — `uv run` resolves it, and without it `rounds`
names the missing dependency. Not a gate. Reads only; never writes.
"""
from __future__ import annotations

import argparse
import re
import statistics
import subprocess
import sys
from collections import defaultdict
from datetime import datetime, timedelta, timezone
from pathlib import Path
from typing import NamedTuple
from urllib.parse import unquote

ROOT = Path(__file__).resolve().parents[2]
sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parent))  # sibling import

# --- thresholds, with their honesty labels -------------------------------
_N_THRESHOLD = 20
# Cycle-time p90 threshold (days): an UNCALIBRATED heuristic — the output says
# so, lest an "unremarkable p90" borrow authority from a guessed number.
_ISSUE_LIMIT = 100
# DORA change-failure window: a later fix: within this many days counts.
_CFR_WINDOW_DAYS = 7
_GIT_LIMIT = 300
# Only real source-code extensions count for CFR file overlap — process
# artifacts (journals, registries) change with almost every commit and would
# fabricate failures.
_CODE_EXT = {
    ".py", ".ts", ".tsx", ".js", ".jsx", ".mjs", ".vue", ".svelte",
    ".go", ".rs", ".java", ".kt", ".kts", ".rb", ".php", ".cs", ".scala",
    ".c", ".cc", ".cpp", ".h", ".hpp", ".m", ".mm", ".swift", ".css",
}
_CONV_COMMIT = re.compile(r"^(feat|fix)(\(.+?\))?!?:", re.IGNORECASE)


# --- confidence framing ----------------------------------------------------
def _level(n: int | None, proxy: bool, sample_biased: bool, threshold: int) -> str:
    if proxy or (n is not None and n < threshold):
        return "low"
    if sample_biased:
        return "medium"
    return "high"


def confidence(n: int | None = None, *, proxy: bool = False,
               sample_biased: bool = False, threshold: int = _N_THRESHOLD) -> str:
    level = _level(n, proxy, sample_biased, threshold)
    reasons: list[str] = []
    if proxy:
        reasons.append("proxy, confounded")
    if n is not None and n < threshold:
        reasons.append(f"n={n}<{threshold}")
    if sample_biased:
        reasons.append("sample not representative")
    if not reasons:
        reasons.append(f"direct, n={n}" if n is not None else "direct")
    return f"confidence: {level} ({'; '.join(reasons)})"


def action(level: str, ready: str, *, thin: str) -> str:
    """At low confidence the only action is the measuring one; the named
    action applies only once the number can carry it."""
    if level == "low":
        return f"action: {thin}"
    return f"action: {ready or thin}"



# --- cost: optional harness tokens ----------------------------------------
def session_output_tokens(transcript_dir: Path) -> dict[str, int]:
    """Output tokens per transcript file (~approx: per session, not per work
    item; the JSONL 'output_tokens' shape is harness-specific)."""
    from dispatch import OUTPUT_TOKENS  # one reader of the transcript shape
    out: dict[str, int] = {}
    if not transcript_dir.is_dir():
        return out
    for f in sorted(transcript_dir.glob("*.jsonl")):
        total = sum(int(m) for m in OUTPUT_TOKENS.findall(f.read_text(errors="ignore")))
        if total:
            out[f.stem] = total
    return out


def cost(transcripts: str | None) -> int:
    print("[cost] ~approx")
    if transcripts:
        tokens = session_output_tokens(Path(transcripts))
        if tokens:
            vals = list(tokens.values())
            # The decision number is the median per session (budget lever per
            # unit of work); the cumulative sum carries no decision — context only.
            print(f"  output tokens/session: median {int(statistics.median(vals)):,} "
                  f"({sum(vals):,} total over {len(vals)} sessions, cumulative — context)")
            print(f"  {confidence(len(vals))}")
        else:
            print(f"  no transcript tokens found under {transcripts}")
    else:
        print("  tokens: not read (pass --transcripts DIR with harness "
              "transcript JSONL; harness-specific)")
    return 0


# --- cfr: DORA change failure rate (proxy) ------------------------------------
def _commit_kind(subject: str) -> str | None:
    m = _CONV_COMMIT.match(subject)
    return m.group(1).lower() if m else None


def _code_files(files: set[str]) -> set[str]:
    return {f for f in files if any(f.endswith(e) for e in _CODE_EXT)}


def change_failure_rate(commits: list[dict], window_days: int = _CFR_WINDOW_DAYS) -> dict:
    """Share of feat: changes followed by a corrective fix: within the window
    that shares at least one CODE file — the closest honest CFR without deploy
    events. Doc-only feats are not deployable changes and do not count."""
    feats = [(c, _code_files(c["files"])) for c in commits
             if _commit_kind(c["subject"]) == "feat"]
    feats = [(c, cf) for c, cf in feats if cf]
    fixes = [(c, _code_files(c["files"])) for c in commits
             if _commit_kind(c["subject"]) == "fix"]
    failed = 0
    for fe, fe_code in feats:
        for fx, fx_code in fixes:
            if (fx["ts"] > fe["ts"]
                    and (fx["ts"] - fe["ts"]).days <= window_days
                    and (fe_code & fx_code)):
                failed += 1
                break
    rate = (100.0 * failed / len(feats)) if feats else 0.0
    return {"feats": len(feats), "fixes": len(fixes), "failed": failed, "rate": rate}


# --- fix clusters: rule 6 across sessions --------------------------------
# Rule 6's two-attempt counter lives in the session; sessions end. A behaviour
# that collects fix after fix across days looks like a first attempt from
# inside every one of them. The durable counter is the commit history — this
# family reads it and names clusters of fix: commits sharing a salient
# subject token. Advisory only: a cluster is the signal to stop path-patching
# and write the invariant record (Type: invariant, adr/template.md) with its
# table test.
_CLUSTER_WINDOW_DAYS = 14
_CLUSTER_MIN = 3
# subject words that carry no behaviour identity (articles, glue verbs the
# conventional style produces constantly). Tokens shorter than 4 chars are
# dropped anyway.
_CLUSTER_STOP = {
    "the", "a", "an", "and", "for", "with", "into", "from", "that", "this",
    "its", "own", "one", "two", "not", "out", "when", "every", "only",
    "let", "make", "keep", "give", "pass", "carry", "mark", "keep", "hear",
    "reach", "behind", "through", "over", "under", "after", "before",
    "test", "tests", "fix", "fixes", "again", "back", "path", "state",
}


def _fix_tokens(subject: str) -> set[str]:
    """Salient identity tokens of a fix: subject — the conventional scope
    plus every >=4-char word outside the stoplist."""
    tokens: set[str] = set()
    m = re.match(r"^fix\((?P<scope>[^)]+)\)!?:\s*(?P<tail>.*)$", subject,
                 re.IGNORECASE)
    tail = subject
    if m:
        tail = m.group("tail")
    else:
        m2 = re.match(r"^fix!?:\s*(?P<tail>.*)$", subject, re.IGNORECASE)
        if m2:
            tail = m2.group("tail")
    for w in re.findall(r"[a-zA-Z][a-zA-Z-]{3,}", tail):
        w = w.lower().strip("-")
        if len(w) >= 4 and w not in _CLUSTER_STOP:
            tokens.add(w)
    return tokens


def fix_clusters(commits: list[dict],
                 window_days: int = _CLUSTER_WINDOW_DAYS,
                 min_cluster: int = _CLUSTER_MIN) -> list[dict]:
    """Clusters of fix: commits in the window, largest first, in two kinds:
    kind="token" (shared subject word — precise, but blind to synonyms and
    to non-English vocabularies) and kind="file" (shared CODE file —
    language-independent, but a hot file collects unrelated fixes). A
    cluster whose commit set is a subset of an already reported one is
    folded away (it re-names the same cluster); token clusters report
    first, so the file dimension only adds what wording missed."""
    fixes = [c for c in commits if _commit_kind(c["subject"]) == "fix"]
    if not fixes:
        return []
    newest = max(c["ts"] for c in fixes)
    fixes = [c for c in fixes if (newest - c["ts"]).days <= window_days]
    by_token: dict[str, list[dict]] = defaultdict(list)
    for c in fixes:
        for t in _fix_tokens(c["subject"]):
            by_token[t].append(c)
    by_file: dict[str, list[dict]] = defaultdict(list)
    for c in fixes:
        for f in _code_files(c["files"]):
            by_file[f].append(c)
    clusters: list[dict] = []
    seen: list[set[int]] = []
    for kind, groups in (("token", by_token), ("file", by_file)):
        for key, cs in sorted(groups.items(), key=lambda kv: (-len(kv[1]), kv[0])):
            if len(cs) < min_cluster:
                continue
            ids = {id(c) for c in cs}
            if any(ids <= s for s in seen):
                continue
            seen.append(ids)
            days = (max(c["ts"] for c in cs) - min(c["ts"] for c in cs)).days
            label = key if kind == "token" else key.rsplit("/", 1)[-1]
            clusters.append({"kind": kind, "token": label, "count": len(cs),
                             "days": days,
                             "subjects": [c["subject"] for c in cs]})
    return clusters


def clusters(branch: str | None,
             window_days: int = _CLUSTER_WINDOW_DAYS,
             min_cluster: int = _CLUSTER_MIN) -> int:
    print(f"[clusters] fix clusters, last {window_days} d ~advisory")
    try:
        b = branch or _default_branch()
        commits = _git_commits(b)
    except (subprocess.CalledProcessError, OSError) as exc:
        print(f"  not a git repository, git missing, or branch not resolvable "
              f"({type(exc).__name__}) — clusters skipped")
        return 0
    if not any(_commit_kind(c["subject"]) == "fix" for c in commits):
        print(f"  no 'fix:' commits on {b} — this detector reads Conventional "
              f"Commits; without 'fix:' subjects it is blind, not green")
        return 0
    found = fix_clusters(commits, window_days, min_cluster)
    if not found:
        print(f"  no cluster of >={min_cluster} fix: commits sharing a "
              f"subject token or code file on {b} — nothing to escalate")
        return 0
    # the advisory names the worst offenders, not every echo — overlapping
    # clusters largely describe the same behaviour from another angle
    shown, rest = found[:5], found[5:]
    if rest:
        print(f"  top 5 of {len(found)} clusters (the rest mostly "
              f"re-name these)")
    for cl in shown:
        kind = "" if cl["kind"] == "token" else \
            "file " if cl["kind"] == "file" else f"{cl['kind']} "
        note = "" if cl["kind"] == "token" else \
            "  (hot files collect unrelated fixes — read before believing)"
        print(f"  {kind}'{cl['token']}': {cl['count']} fix commits in "
              f"{cl['days']} d{note}")
        for s in cl["subjects"][:6]:
            print(f"    - {s}")
        if len(cl["subjects"]) > 6:
            print(f"    ... and {len(cl['subjects']) - 6} more")
    print("  -> a cluster is rule 6's counter surviving the session: stop "
          "path-patching, write the invariant record (Type: invariant, "
          "docs/process/adr/template.md) and pin the WHOLE rule with a "
          "table/property test — the next path-fix grows that table instead")
    return 0


def _default_branch() -> str:
    for b in ("main", "master"):
        if subprocess.run(["git", "rev-parse", "--verify", "--quiet", b],
                          capture_output=True, cwd=str(ROOT)).returncode == 0:
            return b
    return "HEAD"


def _git_commits(branch: str, limit: int = _GIT_LIMIT, root: Path = ROOT) -> list[dict]:
    # -z: without it git quotes a non-ASCII name, and the same file under a
    # quoted and a plain name reads as two. Fields are NUL-separated; a
    # commit's header carries its first name after a newline.
    proc = subprocess.run(
        ["git", "log", branch, "-z", "--no-merges", "-n", str(limit), "--name-only",
         "--pretty=format:\x01%ct\x01%s"],
        capture_output=True, check=True, cwd=str(root),
    )
    commits: list[dict] = []
    cur: dict | None = None
    for field in proc.stdout.decode(errors="surrogateescape").split("\0"):
        if field.startswith("\x01"):
            header, _nl, field = field.partition("\n")
            _, ct, subject = header.split("\x01", 2)
            cur = {"subject": subject,
                   "ts": datetime.fromtimestamp(int(ct), tz=timezone.utc),
                   "files": set()}
            commits.append(cur)
        if field and cur is not None:
            cur["files"].add(field)
    return commits


def cfr(branch: str | None) -> int:
    print("[cfr] change failure rate (DORA) ~approx")
    try:
        b = branch or _default_branch()
        commits = _git_commits(b)
    except (subprocess.CalledProcessError, OSError) as exc:
        print(f"  not a git repository, git missing, or branch not resolvable "
              f"({type(exc).__name__}) — cfr skipped")
        return 0
    r = change_failure_rate(commits)
    if not r["feats"]:
        print(f"  no feat: commits with code files in the last {_GIT_LIMIT} "
              f"commits on {b}")
        return 0
    print(f"  change failure rate on {b}: {r['rate']:.1f}% "
          f"({r['failed']}/{r['feats']} feat changes with a corrective fix "
          f"<={_CFR_WINDOW_DAYS} d, code overlap)")
    print("  DORA bands: elite 0-15% · high 16-30% · medium 31-45% · low >45%")
    print(f"  {confidence(r['feats'], proxy=True)} — hot-file bursts overcount; "
          "only the trend is loadable, never the point value")
    print(f"  -> {action('low', '', thin='build a CFR trend over >=3 windows; if it rises while effectiveness shows catch>0, tighten the test/review gate. Single value: no action')}")
    return 0


# --- models: which model did which phase, and what came of it -----------------
def _reports_by_worker(root: Path) -> dict[str, list[dict]]:
    try:
        import report as _report  # sibling; the worker protocol
    except ImportError:
        return {}
    by: dict[str, list[dict]] = {}
    for rec in _report.read_reports(root, remote=True):
        by.setdefault(rec.get("worker") or "?", []).append(rec)
    return by


def _model(rec: dict) -> str:
    """The reported model with its effort when one was set (`model (effort)`,
    a cell of its own), "" when the report says the model was not measured."""
    m = rec.get("model") or ""
    if m == "not measured":  # report.UNMEASURED
        return ""
    return f"{m} ({rec['effort']})" if rec.get("effort") else m


def _plans(root: Path) -> list[tuple[str, str]]:
    """(path, unfenced text) of every plan, archived ones included."""
    import check_review as _review
    return [(rel, _review._unfenced(text))
            for rel, text in _review.record_texts(root, _review.PLAN_KINDS + ("plan-archive",)) or []]


def _issue_ids(issue, plans: list[tuple[str, str]]) -> set[str]:
    """The work ids one issue goes by: a REVIEW line or a report names its work by the
    plan's slug as often as by the number, so the ids of every plan declaring the issue
    count (`check_review._plan_work_ids`, the gate's own matching)."""
    import check_review as _review
    ids = {str(issue), f"#{issue}"}
    for rel, text in plans:
        if int(issue) in _review._plan_issue_numbers(text):
            ids |= _review._plan_work_ids(_review.plan_stem(rel), text, include_dedated=True)
    return ids


def _rounds_of_issue(root: Path, rounds: dict[str, dict], issue,
                     plans: list[tuple[str, str]] | None = None) -> dict | None:
    """The review rounds of one issue, merged over its work ids (`_issue_ids`)."""
    ids = _issue_ids(issue, _plans(root) if plans is None else plans)
    hits = [rounds[i] for i in ids if i in rounds]
    if not hits:
        return None
    heads: dict[int, set[str]] = {}
    for h in hits:
        for rnd, shas in h["heads"].items():
            heads.setdefault(rnd, set()).update(shas)
    return {"max_round": max(h["max_round"] for h in hits), "passed": any(h["passed"] for h in hits),
            "blocked": set().union(*(h["blocked"] for h in hits)), "heads": heads}


def _review_rounds(root: Path) -> dict[str, dict]:
    """work id → {max_round, passed, tier, pass_round, blocked, heads} from every REVIEW
    line in the journal: `pass_round` is the first passing round (None before
    it), `blocked` the distinct rounds with a block verdict, `heads` round → the
    reviewed heads its lines name (full SHAs only; v2.78, `_blocks_since_round1`)."""
    import check_review as _review
    out: dict[str, dict] = {}
    jdir = root / _review.JOURNAL_DIR
    if not jdir.is_dir():
        return out
    for f in jdir.glob("**/*.md"):
        recs, _e = _review.parse_review_lines(f.read_text(encoding="utf-8", errors="replace"))
        for _ln, r in recs:
            e = out.setdefault(r["work"], {"max_round": 0, "passed": False, "tier": r.get("tier"),
                                           "pass_round": None, "blocked": set(), "heads": {}})
            try:
                rnd = int(r.get("round") or 0)
            except ValueError:
                rnd = None
            if rnd is not None:
                e["max_round"] = max(e["max_round"], rnd)
                if _review.GIT_SHA.match(r.get("head") or ""):
                    e["heads"].setdefault(rnd, set()).add(r["head"])
            tier = str(r.get("tier") or "")
            if tier.isdigit() and not (str(e["tier"] or "").isdigit() and int(e["tier"]) >= int(tier)):
                e["tier"] = tier  # the highest tier any round declared
            if r.get("verdict") == "pass":
                e["passed"] = True
                if rnd is not None and (e["pass_round"] is None or rnd < e["pass_round"]):
                    e["pass_round"] = rnd
            elif r.get("verdict") == "block" and rnd is not None:
                e["blocked"].add(rnd)
    return out


def _token_share(root: Path) -> None:
    """Each model's share of the dispatched sessions' tokens, subagents
    included — whether mechanical steps really moved to a smaller model (#125)."""
    import dispatch as _dispatch  # noqa: PLC0415 — one reader of transcripts
    got = _dispatch.model_token_usage(root)
    print("[models] tokens by model ~approx — the dispatched sessions' transcripts, subagents included")
    usage, unreadable = got if got else ({}, 0)
    if not usage:
        print("  not measured (a `transcripts` glob in the model policy and dispatched sessions)")
        return
    if unreadable:
        print(f"  partial: {unreadable} transcript(s) could not be read — every share below is of what was")
    total = {m: sum(u.values()) for m, u in usage.items()}
    out = {m: u.get("output_tokens", 0) for m, u in usage.items()}
    all_total, all_out = sum(total.values()), sum(out.values())
    print(f"  {'model':<32} {'tokens':>13} {'share':>6} {'output':>11} {'share':>6}")
    for m in sorted(usage, key=lambda m: -total[m]):
        t_share = f"{total[m] / all_total:.0%}" if all_total else "—"
        o_share = f"{out[m] / all_out:.0%}" if all_out else "—"
        print(f"  {m:<32} {total[m]:>13,} {t_share:>6} {out[m]:>11,} {o_share:>6}")


def models(root: Path | None = None) -> int:
    """Per (tier, phase, model): issues seen, blocked reports, review rounds
    to the clearing pass. Reads the worker reports (what model ran which
    phase — the only trace that carries it) and the journal's REVIEW lines.
    Proxy at best: the model is what the worker reported, the rounds are
    the reviewer's count; confidence never above medium."""
    root = root or Path.cwd()
    _token_share(root)
    print("[models] ~proxy — the worker's reported model × the journal's review rounds")
    by = _reports_by_worker(root)
    if not by:
        print("  no worker reports with a model yet (report.py … --model, or PROCESS_MODEL in the session env)")
        return 0
    rounds = _review_rounds(root)
    # one issue is one unit: the LAST model reported per phase did the work
    # that the review counted (a re-dispatch with another model supersedes),
    # blocks are counted per report, rounds once per issue and phase
    cells: dict[tuple, dict] = {}
    seen_rounds: set[tuple] = set()
    for worker, recs in by.items():
        issue = next((str(r.get("issue")) for r in recs if r.get("issue")), None)
        unit = issue or worker
        last_model: dict[str, str] = {}
        for r in sorted(recs, key=lambda x: x.get("epoch", 0)):
            if _model(r) and r.get("phase"):
                last_model[r["phase"]] = _model(r)
        tier = rounds[issue].get("tier") if issue and issue in rounds else None
        for r in recs:
            m, ph = _model(r), r.get("phase") or ""
            if not m or not ph or (last_model.get(ph) != m and not isinstance(r.get("usage"), dict)):
                continue  # a superseded run shows only with tokens of its own
            cell = cells.setdefault((str(tier), ph, m), {"issues": set(), "blocked": 0, "rounds": [], "passed": 0,
                                                        "tokens": 0, "cost": 0.0, "reported": 0})
            if isinstance(r.get("usage"), dict):  # stated by the worker (`report.py --usage`, #270)
                # spent by the model that ran, superseded or not: its tokens are its own
                u = r["usage"]
                cell["tokens"] += int(u.get("input", 0)) + int(u.get("cached", 0)) + int(u.get("output", 0))
                cell["cost"] += float(u.get("cost_usd", 0) or 0)
                cell["reported"] += 1
            if last_model.get(ph) != m:
                continue  # the outcome is the last model's: a superseded run counts no issue
            cell["issues"].add(unit)
            if r.get("state") in ("blocked", "failed"):
                cell["blocked"] += 1
            key = (unit, ph, m)
            if issue and issue in rounds and ph == "execute" and key not in seen_rounds:
                seen_rounds.add(key)
                cell["rounds"].append(rounds[issue]["max_round"])
                cell["passed"] += int(rounds[issue]["passed"])
    if not cells:
        print("  reports carry no model/phase yet — start sessions via dispatch.py or set PROCESS_MODEL/PROCESS_PHASE")
        return 0
    # a crash or timeout (`failed`, #270) counts with the blocks: both end a phase without its result
    print(f"  {'tier':>4} {'phase':<8} {'model':<22} {'n':>3} {'blk/fail':>8} {'rounds→pass':>12} "
          f"{'tokens (stated)':>16} {'cost':>8}")
    for (tier, ph, m), c in sorted(cells.items()):
        n = len(c["issues"])
        avg = f"{sum(c['rounds']) / len(c['rounds']):.1f} ({c['passed']}/{len(c['rounds'])} pass)" if c["rounds"] else "—"
        tok = f"{c['tokens']:,} ({c['reported']})" if c["reported"] else "—"
        cost = f"${c['cost']:.2f}" if c["cost"] else "—"
        print(f"  {tier:>4} {ph:<8} {m:<22} {n:>3} {c['blocked']:>8} {avg:>12} {tok:>16} {cost:>8}")
    n = len({u for c in cells.values() for u in c["issues"]})
    lvl = _level(n, True, False, _N_THRESHOLD)
    print(f"  {confidence(n, proxy=True)} · {action(lvl, 'compare execute models within one tier: more rounds to pass is the price of the cheaper model', thin='keep dispatching with the policy; judge after ~20 issues per cell')}")
    return 0


def execution(root: Path | None = None) -> int:
    """Per execution mode (`report.py … --execution`, `/execute`): issues, review
    rounds to the clearing pass and blocked rounds — does delegating a packet to a
    subagent cost review rounds the saved context does not pay for? An issue whose
    packets ran both ways counts as `mixed`. Proxy: the mode is what the session
    reported, the rounds are the reviewer's count."""
    root = root or Path.cwd()
    print("[execution] ~proxy — the reported packet mode × the journal's review rounds")
    modes: dict[str, set] = {}
    for recs in _reports_by_worker(root).values():
        for r in recs:
            if r.get("issue") and r.get("execution"):
                modes.setdefault(str(r["issue"]), set()).add(r["execution"])
    if not modes:
        print("  nothing measured yet — `/execute` reports each packet's mode "
              "(report.py … --execution delegate|retain-context)")
        return 0
    rounds = _review_rounds(root)
    cells: dict[str, dict] = {}
    for issue, seen in modes.items():
        mode = next(iter(seen)) if len(seen) == 1 else "mixed"
        cell = cells.setdefault(mode, {"issues": 0, "rounds": [], "blocked": 0})
        cell["issues"] += 1
        if issue in rounds:
            cell["rounds"].append(rounds[issue]["pass_round"] or rounds[issue]["max_round"])
            cell["blocked"] += len(rounds[issue]["blocked"])
    print(f"  {'mode':<15} {'issues':>6} {'rounds→pass':>12} {'blocked rounds':>15}")
    for mode, c in sorted(cells.items()):
        avg = f"{sum(c['rounds']) / len(c['rounds']):.1f}" if c["rounds"] else "—"
        print(f"  {mode:<15} {c['issues']:>6} {avg:>12} {c['blocked']:>15}")
    n = sum(c["issues"] for c in cells.values())
    lvl = _level(n, True, False, _N_THRESHOLD)
    print(f"  {confidence(n, proxy=True)} · {action(lvl, 'delegate where it costs no extra rounds; retain context where it does', thin='keep recording the mode; judge after ~20 issues per mode')}")
    return 0


# --- rounds: how many review rounds a work item took, and where its blockers came from
_NO_FINDING_READER = "FINDING lines are read by check_issues — the github-issues module"


_ROUND_IN_NAME = re.compile(r"(?:^|-)r([0-9]+)$")


def _report_round(name: str, head: dict[str, list[str]]) -> int | None:
    """The round a review report belongs to (#293): its `round:` header (the bundle
    and the Codex handoff write it as attest numbers the REVIEW line), else `-r<N>`
    closing its file name (`…-review-r2.md`; `…-r2-migration-review.md` names no
    round), else None — unrounded, not counted. A header that names no single
    number is unrounded too, never read past to the file name. Named residual: a
    slug that itself ends in `-r<N>` (`…-cache-v2-r3.md`) reads as that round —
    a name cannot tell the two apart; the header wins."""
    if "round" in head:
        values = set(head["round"])
        value = values.pop() if len(values) == 1 else ""
        return int(value) if value.isascii() and value.isdigit() else None
    found = _ROUND_IN_NAME.search(Path(name).stem)
    return int(found.group(1)) if found else None


class Report(NamedTuple):
    """One review report as the counts read it (v2.78: named, so a new field never shifts
    an unpacking — #303)."""
    works: list[str]
    round: int | None
    findings: list[dict]
    head: str | None  # the reviewed head of its `artifact:` header, a full SHA; "" when that
    # header names a head that is no full SHA (`HEAD`, a branch); None without one
    unreadable: bool = False  # the file could not be read: no findings known


def _review_reports(root: Path, phase: str | None = None) -> list[Report] | str:
    """(work ids, round, FINDING fields, reviewed head) of every review report — plan reviews only
    (`phase="plan"`), the others (`"code"`) or all (None) — or why they were not read
    (`_blockers_by_work` names the cases). A report names its work in its `work:`
    header (check_review reads that header); one without counts under
    "(no work: header)". One reader for every count over reports and findings."""
    if not (Path(__file__).resolve().parent / "check_issues.py").is_file():
        return _NO_FINDING_READER
    try:
        import check_issues as _issues  # sibling; the one FINDING reader
        import check_review as _review  # sibling; the one report-header reader
    except ModuleNotFoundError as exc:
        if exc.name in ("check_issues", "check_review"):
            return _NO_FINDING_READER
        return (f"check_issues needs {exc.name} — run with it installed "
                f"(e.g. uv run --with pyyaml …)")
    except ImportError as exc:
        return f"check_issues does not import ({exc})"
    out: list[Report] = []
    rdir = root / _issues.REVIEWS_DIR
    if not rdir.is_dir():
        return out
    for p in sorted(rdir.glob("*.md")):
        try:
            text = p.read_text(encoding="utf-8", errors="replace")
        except OSError:
            out.append(Report(["(unreadable)"], None, [], None, unreadable=True))
            continue
        head = _review.report_header(text)
        is_plan = "plan" in [v.lower() for v in head.get("phase", [])]
        if phase is not None and is_plan != (phase == "plan"):
            continue
        works = [w.lstrip("#") for w in head.get("work", [])] or ["(no work: header)"]
        found = [fields for fields, err, _line in _issues.report_findings(text) if not err]
        art = _review.report_artifact(text)
        sha = art.get("head")
        out.append(Report(works, _report_round(p.name, head), found,
                          None if sha is None else (sha if _review.GIT_SHA.match(sha) else "")))
    return out


def _report_findings(root: Path, phase: str | None = None) -> list[tuple[str, dict, int | None]] | str:
    """(work id, fields, round) of every well-formed FINDING line in the review
    reports (`_review_reports`: the phase filter, the round, the reasons not read)."""
    reports = _review_reports(root, phase)
    if isinstance(reports, str):
        return reports
    return [(work, fields, r.round) for r in reports for fields in r.findings for work in r.works]


def _blockers_by_work(root: Path, key: str = "origin",
                      phase: str | None = None) -> dict[str, dict[str, int]] | str:
    """work id → {`key` value (default `origin`; `kind` too) or "-": blocker
    count} over the review reports — only plan reviews (`phase="plan"`: the
    report header says `phase: plan`) or only the others (`phase="code"`), all
    when `phase` is None — or why they were not read: the FINDING reader (check_issues, github-issues module)
    is not installed, or it is and cannot import (a missing dependency is named,
    never read as "module not there").
    A report names its work in its `work:` header (check_review reads
    that header); a report without one counts under "(no work: header)"."""
    found = _report_findings(root, phase)
    if isinstance(found, str):
        return found
    out: dict[str, dict[str, int]] = {}
    for work, fields, _round in found:
        if fields["sev"] != "blocker":
            continue
        cell = out.setdefault(work, {})
        value = fields.get(key) or "-"
        cell[value] = cell.get(value, 0) + 1
    return out


# --- baseline: the numbers a verification change must move (#277) --------------
def _window(text: str) -> tuple[datetime, datetime]:
    """`SINCE:UNTIL` (dates, UNTIL exclusive; either side may be empty)."""
    since, sep, until = text.partition(":")
    if not sep:
        raise argparse.ArgumentTypeError(f"window {text!r} is not SINCE:UNTIL")
    lo = datetime.fromisoformat(since).replace(tzinfo=timezone.utc) if since else datetime.min.replace(tzinfo=timezone.utc)
    hi = datetime.fromisoformat(until).replace(tzinfo=timezone.utc) if until else datetime.max.replace(tzinfo=timezone.utc)
    return lo, hi


def _when(value: object) -> datetime | None:
    if not value:
        return None
    try:
        got = value if isinstance(value, datetime) else datetime.fromisoformat(str(value).replace("Z", "+00:00"))
    except ValueError:
        return None
    return got if got.tzinfo else got.replace(tzinfo=timezone.utc)


NOT_READ = "not read"
# action=fix findings a round's fix pass took on, bucketed (#297: the share of next rounds
# with a fix-induced blocker grew with the size of the pass)
FIX_BUCKETS = ((0, 2, "0-2"), (3, 5, "3-5"), (6, 9, "6-9"), (10, None, ">=10"))


def _bucket(n: int) -> str:
    return next(label for lo, hi, label in FIX_BUCKETS if n >= lo and (hi is None or n <= hi))


def _round_findings(root: Path, ids: dict[object, set[str]]) -> dict:
    """Over the code reviews of the window's works (`ids`: issue → its work ids):
    `blockers_by_origin` — blocking findings by `origin=` ("-" without one) — and
    `fix_findings_vs_fix_blockers`: per bucket of `action=fix` findings in round r,
    the rounds r whose round r+1 has a report, how many of those had an `origin=fix`
    blocker and how many such blockers. The reports of one round add up; a report
    without a round (`_report_round`) is left out and counted as `unrounded`.
    Without the FINDING reader both say why they were not read."""
    reports = _review_reports(root, "code")
    if isinstance(reports, str):
        return {"blockers_by_origin": NOT_READ, "fix_findings_vs_fix_blockers": NOT_READ}
    origins: dict[str, int] = {}
    per_round: dict[tuple[object, int], dict[str, int]] = {}
    unrounded = 0
    for rep in reports:
        works, rnd, found = rep.works, rep.round, rep.findings
        issue = next((i for i, own in ids.items() if own & set(works)), None)
        if issue is None:
            continue  # not a work of this window
        for f in found:
            if f["sev"] == "blocker":
                origin = f.get("origin") or "-"
                origins[origin] = origins.get(origin, 0) + 1
        if rnd is None:
            unrounded += 1
            continue
        cell = per_round.setdefault((issue, rnd), {"fix": 0, "fix_blockers": 0})
        cell["fix"] += sum(f.get("action") == "fix" for f in found)
        cell["fix_blockers"] += sum(f["sev"] == "blocker" and f.get("origin") == "fix" for f in found)
    buckets = {label: {"rounds": 0, "with_fix_blocker": 0, "fix_blockers": 0} for _lo, _hi, label in FIX_BUCKETS}
    for (issue, rnd), cell in per_round.items():
        after = per_round.get((issue, rnd + 1))
        if after is None:
            continue  # no next round to judge the pass by
        b = buckets[_bucket(cell["fix"])]
        b["rounds"] += 1
        b["with_fix_blocker"] += after["fix_blockers"] > 0
        b["fix_blockers"] += after["fix_blockers"]
    return {"blockers_by_origin": origins,
            "fix_findings_vs_fix_blockers": {"buckets": buckets, "unrounded": unrounded}}


# --- blocks on old code (#311): a blocking finding of round >= 2 on lines round 1 saw --------
OLD_REASONS = ("no-at", "no-place", "no-line", "not-code", "no-round1", "no-head", "missing-commit",
               "outside", "git-failed", "unreadable-report")
_HUNK = re.compile(r"^@@ -\d+(?:,\d+)? \+(\d+)(?:,(\d+))? @@")
_PLACE = re.compile(r"^(?P<path>[^\s:]+)(?::(?P<first>[1-9][0-9]*)(?:-(?P<last>[1-9][0-9]*))?)?$")
_DIFF = ("--no-color", "--no-ext-diff", "--no-textconv", "--inter-hunk-context=0")


def _git_run(root: Path, *args: str, timeout: float = 30) -> tuple[int, str] | None:
    """(exit code, stdout) of git, or None when git cannot run or runs past `timeout` — the
    callers tell "not there" (an exit code git documents) from "git failed" (refute,
    round 1: a missing blob read as an absent file)."""
    import os  # noqa: PLC0415
    try:
        # a place is a path, never a glob: `pages/[id].tsx` names that file (plan review, round 3);
        # git speaks one language here (cross-model review, round 2: a translated "Binary files")
        r = subprocess.run(["git", "--literal-pathspecs", "-C", str(root), *args], capture_output=True, text=True,
                           timeout=timeout, encoding="utf-8", errors="replace",
                           env={**os.environ, "LC_ALL": "C", "LANGUAGE": "C"})
    except (OSError, ValueError, subprocess.SubprocessError):  # ValueError: a NUL in a path
        return None
    return r.returncode, r.stdout


def _git_out(root: Path, *args: str, timeout: float = 30) -> str | None:
    """git's stdout, or None when it fails or runs past `timeout` — never an empty answer."""
    r = _git_run(root, *args, timeout=timeout)
    return r[1] if r is not None and r[0] == 0 else None


def _work_group(work: str, plans: list[tuple[str, str]]) -> set[str]:
    """The work ids one report's or REVIEW line's work goes by, `#` stripped: its own, and
    those of every plan that names it (`check_review._plan_work_ids` — slug and issues,
    the matching `_issue_ids` uses) when that plan declares exactly one issue — a plan with
    two issues joins nothing: whose round its slug's lines are cannot be told."""
    import check_review as _review
    key = work.lstrip("#")
    group = {key}
    for rel, text in plans:
        ids = {str(i).lstrip("#") for i in _review._plan_work_ids(_review.plan_stem(rel), text, include_dedated=True)}
        # slug and issue join only through a plan with one issue: a plan with two names
        # neither issue's rounds the other's (refute and cross-model review, round 1 and 2)
        if key in ids and sum(i.isdigit() for i in ids) == 1:
            group |= ids
    return group


def _window_works(issues, plans: list[tuple[str, str]]) -> set[str]:
    """The work ids of a window's merged issues (`_work_group` of each): the filter of
    `_blocks_since_round1`, never another issue of a plan that declares several."""
    return set().union(*(_work_group(str(i), plans) for i in issues)) if issues else set()


class _Diffs:
    """git answers per pair of heads, asked once: commits present, renames over the whole
    tree (a path filter cuts a rename off before git detects it), the hunks of one file."""

    def __init__(self, root: Path):
        self.root, self._have, self._renames, self._hunks, self._lines, self._entries = root, {}, {}, {}, {}, {}

    def has(self, sha: str) -> bool | None:
        """The commit is here (True), not here (False), or git cannot tell (None)."""
        if sha not in self._have:
            r = _git_run(self.root, "rev-parse", "--verify", "-q", f"{sha}^{{commit}}")
            self._have[sha] = None if r is None or r[0] not in (0, 1) else r[0] == 0
        return self._have[sha]

    def renames(self, h1: str, hr: str) -> dict[str, str] | None:
        if (h1, hr) not in self._renames:
            out = _git_out(self.root, "diff", "--name-status", "-z", "-M", *_DIFF, h1, hr)
            got: dict[str, str] | None = None
            if out is not None:
                got, parts, i = {}, out.split("\0"), 0
                while i < len(parts) and parts[i]:
                    if parts[i].startswith(("R", "C")):
                        if parts[i].startswith("R"):
                            got[parts[i + 2]] = parts[i + 1]
                        i += 3
                    else:
                        i += 2
            self._renames[(h1, hr)] = got
        return self._renames[(h1, hr)]

    def lines(self, sha: str, path: str) -> int | str | None:
        """Line count of the file `path` at `sha`, as git counts lines (a `\\n` ends one; a
        form feed does not); "absent" when no such file is there (a directory included);
        None when git cannot tell."""
        if (sha, path) not in self._lines:
            got: int | str | None = self.blob(sha, path)
            if got not in (None, "absent"):
                text = _git_out(self.root, "cat-file", "blob", got)
                got = None if text is None else text.count("\n") + (1 if text and not text.endswith("\n") else 0)
            self._lines[(sha, path)] = got
        return self._lines[(sha, path)]

    def blob(self, sha: str, path: str) -> str | None:
        """The blob id of the file `path` at `sha`; "absent" when no such file is there (a
        directory included); None when git cannot tell."""
        if (sha, path) not in self._entries:
            got: str | None = None
            listed = _git_out(self.root, "ls-tree", "-z", sha, "--", path)
            if listed is not None:
                entry = next((e for e in listed.split("\0") if e.endswith("\t" + path)), "")
                meta = entry.split("\t", 1)[0].split()
                got = meta[2] if len(meta) == 3 and meta[1] == "blob" else "absent"
            self._entries[(sha, path)] = got
        return self._entries[(sha, path)]

    def hunks(self, h1: str, hr: str, old: str, new: str) -> list[tuple[int, int]] | str | None:
        """New-side (start, count) of every hunk of `old` → `new`; "binary" when the file
        changed without a text hunk; None when git fails."""
        key = (h1, hr, old, new)
        if key not in self._hunks:
            out = _git_out(self.root, "diff", "--unified=0", "-M", *_DIFF, h1, hr, "--", old, new)
            if out is None:
                got: list[tuple[int, int]] | str | None = None
            else:
                got = [(int(m.group(1)), 1 if m.group(2) is None else int(m.group(2)))
                       for m in map(_HUNK.match, out.splitlines()) if m]
                if not got and "Binary files" in out:
                    got = "binary"
            self._hunks[key] = got
        return self._hunks[key]


def _unchanged_against(d: _Diffs, h1: str, hr: str, path: str, first: int, last: int) -> bool | None:
    """Is lines first..last of `path` at `hr` as they stood at `h1` (a tree comparison, so a
    rebase between the rounds changes nothing)? None when git cannot tell. A hunk with new
    lines touches the lines it covers; a pure deletion (count 0 after new line s) touches
    s and s+1; a binary or `-diff` file that changed is changed."""
    renames = d.renames(h1, hr)
    if renames is None:
        return None
    old = renames.get(path, path)
    there = d.lines(h1, old)
    if there is None:
        return None
    if there == "absent":
        return False  # not there in round 1: the lines came later
    hunks = d.hunks(h1, hr, old, path)
    if hunks is None:
        return None
    if hunks == "binary" or (not hunks and d.blob(h1, old) != d.blob(hr, path)):
        return False  # changed without a text hunk (binary, `-diff`): in any language git speaks
    for start, count in hunks:
        touched = range(start, start + count) if count else (start, start + 1)
        if any(first <= n <= last for n in touched):
            return False
    return True


def _blocks_since_round1(root: Path, works: set[str] | None = None) -> dict:
    """Over the code reviews: every `sev=blocker` finding of a report whose round is 2 or
    more, as `unchanged` (its `at=` lines stood as they are since a head of round 1),
    `changed`, or unmeasured by reason (`OLD_REASONS`) — in total, `per_round` and
    `per_work` (the report's work). `works` limits it to reports of those works (ids,
    `#` stripped). Without the FINDING reader: {"not_read": why}. Reasons, in order: no
    `at=`; `at=-`; a file without a line; a place in a plan or under `.process-work/`
    (a code review measures code); no REVIEW line of round 1 in the work's group; the
    reviewed head unknown (no full-SHA `artifact:` head, and not exactly one head on the
    journal's lines of that round; an `artifact:` head that is no full SHA never falls back);
    a head not in this repository; the place not at the reviewed head; git failed or ran
    past 30 s. A report that cannot be read counts once as `unreadable-report` (its
    blockers are unknown) when no `works` filter is given."""
    import check_review as _review
    reports = _review_reports(root, "code")
    if isinstance(reports, str):
        return {"not_read": reports}
    rounds, plans, d = _review_rounds(root), _plans(root), _Diffs(root)

    def cell() -> dict:
        return {"unchanged": 0, "changed": 0, "unmeasured": {}}

    total, per_round, per_work = cell(), {}, {}

    def heads_of(group: set[str], rnd: int) -> set[str]:
        return set().union(*(e["heads"].get(rnd, set()) for w, e in rounds.items()
                             if w.lstrip("#") in group and not w.endswith("-plan")))

    def judge(rep: Report, group: set[str], f: dict) -> str:
        at = f.get("at")
        if at is None:
            return "no-at"
        if at == "-":
            return "no-place"
        m = _PLACE.match(at)
        if not m or not m.group("first"):
            return "no-line"
        path = unquote(m.group("path"))
        first = int(m.group("first"))
        last = int(m.group("last") or first)
        if path.startswith(".process-work/") or _review.record_kind(path) in _review.PLAN_KINDS + ("plan-archive",):
            return "not-code"
        h1s = heads_of(group, 1)
        if not h1s:
            return "no-round1"
        if rep.head == "":
            return "no-head"  # the report names its head, and it is no commit: never another one's
        here = heads_of(group, rep.round)
        hr = rep.head or (next(iter(here)) if len(here) == 1 else None)
        if hr is None:
            return "no-head"
        if d.has(hr) is None or any(d.has(h) is None for h in h1s):
            return "git-failed"
        h1s = {h for h in h1s if d.has(h)}
        if not d.has(hr) or not h1s:
            return "missing-commit"
        size = d.lines(hr, path)
        if size is None:
            return "git-failed"
        if size == "absent" or last > size:
            return "outside"
        verdicts = [_unchanged_against(d, h1, hr, path, first, last) for h1 in sorted(h1s)]
        if any(v is True for v in verdicts):
            return "unchanged"
        if any(v is False for v in verdicts):
            return "changed"
        return "git-failed"

    for rep in reports:
        if rep.unreadable:  # its blockers are unknown: counted as a report, never dropped — in the
            # unfiltered count only; a window cannot tell whose it is (refute, round 1)
            if works is None:
                total["unmeasured"]["unreadable-report"] = total["unmeasured"].get("unreadable-report", 0) + 1
            continue
        if rep.round is None or rep.round < 2:
            continue
        keys = [w.lstrip("#") for w in rep.works]
        if works is not None and not set(keys) & works:
            continue
        group = set().union(*(_work_group(w, plans) for w in keys))
        for f in rep.findings:
            if f["sev"] != "blocker":
                continue
            verdict = judge(rep, group, f)
            for c in (total, per_round.setdefault(rep.round, cell()), per_work.setdefault(keys[0], cell())):
                if verdict in ("unchanged", "changed"):
                    c[verdict] += 1
                else:
                    c["unmeasured"][verdict] = c["unmeasured"].get(verdict, 0) + 1
    return {**total, "per_round": per_round, "per_work": per_work}


def _old_text(c: dict) -> str:
    """`unchanged/measured (share)`, never a share without a measurement."""
    measured = c["unchanged"] + c["changed"]
    share = f" ({round(100 * c['unchanged'] / measured)} %)" if measured else ""
    return f"{c['unchanged']}/{measured}{share}" if measured else "—"


def _old_line(c: dict) -> str:
    """One line of the #311 measure: the share, then what was not measured, by reason."""
    if "not_read" in c:
        return f"not read ({c['not_read']})"
    gaps = ", ".join(f"{k} {c['unmeasured'][k]}" for k in OLD_REASONS if k in c["unmeasured"])
    return f"{_old_text(c)} unchanged since round 1" + (f"; not measured: {gaps}" if gaps else "")


def _skips_by_kind(root: Path, ids: dict[object, set[str]]) -> dict[str, int]:
    """Works of the window with a reasoned skip, per kind (`skipped <kind> work=<id>:`,
    `check_review.SKIP_LINE`, in the journal and the plans as rendered) — a skip covers
    its whole work, so a work counts once per kind. Known limit: `compact_journal` drops
    skip lines, so read the baseline before it runs (improvement-monthly.md)."""
    import check_review as _review
    seen: set[tuple[str, object]] = set()
    for _rel, text in _review.record_texts(root) or []:
        for m in _review.SKIP_LINE.finditer(_review.readable(text)):
            work = m.group("work").removesuffix("-plan").lstrip("#")
            issue = next((i for i, own in ids.items() if work in own), None)
            if issue is not None:
                seen.add((m.group("kind"), issue))
    out: dict[str, int] = {}
    for kind, _issue in seen:
        out[kind] = out.get(kind, 0) + 1
    return dict(sorted(out.items()))


def _issue_plans(issue, plans: list[tuple[str, str]]) -> list[str]:
    import check_review as _review
    return [text for _rel, text in plans if int(issue) in _review._plan_issue_numbers(text)]


def _work_tier(issue, plans: list[tuple[str, str]], rounds: dict[str, dict]) -> str | None:
    """A work's tier: its plans' (`plan_tier`, the highest of several phases), else the highest
    any of its REVIEW lines declared, else None — unknown, its own group, never 0."""
    import check_review as _review
    declared = [t for text in _issue_plans(issue, plans) if (t := _review.plan_tier(text)) is not None]
    if declared:
        return str(max(declared))
    ids = _issue_ids(issue, plans)
    seen = [int(e["tier"]) for w, e in rounds.items()
            if w.removesuffix("-plan") in ids and str(e.get("tier") or "").isdigit()]
    return str(max(seen)) if seen else None


def _work_kind(issue, plans: list[tuple[str, str]], subjects: list[str]) -> str:
    """`template-update` (a plan says `template-update: true`); `fix` when the work has a commit
    on product paths and every such commit is a `fix:`; else `change`. Commits only on process
    paths (an attest, a plan) do not count (`subjects` are the product commits')."""
    if any(_TEMPLATE_UPDATE.search(text) for text in _issue_plans(issue, plans)):
        return "template-update"
    if subjects and all(_commit_kind(s) == "fix" for s in subjects):
        return "fix"
    return "change"


def _joined(issue, plans: list[tuple[str, str]], rounds: dict[str, dict]) -> bool:
    """Does a plan declare the work's issue, or a REVIEW line name one of its ids (#341 AC-4)?"""
    return bool(_issue_plans(issue, plans)) or any(i in rounds or f"{i}-plan" in rounds
                                                  for i in _issue_ids(issue, plans))


def _population(root: Path, merged: list[dict], lo: datetime, hi: datetime,
                plans: list[tuple[str, str]], rounds: dict[str, dict]) -> dict:
    """Where a window's merged works come from (#341 AC-4): git's merge events and the host's
    reports, the window's mixed ranges and merges no issue claims, the works joined to no plan
    and no REVIEW line, and whether the clone is shallow."""
    git = merge_events(root)
    events = [e for e in git["events"] or [] if lo <= e["when"] < hi]
    return {"works": len(merged),
            "git": sum(1 for it in merged if it.get("source") in ("git", "both")),
            "host_only": sum(1 for it in merged if it.get("source", "host") == "host"),
            "train": sum(1 for e in events if e["kind"] == "train"),
            "finish": sum(1 for e in events if e["kind"] == "finish"),
            "mixed": sum(1 for e in events if e["mixed"]),
            "unclaimed": sum(1 for e in events if not e["issues"] and not e["plans_unread"]),
            "plans_unread": sum(1 for e in events if e["plans_unread"]),
            # a range git could not read (or the first finish without a lower bound) holds no
            # count of strays or mixing: named as unknown, not summed as 0
            "unbounded": sum(1 for e in events if not e["bounded"]),
            "strays": sum(e.get("strays", 0) for e in events if e["bounded"]),
            "unjoined": sum(1 for it in merged if not _joined(it["issue"], plans, rounds)),
            "shallow": git["shallow"], "why": git["why"]}


def _population_text(p: dict, label: str = "") -> str:
    head = f"  population{label}: {p['works']} merged works — "
    if p["why"]:
        return head + f"host reports only {p['host_only']}; git not read ({p['why']})"
    return (head + f"git {p['git']} ({p['train']} train, {p['finish']} finish merges), host reports only "
            f"{p['host_only']}; mixed ranges {p['mixed']}; merges without an issue {p['unclaimed']}; "
            f"merges with plans git could not read {p['plans_unread']}; ranges unknown {p['unbounded']}; "
            f"joined to no plan or REVIEW line {p['unjoined']}; commits outside a merge range {p['strays']}"
            + ("; shallow clone — history before its boundary is missing, the first range unknown"
               if p["shallow"] else ""))


def baseline_numbers(root: Path, lo: datetime, hi: datetime, *, items: list[dict] | None = None,
                     commits: list[dict] | None = None) -> dict:
    """The baseline of one window, over the works merged in it: medians per work of
    tokens, review rounds, blocked (fix) rounds, findings and lead time; the tokens
    workers stated per phase (`report.py --usage`); escaped defects — the works whose
    issue later got a `Regression-of:` fix, and the change-failure proxy (a `fix:`
    commit on a code file a `feat:` of the window touched). Every number is a proxy."""
    items = flow_items(root) if items is None else items
    merged = [it for it in items if (m := _when(it["merged"]["value"])) and lo <= m < hi]
    rounds = _review_rounds(root)
    found = _report_findings(root)
    by_work: dict[str, int] = {}
    if not isinstance(found, str):
        for work, _f, _round in found:
            by_work[work] = by_work.get(work, 0) + 1

    def med(values: list) -> float | None:
        vals = [v for v in values if v is not None]
        return round(statistics.median(vals), 1) if vals else None

    plans = _plans(root)
    ids = {it["issue"]: _issue_ids(it["issue"], plans) for it in merged}
    rnd = [_rounds_of_issue(root, rounds, it["issue"], plans) for it in merged]
    reviewed_plan = [any(f"{i}-plan" in rounds for i in ids[it["issue"]]) for it in merged]
    phases: dict[str, int] = {}
    for recs in _reports_by_worker(root).values():
        for r in recs:
            at = datetime.fromtimestamp(int(r.get("epoch") or 0), tz=timezone.utc)
            if lo <= at < hi and isinstance(r.get("usage"), dict):
                u = r["usage"]
                ph = r.get("phase") or "-"
                phases[ph] = phases.get(ph, 0) + int(u.get("input", 0)) + int(u.get("cached", 0)) \
                    + int(u.get("output", 0))
    in_window = [c for c in (commits or []) if lo <= c["ts"] < hi]
    escaped = [it for it in merged if it["escapes"]["value"]]
    # #320: per tier — escapes over closed follow-up windows only (an open one counts beside,
    # never in the denominator; an unknown one apart), median rounds and tokens
    tiers: dict[str, dict] = {}
    for it, r in zip(merged, rnd):
        c = tiers.setdefault(_work_tier(it["issue"], plans, rounds) or "unknown",
                             {"works": 0, "escaped": 0, "closed": 0, "open": 0, "unknown": 0,
                              "rounds": [], "tokens": []})
        c["works"] += 1
        esc = it["escapes"]
        if esc.get("value") is None:
            c["unknown"] += 1
        elif esc.get("window_open"):
            c["open"] += 1
        else:
            c["closed"] += 1
            c["escaped"] += esc["value"] > 0
        c["rounds"].append(r["max_round"] if r else None)
        c["tokens"].append(sum(it["tokens"]["value"].values()) if it["tokens"]["value"] else None)
    by_tier = {t: {**{k: c[k] for k in ("works", "escaped", "closed", "open", "unknown")},
                   "rate": round(c["escaped"] / c["closed"], 2) if c["closed"] else None,
                   "rounds": med(c["rounds"]), "tokens": med(c["tokens"]), "thin": c["works"] < _N_THRESHOLD}
               for t, c in sorted(tiers.items())}
    return {
        "works": len(merged),
        # `tokens.value` holds the fields of a work's usage (input, output, …): their sum
        "tokens_per_work": med([sum(it["tokens"]["value"].values()) if it["tokens"]["value"] else None
                                for it in merged]),
        "rounds_per_work": med([r["max_round"] if r else None for r in rnd]),
        "fix_rounds_per_work": med([len(r["blocked"]) if r else None for r in rnd]),
        # #293: does a reviewed plan buy fewer code rounds?
        "rounds_with_plan_review": med([r["max_round"] if r else None
                                        for r, planned in zip(rnd, reviewed_plan) if planned]),
        "rounds_without_plan_review": med([r["max_round"] if r else None
                                           for r, planned in zip(rnd, reviewed_plan) if not planned]),
        **_round_findings(root, ids),
        "skips_by_kind": _skips_by_kind(root, ids),
        # #311: blocks of round >= 2 on lines round 1 saw, over the window's works
        "blocks_on_unchanged": _blocks_since_round1(root, _window_works([it["issue"] for it in merged], plans)),
        "findings_per_work": None if isinstance(found, str) else med([by_work.get(str(it["issue"]), 0)
                                                                     for it in merged]),
        "lead_hours": med([it["lead_s"]["value"] / 3600 if it["lead_s"]["value"] else None for it in merged]),
        "stated_tokens_by_phase": phases,
        "escaped_works": len(escaped),
        "change_failure_proxy": change_failure_rate(in_window) if commits is not None else None,
        "by_tier": by_tier,
        "population": _population(root, merged, lo, hi, plans, rounds),
    }


def baseline(root: Path | None = None, windows: list[tuple[datetime, datetime]] | None = None,
             *, as_json: bool = False) -> int:
    """One or two windows side by side, so a change's effect is the difference of
    two runs (#277). The numbers a deterministic check should move: fewer fix rounds
    and tokens per work, with escaped defects as the guard that nothing slipped."""
    import json  # noqa: PLC0415
    import tower  # noqa: PLC0415 — the one owner of the integration branch
    root = root or Path.cwd()
    windows = windows or [(datetime.min.replace(tzinfo=timezone.utc), datetime.max.replace(tzinfo=timezone.utc))]
    items = flow_items(root)
    ref = tower.integration_ref(root)
    try:
        commits = _git_commits(ref, root=root) if ref else None
    except (subprocess.CalledProcessError, OSError):
        commits = None
    got = [baseline_numbers(root, lo, hi, items=items, commits=commits) for lo, hi in windows]
    if as_json:
        print(json.dumps(got, default=str, sort_keys=True))
        return 0
    label = [f"{lo.date() if lo.year > 1 else '…'}–{hi.date() if hi.year < 9999 else '…'}" for lo, hi in windows]
    print("[baseline] ~proxy — per merged work, medians; compare two windows (#277)")
    for g, x in zip(got, label):
        print(_population_text(g["population"], f" {x}" if len(got) > 1 else ""))
    print(f"  {'':<28}" + "".join(f"{x:>24}" for x in label))
    for key in ("works", "tokens_per_work", "rounds_per_work", "fix_rounds_per_work", "findings_per_work",
                "rounds_with_plan_review", "rounds_without_plan_review", "lead_hours", "escaped_works"):
        print(f"  {key:<28}" + "".join(f"{'—' if g[key] is None else g[key]:>24}" for g in got))
    cfr = ["—" if not g["change_failure_proxy"] else
           f"{g['change_failure_proxy']['failed']}/{g['change_failure_proxy']['feats']} feat" for g in got]
    print(f"  {'change_failure_proxy':<28}" + "".join(f"{x:>24}" for x in cfr))
    for g, x in zip(got, label):
        if g["stated_tokens_by_phase"]:
            print(f"  stated tokens by phase {x}: "
                  + ", ".join(f"{p} {n:,}" for p, n in sorted(g["stated_tokens_by_phase"].items())))
        origins = g["blockers_by_origin"]
        print(f"  blockers by origin {x}: " + (origins if isinstance(origins, str) else
                                               ", ".join(f"{o} {n}" for o, n in sorted(origins.items())) or "none"))
        pairs = g["fix_findings_vs_fix_blockers"]
        if isinstance(pairs, str):
            print(f"  fix findings → next round's fix blockers {x}: {pairs}")
        else:
            print(f"  fix findings → next round's fix blockers {x}: "
                  + "; ".join(f"{b} findings: {c['with_fix_blocker']}/{c['rounds']} rounds, {c['fix_blockers']} blockers"
                              for b, c in pairs["buckets"].items())
                  + f"; unrounded reports {pairs['unrounded']}")
        print(f"  skips by kind {x}: "
              + (", ".join(f"{k} {n}" for k, n in g["skips_by_kind"].items()) or "none"))
        print(f"  old-code blocks {x}: {_old_line(g['blocks_on_unchanged'])}")
        # #320: what the review buys per tier — escapes over closed follow-up windows only
        print(f"  by tier {x} (escapes over closed windows; rounds and tokens median):")
        for tier, c in g["by_tier"].items():
            rate = f" ({round(100 * c['rate'])} %)" if c["rate"] is not None else ""
            rounds_text = "—" if c["rounds"] is None else c["rounds"]
            tokens_text = "—" if c["tokens"] is None else f"{c['tokens']:,.0f}"
            print(f"    tier {tier}: works {c['works']}, escaped {c['escaped']}/{c['closed']} closed{rate}, "
                  f"open {c['open']}, unknown {c['unknown']}; rounds {rounds_text}; tokens {tokens_text}"
                  + (f" — thin (n={c['works']}<{_N_THRESHOLD})" if c["thin"] else ""))
    n = min(g["works"] for g in got)
    lvl = _level(n, True, False, _N_THRESHOLD)
    print(f"  {confidence(n, proxy=True)} · {action(lvl, 'a check that removed review work shows fewer fix rounds and tokens per work at the same or fewer escaped works', thin='keep recording; judge a change after ~20 merged works per window')}")
    return 0


# --- findings: what could have caught them (#276) --------------------------------
_HEAVY = ("blocker", "major")


def findings(root: Path | None = None, *, min_works: int = 2, as_json: bool = False) -> int:
    """Findings by class (`class=`: mechanical, testable, judgment, unclassed) and,
    for mechanical and testable ones, by the check that would catch them (`rule=`,
    else `kind=`). A check seen in `min_works` works or more is the next gate to
    write; the judgment share among blocking findings is what is left for a reader."""
    import json  # noqa: PLC0415
    root = root or Path.cwd()
    found = _report_findings(root)
    if isinstance(found, str):
        print(f"[findings] not read ({found})")
        return 0
    classes: dict[str, int] = {}
    heavy: dict[str, int] = {}
    checks: dict[str, set[str]] = {}
    for work, f, _round in found:
        cls = f.get("class") or "unclassed"
        classes[cls] = classes.get(cls, 0) + 1
        if f["sev"] in _HEAVY:
            heavy[cls] = heavy.get(cls, 0) + 1
        if cls in ("mechanical", "testable"):
            checks.setdefault(f"{cls}:{f.get('rule') or f.get('kind') or '-'}", set()).add(work)
    repeating = {k: sorted(w) for k, w in sorted(checks.items()) if len(w) >= min_works}
    judged = sum(n for c, n in heavy.items() if c != "unclassed")
    share = round(heavy.get("judgment", 0) / judged, 2) if judged else None
    if as_json:
        print(json.dumps({"classes": classes, "blocking": heavy, "repeating": repeating,
                          "judgment_share_of_blocking": share}, sort_keys=True))
        return 0
    print("[findings] ~proxy — review findings by what could have caught them")
    if not found:
        print("  no FINDING lines in the review reports yet")
        return 0
    print(f"  all: {_kind_text(classes)}")
    print(f"  blocker/major: {_kind_text(heavy)}")
    if share is not None:
        print(f"  judgment share of classified blocker/major findings: {share}")
    for key, works in repeating.items():
        print(f"  repeats in {len(works)} works: {key} ({', '.join(works[:5])}{' …' if len(works) > 5 else ''})")
    n = len({w for w, _f, _round in found})
    lvl = _level(n, True, False, _N_THRESHOLD)
    print(f"  {confidence(n, proxy=True)} · {action(lvl, 'turn a repeating mechanical or testable check into a gate or a class-level test (testing.md, classes not cases)', thin='record class= and rule= on findings; judge after ~20 work items')}")
    return 0


def _origin_text(counts: dict[str, int]) -> str:
    total = sum(counts.values())
    named = [f"{o} {counts[o]}" for o in ("draft", "fix", "late") if counts.get(o)]
    if counts.get("-") and named:
        named.append(f"unmarked {counts['-']}")
    return f"{total} ({', '.join(named)})" if named else str(total)


def _kind_text(counts: dict[str, int]) -> str:
    named = [f"{k} {counts[k]}" for k in sorted(counts, key=lambda k: (k == "-", k))]
    return ", ".join(named) if named else "0"


ROUND_STEPS = ("1", "2", "3", ">=4")


def _round_step(rnd: int) -> str:
    return str(rnd) if rnd < 4 else ">=4"


def _review_costs(root: Path) -> dict[int, list[int]]:
    """issue → the tokens of its review runs that stated their usage (`report.py --usage`, phase
    `review`), in order: the n-th is read as round n's cost — an estimate; a round without one is
    unknown. No trace tells a plan review's run apart, so plan rounds carry no cost."""
    runs: dict[int, list[tuple[float, int]]] = {}
    for recs in _reports_by_worker(root).values():
        for r in recs:
            u = r.get("usage")
            if r.get("phase") == "review" and isinstance(u, dict) and str(r.get("issue") or "").isdigit():
                tokens = int(u.get("input", 0)) + int(u.get("cached", 0)) + int(u.get("output", 0))
                runs.setdefault(int(r["issue"]), []).append((r.get("epoch", 0), tokens))
    return {n: [t for _e, t in sorted(v)] for n, v in runs.items()}


def rounds_by_number(root: Path, old: dict | None = None) -> dict:
    """#318: per round number (1, 2, 3, >=4), code reviews apart from plan reviews: the median
    blockers per work and round (FINDING lines; "not read" without the reader, None where no
    report of that round exists), the works whose round blocked of all works reviewed, the share
    of blocks on lines unchanged since round 1 (`_blocks_since_round1`; plan reviews "n/a"), and
    the round's cost where a review run stated it — a round without one is unknown, never free."""
    rounds, plans = _review_rounds(root), _plans(root)
    works: dict[str, dict[str, dict]] = {"code": {}, "plan": {}}
    for w, e in rounds.items():
        key = w.lstrip("#")
        phase = "plan" if key.endswith("-plan") else "code"
        cur = works[phase].setdefault(key.removesuffix("-plan"), {"max_round": 0, "blocked": set()})
        cur["max_round"] = max(cur["max_round"], e["max_round"])
        cur["blocked"] |= e["blocked"]
    old = _blocks_since_round1(root) if old is None else old
    costs = _review_costs(root)
    out: dict[str, dict] = {}
    for phase in ("code", "plan"):
        mine = works[phase]
        reports = _review_reports(root, phase)
        found: dict[tuple[str, int], int] = {}
        if not isinstance(reports, str):
            for rep in reports:
                for w in rep.works:
                    key = w.lstrip("#").removesuffix("-plan")
                    if rep.unreadable or rep.round is None or key not in mine:
                        continue
                    found[(key, rep.round)] = found.get((key, rep.round), 0) + sum(
                        f["sev"] == "blocker" for f in rep.findings)
        issue_of = {}
        for key in mine:
            nums = [i for i in _work_group(key, plans) if i.isdigit()]
            issue_of[key] = int(nums[0]) if len(nums) == 1 else None
        table: dict[str, dict] = {}
        for step in ROUND_STEPS:
            blockers = [n for (key, rnd), n in found.items() if _round_step(rnd) == step]
            known = unknown = 0
            spent: list[int] = []
            for key, e in mine.items():
                for rnd in range(1, e["max_round"] + 1):
                    if _round_step(rnd) != step:
                        continue
                    runs = costs.get(issue_of[key], []) if phase == "code" and issue_of[key] is not None else []
                    if rnd <= len(runs):
                        known += 1
                        spent.append(runs[rnd - 1])
                    else:
                        unknown += 1
            if phase == "plan" or step == "1":
                unchanged = "n/a"  # only code reviews have lines; round 1 has nothing before it
            elif "not_read" in old:
                unchanged = NOT_READ
            else:
                c = {"unchanged": 0, "changed": 0}
                for rnd, cell in old["per_round"].items():
                    if _round_step(rnd) == step:
                        c["unchanged"] += cell["unchanged"]
                        c["changed"] += cell["changed"]
                unchanged = _old_text(c)
            table[step] = {
                "blockers_median": (NOT_READ if isinstance(reports, str) else
                                    statistics.median(blockers) if blockers else None),
                "blocked": (sum(1 for e in mine.values() if any(_round_step(r) == step for r in e["blocked"])),
                            len(mine)),
                "unchanged": unchanged,
                "cost": {"median": statistics.median(spent) if spent else None, "known": known, "unknown": unknown},
            }
        out[phase] = table
    out["works"] = {phase: len(works[phase]) for phase in works}
    return out


def _cost_text(c: dict) -> str:
    if not c["known"] and not c["unknown"]:
        return "—"
    if not c["known"]:
        return f"unknown ({c['unknown']})"
    return f"{c['median']:,.0f} tokens ({c['known']})" + (f", unknown {c['unknown']}" if c["unknown"] else "")


def rounds(root: Path | None = None) -> int:
    """Per work item: tier, rounds to the first pass, blocked rounds (journal
    REVIEW lines) and blockers per FINDING, by `origin=` where the reports
    carry it. Many `fix` blockers ask for regression tests and a re-check of the
    fixed class; many `late` ones for a more complete first round."""
    root = root or Path.cwd()
    print("[rounds] ~proxy — review rounds per work item × blockers by origin")
    rnds = _review_rounds(root)
    if not rnds:
        print("  no REVIEW lines in the journal yet")
        return 0
    blockers = _blockers_by_work(root)
    print(f"  {'work':<24} {'tier':>4} {'rounds→pass':>11} {'blocked':>7}  blockers")
    totals: dict[str, int] = {}
    for work, e in sorted(rnds.items()):
        to_pass = str(e["pass_round"]) if e["pass_round"] is not None else "open"
        if isinstance(blockers, str):
            found = "not read"
        else:
            counts = blockers.get(work.lstrip("#"), {})
            for o, n in counts.items():
                totals[o] = totals.get(o, 0) + n
            found = _origin_text(counts) if counts else "0"
        print(f"  {work:<24} {str(e['tier'] or '?'):>4} {to_pass:>11} {len(e['blocked']):>7}  {found}")
    if isinstance(blockers, str):
        print(f"  blockers: not read ({blockers})")
    elif totals:
        print(f"  all blockers: {_origin_text(totals)}")
    if not isinstance(blockers, str):
        # plan reviews (report header `phase: plan`) apart from code reviews;
        # "-" = a blocker without kind=; the same work items as the table above,
        # so the kind and origin totals count the same reports
        listed = {w.lstrip("#") for w in rnds}
        by_phase = {}
        for ph in ("plan", "code"):
            counts: dict[str, int] = {}
            by_work = _blockers_by_work(root, "kind", ph)
            for cell in (c for w, c in by_work.items() if w in listed):
                for k, n in cell.items():
                    counts[k] = counts.get(k, 0) + n
            by_phase[ph] = counts
        print(f"  blockers by kind — plan reviews: {_kind_text(by_phase['plan'])}; "
              f"code reviews: {_kind_text(by_phase['code'])}")
        # who raised them (`by=`, #247): "-" = a blocker without by=
        by_reviewer: dict[str, int] = {}
        for cell in (c for w, c in _blockers_by_work(root, "by").items() if w in listed):
            for k, n in cell.items():
                by_reviewer[k] = by_reviewer.get(k, 0) + n
        print(f"  blockers by reviewer: {_kind_text(by_reviewer)}")
    # #311: blocking findings of round >= 2 on lines unchanged since round 1 (`at=`)
    old = _blocks_since_round1(root)
    print(f"  old-code blocks (rounds >= 2): {_old_line(old)}")
    if "not_read" not in old:
        for rnd, c in sorted(old["per_round"].items()):
            print(f"    round {rnd}: {_old_line(c)}")
        for work, c in sorted(old["per_work"].items()):
            print(f"    {work}: {_old_line(c)}")
    # #318: what round 1, 2, 3 and >= 4 still find, against what they cost
    steps = rounds_by_number(root, old)
    for phase, name in (("code", "code reviews"), ("plan", "plan reviews")):
        print(f"  by round — {name} over {steps['works'][phase]} works (blockers: median per work and round):")
        print(f"    {'round':<6} {'blockers':>8} {'blocked works':>16} {'unchanged since r1':>20}  cost")
        for step, c in steps[phase].items():
            b = c["blockers_median"]
            blockers = "—" if b is None else b if isinstance(b, str) else f"{b:g}"
            hit, of = c["blocked"]
            blocked = f"{hit}/{of}" + (f" ({round(100 * hit / of)} %)" if of else "")
            print(f"    {step:<6} {blockers:>8} {blocked:>16} {c['unchanged']:>20}  {_cost_text(c['cost'])}")
    n = len(rnds)
    lvl = _level(n, True, False, _N_THRESHOLD)
    print(f"  {confidence(n, proxy=True)} · {action(lvl, 'compare rounds to pass within one tier over time; where fix-origin blockers dominate, re-check the fixed class (verification-independence.md, What each round judges)', thin='record origin= on blocker findings; judge after ~20 work items')}")
    return 0


# --- share: how much of what lands is process ----------------------------------
def share(weeks: int = 4) -> int:
    """Week by week on the integration branch: process-only, mixed and product
    commits, and the landed changes that carried product code. tower.py owns
    the classification (one owner); this prints its trend."""
    import tower  # noqa: E402  (sibling; owns PROCESS_PATHS and balance)
    print("[share] process vs product on the integration branch")
    ref = tower.integration_ref(ROOT)
    rows = [tower.balance(ROOT, ref, 7, 7 * w) for w in range(weeks)]
    if not ref or any(r is None for r in rows):
        print("  no integration branch or git unreadable — share skipped")
        return 0
    for w, r in enumerate(rows):
        n = r["commits"]
        pct = (lambda k: f"{100 * r[k] // n:>3}%") if n else (lambda k: "  -")
        print(f"  week -{w}: {n:>4} commits — process only {pct('process')}, mixed {pct('mixed')}, "
              f"product {pct('product')}; {r['landed_product']}/{r['landed']} landed changes with product code")
    n = sum(r["commits"] for r in rows)
    heavy = n and sum(r["process"] for r in rows) / n > tower.PROCESS_HEAVY_SHARE
    print(f"  {confidence(n, proxy=True)} — paths classify, not effort: a one-line plan edit counts like a feature")
    print(f"  -> {action('low', '', thin='process-only above 40% over weeks: look where the rounds go (rounds) and batch bookkeeping one commit per round (testing.md); falling product changes with rising process share is the signal' if heavy else 'watch the trend; act when process-only stays above 40% for two weeks')}")
    return 0


# --- train-phases: where the merge train's time goes ---------------------------
_TRAIN_PHASES = ("preflight", "gates", "suite", "retry", "bisect", "push", "deploy")


def _stage_lines(rows: list[dict]) -> list[str]:
    """The merge-suite stages (`stages` of a phases line, testing.md "Stages"): the last train that
    recorded them, then median and maximum minutes per stage over the window, where a
    stage ran, with its skipped and red counts. A stage that did not run still
    stands in the last train's line."""
    staged = [row["stages"] for row in rows if isinstance(row.get("stages"), dict) and row["stages"]]
    if not staged:
        return ["  no stage times recorded yet"]
    lines = []
    for name, last in staged[-1].items():
        if last.get("state") == "skipped":
            lines.append(f"  stage {name:<14} skipped")
            continue
        runs = last.get("runs", 0)
        lines.append(f"  stage {name:<14} {last.get('seconds', 0) / 60:.1f} min {last.get('state')} "
                     f"({runs} run{'' if runs == 1 else 's'})")
    for name in staged[-1]:
        entries = [s[name] for s in staged if isinstance(s.get(name), dict)]
        ran = [e.get("seconds", 0) / 60 for e in entries if e.get("runs")]
        if ran:
            skipped = sum(e.get("state") == "skipped" for e in entries)
            red = sum(e.get("state") == "red" for e in entries)
            lines.append(f"  {name:<14} median {statistics.median(ran):.1f} min, max {max(ran):.1f} min "
                         f"(in {len(ran)}/{len(entries)} trains); {skipped} skipped, {red} red")
    return lines


def train_phases(runs: int = 20) -> int:
    """Median and maximum seconds per phase over the last `runs` trains
    (`process-train/phases.jsonl`, written by train.py): a slow merge is
    a wait, a suite, a bisection or a deploy — each has its own lever."""
    import json  # noqa: PLC0415

    print(f"[train-phases] the last {runs} train runs")
    r = subprocess.run(["git", "-C", str(ROOT), "rev-parse", "--git-common-dir"],
                       capture_output=True, text=True)
    common = Path(r.stdout.strip()) if r.returncode == 0 else None
    if common is not None and not common.is_absolute():
        common = ROOT / common
    rows = []
    try:
        for line in (common / "process-train" / "phases.jsonl").read_text(encoding="utf-8").splitlines():
            try:
                row = json.loads(line)
            except ValueError:
                continue
            if isinstance(row, dict):
                rows.append(row)
    except (OSError, TypeError):
        pass
    rows = rows[-runs:]
    if not rows:
        print("  no train run recorded yet — train-phases skipped")
        return 0
    for phase in _TRAIN_PHASES:
        values = [float(row.get(phase) or 0) for row in rows]
        ran = [v for v in values if v]
        if ran:
            print(f"  {phase:<9} median {statistics.median(values):>6.0f} s, max {max(values):>6.0f} s "
                  f"(in {len(ran)}/{len(rows)} runs)")
    for line in _stage_lines(rows):
        print(line)
    results = [row.get("result") for row in rows]
    print(f"  {results.count('red')}/{len(rows)} runs ended red, "
          f"{results.count('environment')} stopped by the preflight (the host, not a passenger)")
    n = len(rows)
    print(f"  {confidence(n)} · {action(_level(n, False, False, _N_THRESHOLD), 'shorten the phase with the largest median first: suite → test selection and certificates, bisect → smaller batches, retry → flaky tests (failure-catalog.md)', thin='let more trains run before acting on a phase')}")
    return 0


# --- flow: one issue from its first dispatched phase to deploy ---------------
# What ties the traces together (docs/process/optimization.md, "Goals"): the
# dispatch logs (a phase's start, named <branch>-<phase>-<stamp>.log), the
# worker reports (a phase's end), the train's phases.jsonl (who landed,
# whether the deploy ran green, when), git (Regression-of trailers, the
# process version at merge) and the plans (owner decisions). Every field
# says whether it is measured, estimated or missing; nothing is filled in.
_FOLLOW_UP_DAYS = 30  # escapes count this long after the merge (mandate: follow_up_days)
_PHASE_LOG = re.compile(r"^(?P<branch>.+)-(?P<phase>brainstorm|plan|execute|review)-(?P<ts>\d{8}-\d{6})\.log$")
_PHASE_ENDS = {"brainstorm": {"planned", "blocked", "failed", "idle"}, "plan": {"planned", "blocked", "failed"},
               "execute": {"pushed", "blocked", "failed"}, "review": {"review-pass", "blocked", "failed"}}
_ANSWERS_COMMIT = re.compile(r"^_commit:\s*['\"]?([^'\"\s]+)", re.MULTILINE)


def _common_dir(root: Path) -> Path | None:
    r = subprocess.run(["git", "-C", str(root), "rev-parse", "--git-common-dir"],
                       capture_output=True, text=True)
    if r.returncode != 0 or not r.stdout.strip():
        return None
    common = Path(r.stdout.strip())
    return common if common.is_absolute() else root / common


def _aware(value) -> datetime | None:
    """An ISO timestamp as an aware datetime; a naive one is this host's local time."""
    if not value:
        return None
    try:
        dt = datetime.fromisoformat(str(value).replace("Z", "+00:00"))
    except ValueError:
        try:
            dt = datetime.strptime(str(value), "%Y-%m-%dT%H:%M:%S%z")
        except ValueError:
            return None
    return dt if dt.tzinfo else dt.astimezone()


def _phase_starts(common: Path | None) -> list[dict]:
    """[{branch, phase, ts}] from the dispatch logs' names (one per started phase)."""
    out: list[dict] = []
    d = common / "process-dispatch" if common else None
    if d is None or not d.is_dir():
        return out
    for f in d.glob("*.log"):
        m = _PHASE_LOG.match(f.name)
        if m:
            ts = datetime.strptime(m.group("ts"), "%Y%m%d-%H%M%S").astimezone()
            out.append({"branch": m.group("branch").replace("__", "/"), "phase": m.group("phase"), "ts": ts})
    return out


def _train_rows(common: Path | None) -> list[dict]:
    import json  # noqa: PLC0415

    rows: list[dict] = []
    try:
        for line in (common / "process-train" / "phases.jsonl").read_text(encoding="utf-8").splitlines():
            try:
                row = json.loads(line)
            except ValueError:
                continue
            if isinstance(row, dict):
                rows.append(row)
    except (OSError, TypeError):
        pass
    return rows


def _regressions(root: Path, branch: str | None) -> dict[int, list[datetime]] | None:
    """issue → commit times of the fixes that name it in a `Regression-of:` trailer
    (process_git owns the grammar; the train reads the same); None when git cannot read
    the branch — unknown, never "no escapes"."""
    from process_git import regression_refs  # noqa: PLC0415

    log = _git_out(root, "log", branch, "-z", "--format=%ct%x01%B", timeout=_HISTORY_TIMEOUT) if branch else None
    if log is None:
        return None
    out: dict[int, list[datetime]] = defaultdict(list)
    for entry in log.split("\0"):
        ct, sep, body = entry.strip("\n").partition("\x01")
        if not sep or not ct.isdigit():
            continue
        when = datetime.fromtimestamp(int(ct), tz=timezone.utc)
        for n in regression_refs(body):
            out[n].append(when)
    return out


def _owner_decisions(root: Path) -> dict[int, int]:
    """issue → `DECISION <date> owner:` lines in the plans that declare it (proxy for owner effort)."""
    import check_review as _review  # noqa: PLC0415
    from process_context import DECISION  # noqa: PLC0415 — the ledger line's owner

    out: dict[int, int] = defaultdict(int)
    for _rel, text in _review.record_texts(root, ("plan", "plan-archive", "spec-plan")) or []:
        owners = sum(1 for m in DECISION.finditer(text) if m.group(2).strip().lower() == "owner")
        for n in set(_review.declared_issue_numbers(text)):
            out[n] += owners
    return out


def _process_version(root: Path, branch: str | None, when: datetime | None) -> str | None:
    """`_commit` of .copier-answers.yml on the integration branch at `when`."""
    if when is None or not branch:
        return None
    sha = (_git_out(root, "log", "-1", f"--before={when.isoformat()}", "--format=%H", branch) or "").strip()
    if not sha:
        return None
    answers = _git_out(root, "show", f"{sha}:.copier-answers.yml")
    m = _ANSWERS_COMMIT.search(answers) if answers is not None else None
    return m.group(1) if m else None


def _percentile(values: list[float], q: float) -> float:
    """Nearest-rank percentile: honest for small n (P90 of 3 values is the largest)."""
    ordered = sorted(values)
    k = max(0, min(len(ordered) - 1, -(-int(q * 100) * len(ordered) // 100) - 1))
    return ordered[k]


# --- merged works from git (#341) ---------------------------------------------
# The population of merged works is read from the integration branch itself, so a
# fresh clone counts the works the host counts. Host-local traces (worker reports,
# dispatch starts, train rows) only enrich a work; a value only they hold is
# unknown elsewhere, never zero. A merge event lies on the first-parent chain: a
# train merge (`train: merge <branch>`, two parents; its commits are
# merge^1..merge^2) or a `finish` merge (`docs: archive plan(s) on merge — <names>`;
# finish fast-forwards, so its commits are the range from the event before it to the
# archive commit). A merge without a marker (a hand merge, a PR squash, a commit past
# the hooks) falls into the next event's range and makes that range mixed.
_TRAIN_MERGE = re.compile(r"^train: merge (?P<branch>\S+)\s*$")  # train.py writes it
_FINISH_ARCHIVE = re.compile(r"^docs: archive plan\(s\) on merge — (?P<names>.+?)\s*$")  # finish.py writes it
# the issues a train merge holds open (`Refs #N`, written by train.py beside `Closes #N`) — read
# here from the merge's own message; the claim grammar itself stays check_review's
_TRAIN_REFS = re.compile(r"^Refs #(\d+)\s*$", re.MULTILINE)
_TEMPLATE_UPDATE = re.compile(r"^template-update:\s*true\s*$", re.MULTILINE)  # as check_review reads it
_EVENTS_READ: dict[tuple[str, str, str], dict] = {}  # (root, ref, tip) → merge_events: git asked once
_HISTORY_TIMEOUT = 600  # s, the whole-history reads (merge_events, the Regression-of log)


def _claims(message: str) -> set[int]:
    """The issues a commit message claims, in check_review's grammar (`_ISSUE_CLOSING`
    anywhere, `_ISSUE_SUBJECT` on the subject), imported unchanged. `Regression-of:` is no claim."""
    import check_review as _review  # noqa: PLC0415
    body = message.strip()
    if not body:
        return set()
    return ({int(n) for n in _review._ISSUE_CLOSING.findall(body)}
            | {int(n) for n in _review._ISSUE_SUBJECT.findall(body.splitlines()[0])})


def _commit_table(root: Path, ref: str) -> dict[str, dict] | None:
    """sha → {parents, at (author time), ct (commit time), message, files} of every commit
    `ref` reaches; a merge lists no files. None when git cannot read it."""
    # one read of the whole history: on a cold cache it ran past the 30 s other reads get
    # (dry run on a consumer clone with ~9000 commits)
    out = _git_out(root, "log", ref, "-z", "--name-only", "--format=%x01%H%x01%P%x01%at%x01%ct%x01%B",
                   timeout=_HISTORY_TIMEOUT)
    if out is None:
        return None
    table: dict[str, dict] = {}
    cur: dict | None = None
    for field in out.split("\0"):
        if field.startswith("\x01"):  # `\x01<sha>…<body>`, then its names, the first after a newline
            _, sha, parents, at, ct, body = field.split("\x01", 5)
            cur = table[sha] = {"sha": sha, "parents": parents.split(), "at": int(at), "ct": int(ct),
                                "message": body, "files": set()}
            continue
        field = field.lstrip("\n")
        if field and cur is not None:
            cur["files"].add(field)
    return table


def _rev_list(root: Path, spec: str) -> list[str] | None:
    out = _git_out(root, "rev-list", spec)
    return None if out is None else out.split()


def _numstat(root: Path, a: str, b: str) -> list[tuple[int | None, str, str | None]] | None:
    """(added plus deleted lines — None for a binary file —, path, the old path of a rename)
    per file of `git diff -M a b`; None when git fails."""
    out = _git_out(root, "diff", "--numstat", "-z", "-M", "--no-color", "--no-ext-diff", "--no-textconv", a, b)
    if out is None:
        return None
    parts, i, got = out.split("\0"), 0, []
    while i < len(parts):
        entry = parts[i]
        if not entry:
            i += 1
            continue
        added, _t, rest = entry.partition("\t")
        deleted, _t, path = rest.partition("\t")
        old = None
        if not path:  # a rename: the old and the new name follow
            if i + 2 >= len(parts):
                break
            old, path = parts[i + 1], parts[i + 2]
            i += 3
        else:
            i += 1
        got.append((None if "-" in (added, deleted) else int(added) + int(deleted), path, old))
    return got


def _branch_plan_issues(root: Path, p1: str, p2: str, branch: str) -> set[int] | None:
    """The issues of the plans a train merge's branch side owns (`check_review.own_plans`, the
    rule the train settles plans by) — for a merge whose message names none (a plan that stays
    active, an open task: `train._settle_plans` closes nothing); None when git cannot read them
    (a shallow clone without the merge base, a timeout) — not read, never "no issue"."""
    import check_review as _review  # noqa: PLC0415
    n = _review.branch_issue(branch)
    plans = _review.PLANS_ACTIVE

    def read(rel: str) -> str | None:
        return _git_out(root, "show", f"{p2}:{rel}")
    own = _review.own_plans(root, p1, p2, {n} if n else set(), read, (plans, _review.SPECS_DIR),
                            lambda rel: rel.endswith(".md") and (rel.startswith(plans + "/")
                                                                 or _review.record_kind(rel) == "spec-plan"))
    if own is None:
        return None
    return set().union(*(_review.local_issue_numbers(plain) for _rel, plain, _added in own))


def _event(root: Path, table: dict[str, dict], c: dict, prev: str | None, kind: str, m: re.Match) -> dict:
    """One merge event: its issues and where they came from, its range (bounded or not, mixed
    or not), its start (earliest author time), its product and process lines and files."""
    import check_review as _review  # noqa: PLC0415
    import tower  # noqa: PLC0415 — the one path classifier
    sha, message = c["sha"], c["message"]
    ev = {"sha": sha, "kind": kind, "when": datetime.fromtimestamp(c["ct"], tz=timezone.utc),
          "branch": None, "plans": [], "issues": [], "claim": "none", "bounded": True, "mixed": False,
          "start": None, "product_lines": None, "process_lines": None, "binary": 0, "files": {},
          "process_files": [], "renames": [], "product_subjects": [], "strays": 0, "plans_unread": 0,
          "stray_process_lines": 0, "stray_product_lines": 0}
    if kind == "train":
        p1, p2 = c["parents"]
        ev["branch"] = m.group("branch")
        own = _rev_list(root, f"{p1}..{p2}")
        # commits between the event before and merge^1 came onto the integration branch without
        # a marker: they are no part of this branch — counted apart, never in its lines or start
        # (a dry run on a consumer clone put 200 000 lines of unmarked history into one merge)
        strays = _rev_list(root, f"{prev}..{p1}") if prev and prev != p1 else []
        base = p1
        issues = _claims(message) | {int(n) for n in _TRAIN_REFS.findall(message)}
        claim = "message"
        if not issues:
            got_plans = _branch_plan_issues(root, p1, p2, ev["branch"])
            issues, claim = got_plans or set(), "plans"
            ev["plans_unread"] = int(got_plans is None)
    else:
        ev["plans"] = [n.strip() for n in m.group("names").split(",") if n.strip()]
        issues, claim = set(), "plans"
        for name in ev["plans"]:
            text = _git_out(root, "show", f"{sha}:{_review.PLANS_ARCHIVE}/{name}")
            if text is None:
                ev["plans_unread"] += 1  # not read: its issue is unknown, the merge not "without one"
                continue
            issues |= _review.local_issue_numbers(_review._unfenced(text))
        # the first finish without an event before it has no lower bound: it would swallow
        # every commit since the root (the onboarding commit) — unknown, not estimated
        own = _rev_list(root, f"{prev}..{sha}") if prev else None
        strays, base = [], prev
    ev["issues"], ev["claim"] = sorted(issues), claim if issues else "none"
    if own is None or strays is None or base is None:
        ev["bounded"] = False
        return ev
    ev["strays"] = len(strays)
    if strays:
        # the stray commits' own lines: records committed straight onto the integration branch
        # are process load that no merge carries (a steward's journal, a review log)
        stray_stat = _numstat(root, prev, p1)
        ev["stray_process_lines"] = (None if stray_stat is None else
                                     sum(n or 0 for n, f, _o in stray_stat if tower.is_process_path(f)))
        ev["stray_product_lines"] = (None if stray_stat is None else
                                     sum(n or 0 for n, f, _o in stray_stat if not tower.is_process_path(f)))
    commits = [table[s] for s in own if s in table]

    def product(x: dict) -> bool:
        return any(not tower.is_process_path(f) for f in x["files"])
    # mixed: a commit claiming another issue, or — a fast-forward cannot tell the branch's
    # commits from others — a product commit in a finish range that claims nothing
    ev["mixed"] = (any(_claims(x["message"]) - issues for x in commits)
                   or (kind == "finish" and any(product(x) and not _claims(x["message"]) for x in commits)))
    if commits:
        ev["start"] = datetime.fromtimestamp(min(x["at"] for x in commits), tz=timezone.utc)
    ev["product_subjects"] = [(x["message"].splitlines() or [""])[0] for x in commits if product(x)]
    stat = _numstat(root, base, sha)
    if stat is None:
        return ev  # git failed: lines unknown
    prod = proc = 0
    for lines, path, old in stat:
        if tower.is_process_path(path):
            proc += lines or 0
            ev["process_files"].append(path)
            continue
        if lines is None:
            ev["binary"] += 1  # a binary file: 0 lines, counted apart
        prod += lines or 0
        ev["files"][path] = ev["files"].get(path, 0) + (lines or 0)
        if old is not None:
            ev["renames"].append((old, path))
    ev["product_lines"], ev["process_lines"] = prod, proc
    return ev


def merge_events(root: Path, ref: str | None = None) -> dict:
    """{"ref", "events" (oldest first; None when git cannot tell), "shallow", "why"} over the
    first-parent chain of the integration branch (`tower.integration_ref`, the one owner)."""
    import tower  # noqa: PLC0415
    ref = ref or tower.integration_ref(root)
    if not ref:
        return {"ref": None, "events": None, "shallow": False, "why": "no integration branch"}
    tip = _git_out(root, "rev-parse", "--verify", "-q", f"{ref}^{{commit}}")
    if tip is None:
        return {"ref": ref, "events": None, "shallow": False, "why": f"git cannot read {ref}"}
    key = (str(root), ref, tip.strip())
    if key in _EVENTS_READ:
        return _EVENTS_READ[key]
    table = _commit_table(root, ref)
    chain = _git_out(root, "rev-list", "--first-parent", ref)
    if table is None or chain is None:
        # a failed read stays failed for the run: a later read that succeeds would give the
        # header a different answer than the reports already printed from this one
        failed = {"ref": ref, "events": None, "shallow": False, "why": f"git log of {ref} failed"}
        _EVENTS_READ[key] = failed
        return failed
    events: list[dict] = []
    prev = None
    for sha in reversed(chain.split()):
        c = table.get(sha)
        if c is None:
            continue
        subject = (c["message"].splitlines() or [""])[0]
        train = _TRAIN_MERGE.match(subject) if len(c["parents"]) == 2 else None
        finish = None if train else _FINISH_ARCHIVE.match(subject)
        if train or finish:
            events.append(_event(root, table, c, prev, "train" if train else "finish", train or finish))
            prev = sha
    # a shallow clone's boundary commit has no parents: what lies behind it is not here
    shallow = (_git_out(root, "rev-parse", "--is-shallow-repository") or "").strip() == "true"
    got = {"ref": ref, "events": events, "shallow": shallow, "why": None}
    _EVENTS_READ[key] = got
    return got


def merged_works(root: Path, ref: str | None = None) -> dict:
    """merge_events plus {"works": issue → work, "unclaimed": events no issue claims, "mixed":
    mixed ranges}. A work is an issue with its merge events (stacked phases are several events
    of one work): its end is the last event (`measured` for a train merge, `estimated` for a
    finish archive commit, which lies before rebase, suite and push), its start the earliest
    author time over its ranges, its lines and files the sums over its events."""
    got = merge_events(root, ref)
    by_issue: dict[int, list[dict]] = {}
    for ev in got["events"] or []:
        for n in ev["issues"]:
            by_issue.setdefault(n, []).append(ev)
    works: dict[int, dict] = {}
    for n, evs in by_issue.items():
        known = all(e["bounded"] and e["product_lines"] is not None for e in evs)
        mixed = any(e["mixed"] for e in evs)
        files: dict[str, int] = {}
        for e in evs:
            for f, k in e["files"].items():
                files[f] = files.get(f, 0) + k
        starts = [e["start"] for e in evs]
        works[n] = {
            "issue": n, "events": evs, "first": evs[0]["when"], "end": evs[-1]["when"],
            "end_quality": "measured" if evs[-1]["kind"] == "train" else "estimated",
            "start": min(starts) if all(e["bounded"] for e in evs) and all(starts) else None,
            "product_lines": sum(e["product_lines"] for e in evs) if known else None,
            "process_lines": sum(e["process_lines"] for e in evs) if known else None,
            "lines_quality": "missing" if not known else "estimated" if mixed else "measured",
            "files": files, "mixed": mixed,
            "branches": sorted({e["branch"] for e in evs if e["branch"]}),
            "product_subjects": [s for e in evs for s in e["product_subjects"]],
        }
    events = got["events"] or []
    return {**got, "works": works, "unclaimed": sum(1 for e in events if not e["issues"]),
            "mixed": sum(1 for e in events if e["mixed"])}


def _first_deploy(rows: list[dict], branches: set[str], when: datetime) -> datetime | None:
    """The first train row that landed one of `branches` and deployed at or after `when`."""
    for row in rows:
        landed = row.get("branches")
        if not isinstance(landed, list) or not branches & {b for b in landed if isinstance(b, str)}:
            continue
        ended = _aware(row.get("ended"))
        if ended is not None and ended >= when and row.get("deployed") is True:
            return ended
    return None


def flow_items(root: Path, *, issue: int | None = None, branch: str | None = None,
               follow_up_days: int = _FOLLOW_UP_DAYS, now: datetime | None = None) -> list[dict]:
    """One timeline per issue; every value is {"value", "quality"} where quality
    is measured, estimated or missing. The issues are the host's (reports, dispatch
    logs) and the merged works git holds (`merged_works`, #341); one both know counts
    once: git's merge time before the report's, the host's dispatch start before
    git's earliest author time, git's start before a report's. Escapes count from the
    work's first merge (its deploy where a train row has it) on both paths."""
    import check_review as _review  # noqa: PLC0415
    import tower  # noqa: PLC0415 — the one owner of the integration branch

    # a project whose mandate says it has no deploy step ends at the merge by
    # design, also where no train row exists (merged with finish.py)
    try:
        import optimize  # noqa: PLC0415 — the mandate's one reader
        no_deploy = (optimize.load_mandate(root)[0] or {}).get("deploy") is False
    except Exception:  # noqa: BLE001
        no_deploy = False
    now = now or datetime.now(timezone.utc)
    common = _common_dir(root)
    integration = branch or tower.integration_ref(root)
    gw = merged_works(root, integration)["works"]
    starts = _phase_starts(common)
    reports = [r for recs in _reports_by_worker(root).values() for r in recs]
    rows = _train_rows(common)
    # which branches carried which issue: a worker's own report says it (never
    # the train's `done`, whose issue is the first #N any commit names — a
    # `Regression-of: #12` in a fix for #20 would file the fix under #12), else
    # the dispatch log's branch name. The integration branch carries no issue.
    integration_names = {integration, "main", "master", "HEAD"}
    reports = [r for r in reports if isinstance(r.get("worker") or r.get("branch"), str)]
    branches_of: dict[int, set[str]] = defaultdict(set)
    for rep in reports:
        b = rep.get("worker") or rep.get("branch")
        if b in integration_names:
            continue
        if rep.get("state") != "done" and str(rep.get("issue") or "").isdigit():
            branches_of[int(rep["issue"])].add(b)
        elif rep.get("state") == "done":
            n = _review.branch_issue(b)  # a merge known only from the train: the name says whose
            if n and str(n).isdigit():
                branches_of[int(n)].add(b)
    for st in starts:
        n = _review.branch_issue(st["branch"])
        if n and str(n).isdigit() and st["branch"] not in integration_names:
            branches_of[int(n)].add(st["branch"])
    shared = {b for b in set().union(*branches_of.values()) if sum(b in v for v in branches_of.values()) > 1} \
        if branches_of else set()
    wanted = [issue] if issue is not None else sorted(set(branches_of) | set(gw))
    regressions = _regressions(root, integration)
    decisions = _owner_decisions(root)
    try:
        import dispatch as _dispatch  # noqa: PLC0415 — one reader of transcripts
    except ImportError:  # pragma: no cover — dispatch is core
        _dispatch = None
    # the plan-drift node's last word per issue (dispatch asks before execute)
    drift: dict[int, dict] = {}
    for ev in _gate_events(common, datetime.min.replace(tzinfo=timezone.utc)):
        plans = ev.get("plans")
        if (ev.get("gate") == "plan-drift" and isinstance(ev.get("issue"), int)
                and ev.get("outcome") in ("pass", "fail") and isinstance(plans, list)):
            nums = [(p.get("behind"), p.get("touching")) for p in plans if isinstance(p, dict)
                    and all(isinstance(p.get(k), int) for k in ("behind", "touching"))]
            if nums:
                drift[ev["issue"]] = {"behind": max(b for b, _ in nums), "touching": max(t for _, t in nums),
                                      "outcome": ev["outcome"], "mode": ev.get("mode")}
    items = []
    for n in wanted:
        bs = branches_of.get(n, set())
        mine = sorted(((r, t) for r in reports
                       if (r.get("worker") in bs or r.get("branch") in bs)
                       and (t := _aware(r.get("ts"))) is not None), key=lambda rt: rt[1])
        all_starts = sorted((s for s in starts if s["branch"] in bs), key=lambda s: s["ts"])
        reused = bool(bs & shared)
        if reused:
            # a name that carried another issue: this issue's window opens after
            # the last merge on that name before its own first report
            own_first = next((t for r, t in mine if str(r.get("issue")) == str(n) and r.get("state") != "done"),
                             None)
            prev = max((t for r, t in mine if r.get("state") == "done" and own_first and t < own_first),
                       default=None)
            if prev is not None:
                mine = [(r, t) for r, t in mine if t > prev]
                all_starts = [st for st in all_starts if st["ts"] > prev]
        first = all_starts[0]["ts"] if all_starts else (mine[0][1] if mine else None)
        # the first merge after the issue began closes it: a reused branch name
        # later carries another issue's work and merge
        done = [t for r, t in mine if r.get("state") == "done" and (first is None or t >= first)]
        g = gw.get(n)
        # git's merge time before the report's: the last merge event ends the work
        merged = ({"value": g["end"], "quality": g["end_quality"]} if g else
                  {"value": done[0], "quality": "measured"} if done else {"value": None, "quality": "missing"})
        horizon_end = merged["value"]
        own_starts = [s for s in all_starts if horizon_end is None or s["ts"] <= horizon_end]
        own_reports = [(r, t) for r, t in mine if horizon_end is None or t <= horizon_end]
        start = {"value": own_starts[0]["ts"], "quality": "measured"} if own_starts else (
            {"value": g["start"], "quality": "estimated"} if g and g["start"] else
            {"value": own_reports[0][1], "quality": "estimated"} if own_reports else
            {"value": None, "quality": "missing"})
        deployed = {"value": None, "quality": "missing"}
        for row in rows:
            landed = row.get("branches")
            if not isinstance(landed, list) or not bs & {b for b in landed if isinstance(b, str)}:
                continue
            ended = _aware(row.get("ended"))
            if horizon_end is not None and ended is not None and ended < horizon_end:
                continue  # an earlier train of a reused name
            if row.get("deployed") is True and ended:
                deployed = {"value": ended, "quality": "measured"}
                break
            if row.get("deployed") is False:
                deployed = {"value": None, "quality": "failed"}  # a later train may still deploy it
            elif row.get("deployed") is None and deployed["quality"] == "missing":
                deployed = {"value": None, "quality": "not configured"}
        # the endpoint is said, never swapped silently: planning-to-deploy is the
        # measure; a project without a deploy step ends at the merge by design, a
        # missing or failed deploy makes a merge-ended lead time an estimate
        if deployed["value"]:
            end, endpoint = deployed, "deploy"
        else:
            end, endpoint = merged, "merge"
        if no_deploy and deployed["quality"] == "missing":
            deployed = {"value": None, "quality": "not configured"}
        merge_by_design = deployed["quality"] == "not configured"
        # working time is the union of phase intervals: a re-dispatched phase
        # overlaps its first attempt and must not count twice
        spans = []
        unended = 0
        for s in own_starts:
            fin = next((t for r, t in own_reports if t >= s["ts"]
                        and (r.get("worker") == s["branch"] or r.get("branch") == s["branch"])
                        and r.get("state") in _PHASE_ENDS[s["phase"]]), None)
            if fin is None:
                unended += 1
            else:
                spans.append((s["ts"], fin))
        work = 0.0
        last_end = None
        for a, b in sorted(spans):
            if last_end is not None and a < last_end:
                a = last_end
            if b > a:
                work += (b - a).total_seconds()
            last_end = b if last_end is None else max(last_end, b)
        unended += reused  # a shared branch name: attribution is an estimate
        if reused:
            # git's merge time names its issue itself: no shared name blurs it
            for field in (start, deployed) if g else (start, merged, deployed):
                if field["quality"] == "measured":
                    field["quality"] = "estimated"
        lead = wait = None
        if start["value"] and end["value"]:
            lead = (end["value"] - start["value"]).total_seconds()
            # with no phase closed, working time is unknown, not zero — and so is the wait
            wait = max(0.0, lead - work) if spans else None
        quality = ("missing" if lead is None else
                   "measured" if start["quality"] == end["quality"] == "measured" and not unended
                   and (endpoint == "deploy" or merge_by_design)
                   else "estimated")
        # escapes count from the moment users had the change: the deploy, else the merge — of
        # the work's FIRST merge, on the host and on a clone alike, so a fix under the same
        # issue after the first merge is an escape; a git log that failed leaves them unknown
        escapes = None
        firsts = [t for t in (g["first"] if g else None, done[0] if done else None) if t is not None]
        first_merge = min(firsts) if firsts else None
        first_deploy = _first_deploy(rows, bs, first_merge) if first_merge else deployed["value"]
        window_from = first_deploy or first_merge
        if window_from and regressions is not None:
            horizon = window_from + timedelta(days=follow_up_days)
            escapes = sum(1 for t in regressions.get(n, []) if window_from <= t <= horizon)
            window_open = now < horizon
        else:
            window_open = None
        coverage = _dispatch.issue_token_coverage(root, n) if _dispatch else None
        tokens = coverage[:2] if coverage else None
        # a field some usage events lack, or a source that could not be read
        # completely, makes a partial sum: estimated, never measured
        partial = bool(coverage) and (coverage[4] > 0
                                      or any(c < coverage[3] for c in coverage[2].values()))
        items.append({
            "issue": n, "branches": sorted(bs),
            "start": start, "merged": merged, "deployed": deployed,
            "lead_s": {"value": lead, "quality": quality, "endpoint": endpoint},
            "work_s": {"value": work if spans else None,
                       "quality": "missing" if not spans else ("estimated" if unended else "measured")},
            "wait_s": {"value": wait, "quality": quality},
            "tokens": {"value": tokens[0] if tokens and tokens[0] else None,
                       "sessions": tokens[1] if tokens else 0,
                       "coverage": coverage[2] if coverage else {},
                       "events": coverage[3] if coverage else 0,
                       "unknown_sources": coverage[4] if coverage else 0,
                       "quality": ("missing" if not (tokens and tokens[0]) else
                                   "estimated" if partial else "measured")},
            "owner_decisions": {"value": decisions.get(n, 0), "quality": "proxy"},
            "escapes": {"value": escapes,
                        "quality": ("missing" if escapes is None else
                                    "measured" if first_deploy or merge_by_design else "estimated"),
                        "window_open": window_open, "days": follow_up_days,
                        "from": "deploy" if first_deploy else "merge"},
            "plan_drift": {"value": drift.get(n), "quality": "measured" if n in drift else "missing"},
            "process_version": {"value": _process_version(root, integration, merged["value"]),
                                "quality": "measured" if merged["value"] else "missing"},
            # from git (#341): which traces know the work, its merge events, its lines
            "source": "both" if g and n in branches_of else "git" if g else "host",
            "events": [e["sha"] for e in g["events"]] if g else [],
            "first_merge": first_merge,
            "product_lines": ({"value": g["product_lines"], "quality": g["lines_quality"]} if g else
                              {"value": None, "quality": "missing"}),
            "process_lines": ({"value": g["process_lines"], "quality": g["lines_quality"]} if g else
                              {"value": None, "quality": "missing"}),
            "files": g["files"] if g else {},
            "product_subjects": g["product_subjects"] if g else [],
        })
    return items


def _drift_text(d: dict | None) -> str:
    return ("plan drift not measured" if d is None else
            f"plan {d['behind']} behind, {d['touching']} touching" + (" (stale)" if d["outcome"] == "fail" else ""))


def _hours(seconds: float | None) -> str:
    return "—" if seconds is None else f"{seconds / 3600:.1f} h"


def _token_text(tok: dict) -> str:
    if tok["value"] is None:
        return "tokens not measured"
    v = tok["value"]
    names = (("output_tokens", "out"), ("input_tokens", "in"),
             ("cache_read_input_tokens", "cache read"), ("cache_creation_input_tokens", "cache write"))
    parts = [f"{label} {v[k]:,}" for k, label in names if k in v]
    return f"tokens {' / '.join(parts) or 'none recorded'} ({tok['sessions']} session(s))"


def flow(root: Path | None = None, *, issue: int | None = None, as_json: bool = False,
         follow_up_days: int = _FOLLOW_UP_DAYS) -> int:
    import json  # noqa: PLC0415

    root = root or Path.cwd()
    items = flow_items(root, issue=issue, follow_up_days=follow_up_days)
    if as_json:
        def _plain(o):
            return o.isoformat() if isinstance(o, datetime) else str(o)
        print(json.dumps(items, indent=2, default=_plain))
        return 0
    print("[flow] per issue — first dispatched phase to deploy (else merge); "
          "measured / estimated / missing per field")
    if not items:
        print("  no dispatched issue found (dispatch logs, worker reports) — flow skipped")
        return 0
    for it in items:
        esc = it["escapes"]
        esc_text = ("escapes not measurable (no merge)" if esc["value"] is None else
                    f"escapes {esc['value']} in {esc['days']} d" + (" (window still open)" if esc["window_open"] else ""))
        print(f"  #{it['issue']}: lead {_hours(it['lead_s']['value'])} to {it['lead_s']['endpoint']} "
              f"[{it['lead_s']['quality']}] "
              f"(work {_hours(it['work_s']['value'])}, wait {_hours(it['wait_s']['value'])}) · "
              f"start {it['start']['quality']} · merge {it['merged']['quality']} · "
              f"deploy {it['deployed']['quality']} · {_token_text(it['tokens'])} · "
              f"owner decisions {it['owner_decisions']['value']} (proxy) · {esc_text} · "
              f"{_drift_text(it['plan_drift']['value'])} · "
              f"process {it['process_version']['value'] or 'unknown'}")
    leads = [it["lead_s"]["value"] for it in items if it["lead_s"]["value"] is not None]
    measured = [it for it in items if it["lead_s"]["quality"] == "measured"]
    if leads:
        works = [it["work_s"]["value"] for it in items if it["lead_s"]["value"] is not None
                 and it["work_s"]["value"] is not None]
        waits = [it["wait_s"]["value"] for it in items if it["wait_s"]["value"] is not None]
        print(f"  lead median {_hours(statistics.median(leads))}, P90 {_hours(_percentile(leads, 0.9))} "
              f"over n={len(leads)} ({len(measured)} fully measured)"
              + (f"; work median {_hours(statistics.median(works))}" if works else "")
              + (f", wait median {_hours(statistics.median(waits))}" if waits else ""))
    n = len(measured)
    level = _level(n, False, len(measured) < len(items), _N_THRESHOLD)
    print(f"  {confidence(n, sample_biased=len(measured) < len(items))} · "
          f"{action(level, 'the larger of work and wait is the lever: wait → steward hand-offs, questions, the train; work → rounds (`rounds`) and context', thin='let more issues run through dispatch, reports and the train before acting on a duration')}")
    print("  recovery time: not measured (no incident records)")
    return 0


# --- losses: four measures that are never summed ----------------------------
# Occupancy (agent hours actually spent), delay (hours an issue waited),
# owner effort and tokens have different units and different owners; twenty
# issues waiting one hour on the same outage are twenty issue-hours of delay,
# not twenty agent-hours (refutation, round 2). A breakdown (rework, a
# regression fix) is part of occupancy, never added on top. An issue without
# a value counts as missing, never as zero.
_LOSS_DAYS = 28


def _sum_measure(items: list[dict], key: str) -> dict:
    present = [it[key] for it in items if it[key]["value"] is not None]
    qualities = {m["quality"] for m in present}
    return {"value": round(sum(m["value"] for m in present) / 3600, 2) if present else None,
            "unit": "h", "issues": len(present), "missing": len(items) - len(present),
            "quality": ("missing" if not present else
                        "measured" if qualities == {"measured"} and len(present) == len(items) else "estimated")}


def losses_table(root: Path, *, days: int = _LOSS_DAYS, now: datetime | None = None) -> dict:
    now = now or datetime.now(timezone.utc)
    since = now - timedelta(days=days)
    items = [it for it in flow_items(root, now=now)
             if (it["start"]["value"] or it["merged"]["value"] or now) >= since]
    tokens: dict[str, int] = {}
    with_tokens = [it["tokens"] for it in items if it["tokens"]["value"]]
    for tok in with_tokens:
        for field, n in tok["value"].items():
            tokens[field] = tokens.get(field, 0) + n
    escapes = [it["escapes"]["value"] for it in items if it["escapes"]["value"] is not None]
    return {
        "days": days, "issues": len(items),
        "occupancy": _sum_measure(items, "work_s"),
        "delay": {**_sum_measure(items, "wait_s"), "unit": "issue-h"},
        "owner_effort": {"decisions": sum(it["owner_decisions"]["value"] for it in items),
                         "minutes": None, "quality": "proxy"},
        "tokens": {"value": tokens or None, "issues": len(with_tokens),
                   "missing": len(items) - len(with_tokens),
                   "quality": ("missing" if not with_tokens else
                               "measured" if len(with_tokens) == len(items)
                               and all(t["quality"] == "measured" for t in with_tokens) else "estimated")},
        # diagnostic only: where to look, never an input to a budget
        "proxies": {"regression_fixes": sum(escapes) if escapes else None,
                    "regression_issues_observed": len(escapes)},
    }


def losses(root: Path | None = None, *, days: int = _LOSS_DAYS, as_json: bool = False) -> int:
    import json  # noqa: PLC0415

    root = root or Path.cwd()
    t = losses_table(root, days=days)
    if as_json:
        print(json.dumps(t, indent=2))
        return 0
    print(f"[losses] last {days} days over {t['issues']} dispatched issue(s) — four measures, never summed")
    if not t["issues"]:
        print("  no dispatched issue in the window (dispatch logs, worker reports) — losses skipped")
        return 0

    def _m(m: dict) -> str:
        v = "—" if m["value"] is None else f"{m['value']:.1f} {m['unit']}"
        return f"{v} [{m['quality']}; {m['issues']} with a value, {m['missing']} missing]"
    print(f"  occupancy   {_m(t['occupancy'])}")
    print(f"  delay       {_m(t['delay'])}")
    print(f"  owner       {t['owner_effort']['decisions']} decision(s) [proxy; minutes not measured]")
    tok = t["tokens"]
    tok_text = ("not measured" if not tok["value"] else
                " / ".join(f"{k} {v:,}" for k, v in sorted(tok["value"].items())))
    print(f"  tokens      {tok_text} [{tok['quality']}; {tok['issues']} with a value, {tok['missing']} missing]")
    p = t["proxies"]
    print(f"  proxy       regression fixes {p['regression_fixes'] if p['regression_fixes'] is not None else '—'} "
          f"over {p['regression_issues_observed']} merged issue(s) (diagnostic, not a loss in hours)")
    n = t["issues"]
    print(f"  {confidence(n)} · {action(_level(n, False, False, _N_THRESHOLD), 'compare each measure with its own past, never with the others: delay → hand-offs and the train, occupancy → rounds and context, tokens → model and context per phase', thin='let more issues run through dispatch before reading a trend')}")
    return 0


# --- works: what one merged work cost (#314) ------------------------------------
_ALL_TIME = (datetime.min.replace(tzinfo=timezone.utc), datetime.max.replace(tzinfo=timezone.utc))


def _merged_in(items: list[dict], lo: datetime, hi: datetime) -> list[dict]:
    return sorted((it for it in items if (m := _when(it["merged"]["value"])) and lo <= m < hi),
                  key=lambda it: _when(it["merged"]["value"]))


def _sessions_by_issue(root: Path) -> dict[int, dict[str, int]]:
    """issue → sessions per model family (the reported model's first word: `claude-opus-5` →
    `claude`), a session being one worker's phase on one model — only where the host has
    worker reports with a model."""
    seen: set[tuple] = set()
    out: dict[int, dict[str, int]] = {}
    for recs in _reports_by_worker(root).values():
        for r in recs:
            model = str(r.get("model") or "").strip()
            issue = str(r.get("issue") or "")
            if not model or model == "not measured" or not issue.isdigit():
                continue
            key = (int(issue), r.get("worker"), r.get("phase"), model)
            if key in seen:
                continue
            seen.add(key)
            family = re.split(r"[-_ .:@]", model.rsplit("/", 1)[-1].lower())[0] or model
            cell = out.setdefault(int(issue), {})
            cell[family] = cell.get(family, 0) + 1
    return out


def _spread(rows: list[dict], key: str, fields: tuple[str, ...]) -> dict[str, dict]:
    """Per value of `key` (None → "unknown"): n, median and p90 of each field, over the rows
    that have it — a missing value is left out, never a zero."""
    groups: dict[str, list[dict]] = {}
    for row in rows:
        groups.setdefault(str(row[key] or "unknown"), []).append(row)
    out: dict[str, dict] = {}
    for name, members in sorted(groups.items()):
        cell: dict = {"works": len(members)}
        for field in fields:
            vals = [r[field] for r in members if r[field] is not None]
            cell[field] = {"n": len(vals), "median": statistics.median(vals) if vals else None,
                           "p90": _percentile(vals, 0.9) if vals else None}
        out[name] = cell
    return out


_WORK_FIELDS = ("lead_h", "work_h", "plan_rounds", "code_rounds", "product_lines")


def works_table(root: Path, lo: datetime = _ALL_TIME[0], hi: datetime = _ALL_TIME[1], *,
                items: list[dict] | None = None) -> dict:
    """One row per work merged in the window: issue, tier, kind, plan and code review rounds,
    lead time (start to its last merge), active session time (`work_s`) and sessions per model
    family where the host has them, product lines; median and p90 by tier and by kind."""
    items = flow_items(root) if items is None else items
    merged = _merged_in(items, lo, hi)
    plans, rounds = _plans(root), _review_rounds(root)
    sessions = _sessions_by_issue(root)
    rows = []
    for it in merged:
        n = it["issue"]
        code = _rounds_of_issue(root, rounds, n, plans)
        planned = [rounds[f"{i}-plan"]["max_round"] for i in _issue_ids(n, plans) if f"{i}-plan" in rounds]
        start, end = _when(it["start"]["value"]), _when(it["merged"]["value"])
        work = (it.get("work_s") or {}).get("value")
        rows.append({
            "issue": n, "tier": _work_tier(n, plans, rounds), "kind": _work_kind(n, plans, it.get("product_subjects", [])),
            "plan_rounds": max(planned) if planned else None,
            "code_rounds": code["max_round"] if code else None,
            "lead_h": round((end - start).total_seconds() / 3600, 1) if start and end else None,
            "work_h": round(work / 3600, 1) if work is not None else None,
            "sessions": sessions.get(n) or None,
            "product_lines": (it.get("product_lines") or {}).get("value"),
            "source": it.get("source", "host"),
        })
    return {"rows": rows, "by_tier": _spread(rows, "tier", _WORK_FIELDS),
            "by_kind": _spread(rows, "kind", _WORK_FIELDS),
            "population": _population(root, merged, lo, hi, plans, rounds)}


def _num(v) -> str:
    return "—" if v is None else f"{v:g}" if isinstance(v, float) else str(v)


