#!/usr/bin/env python3
"""gh_sync: pull GitHub issues into the committed snapshot the github-master gate
checks against. This is the ONE place the process talks to the network.

Truth flows GitHub -> snapshot. The snapshot (.process-work/github-snapshot.json)
is then checked, offline and deterministically, by check_github_master.py. Run
this whenever the GitHub side changes, then commit the snapshot. Best-effort by
nature (needs `gh`, auth, network) — it is not a gate and never blocks CI; the
gate is the tested, hermetic contract.

Lean pass: issues ARE the work log (no registry mirror to join against) — the
snapshot keys entries by issue number. Stdlib + `gh`.

Usage: python scripts/process/gh_sync.py [OWNER/REPO]
       (repo falls back to the github_repo copier answer)
"""
from __future__ import annotations

import json
import re
import shutil
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path

SNAPSHOT = ".process-work/github-snapshot.json"
ANSWERS = ".copier-answers.yml"
STATUS_LABEL = re.compile(r"^status:(\S+)$")


def _repo(root: Path, argv: list[str]) -> str | None:
    if len(argv) > 1 and argv[1]:
        return argv[1]
    f = root / ANSWERS
    if f.is_file():
        for line in f.read_text(encoding="utf-8").splitlines():
            if line.startswith("github_repo:"):
                v = line.split(":", 1)[1].strip().strip('"').strip("'")
                return v or None
    return None


def _status_from(labels: list, state: str) -> str:
    for lb in labels:
        name = lb.get("name") if isinstance(lb, dict) else str(lb)
        m = STATUS_LABEL.match(name or "")
        if m:
            return m.group(1)
    # unlabeled open = proposed: the DoR gates *starting* work — an unclaimed
    # backlog issue is not started; `status:in-progress` is the claim
    return "done" if state == "closed" else "proposed"


def _dor_facts(labels: list, title: str, body: str) -> dict:
    """Definition-of-Ready facts, computed here — the one place that sees the
    live issue content — so the hermetic gate can enforce DoR offline without
    the snapshot carrying the body:

    - typed: carries a `type:*` label (DoR R1);
    - ears: an EARS acceptance section — heading (English or German) or a
      `shall` clause, case-insensitive; an epic is exempt (scope + invariants
      instead, DoR R2);
    - deviation: the issue body records a `## Deviations` note — the DoR's named
      escape hatch (definition-of-ready-and-done.md, Bindingness)."""
    names = {(lb.get("name") if isinstance(lb, dict) else str(lb)) or ""
             for lb in labels}
    typed = any(n.startswith("type:") for n in names)
    is_epic = "type:epic" in names or (title or "").upper().startswith("EPIC")
    b = body or ""
    ears = bool(is_epic
                or re.search(r"(acceptance criteria|akzeptanzkriterien)\s*\(ears\)", b, re.I)
                or re.search(r"\bshall\b", b, re.I))
    deviation = bool(re.search(r"(?m)^#{1,6}[ \t]+Deviations\b", b, re.I))
    return {"typed": typed, "ears": ears, "deviation": deviation}


def main() -> int:
    root = Path(".").resolve()
    gh = shutil.which("gh")
    if not gh:
        print("gh_sync: `gh` not on PATH — install and authenticate it", file=sys.stderr)
        return 1
    repo = _repo(root, sys.argv)
    if not repo:
        print("gh_sync: no repo — pass OWNER/REPO or set the github_repo answer",
              file=sys.stderr)
        return 1
    try:
        r = subprocess.run(
            [gh, "issue", "list", "--repo", repo, "--state", "all", "--limit", "500",
             "--json", "number,title,state,labels,body"],
            capture_output=True, text=True, timeout=60,
        )
    except (subprocess.TimeoutExpired, OSError) as exc:
        print(f"gh_sync: gh failed: {exc}", file=sys.stderr)
        return 1
    if r.returncode != 0:
        print(f"gh_sync: gh failed: {r.stderr.strip()}", file=sys.stderr)
        return 1

    # carry forward slots this tool does not master, so re-running gh_sync to
    # refresh title/status does NOT wipe values another tool (e.g. gh_board's
    # board_status) merged into the committed snapshot.
    out = root / SNAPSHOT
    prior: dict = {}
    if out.is_file():
        try:
            prev = json.loads(out.read_text(encoding="utf-8"))
            prior = {e.get("number"): e for e in prev.get("issues", [])
                     if isinstance(e, dict)}
        except (json.JSONDecodeError, UnicodeDecodeError):
            prior = {}

    issues = []
    for it in json.loads(r.stdout):
        num = it["number"]
        kept = prior.get(num, {})
        issues.append({
            "number": num, "title": it.get("title"),
            "state": it.get("state", "").lower(),
            "status": _status_from(it.get("labels") or [], it.get("state", "").lower()),
            # Definition-of-Ready facts, derived from the live issue here so the
            # gate can enforce DoR offline (the body itself is not snapshotted)
            "dor": _dor_facts(it.get("labels") or [], it.get("title") or "",
                              it.get("body") or ""),
            # gh_sync does not master this — preserve whatever gh_board committed
            # (null until then); the gate skips checks on null slots.
            "board_status": kept.get("board_status"),
        })
    out.parent.mkdir(parents=True, exist_ok=True)
    # generated_at stamps when this mirror was pulled — the gate cannot check
    # freshness (no clock/network), but it surfaces the stamp so a human can.
    stamp = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    out.write_text(json.dumps({"generated_by": "gh_sync", "generated_at": stamp,
                               "issues": issues}, indent=2) + "\n", encoding="utf-8")
    print(f"gh_sync: wrote {len(issues)} issue(s) to {SNAPSHOT}")
    print("gh_sync: commit the snapshot, then the github-master gate checks it offline")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
