#!/usr/bin/env python3
"""github-master gate: when GitHub Issues are the work-log source of truth,
keep the committed snapshot honest — hermetically.

The truth lives in GitHub (issues, board). The `gh_sync.py` tool pulls it into
a committed snapshot (`.process-work/github-snapshot.json`) over the network.
THIS gate never touches the network: it checks, offline and deterministically,
that the committed snapshot is well-formed and internally consistent — DoR at
rest for started work, board column vs issue state/status. Freshness of the
snapshot vs live GitHub is the sync tool's job, not a gate's.

Lean pass: issues ARE the work log — there is no registry mirror to
cross-check; the feature inventory (feature-registry module) answers the
separate "what exists and is proven" question and is not coupled here.
With this module off, nothing here runs. Stdlib only.
"""
from __future__ import annotations

import json
import sys
from pathlib import Path

SNAPSHOT = ".process-work/github-snapshot.json"

# board column (case-insensitive) -> the status label it implies
BOARD_STATUS = {"backlog": "proposed", "ready": "proposed",
                "in-progress": "in-progress", "in progress": "in-progress",
                "review": "in-progress", "done": "done"}
# board column -> the issue state it implies
BOARD_STATE = {"backlog": "open", "ready": "open", "in-progress": "open",
               "in progress": "open", "review": "open", "done": "closed"}
ENTRY_KEYS = {"number", "title", "state", "status", "board_status", "dor"}


def _load_snapshot(root: Path) -> tuple[dict | None, list[str], object]:
    """(entries_by_number, hard_errors, generated_at). entries is None when the
    snapshot is absent (a soft, pre-sync state the caller reports)."""
    f = root / SNAPSHOT
    if not f.is_file():
        return None, [], None
    try:
        raw = f.read_text(encoding="utf-8")
    except UnicodeDecodeError:
        return {}, [f"{SNAPSHOT}: not valid UTF-8"], None
    try:
        data = json.loads(raw)
    except json.JSONDecodeError as exc:
        return {}, [f"{SNAPSHOT}: invalid JSON: {exc}"], None
    if not isinstance(data, dict) or not isinstance(data.get("issues"), list):
        return {}, [f"{SNAPSHOT}: must be an object with an 'issues' list"], None
    generated_at = data.get("generated_at")
    top_extra = set(data) - {"generated_by", "generated_at", "issues"}
    hard: list[str] = []
    if top_extra:
        hard.append(f"{SNAPSHOT}: unknown top-level key(s): {sorted(top_extra)}")
    by_number: dict = {}
    for i, e in enumerate(data["issues"]):
        if not isinstance(e, dict):
            hard.append(f"{SNAPSHOT}: issues[{i}] must be an object")
            continue
        extra = set(e) - ENTRY_KEYS
        if extra:
            hard.append(f"{SNAPSHOT}: issues[{i}] has unknown key(s): {sorted(extra)}")
        num = e.get("number")
        if not isinstance(num, int):
            hard.append(f"{SNAPSHOT}: issues[{i}] missing integer 'number'")
            continue
        if num in by_number:  # a duplicate would silently mask a divergent entry
            hard.append(f"{SNAPSHOT}: duplicate entry for #{num}")
            continue
        if e.get("state") not in ("open", "closed"):
            hard.append(f"{SNAPSHOT}: #{num} 'state' must be 'open' or 'closed'")
        # type-guard the slots the checks consume — a malformed committed
        # snapshot must fail clean, never traceback
        for key in ("title", "status", "board_status"):
            if e.get(key) is not None and not isinstance(e[key], str):
                hard.append(f"{SNAPSHOT}: #{num} {key!r} must be a string or null")
                e = {**e, key: None}
        dor = e.get("dor")
        if dor is not None and not (
                isinstance(dor, dict)
                and set(dor) == {"typed", "ears", "deviation"}
                and all(isinstance(dor[k], bool) for k in dor)):
            hard.append(f"{SNAPSHOT}: #{num} 'dor' must be null or an object with "
                        f"boolean typed/ears/deviation")
            e = {**e, "dor": None}  # neutralize before the DoR check
        by_number[num] = e
    return by_number, hard, generated_at


def _board_checks(snap: dict) -> list[str]:
    """Board column vs issue state and status label — all three come from
    GitHub, but from different surfaces (board, issue state, labels); the gate
    catches the divergence a human misses (e.g. a closed issue still parked in
    In-progress). `null` board slots are skipped (board not synced yet)."""
    hard: list[str] = []
    for num, e in sorted(snap.items()):
        board = e.get("board_status")
        if board is None:
            continue
        col = board.lower()
        if col not in BOARD_STATUS:
            hard.append(f"{SNAPSHOT}: #{num} board column {board!r} is not a known "
                        f"column ({', '.join(sorted(set(BOARD_STATUS)))})")
            continue
        if e.get("state") in ("open", "closed") and e["state"] != BOARD_STATE[col]:
            hard.append(f"{SNAPSHOT}: #{num} board column {board!r} implies a "
                        f"{BOARD_STATE[col]} issue, but it is {e['state']!r}")
        if e.get("status") is not None and e["status"] != BOARD_STATUS[col]:
            hard.append(f"{SNAPSHOT}: #{num} board column {board!r} implies status "
                        f"{BOARD_STATUS[col]!r}, but the status label says "
                        f"{e['status']!r}")
    return hard


def _dor_checks(snap: dict) -> tuple[list[str], list[str]]:
    """Definition of Ready, enforced at rest: an *in-progress* issue (work has
    started) must be Ready — typed (R1) and EARS-gradeable (R2, epics exempt at
    sync time) — or carry a recorded `## Deviations` note (the DoR's named
    escape). Facts come from the snapshot's `dor` slot, which gh_sync derives
    from the live issue; a snapshot predating that slot degrades to a note
    (re-sync), never a fake fail. `done` is the review gate's business."""
    hard: list[str] = []
    stale: list[str] = []
    for num, e in sorted(snap.items()):
        if e.get("status") != "in-progress" or e.get("state") != "open":
            continue
        dor = e.get("dor")
        if dor is None:
            stale.append(f"#{num}")
            continue
        if dor["deviation"]:
            continue  # recorded, justified deviation — the named escape
        missing = [name for flag, name in ((dor["typed"], "a type: label (R1)"),
                                           (dor["ears"], "EARS acceptance (R2)"))
                   if not flag]
        if missing:
            hard.append(f"{SNAPSHOT}: #{num} is in-progress but not Ready — "
                        f"missing {' and '.join(missing)}; make it ready or "
                        f"record a '## Deviations' note on the issue, then "
                        f"re-run gh_sync.py (definition-of-ready-and-done.md)")
    soft = ([f"{len(stale)} in-progress issue(s) have a snapshot entry without "
             f"DoR facts ({', '.join(stale)}) — snapshot predates the dor slot; "
             f"re-run gh_sync.py to enforce the Definition of Ready"]
            if stale else [])
    return hard, soft


def check(root: Path) -> tuple[list[str], list[str]]:
    hard: list[str] = []
    snap, snap_hard, generated_at = _load_snapshot(root)
    hard += snap_hard
    if snap is None:
        return hard, ["no github-snapshot.json yet — run gh_sync.py (expected pre-sync)"]

    # Freshness is NOT gated: this gate is deterministic over the *committed*
    # snapshot, so a snapshot that lags GitHub still passes green. Surface that
    # every run — the caveat belongs where the reader sees the result, not only
    # in the docs. The gate cannot check freshness without a clock/network.
    stamp = generated_at if generated_at is not None else "unknown (no generated_at)"
    soft = [f"freshness is not gated — snapshot generated_at={stamp!r}; "
            f"re-run gh_sync.py if GitHub changed since (a stale mirror passes)"]

    hard += _board_checks(snap)
    dor_hard, dor_soft = _dor_checks(snap)
    hard += dor_hard
    soft += dor_soft
    return hard, soft


def main() -> int:
    root = Path(sys.argv[1] if len(sys.argv) > 1 else ".").resolve()
    if not root.is_dir():
        print(f"github-master: FAILED:\n  - root {root} is not a directory")
        return 1
    hard, soft = check(root)
    for note in soft:
        print(f"github-master: note: {note}")
    if hard:
        print("github-master: FAILED:")
        for h in sorted(set(hard)):
            print(f"  - {h}")
        return 1
    print("github-master: OK")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
