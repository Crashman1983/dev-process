# template_update.py writes the per-release delta of owned files here: working
# memory to port by hand, never committed
template-delta/
# make_review_bundle.py -o .process-work/reviews/<slug>.bundle.md: a reviewer's
# input, rebuilt per round — never committed (an untracked one dirties the tree
# and reads as an unhomed plan)
*.bundle.md
# reviews/ versions only reports (*.md) and UI evidence (images); what a review
# run generates beside them — logs, transcripts, raw output, diffs — is never
# committed. Never add *.md or an image here: check_issues skips an ignored
# report, and further readers need the tracked ones
reviews/**/*.log
reviews/**/*.jsonl
reviews/**/*.json
reviews/**/*.txt
reviews/**/*.gz
reviews/**/*.patch
reviews/**/*.diff
