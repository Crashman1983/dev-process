name: process-gates
{% if ci.github == 'manual' -%}
# ci.github: manual — no hosted trigger: the pre-push hook of a clone is the
# gate (docs/process/start-here.md); this workflow is a by-hand run of the same
# checks and nothing may rely on its result.
on:
  workflow_dispatch:
{% else -%}
# push only on main: PR branches already run via pull_request; [push, pull_request]
# would run every PR push twice.
on:
  push:
    branches: [main]
  pull_request:
{% endif -%}
# least privilege: the gate job only reads the working tree and exits.
permissions:
  contents: read
# a newer push supersedes a running check on a branch; the integration branch's
# runs always finish (each is the record of what landed)
concurrency:
  group: {% raw %}${{ github.workflow }}-${{ github.ref }}{% endraw %}
  cancel-in-progress: {% raw %}${{ github.ref != 'refs/heads/main' }}{% endraw %}
jobs:
  # job id = the required-status-check context; must match what the docs tell
  # adopters to require{% if ci.github is sameas true %} (and what setup_branch_protection.sh sets){% endif %}: process-gates
  process-gates:
    name: process-gates
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
      - uses: astral-sh/setup-uv@08807647e7069bb48b6ef5acd8ec9567f424441b # v8.1.0
      - run: uv run scripts/process/gate_runner.py
# Note: a red check blocks a merge only if this job is set as a REQUIRED status
# check in branch protection — see docs/process/start-here.md. CI cannot set that.
